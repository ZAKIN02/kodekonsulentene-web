# Nøkkel til PageSpeed Insights API. Uten den faller /api/sjekk tilbake på egne målinger
# og merker ytelsesraden som «Ikke sjekket». Hent den på https://console.cloud.google.com
PAGESPEED_API_KEY=

# Resend – sender rapporten på e-post. Uten den returneres rapporten bare som JSON.
RESEND_API_KEY=
RAPPORT_FRA=rapport@kodekonsulentene.no
RAPPORT_KOPI=

# Claude – AI-omskriveren på /apper-og-ai. Uten den svarer /api/ai-tekst med at
# funksjonen ikke er skrudd på, og ingenting sendes noe sted.
# Hent den på https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Valgfritt. Standard er claude-haiku-4-5 (rask, billig, begynner å skrive straks).
# claude-sonnet-5-5 gir bedre norsk, men har tenking på av default – les kommentaren
# i src/lib/ai-tekst.ts før du bytter.
CLAUDE_MODELL=

# Valgfritt. Kvoten på det offentlige AI-endepunktet. Standard: 3 / 8 / 50.
AI_PER_IP=
AI_IP_DOGN=
AI_DOGNTAK=
