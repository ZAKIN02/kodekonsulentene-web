# Nøkkel til PageSpeed Insights API. Uten den faller /api/sjekk tilbake på egne målinger
# og merker ytelsesraden som «Ikke sjekket». Hent den på https://console.cloud.google.com
PAGESPEED_API_KEY=

# Resend – sender rapporten på e-post. Uten den returneres rapporten bare som JSON.
RESEND_API_KEY=
RAPPORT_FRA=rapport@kodekonsulentene.no
RAPPORT_KOPI=
