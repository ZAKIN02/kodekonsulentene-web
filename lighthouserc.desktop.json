{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4477 node ./server.mjs",
      "startServerReadyPattern": "lytter",
      "url": [
        "http://127.0.0.1:4477/",
        "http://127.0.0.1:4477/nettsider",
        "http://127.0.0.1:4477/systemer",
        "http://127.0.0.1:4477/sikkerhet",
        "http://127.0.0.1:4477/priser",
        "http://127.0.0.1:4477/verktoy",
        "http://127.0.0.1:4477/historie",
        "http://127.0.0.1:4477/sjekk",
        "http://127.0.0.1:4477/kontakt",
        "http://127.0.0.1:4477/caser",
        "http://127.0.0.1:4477/om"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "formFactor": "desktop",
        "screenEmulation": {
          "mobile": false,
          "width": 1440,
          "height": 900,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-desktop"
    }
  }
}
