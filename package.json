{
  "name": "kodekonsulentene-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KodeKonsulentene – nettside, nettsidesjekk og byråets arbeidsflyt.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run test && npm run check && npm run build",
    "deploy": "fly deploy",
    "logs": "fly logs -a kodekonsulentene",
    "dns:list": "node scripts/dns-godaddy.mjs list",
    "dns:plan": "node scripts/dns-godaddy.mjs plan",
    "dns:apply": "node scripts/dns-godaddy.mjs apply",
    "se": "node .skudd/filmstripe.mjs",
    "kontrast": "node .skudd/herokontrast.mjs",
    "visuell": "playwright test",
    "visuell:prod": "BASE_URL=https://kodekonsulentene.no playwright test --grep @overvaak",
    "visuell:ui": "playwright test --ui",
    "scene": "node scripts/scene.mjs",
    "ytelse": "node .skudd/lh.mjs",
    "ytelse:prod": "node .skudd/lh.mjs https://kodekonsulentene.no",
    "lhci": "lhci autorun",
    "og": "node scripts/og.mjs",
    "bilde": "node scripts/stillbilde.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@higgsfield/client": "^0.2.6",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "satori": "^0.35.0",
    "typescript": "^5.9.3",
    "wawoff2": "^2.0.1"
  }
}
