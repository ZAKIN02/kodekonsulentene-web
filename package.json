{
  "name": "kodekonsulentene-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KodeKonsulentene – nettside, nettsidesjekk og byråets arbeidsflyt.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run test && npm run check && npm run build",
    "deploy": "fly deploy",
    "logs": "fly logs -a kodekonsulentene",
    "dns:list": "node scripts/dns-godaddy.mjs list",
    "dns:plan": "node scripts/dns-godaddy.mjs plan",
    "dns:apply": "node scripts/dns-godaddy.mjs apply",
    "se": "node .skudd/filmstripe.mjs",
    "kontrast": "node .skudd/herokontrast.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
