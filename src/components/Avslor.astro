---
/**
 * Scroll-avdekking. Innholdet tones og glir inn når det kommer i syne.
 *
 * Progressiv forbedring i to lag:
 *  1. Chrome/Safari: ren CSS med `animation-timeline: view()`. Null JavaScript,
 *     og bevegelsen kjører på compositor-tråden.
 *  2. Firefox (mangler scroll-driven animations i stabil versjon): en
 *     IntersectionObserver i scener.css-skriptet legger på en klasse.
 *
 * Uten JavaScript, og med prefers-reduced-motion, står innholdet ferdig. Det er
 * default-tilstanden i CSS – ingenting skjules før noe aktivt skjuler det.
 */
import "../styles/interaksjon.css";

interface Props {
  /** Forsinkelse i trinn, 0–5. Brukes til å la elementer komme etter hverandre. */
  trinn?: number;
  /**
   * Gesten innholdet kommer inn med.
   *
   * «opp» og «venstre» er inngangsbevegelser og mest diskré. De tre siste kom
   * til fordi nettstedet hadde ÉN gest brukt på alt, og leste som en liste i
   * stedet for et rom:
   *
   *  - «skjev»   kommer inn på skrå og retter seg opp. Bryter rutenettet.
   *  - «naer»    skalerer opp mot leseren.
   *  - «dybde»   er ikke en inngang i det hele tatt, men kontinuerlig parallakse
   *              så lenge elementet overlapper vinduet. To elementer med ulik
   *              `dybde` drar fra hverandre, og DET er det som leses som rom.
   *
   * De to siste er de eneste som BÆRER INFORMASJON. Alle de fem over er
   * utbyttbare: bytt innholdet, og gesten passer like godt. Disse to kan brukes
   * feil, og det er beviset på at de sier noe:
   *
   *  - «rekke»   barna lander ETT OM GANGEN, i dokumentrekkefølge, lest av én
   *              felles klokke. Budskapet er at rekkefølgen betyr noe. Feil på
   *              innhold uten rekkefølge.
   *  - «spor»    punktet lander, innholdet kommer med det, og DERETTER tegner
   *              veien seg nedover mot neste punkt. Budskapet er at dette er et
   *              sted på en vei. Feil på noe frittstående.
   */
  fra?: "opp" | "venstre" | "skjev" | "naer" | "dybde" | "rekke" | "spor";
  /**
   * Spiller på TID i stedet for på scroll.
   *
   * For innhold som står over folden. En scroll-drevet gest der er ferdig
   * allerede i første frame og er dermed ingen gest – målt mot referansene sto
   * siden vår på 153 pikselavvik i ro mot jeton.com sine 485.
   *
   * Bonus: tidsdrevne animasjoner virker i EKTE Firefox, som ikke har view().
   * Dette er den eneste gesten i vokabularet som er identisk i alle nettlesere.
   *
   * Gyldig med `fra="opp"`, `"rekke"` og `"spor"`. `straks` overstyrer
   * `animation-name`, så på `skjev`/`naer`/`dybde` ville den stille spist gesten;
   * derfor sier vi fra i stedet for å la den gjøre noe halvveis.
   */
  straks?: boolean;
  /** Utslag i piksler for `fra="dybde"`. Negativt gir motsatt retning. */
  dybde?: number;
  /** Vinkel for `fra="skjev"`. Over ~4 grader leses det som en feil. */
  skjev?: number;
  /** Lar flaten blø ut til skjermkanten. Innholdet beholder lesebredden. */
  utbrudd?: boolean;
  as?: "div" | "li" | "article" | "section";
  class?: string;
}
const {
  trinn = 0,
  fra = "opp",
  straks = false,
  dybde,
  skjev,
  utbrudd = false,
  as = "div",
  class: cls,
} = Astro.props;
const Tag = as;

/**
 * `straks` bytter tidslinje OG `animation-name`. På `skjev`, `naer` og `dybde`
 * ville den derfor spist selve gesten uten at noe feiler synlig – akkurat den
 * feilklassen som har truffet dette vokabularet før (navnet sto riktig, mens
 * tidslinjen var «auto», og bevegelsen forsvant uten en lyd). Vi sier fra i
 * byggeloggen og lar gesten stå, i stedet for å levere noe halvveis.
 */
const STRAKS_OK = ["opp", "rekke", "spor"] as const;
const straksGjelder =
  straks && (STRAKS_OK as readonly string[]).includes(fra);
if (straks && !straksGjelder) {
  console.warn(
    `[Avslor] straks er ikke støttet med fra="${fra}". ` +
      `Gyldige: ${STRAKS_OK.join(", ")}. Gesten står, straks ignoreres.`,
  );
}

const stil = [
  `--trinn:${trinn}`,
  typeof dybde === "number" ? `--dybde:${dybde}px` : null,
  typeof skjev === "number" ? `--skjev:${skjev}deg` : null,
].filter(Boolean).join(";");
---
<Tag
  class:list={[
    "avslor",
    `avslor--${fra}`,
    straksGjelder && "avslor--straks",
    utbrudd && "avslor--utbrudd",
    cls,
  ]}
  style={stil}
  data-avslor
  data-straks={straksGjelder ? "" : undefined}
>
  <slot />
</Tag>

<script>
  /**
   * Reserve for Firefox, som ennå ikke har scroll-driven animations i stabil
   * versjon. Kjører bare der CSS-en IKKE klarer jobben selv – i Chrome og Safari
   * gjør dette skriptet ingenting, og koster da heller ingenting.
   *
   * Rekkefølgen er viktig: vi legger på js-avslor FØR vi merker elementene, slik
   * at ingenting rekker å blinke synlig og så bli skjult.
   *
   * `:not([data-straks])` er med vilje: `straks`-gestene er TIDSDREVNE og virker
   * i Firefox helt på egen hånd, uten denne reserven. Lot vi dem bli merket
   * `data-vent` også, kjørte to mekanismer på samme element – CSS-animasjonen og
   * en IntersectionObserver som setter opasitet 0 – og det er to kilder til
   * samme sannhet. Elementet endte synlig uansett, men av to grunner, og da vet
   * ingen hvilken som faktisk bar bevegelsen.
   */
  const stoetter = CSS.supports("animation-timeline: view()");
  const rolig = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!stoetter && !rolig) {
    const mål = document.querySelectorAll<HTMLElement>(
      "[data-avslor]:not([data-straks]), [data-stortekst]",
    );
    if (mål.length) {
      document.documentElement.classList.add("js-avslor");
      for (const el of mål) el.dataset.vent = "";

      const io = new IntersectionObserver(
        (poster) => {
          for (const p of poster) {
            if (!p.isIntersecting) continue;
            delete (p.target as HTMLElement).dataset.vent;
            io.unobserve(p.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
      );
      for (const el of mål) io.observe(el);

      // Sikkerhetsnett: rekker ikke observeren å fyre – blokkert, bakgrunnsfane,
      // eller en feil et annet sted – skal innholdet uansett bli synlig.
      setTimeout(() => {
        for (const el of mål) delete el.dataset.vent;
      }, 4000);
    }
  }
</script>
