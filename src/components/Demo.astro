---
/**
 * Et ekte skjermopptak av verktøyet, i ramme.
 *
 * Dette er ikke dekorasjon bak tekst. Det er produktet som kjører mot en ekte
 * side, med ekte funn. Grunnen til at det står i ramme og ikke som nedtonet
 * bakgrunn: nedtonet video leser som billig tapet, mens et innrammet opptak
 * leser som bevis. Brandboken sier skjermbilder får hårlinje og radius – det
 * gjelder også levende bilder.
 *
 * Spoles av scroll, spiller aldri av seg selv.
 */
interface Props {
  /**
   * Lar opptaket SPILLE i løkke i stedet for å bli spolt av scrollhjulet.
   *
   * Målt på alle 26 sider: av 21 videoer var 19 `paused`. De spilte ikke – de ble
   * skrubbet, og sto frosset på nøyaktig halve varigheten så snart brukeren sluttet
   * å dra. 21 av 26 sider målte 0,0000 i pikselendring i ro; skjermbildene var
   * bit-identiske. Referansen spinxdigital.com sto aldri stille i noen visning.
   *
   * Skjermopptakene av våre egne verktøy er det sterkeste materialet vi har – og de
   * sto alle sammen på pause. 2–3 sekunder effektiv handling hver. La dem gå.
   */
  spill?: boolean;
  smal: string;
  bred: string;
  /** Valgfritt 1920-trinn. Uten dette blir de største filene liggende ubrukt –
   *  SceneFilm og HeroFilm hadde begge den feilen, til sammen 28 MB dødvekt. */
  stor?: string;
  plakat: string;
  tekst: string;
  kilde?: string;
}
const { smal, bred, stor, plakat, tekst, kilde, spill = false } = Astro.props;
---
<figure class="demo" data-demo data-demo-spill={spill ? "" : undefined}>
  <div class="demo__ramme">
    <video data-demo-video muted playsinline preload="none" poster={plakat} width="1920" height="1080">
      <source data-smal={smal} data-bred={bred} data-stor={stor} type="video/mp4" />
    </video>
  </div>
  {/* Knappen finnes bare paa smal skjerm, og skriptet slaar den paa. Uten
      JavaScript staar stillbildet alene – som er nøyaktig det en telefon fikk
      ut av opptaket foer ogsaa, bare uten at noe later som det beveger seg. */}
  <button class="demo__helskjerm kk-btn" type="button" data-demo-helskjerm hidden>
    Spill av i fullskjerm
  </button>
  <figcaption class="small">
    {tekst}
    {kilde && <span class="faint mono"> {kilde}</span>}
  </figcaption>
</figure>

<style>
  .demo { margin: 0; display: grid; gap: var(--space-3); }
  .demo__ramme {
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-sunken);
  }
  .demo__ramme video { display: block; width: 100%; height: auto; }
  .demo figcaption { color: var(--ink-muted); }

  .demo__helskjerm { display: none; }
  @media (max-width: 640px) {
    .demo__helskjerm:not([hidden]) { display: inline-flex; justify-self: start; }
  }
  /* Fullskjerm skal fylle skjermen, ikke staa som et lite kort midt i svart.
     `object-fit: contain` beholder bildeforholdet. */
  .demo__ramme video:fullscreen { width: 100%; height: 100%; object-fit: contain; background: #000; }
</style>

<script>
  /**
   * ET OPPTAK PAA 0,18x ER IKKE ET BEVIS.
   *
   * Maalt 7. oktober 2026 paa ni sider: opptakene er 1920x1080 og males i
   * 340x191 px. Det er 0,18x. Grensesnittekst paa 16 px i opptaket blir
   * 2,8 px paa skjermen. Flere hele skjermer besto av et klipp der det eneste
   * man kunne se var at det var graatt og at det rørte seg.
   *
   * Det kan ikke rettes med CSS. For at 16 px kildetekst skal naa 12 px paa
   * skjermen maa klippet vises paa omtrent 1440 px bredde, og da er under en
   * fjerdedel av bildet inne i rammen – uansett hvor man zoomer eller
   * beskjaerer. Den varige rettingen er egne opptak tatt opp i telefonformat,
   * og den hoerer hjemme i scripts/opptak.mjs, som allerede kjoerer hvert
   * opptak determenistisk.
   *
   * Det denne endringen gjoer er aa slutte aa late som. Under 640 px staar
   * STILLBILDET – plakaten, som er 1920 px bred – og det kan telefonen
   * knipe-zoome og lese. Et klipp som gaar i loekke kan den ikke: bildet
   * skifter under fingeren. Den som vil se bevegelsen faar en knapp som spiller
   * av i fullskjerm, og det er det beste en telefon kan gi.
   *
   * Over 640 px er alt som foer.
   */
  const SMAL = matchMedia("(max-width: 640px)");

  for (const rot of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const film = rot.querySelector<HTMLVideoElement>("[data-demo-video]");
    const kilde = film?.querySelector<HTMLSourceElement>("source");
    const redusert = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const spar = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!film || !kilde) continue;

    // Knappen staar UTENFOR vilkaarene om redusert bevegelse og datasparing.
    // De to sier at ingenting skal begynne aa bevege seg av seg selv – ikke at
    // brukeren ikke faar lov til aa be om det. Et trykk er nettopp det: en
    // handling brukeren selv har valgt. Fila lastes ikke foer trykket.
    //
    // Knappen vises foerst naar vi vet at den virker. `webkitEnterFullscreen`
    // er Safari paa iPhone sin eneste vei inn: der kan BARE <video> gaa i
    // fullskjerm, ikke et vilkaarlig element.
    const helskjerm = rot.querySelector<HTMLButtonElement>("[data-demo-helskjerm]");
    type IOSVideo = HTMLVideoElement & { webkitEnterFullscreen?: () => void };
    const kanHelskjerm =
      typeof film.requestFullscreen === "function" ||
      typeof (film as IOSVideo).webkitEnterFullscreen === "function";
    if (helskjerm && kanHelskjerm) {
      helskjerm.hidden = false;
      helskjerm.addEventListener("click", () => {
        // Kilden settes FOER play(), ellers spiller vi av et <source> uten src
        // og feiler stille. Samme rekkefoelge som i loekken under.
        if (!kilde.src) {
          kilde.src = kilde.dataset.bred ?? kilde.dataset.smal ?? "";
          film.load();
        }
        film.controls = true;
        film.loop = false;
        film.play().catch(() => {});
        if (typeof film.requestFullscreen === "function") film.requestFullscreen().catch(() => {});
        else (film as IOSVideo).webkitEnterFullscreen?.();
      });
      // Ut av fullskjerm: tilbake til stillbildet. Et klipp som blir staaende
      // og gaa i miniatyr etterpaa er nøyaktig graauten vi ble kvitt.
      film.addEventListener("webkitendfullscreen", () => { film.pause(); film.controls = false; });
      document.addEventListener("fullscreenchange", () => {
        if (document.fullscreenElement !== film) { film.pause(); film.controls = false; }
      });
    }

    // Verken spoling eller loekke paa smal skjerm: stillbildet staar.
    // Her kommer ogsaa de to vilkaarene som knappen over med vilje staar
    // utenfor – ingenting skal starte av seg selv.
    if (SMAL.matches || redusert || spar) continue;

    // Løkke i stedet for spoling. Rekkefølgen er viktig: kilden må settes FØR
    // play(), ellers spiller vi av et <source> uten src og feiler stille.
    if (rot.hasAttribute("data-demo-spill")) {
      film.loop = true;
      film.muted = true;
      film.setAttribute("playsinline", "");
      const ioS = new IntersectionObserver((poster) => {
        if (!poster.some((p) => p.isIntersecting)) return;
        ioS.disconnect();
        const nett = (navigator as Navigator & { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
        const treigt = nett?.saveData === true || /2g|3g/.test(nett?.effectiveType ?? "");
        const px = window.innerWidth * (window.devicePixelRatio || 1);
        kilde.src =
          !treigt && px >= 2200 && kilde.dataset.stor
            ? kilde.dataset.stor
            : window.innerWidth >= 1024
              ? kilde.dataset.bred!
              : kilde.dataset.smal!;
        film.load();
        film.play().catch(() => {});
      }, { rootMargin: "60% 0px" });
      ioS.observe(rot);
      continue;
    }

    let planlagt = false;
    const oppdater = () => {
      planlagt = false;
      if (!film.duration) return;
      const r = rot.getBoundingClientRect();
      // Spoles over strekningen der rammen er synlig.
      const andel = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - r.top) / (window.innerHeight * 0.7 + r.height)));
      film.currentTime = andel * film.duration;
    };
    const io = new IntersectionObserver((poster) => {
      if (!poster.some((p) => p.isIntersecting)) return;
      io.disconnect();
      const nett = (navigator as Navigator & { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
      const treigt = nett?.saveData === true || /2g|3g/.test(nett?.effectiveType ?? "");
      const px = window.innerWidth * (window.devicePixelRatio || 1);
      kilde.src =
        !treigt && px >= 2200 && kilde.dataset.stor
          ? kilde.dataset.stor
          : window.innerWidth >= 1024
            ? kilde.dataset.bred!
            : kilde.dataset.smal!;
      film.preload = "auto";
      film.load();
          // 200 % hentet videoen to skjermhøyder før den var i nærheten av synsranden:
      // 1162 kB på /verktoy/dmarc, 747 på uu-sjekk, 582 på cookie-sjekk, alt før
      // brukeren hadde scrollet. SceneFilm hadde samme feil og står nå på 60 %.
    }, { rootMargin: "60% 0px" });
    io.observe(rot);
    film.addEventListener("loadedmetadata", () => { rot.dataset.klar = "true"; oppdater(); });
    addEventListener("scroll", () => {
      if (!planlagt) { planlagt = true; requestAnimationFrame(oppdater); }
    }, { passive: true });
  }
</script>
