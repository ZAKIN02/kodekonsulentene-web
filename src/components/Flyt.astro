  /* ------------------------------------------------------------------- mobil ---

    Under 1024 px males navnet i figuren under 16 px fordi SVG-en skaleres med
    spalten. Da er lista hele innholdet – og da skal den fortelle den SAMME
    historien, loddrett: en skinne, en prikk per ledd som tennes nedover i
    rekkefølge, og kvitteringen ved siden av.

    Grensen lå først på 720 px, så 900. Målingen flyttet den igjen: på 901 px ble
    navnet malt på 13,4 px og på 1000 px på 15,9 px. Tall som består
    kontrastkravet kan fortsatt være for små å lese. På 1024 px males navnet på
    16,3 px, og det er der grensen hører hjemme.
  */
  @media (max-width: 1023.98px) {
    .flyt__svg { display: none; }
    .flyt__liste {
      position: relative;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: grid;
      gap: var(--space-5);
      padding-left: 30px;
    }
    /* Skinnen. Stopper i midten av første og siste prikk, ikke i kanten av
       lista: en strek som stikker ut over det første leddet ser ut som om
       historien begynner et sted utenfor figuren. */
    .flyt__liste::before {
      content: "";
      position: absolute;
      left: 5px;
      top: 7px;
      bottom: 7px;
      width: var(--hairline);
      background: var(--line-strong);
    }
    .flyt__liste li { position: relative; display: grid; gap: 2px; }
    /* Prikken i hvile: hul ring i samme strek som skinnen. */
    .flyt__liste li::before {
      content: "";
      position: absolute;
      left: -30px;
      top: 2px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      border: var(--hairline) solid var(--line-strong);
      background: var(--bg-raised);
    }
    /* Prikken som tennes. Egen pseudoelement oppå ringen, så ringen blir stående
       når animasjoner er av. */
    .flyt__liste li::after {
      content: "";
      position: absolute;
      left: -28px;
      top: 4px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-text);
      opacity: 0;
      animation-name: flyt-punkt;
      animation-duration: var(--loop);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-fill-mode: both;
      animation-delay: calc(var(--i) * var(--takt));
    }
    .flyt__liste-nr { color: var(--accent-text); }
    /* Kvitteringen står STILLE på mobil. På en liten skjerm er lista selve
       innholdet, og tekst som toner ut mens man leser den er et tap, ikke et
       grep. Prikkene bærer bevegelsen. */
    .flyt__liste-kvitt { color: var(--accent-text); font-size: 0.8125rem; }
  }

  @keyframes flyt-punkt {
    0% { opacity: 0; transform: scale(0.4); }
    2% { opacity: 1; transform: scale(1); }
    40% { opacity: 1; transform: scale(1); }
    50% { opacity: 0; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }

  /*
    REDUSERT BEVEGELSE: figuren står ferdig tegnet med ALLE kvitteringene synlige,
    og ingenting rører seg. Historien er fortsatt der – den er bare fortalt
    ferdig i stedet for å spilles. Prikken, glimtet og gløden hører til
    spillingen og forsvinner; det er riktig, for de tre sier ingenting i stillbilde.
  */
  @media (prefers-reduced-motion: reduce) {
    .flyt__boks,
    .flyt__linje,
    .flyt__spiss,
    .flyt__skille,
    .flyt__nr,
    .flyt__navn,
    .flyt__detalj,
    .flyt__kvitt,
    .flyt__glod,
    .flyt__pakke,
    .flyt__glimt,
    .flyt__liste li::after {
      animation: none !important;
      stroke-dashoffset: 0 !important;
    }
    .flyt__boks,
    .flyt__linje,
    .flyt__spiss,
    .flyt__skille,
    .flyt__nr,
    .flyt__navn,
    .flyt__detalj,
    .flyt__kvitt {
      opacity: 1 !important;
    }
