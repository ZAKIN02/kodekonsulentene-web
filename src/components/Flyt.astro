---
/**
 * Flytdiagram: bokser med EKTE systemnavn, forbundet av linjer som tegner seg
 * selv mens man scroller.
 *
 * Hvorfor den finnes: nettstedet hadde 81 genererte bilder av aluminiumsplater og
 * ingen figur som forklarer hva en kunde får kjøpt. Et bilde av plater i snorer
 * sier ingenting om at tilbudet blir til en faktura uten dobbeltføring. «Vipps»
 * og «Fiken» i to bokser med en pil mellom gjør det på to sekunder.
 *
 * KOSTER 0 kB JAVASCRIPT. Trikset er SVG-attributtet `pathLength="1"`: banen
 * normaliseres til lengde 1 uansett hvor lang den er, så `stroke-dasharray: 1`
 * med `stroke-dashoffset` fra 1 til 0 tegner den – uten at noe må måles med
 * `getTotalLength()` i JavaScript. Det er hele grunnen til at vivus (4,53 kB),
 * lazy-line-painter (5,60 kB) og walkway.js (1,80 kB) finnes, og hele grunnen
 * til at vi ikke trenger dem. Se docs/research-svg.md.
 *
 * DEGRADERING: standardtilstanden i CSS er FERDIG TEGNET. Animasjonen skjuler og
 * tegner på nytt bare der `animation-timeline: view()` finnes. I Firefox, som
 * ikke har den, står hele figuren komplett av seg selv – ingen reserve trengs,
 * og ingenting kan bli stående usynlig. Det er en ekte fordel over innton-
 * effekter, som må ha en IntersectionObserver for ikke å etterlate tom skjerm.
 *
 * TILGJENGELIGHET: SVG-en er `aria-hidden`, og lista under bærer meningen. Det er
 * med vilje – uten det ville en skjermleser lest hvert systemnavn to ganger, én
 * gang fra figuren og én gang fra lista. Teksten i figuren er likevel ekte
 * `<text>`, ikke baner: den kan markeres, søkes i med Ctrl+F og skaleres uten å
 * bli uskarp.
 */
import type { Flyt } from "../data/flyter";

interface Props {
  flyt: Flyt;
  /** Overskriftsnivå. Figuren står som regel inne i en scene som eier h2. */
  nivaa?: 2 | 3;
  class?: string;
}
const { flyt, nivaa = 3, class: cls } = Astro.props;
const Tittel = `h${nivaa}` as "h2" | "h3";

const noder = flyt.noder;
const n = noder.length;

/**
 * Fast viewBox-bredde, variabel boksbredde.
 *
 * Omvendt – fast boks og voksende viewBox – ville gitt ulik tekststørrelse fra
 * side til side, siden SVG-en alltid skaleres til samme spaltebredde. En flyt med
 * tre ledd ville da fått merkbart større skrift enn en med fem.
 */
/**
 * viewBox-bredden er satt til ~spaltebredden med vilje, så skalaen blir rundt 1:1
 * og skriftstørrelsene i figuren males i den størrelsen de er oppgitt i. Første
 * forsøk brukte 1200 og ble skalert til 0,84: 11px-merket ble malt på 9,2 px og
 * detaljlinjen på 10,1 px. Kontrasten besto, men teksten var for liten å lese.
 */
const VB_B = 1000;
const VB_H = 122;
const GAP = 56;
const BOKS_B = (VB_B - (n - 1) * GAP) / n;
const BOKS_Y = 22;
const BOKS_H = 64;
const R = 10;
const MIDT_Y = BOKS_Y + BOKS_H / 2;

const x0 = (i: number) => i * (BOKS_B + GAP);
const cx = (i: number) => x0(i) + BOKS_B / 2;

/** Avrundet rektangel som én bane, så den kan tegne seg med stroke-dashoffset. */
function boksBane(i: number) {
  const x = x0(i);
  const y = BOKS_Y;
  const w = BOKS_B;
  const h = BOKS_H;
  return [
    `M${x + R},${y}`,
    `H${x + w - R}`,
    `A${R},${R} 0 0 1 ${x + w},${y + R}`,
    `V${y + h - R}`,
    `A${R},${R} 0 0 1 ${x + w - R},${y + h}`,
    `H${x + R}`,
    `A${R},${R} 0 0 1 ${x},${y + h - R}`,
    `V${y + R}`,
    `A${R},${R} 0 0 1 ${x + R},${y}`,
    "Z",
  ].join(" ");
}

/** Pilene står mellom boksene, med luft i hver ende. */
const piler = noder.slice(0, -1).map((_, i) => {
  const fra = x0(i) + BOKS_B + 8;
  const til = x0(i + 1) - 8;
  return { i, fra, til, spiss: `M${til - 7},${MIDT_Y - 6} L${til},${MIDT_Y} L${til - 7},${MIDT_Y + 6}` };
});

const nr = (i: number) => String(i + 1).padStart(2, "0");
---

<figure class:list={["flyt", cls]}>
  <Tittel class="heading flyt__tittel">{flyt.tittel}</Tittel>

  <div class="flyt__ramme">
    <svg
      class="flyt__svg"
      viewBox={`0 0 ${VB_B} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
      focusable="false"
    >
      {piler.map((p) => (
        <g class="flyt__pil" style={`--i:${p.i}`}>
          <path class="flyt__linje" d={`M${p.fra},${MIDT_Y} H${p.til}`} pathLength="1" fill="none" />
          <path class="flyt__spiss" d={p.spiss} fill="none" />
        </g>
      ))}

      {noder.map((node, i) => (
        <g class:list={["flyt__node", i === n - 1 && "flyt__node--siste"]} style={`--i:${i}`}>
          <path class="flyt__boks" d={boksBane(i)} pathLength="1" fill="none" />
          {/* Tiden erstatter løpenummeret der den finnes – på prosessflyten er
              tiden poenget, og to tall over hverandre ville konkurrert. */}
          <text
            class:list={["flyt__nr", node.tid && "flyt__nr--tid"]}
            x={cx(i)}
            y={13}
            text-anchor="middle">{node.tid ?? nr(i)}</text>
          <text class="flyt__navn" x={cx(i)} y={MIDT_Y + 6} text-anchor="middle">{node.navn}</text>
          <text class="flyt__detalj" x={cx(i)} y={VB_H - 6} text-anchor="middle">{node.detalj}</text>
        </g>
      ))}
    </svg>

    {/*
      Hele meningen i tekst. Skjult for øyet på bred skjerm, der figuren sier det
      samme – men alltid i DOM-en, så skjermlesere og folk uten SVG får den. Under
      721 px skjules figuren og denne lista ER innholdet.
    */}
    <ol class="flyt__liste visually-hidden">
      {noder.map((node, i) => (
        <li>
          {/* Samme bytte som i figuren. På mobil ER denne lista innholdet, så
              tiden må stå her – rekkefølgen bæres uansett av <ol>. */}
          <span class="mono-label flyt__liste-nr">{node.tid ?? nr(i)}</span>
          <strong class="body-strong">{node.navn}</strong>
          <span class="small muted">{node.detalj}</span>
        </li>
      ))}
    </ol>
  </div>

  <figcaption class="small faint flyt__bunn">{flyt.beskrivelse}</figcaption>
</figure>

<style>
  .flyt { display: grid; gap: var(--space-4); margin: 0; }
  .flyt__tittel { margin: 0; }

  .flyt__ramme {
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    padding: var(--space-6) var(--space-5);
  }

  /* overflow: visible – strøkene ligger helt i kanten av viewBox og ville ellers
     blitt klippet på halve bredden. */
  .flyt__svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* Standardtilstand er FERDIG TEGNET. Alt som skjuler noe står i @supports under,
     så en nettleser uten scroll-tidslinjer viser hele figuren uten å gjøre noe. */
  .flyt__linje,
  .flyt__boks {
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .flyt__linje { stroke: var(--line-strong); }
  .flyt__boks { stroke: var(--line); }
  .flyt__spiss {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 1;
  }

  /* Siste ledd er poenget – det ene stedet aksenten brukes i figuren. */
  .flyt__node--siste .flyt__boks { stroke: var(--accent); }
  .flyt__node--siste .flyt__navn { fill: var(--accent-text); }

  /* Størrelsene er oppgitt i viewBox-enheter. Med VB_B = 1000 mot en spalte på
     rundt 1005 px males de omtrent 1:1 på full bredde, og aldri under ~11 px før
     figuren byttes ut med lista på 900 px. */
  .flyt__nr {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    fill: var(--ink-faint);
  }
  /* Sperring kler et tosifret løpenummer, men gjør «2–3 uker» luftig og vanskelig
     å lese som én enhet. Tiden er et tall, så den beholder monospace. */
  .flyt__nr--tid { letter-spacing: 0; fill: var(--ink-muted); }
  .flyt__navn {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--ink);
  }
  .flyt__detalj {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--ink-muted);
  }

  .flyt__bunn { margin: 0; max-width: 72ch; }

  .flyt__liste { margin: 0; padding: 0; list-style: none; }

  /* Under 900 px blir teksten i figuren malt under ~11 px fordi SVG-en skaleres
     med spalten. Da er lista hele innholdet, og den slutter å være visuelt skjult.
     Grensen lå først på 720 px, men målingen viste at merket da ble malt på 9,2 px
     – tall som består kontrastkravet og likevel er for små å lese. */
  @media (max-width: 900px) {
    .flyt__svg { display: none; }
    .flyt__liste {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: grid;
      gap: var(--space-4);
    }
    .flyt__liste li { display: grid; gap: 2px; }
    .flyt__liste-nr { color: var(--accent-text); }
  }

  /*
    LANGFORMER MED VILJE. Skriver man `animation: navn linear both` og
    `animation-timeline: view()` som to erklæringer, slår lightningcss dem sammen
    til `animation: linear both navn view()`. Den formen er ugyldig –
    animation-timeline er ikke del av stenografien – og BÅDE Chromium og Firefox
    forkaster hele erklæringen uten å si fra. Testen i test/bygget-html.test.ts
    feiler hvis mønsteret dukker opp i bygget.
  */
  @supports (animation-timeline: view()) {
    .flyt__boks {
      animation-name: flyt-tegnes;
      animation-duration: 1ms;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry calc(12% + var(--i) * 13%) cover calc(28% + var(--i) * 13%);
    }
    .flyt__linje {
      animation-name: flyt-tegnes;
      animation-duration: 1ms;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      /* Linjen starter der boksen foran er ferdig, så flyten leses venstre mot høyre. */
      animation-range: entry calc(26% + var(--i) * 13%) cover calc(40% + var(--i) * 13%);
    }
    .flyt__spiss,
    .flyt__nr,
    .flyt__navn,
    .flyt__detalj {
      animation-name: flyt-tones-inn;
      animation-duration: 1ms;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry calc(20% + var(--i) * 13%) cover calc(34% + var(--i) * 13%);
    }
  }

  @keyframes flyt-tegnes {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes flyt-tones-inn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Redusert bevegelse: figuren står ferdig, ingenting beveger seg. */
  @media (prefers-reduced-motion: reduce) {
    .flyt__boks,
    .flyt__linje,
    .flyt__spiss,
    .flyt__nr,
    .flyt__navn,
    .flyt__detalj {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }
  }
</style>
