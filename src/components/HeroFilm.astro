---
/**
 * Hero-bakgrunn: scroll-spolt video i full bredde, med innholdet liggende over.
 *
 * Kilden er rendret i 4K (3840x2160) og skalert ned til 1920 og 1280, slik at
 * platekantene holder seg skarpe. Den spoles av scroll og spiller ikke av seg selv – da gjelder ikke kravet i
 * WCAG 2.2.2 om pauseknapp, og den bruker ingen CPU når siden står stille.
 * Plakaten (AVIF) er LCP-elementet og står alene ved redusert bevegelse,
 * Save-Data, eller hvis videoen ikke rekker å laste.
 */
---
<div class="herofilm" data-herofilm aria-hidden="true">
  <video
    data-herofilm-video
    muted
    playsinline
    preload="none"
    poster="/historie/hero-poster.avif"
    width="1920"
    height="1080"
  >
    <source data-smal="/historie/hero-1280.mp4" data-bred="/historie/hero-1920.mp4" data-stor="/historie/hero-2560.mp4" type="video/mp4" />
  </video>
</div>

<style>
  .herofilm {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* Bildet er dekorasjon. Det skal aldri kjempe med teksten, så det tones ned
       og får en maske som lar venstre side gå i null. */
    opacity: 0.9;
    /* Teksten eier venstre halvdel. Masken må være helt gjennomsiktig der, ellers
       havner platene bak ingressen – målt 1,01:1 med den gamle kurven. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 46%, rgb(0 0 0 / 0.25) 58%, #000 76%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 46%, rgb(0 0 0 / 0.25) 58%, #000 76%);
  }
  .herofilm video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    display: block;
  }
  @media (max-width: 860px) {
    .herofilm {
      /* På mobil står teksten øverst og filmen må holde seg under den. Med den
         gamle kurven (gjennomsiktig til 30 %) lå platene bak ingressen og målte
         3,85:1 – under AA-kravet på 4,5. Nå er filmen helt borte i øvre halvdel. */
      opacity: 0.42;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, rgb(0 0 0 / 0.35) 68%, #000 88%);
      mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, rgb(0 0 0 / 0.35) 68%, #000 88%);
    }
    .herofilm video { object-position: center 60%; }
  }
</style>

<script>
  const rot = document.querySelector<HTMLElement>("[data-herofilm]");
  const film = rot?.querySelector<HTMLVideoElement>("[data-herofilm-video]");
  const kilde = film?.querySelector<HTMLSourceElement>("source");
  const redusert = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sparData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (rot && film && kilde && !redusert && !sparData) {
    // Tre trinn, ikke to. 2560-fila ble generert men aldri referert – 9,6 MB som
    // lå ubrukt i repoet. Den hentes bare når skjermen faktisk kan vise den, og
    // bare over en rask forbindelse: 2560-trinnet er 9,6 MB mot 3,1 for 1280.
    const nett = (navigator as Navigator & { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
    const treigt = nett?.saveData === true || /2g|3g/.test(nett?.effectiveType ?? "");
    const bredde = window.innerWidth * (window.devicePixelRatio || 1);
    kilde.src =
      !treigt && bredde >= 2200 && kilde.dataset.stor
        ? kilde.dataset.stor
        : window.innerWidth >= 1024
          ? kilde.dataset.bred!
          : kilde.dataset.smal!;
    film.preload = "auto";
    film.load();

    let planlagt = false;
    const oppdater = () => {
      planlagt = false;
      if (!film.duration) return;
      // Hero-en spoles over de to første skjermhøydene. Etter det er den forbi.
      const strekk = window.innerHeight * 1.6;
      const andel = Math.min(1, Math.max(0, window.scrollY / strekk));
      film.currentTime = andel * film.duration;
    };
    film.addEventListener("loadedmetadata", () => { rot.dataset.klar = "true"; oppdater(); });
    addEventListener("scroll", () => {
      if (!planlagt) { planlagt = true; requestAnimationFrame(oppdater); }
    }, { passive: true });
  }
</script>
