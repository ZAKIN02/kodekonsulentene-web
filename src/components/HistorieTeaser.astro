---
/**
 * Fullbredde-inngang til scroll-historien.
 *
 * Bruker plakaten fra historien – 7 kB AVIF – og ikke videoen. Forsiden har et
 * ytelsesbudsjett å holde, og en autospillende video over folden ville spist det.
 * Bevegelsen ligger på /historie, der den har plass.
 */
import Button from "./Button.astro";
---
<section class="teaser" aria-labelledby="teaser-tittel">
  <img
    src="/historie/poster.avif"
    alt=""
    width="1280"
    height="720"
    loading="lazy"
    decoding="async"
  />
  <div class="teaser__slor" aria-hidden="true"></div>
  <div class="teaser__ramme">
   <div class="teaser__tekst">
    <p class="kk-eyebrow"><span class="kk-eyebrow-n" aria-hidden="true">//</span> <span>Se innsiden</span></p>
    <h2 id="teaser-tittel" class="display-lg">En nettside er flere lag enn du tror</h2>
    <p class="body-lg">
      Design, kode, sikkerhet og integrasjoner. Scroll gjennom historien, så tar vi
      en side fra hverandre og setter den sammen igjen.
    </p>
    <Button variant="primary" href="/historie">Se historien</Button>
   </div>
  </div>
</section>

<style>
  .teaser {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    min-height: 420px;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--terminal);
    border-block: var(--hairline) solid var(--line);
  }
  .teaser > * { grid-area: 1 / 1; }
  .teaser img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Motivet skyves mot høyre så venstre halvdel blir tom og mørk. Teksten lå før
       midt over stabelen, og platene gikk tvers gjennom ingressen – målt 4,07:1,
       under AA-kravet. Dette er en komposisjonsfiks, ikke et mørkere slør:
       å skru opp sløret til teksten holdt ville gjort bildet usynlig. */
    object-position: 78% center;
    opacity: 0.85;
  }
  /* To nivåer med vilje: rammen sentrerer innholdsbredden, kolonnen holder teksten
     til venstre. Lå max-width på samme element som margin-inline: auto, krympet
     hele blokken og havnet midt over motivet – der kontrasten var 3,5:1. */
  .teaser__ramme {
    position: relative;
    width: min(1120px, 100%);
    margin-inline: auto;
    padding: var(--space-7) var(--space-5);
    display: flex;
    align-items: center;
  }
  .teaser__tekst {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 40ch;
    /* Teksten ligger over et bilde, så den trenger sin egen grunn for å holde
       kontrastkravet uansett hvor lyst bildet er akkurat der. */
    color: var(--on-terminal);
  }
  .teaser__tekst .display-lg,
  .teaser__tekst .kk-eyebrow span:last-child { color: #fff; }
  .teaser__tekst .body-lg { color: var(--on-terminal); }
  /* Egen flate i rutenettet, ikke et ::before med negativ z-index – det havnet
     bak seksjonen i stedet for over bildet, og teksten krysset lyse plater. */
  .teaser__slor {
    /* To fallgruver her, begge målt:
       1. .teaser har align-items: center, så en tom div kollapser til null høyde.
          Derfor stretch.
       2. Bildet har opacity under 1, og da males det i samme fase som posisjonerte
          elementer – altså OVER et vanlig statisk div. Sløret lå under bildet og
          gjorde ingenting; å sette det til knallrødt endret knapt en piksel.
          position: relative løfter det inn i riktig lag. */
    position: relative;
    align-self: stretch;
    justify-self: stretch;
    background: linear-gradient(90deg, rgb(6 7 8 / 0.92) 0%, rgb(6 7 8 / 0.85) 34%, rgb(6 7 8 / 0.25) 58%, rgb(6 7 8 / 0) 78%);
  }
  @media (min-width: 861px) { .teaser { min-height: 520px; } }
</style>
