---
/**
 * Fullbredde-inngang til scroll-historien – stabelen åpner seg mens du scroller forbi.
 *
 * Videoen er 344 kB og lastes først når stripen nærmer seg. Den ligger under folden,
 * så den påvirker ikke LCP. Bevegelsen styres av scroll og ikke av en tidtaker:
 * da slipper vi kravet i WCAG 2.2.2 om pauseknapp, og brukeren bestemmer tempoet.
 * Plakaten på 7 kB står til videoen er klar, og blir stående ved redusert bevegelse
 * eller Save-Data.
 */
import Button from "./Button.astro";
---
<section class="teaser" aria-labelledby="teaser-tittel">
  <video
    class="teaser__film"
    data-teaser-film
    muted
    playsinline
    preload="none"
    poster="/historie/poster.avif"
    width="960"
    height="540"
    aria-hidden="true"
  >
    <source data-src="/historie/teaser-960.mp4" type="video/mp4" />
  </video>
  <div class="teaser__slor" aria-hidden="true"></div>
  <div class="teaser__ramme">
   <div class="teaser__tekst">
    <p class="kk-eyebrow"><span class="kk-eyebrow-n" aria-hidden="true">//</span> <span>Se innsiden</span></p>
    <h2 id="teaser-tittel" class="display-lg">En nettside er flere lag enn du tror</h2>
    <p class="body-lg">
      Design, kode, sikkerhet og integrasjoner. Scroll gjennom historien, så tar vi
      en side fra hverandre og setter den sammen igjen.
    </p>
    <Button variant="primary" href="/historie">Se historien</Button>
   </div>
  </div>
</section>

<style>
  .teaser {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    min-height: 420px;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--terminal);
    border-block: var(--hairline) solid var(--line);
  }
  .teaser > * { grid-area: 1 / 1; }
  .teaser__film {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Motivet skyves mot høyre så venstre halvdel blir tom og mørk. Teksten lå før
       midt over stabelen, og platene gikk tvers gjennom ingressen – målt 4,07:1,
       under AA-kravet. Dette er en komposisjonsfiks, ikke et mørkere slør:
       å skru opp sløret til teksten holdt ville gjort bildet usynlig. */
    object-position: 78% center;
    opacity: 0.85;
  }
  /* To nivåer med vilje: rammen sentrerer innholdsbredden, kolonnen holder teksten
     til venstre. Lå max-width på samme element som margin-inline: auto, krympet
     hele blokken og havnet midt over motivet – der kontrasten var 3,5:1. */
  .teaser__ramme {
    position: relative;
    width: min(1120px, 100%);
    margin-inline: auto;
    padding: var(--space-7) var(--space-5);
    display: flex;
    align-items: center;
  }
  .teaser__tekst {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 40ch;
    /* Teksten ligger over et bilde, så den trenger sin egen grunn for å holde
       kontrastkravet uansett hvor lyst bildet er akkurat der. */
    color: var(--on-terminal);
  }
  .teaser__tekst .display-lg,
  .teaser__tekst .kk-eyebrow span:last-child { color: #fff; }
  .teaser__tekst .body-lg { color: var(--on-terminal); }
  /* Egen flate i rutenettet, ikke et ::before med negativ z-index – det havnet
     bak seksjonen i stedet for over bildet, og teksten krysset lyse plater. */
  .teaser__slor {
    /* To fallgruver her, begge målt:
       1. .teaser har align-items: center, så en tom div kollapser til null høyde.
          Derfor stretch.
       2. Bildet har opacity under 1, og da males det i samme fase som posisjonerte
          elementer – altså OVER et vanlig statisk div. Sløret lå under bildet og
          gjorde ingenting; å sette det til knallrødt endret knapt en piksel.
          position: relative løfter det inn i riktig lag. */
    position: relative;
    align-self: stretch;
    justify-self: stretch;
    background: linear-gradient(90deg, rgb(6 7 8 / 0.92) 0%, rgb(6 7 8 / 0.85) 34%, rgb(6 7 8 / 0.25) 58%, rgb(6 7 8 / 0) 78%);
  }
  /* På mobil dekker teksten hele bredden, og en vannrett gradient gir ingen
     mening – høyresiden står lys bak teksten. Målt 2,23:1 der. Loddrett slør i
     stedet: mørkt der teksten er, lysere mot bunnen så motivet fortsatt sees. */
  @media (max-width: 860px) {
    .teaser__slor {
      background: linear-gradient(
        180deg,
        rgb(6 7 8 / 0.93) 0%,
        rgb(6 7 8 / 0.92) 62%,
        rgb(6 7 8 / 0.55) 85%,
        rgb(6 7 8 / 0.35) 100%
      );
    }
    .teaser__film { object-position: center 35%; }
  }
  @media (min-width: 861px) { .teaser { min-height: 520px; } }
</style>

<script>
  // Samme mekanikk som på /historie, i miniatyr: scroll-andel gjennom stripen
  // settes til video.currentTime. Ingen bibliotek, ingen tidtaker.
  const stripe = document.querySelector<HTMLElement>(".teaser");
  const film = stripe?.querySelector<HTMLVideoElement>("[data-teaser-film]");
  const kilde = film?.querySelector<HTMLSourceElement>("source");
  const redusert = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sparData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (stripe && film && kilde && !redusert && !sparData) {
    let planlagt = false;
    const oppdater = () => {
      planlagt = false;
      const r = stripe.getBoundingClientRect();
      if (!film.duration) return;
      // 0 når stripen akkurat kommer inn nedenfra, 1 når den forlater toppen.
      const andel = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
      film.currentTime = andel * film.duration;
    };

    const io = new IntersectionObserver(
      (poster) => {
        if (!poster.some((p) => p.isIntersecting)) return;
        io.disconnect();
        kilde.src = kilde.dataset.src!;
        film.preload = "auto";
        film.load();
      },
      { rootMargin: "150% 0px" },
    );
    io.observe(stripe);

    film.addEventListener("loadedmetadata", () => {
      stripe.dataset.film = "klar";
      oppdater();
    });
    addEventListener("scroll", () => {
      if (!planlagt) { planlagt = true; requestAnimationFrame(oppdater); }
    }, { passive: true });
  }
</script>
