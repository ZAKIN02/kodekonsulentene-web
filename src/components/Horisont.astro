---
/**
 * En seksjon som beveger seg vannrett mens du scroller vertikalt.
 *
 * Dette er ikke scroll-jacking. Sidens egen scroll røres aldri – vi hverken
 * avbryter, forsinker eller overstyrer den. Det eneste som skjer er at
 * `scrollLeft` på et spor settes i takt med hvor langt seksjonen har kommet
 * forbi. Sporet er et helt vanlig vannrett scrollområde, så uten JavaScript får
 * du nøyaktig samme innhold – du drar det bare selv.
 *
 * Tilgjengelighet:
 *  - Sporet har tabindex og aria-label. Et vannrett scrollområde som ikke kan
 *    nås med tastatur er et brudd på WCAG 2.1.1 (axe: scrollable-region-focusable).
 *  - Når sporet har fokus, eller brukeren drar i det selv, slipper vi taket og
 *    lar hen styre. Scroll-synkingen tar over igjen når fokus forsvinner.
 *  - prefers-reduced-motion gjør hele seksjonen til en vanlig vertikal liste.
 *
 * Brandboken forbyr scroll-jacking og parallax. Dette er på grensen, og det er
 * verdt å si høyt: bevegelsen er bundet til scroll, men innholdet beveger seg i
 * en annen akse enn siden. Den er derfor bygget slik at den kan brukes helt uten
 * bevegelse, og at bevegelsen aldri er den eneste veien til innholdet.
 */
import "../styles/typo.css";

export interface HorisontPost {
  tittel: string;
  tekst: string;
  /** Liten monospace-markør over tittelen – steg, tid eller nummer. */
  nr?: string;
}
interface Props {
  poster: HorisontPost[];
  /** Beskrivende navn på sporet, for skjermlesere. */
  navn: string;
  /** Tittel som står stille mens kortene beveger seg forbi. */
  tittel?: string;
  /** Nummerert etikett over tittelen. */
  merke?: string;
  n?: number;
  /**
   * Tak for hvor mange skjermhøyder seksjonen får strekke seg over.
   *
   * Den faktiske høyden settes av skriptet ut fra hvor langt sporet VIRKELIG
   * har å reise. Fast høyde var feilen: med fire kort på 1440 px er vannrett
   * vei 632 px, men seksjonen krevde 1800 px scroll – du dro to skjermhøyder
   * for å flytte kortene under halvannen kortbredde. Nå er forholdet 1:1.
   */
  hoyde?: number;
  class?: string;
}
const { poster, navn, tittel, merke, n, hoyde = 3, class: cls } = Astro.props;
const nr = typeof n === "number" ? String(n).padStart(2, "0") : null;
---
<section
  class:list={["horisont", cls]}
  data-horisont
  style={`--hoyde:${hoyde * 100}svh`}
>
  <div class="horisont__fest">
    {(merke || tittel) && (
      <header class="horisont__topp">
        {merke && (
          <p class="horisont__merke">
            <span class="nr" aria-hidden="true">//{nr ? ` ${nr}` : ""}</span>
            <span>{merke}</span>
          </p>
        )}
        {tittel && <h2 class="horisont__overskrift">{tittel}</h2>}
      </header>
    )}

    <div
      class="horisont__spor"
      data-horisont-spor
      tabindex="0"
      role="region"
      aria-label={`${navn}. Kan scrolles vannrett.`}
    >
      {poster.map((p, i) => (
        <article class="horisont__kort">
          <span class="horisont__nr">{p.nr ?? String(i + 1).padStart(2, "0")}</span>
          <div class="horisont__brod">
            <h3 class="horisont__tittel">{p.tittel}</h3>
            <p class="horisont__tekst">{p.tekst}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="horisont__linje" data-horisont-linje aria-hidden="true"></div>

    <p class="horisont__hjelp small">
      Dra sporet, eller bruk piltastene når det har fokus.
    </p>
  </div>
</section>

<style>
  /* Disse reglene ligger her og ikke i typo.css fordi de gjelder elementer
     DENNE komponenten tegner. Astro gir dem komponentens scope-id, så de har
     høyere spesifisitet enn basisreglene og vinner uten !important.

     Motsatt vei virker ikke: en side kan ikke style komponentens elementer med
     en scoped <style>, fordi elementene aldri får sidens scope-id. Den fellen
     gjorde maskeoverstyringen i SceneFilm til død CSS i ukevis. */

  /* Kortet fylte 198 px av et festet vindu på 900. Resten var tomrom – målt
     som 192-244 px sammenhengende dødt bånd på fire sider. Nå bærer kortet
     flaten det står i: tallet øverst, teksten mot foten. */
  .horisont__kort {
    width: min(82vw, 460px);
    min-height: min(34svh, 290px);
    padding: var(--space-6);
    align-content: space-between;
    gap: var(--space-6);
  }

  /* Tallet som grafikk, ikke som etikett.
     Første forsøk ga kortet 400 px og skjøv tre små elementer fra topp til bunn.
     Målingen ble bedre – elementFromPoint traff jo kortflaten – men skjermbildet
     viste at tomrommet bare hadde flyttet INN i kortet. Et stort tall fyller
     flaten med noe som faktisk betyr noe, og det er samme grep som Nokkeltall
     bruker: typografi i stedet for pynt. */
  .horisont__nr {
    font-size: clamp(44px, 4.4vw, 76px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--line-strong);
    font-weight: 500;
  }
  .horisont__brod {
    display: grid;
    gap: var(--space-3);
  }
  .horisont__tittel {
    font-size: clamp(26px, 2.4vw, 38px);
    line-height: 1.08;
    text-wrap: balance;
  }
  .horisont__tekst {
    font-size: clamp(16px, 1.05vw, 18px);
    line-height: 1.55;
    max-width: 34ch;
  }

  @media (max-width: 720px) {
    .horisont__kort {
      width: min(86vw, 360px);
      min-height: min(32svh, 250px);
      padding: var(--space-5);
    }
    .horisont__nr { font-size: 40px; }
  }

  /* Redusert bevegelse stabler kortene som en vanlig liste. Da er en minste-
     høyde på 400 px bare luft mellom avsnitt, så den slås av. */
  @media (prefers-reduced-motion: reduce) {
    .horisont__kort {
      min-height: 0;
      align-content: start;
      gap: var(--space-3);
    }
    /* Fargen MÅ byttes sammen med størrelsen. Som 76 px grafikk er --line-strong
       riktig – det er en strekfarge, og stor tekst krever 3:1. Som 12 px er tallet
       en etikett, og da gjelder 4,5:1. --line-strong måler 3,09:1 og stryker.
       Dette traff bare brukere med redusert bevegelse, og var derfor usynlig i
       alle målinger som ikke satte det flagget. */
    .horisont__nr {
      font-size: 12px;
      line-height: 16px;
      letter-spacing: 0.08em;
      color: var(--ink-faint);
    }
  }

  /* Paa telefon drives sporet av sidescrollen, og det lander naesten aldri paa en
     kortkant: maalt scrollLeft 0 -> 149 av ren loddrett scrolling, med to HALVE kort
     side om side og bokstaver kuttet paa begge kanter – «...kningen slaar ut»,
     «...fikat og ytelse sjekkes». Sporet er 1462 px i et vindu paa 390.
     Under 720 px arver vi derfor den loddrette stabelen fra redusert bevegelse, som
     allerede er bygget og lesbar. */
  @media (max-width: 720px) {
    .horisont__kort {
      min-height: 0;
      align-content: start;
      gap: var(--space-3);
    }
    /* Fargen MÅ byttes sammen med størrelsen. Som 76 px grafikk er --line-strong
       riktig – det er en strekfarge, og stor tekst krever 3:1. Som 12 px er tallet
       en etikett, og da gjelder 4,5:1. --line-strong måler 3,09:1 og stryker.
       Dette traff bare brukere med redusert bevegelse, og var derfor usynlig i
       alle målinger som ikke satte det flagget. */
    .horisont__nr {
      font-size: 12px;
      line-height: 16px;
      letter-spacing: 0.08em;
      color: var(--ink-faint);
    }
  }
</style>

<script>
  for (const rot of document.querySelectorAll<HTMLElement>("[data-horisont]")) {
    const spor = rot.querySelector<HTMLElement>("[data-horisont-spor]");
    const linje = rot.querySelector<HTMLElement>("[data-horisont-linje]");
    if (!spor) continue;

    const rolig = matchMedia("(prefers-reduced-motion: reduce)");
    let egenStyring = false;
    // Propen kommer inn som «300svh» og leses som et tak i skjermhøyder.
    const taket = Number.parseFloat(rot.style.getPropertyValue("--hoyde")) / 100 || 3;

    // Fremdriftslinjen følger sporet uansett hvem som flyttet det.
    const tegnLinje = () => {
      const maks = spor.scrollWidth - spor.clientWidth;
      const andel = maks > 0 ? spor.scrollLeft / maks : 0;
      linje?.style.setProperty("--andel", andel.toFixed(4));
    };
    spor.addEventListener("scroll", tegnLinje, { passive: true });

    // Brukeren eier sporet når hen rører det selv.
    spor.addEventListener("focusin", () => { egenStyring = true; });
    spor.addEventListener("focusout", () => { egenStyring = false; });
    spor.addEventListener("pointerdown", () => { egenStyring = true; });
    addEventListener("pointerup", () => {
      // Lite pusterom, så siden ikke rykker sporet tilbake i samme øyeblikk.
      setTimeout(() => { if (!spor.contains(document.activeElement)) egenStyring = false; }, 600);
    });

    let planlagt = false;
    const synk = () => {
      planlagt = false;
      if (egenStyring || rolig.matches) return;
      const r = rot.getBoundingClientRect();
      const strekk = r.height - window.innerHeight;
      if (strekk <= 0) return;
      const andel = Math.min(1, Math.max(0, -r.top / strekk));
      const maks = spor.scrollWidth - spor.clientWidth;
      spor.scrollLeft = andel * maks;
    };

    /**
     * Høyden følger hvor langt sporet faktisk har å reise – ikke et fast tall.
     *
     * Før: `hoyde={3}` ga 2700 px seksjon uansett innhold. Med fire kort på
     * 1440 px er vannrett vei bare 632 px, så man dro 1800 px vertikalt for å
     * flytte kortene 632 px sidelengs. Det er den direkte årsaken til de døde
     * strekkene som ble målt på /caser, /handbok og /status.
     *
     * Nå er forholdet 1:1 – ett piksel scroll gir ett piksel sideveis – med
     * propen som tak. Da står den klebrige lengden i forhold til hva som skjer.
     */
    const settHoyde = () => {
      const reise = spor.scrollWidth - spor.clientWidth;
      if (reise <= 0) return 0;
      const tak = taket * window.innerHeight;
      // Litt pusterom i hver ende, så første og siste kort rekker å stå stille.
      const strekk = Math.min(tak, reise + window.innerHeight * 0.35);
      rot.style.setProperty("--hoyde", `${Math.round(window.innerHeight + strekk)}px`);
      return strekk;
    };

    const pa = () => {
      if (rolig.matches) {
        delete rot.dataset.fest;
        rot.style.removeProperty("--hoyde");
        spor.scrollLeft = 0;
        return;
      }
      // En festet seksjon uten noe å reise på er ren dødflate: alt får plass
      // allerede, og brukeren drar en skjermhøyde for ingenting.
      if (settHoyde() <= 0) {
        delete rot.dataset.fest;
        rot.style.removeProperty("--hoyde");
        return;
      }
      // Festing settes først her: uten JavaScript skal seksjonen aldri bli
      // 300svh høy med et sticky innhold som ingen kan flytte.
      rot.dataset.fest = "";
      synk();
      tegnLinje();
    };

    pa();
    rolig.addEventListener("change", pa);
    addEventListener("scroll", () => {
      if (!planlagt) { planlagt = true; requestAnimationFrame(synk); }
    }, { passive: true });
    // Høyden avhenger av sporets bredde, som endrer seg med vindusbredden.
    addEventListener("resize", () => { pa(); }, { passive: true });
  }
</script>
