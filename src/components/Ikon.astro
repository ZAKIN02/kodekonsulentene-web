---
/**
 * Ikonsettet.
 *
 * Banene er kopiert ordrett fra Lucide (ISC-lisens, lucide-icons/lucide på
 * GitHub, hentet 6. oktober 2026). Vi kopierer i stedet for å installere, og det
 * er et målt valg: hele settet under veier 1,7 kB som banedata, mens
 * `astro-icon` + `@iconify-json/lucide` er 643 kB i node_modules for å produsere
 * nøyaktig den samme inlinede SVG-en. Kjøretidskostnaden er identisk.
 *
 * Brandboken: 1,5 px strek, 20 px standard, alltid `currentColor`. Lucide leverer
 * 2 px som standard – vi overstyrer, ellers er ikonene tyngre enn hårlinjene rundt.
 *
 * Ikoner står alltid ved et ord. Derfor er de `aria-hidden` som standard; trenger
 * et ikon å bære mening alene, må kalleren sende `tittel`.
 */
export const IKONER = {
  "arrow-right": '<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />',
  calendar: '<path d="M8 2v3" /><path d="M16 2v3" /><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18" />',
  check: '<path d="M20 6 9 17l-5-5" />',
  "circle-minus": '<circle cx="12" cy="12" r="10" /><path d="M8 12h8" />',
  "circle-x": '<circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" />',
  "credit-card": '<rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" x2="22" y1="10" y2="10" /><path d="M6 14h2" />',
  "file-check": '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="m9 15 2 2 4-4" />',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />',
  minus: '<path d="M5 12h14" />',
  moon: '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />',
  search: '<path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" />',
  "shield-check": '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />',
  sun: '<circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />',
  terminal: '<path d="M12 19h8" /><path d="m4 17 6-6-6-6" />',
  "triangle-alert": '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" />',
  zap: '<path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z" />',
} as const;

export type IkonNavn = keyof typeof IKONER;

interface Props {
  navn: IkonNavn;
  /** Brandboken: 20 px er standard. */
  storrelse?: number;
  /** Settes bare når ikonet må bære mening alene. Ellers er det dekorasjon. */
  tittel?: string;
  class?: string;
}
const { navn, storrelse = 20, tittel, class: cls } = Astro.props;
---
<svg
  class:list={["ikon", cls]}
  width={storrelse}
  height={storrelse}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={tittel ? "img" : undefined}
  aria-label={tittel}
  aria-hidden={tittel ? undefined : "true"}
  set:html={IKONER[navn]}
/>

<style>
  .ikon { flex: none; display: inline-block; vertical-align: -0.15em; }
</style>
