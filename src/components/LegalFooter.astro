---
// Lovpålagt footer: foretaksnavn, org.nr., adresse, e-post og telefon, pluss
// lenker til personvern, cookies og vilkår.
// Komponenten rendrer ikke uten org.nr. – det er med vilje.
//
// HJEMMELEN. Her sto «(Altinn)» bak org.nr., og Altinn er en portal, ikke en
// hjemmel. Plikten følger av to lover, og hvilken som treffer avhenger av
// registeret foretaket står i:
//   - foretaksregisterloven (LOV-1985-06-21-78) § 10-2 for foretak registrert
//     i Foretaksregisteret, og
//   - ehandelsloven (LOV-2003-05-23-35) § 8 for enhver som tilbyr en
//     informasjonssamfunnstjeneste – som er hjemmelen for VÅR egen footer, jf.
//     `registrertIForetaksregisteret: false` i src/data/firma.ts.
// Begge er kontrollert mot Lovdata 7. oktober 2026 og står i src/data/kilder.ts.
// Adresse, e-post og telefon følger av ehandelsloven § 8 uansett.
export interface FooterLink { label: string; href: string }
interface Props {
  name?: string; legalName?: string; tagline?: string; orgnr: string; vat?: boolean;
  address?: string; email?: string; phone?: string; links?: FooterLink[];
  cookieNote?: string; meta?: string; class?: string;
}
const {
  name = "KodeKonsulentene", legalName, tagline, orgnr, vat = false,
  address, email, phone, links = [], cookieNote, meta, class: cls,
} = Astro.props;
const org = orgnr.replace(/\D/g, "").replace(/(\d{3})(\d{3})(\d{3})/, "$1 $2 $3");
---
{orgnr && (
  <footer class:list={["kk-footer", cls]}>
    <div>
      <p class="kk-wordmark">{name}</p>
      {tagline && <p>{tagline}</p>}
      <p class="kk-orgnr">
        <span class="visually-hidden">Organisasjonsnummer </span>Org.nr. {org}{vat ? " MVA" : ""}
      </p>
    </div>
    <div>
      <address>
        {legalName && <div>{legalName}</div>}
        {address && <div>{address}</div>}
        {email && <div><a class="kk-link" href={`mailto:${email}`}>{email}</a></div>}
        {phone && <div><a class="kk-link" href={`tel:${phone.replace(/\s/g, "")}`}>{phone}</a></div>}
      </address>
    </div>
    <div>
      <ul>
        {links.map((l) => <li><a class="kk-link" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="kk-footer-meta">
      <span>{cookieNote}</span>
      {meta && <span>{meta}</span>}
    </div>
  </footer>
)}
