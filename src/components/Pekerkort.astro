---
/**
 * Kort som svarer på pekeren.
 *
 * To ting skjer: en markør glir langs overkanten og peker på der du er, og
 * kortet vipper noen få grader mot deg. Markøren er hovedsaken – den er en
 * skarp aksentstrek, ikke en glød, fordi brandboken forbyr gradienter og
 * glassmorphism. Vippen er sekundær og holdes under 2,5 grader.
 *
 * MERK en spenning mot brandboken: den sier «ingen 3D» under Bevegelse. Den
 * regelen er skrevet mot 3D-scener og WebGL som spiser ytelsesbudsjettet, ikke
 * mot en transform på hover. Vippen kan slås av med `vipp={false}` hvis den
 * skal følges bokstavelig.
 *
 * Tastatur får nøyaktig samme tilbakemelding som musa: markøren vises ved
 * fokus. En interaksjon bare musa når er ingen interaksjon.
 */
interface Props {
  nr?: number;
  tittel: string;
  tekst: string;
  href?: string;
  lenketekst?: string;
  /** Slår av den svake vippen. Markøren står uansett. */
  vipp?: boolean;
  /**
   * Plass i rekken, 0-basert. Kort med ulik `i` kommer inn etter hverandre og
   * med litt ulik vinkel, slik at en rad leses som spredte kort og ikke som en
   * tabellrad. Uten denne kommer alle kortene i samme øyeblikk.
   */
  i?: number;
}
const { nr, tittel, tekst, href, lenketekst = "Les mer", vipp = true, i = 0 } = Astro.props;
const Tag = href ? "a" : "article";
---
<Tag
  class="pekerkort"
  data-pekerkort
  data-vipp={vipp ? "" : undefined}
  style={`--i:${i}`}
  href={href}
>
  <span class="pekerkort__markor" aria-hidden="true"></span>
  <div class="pekerkort__topp">
    <h3 class="pekerkort__tittel">{tittel}</h3>
    {typeof nr === "number" && <span class="pekerkort__nr mono-label">{String(nr).padStart(2, "0")}</span>}
  </div>
  <p class="pekerkort__tekst">{tekst}</p>
  {href && <span class="pekerkort__lenke">{lenketekst} <span aria-hidden="true">→</span></span>}
</Tag>

<style>
  .pekerkort {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease, transform 160ms ease;
    will-change: auto;
  }
  .pekerkort:hover { border-color: var(--line-strong); }
  .pekerkort:focus-visible { outline: var(--focus-width) solid var(--focus); outline-offset: 2px; }

  /* Markøren: en skarp aksentstrek på overkanten som følger pekerens x.
     --p er 0–1 fra skriptet. Ingen gradient, ingen glød. */
  .pekerkort__markor {
    position: absolute;
    top: calc(var(--hairline) * -1);
    width: 28%;
    height: var(--focus-width);
    background: var(--accent);
    border-radius: var(--radius-pill);
    /* Prosent i `left` løses mot kortets bredde. Ingen container queries:
       markøren er sitt eget element, og hadde den vært en container, ville
       cqw-enhetene løst mot markøren i stedet for kortet. */
    left: calc(var(--p, 0.5) * (100% - 28%));
    opacity: 0;
    transition: opacity 120ms ease, left 120ms linear;
    pointer-events: none;
  }
  .pekerkort:hover .pekerkort__markor,
  .pekerkort:focus-visible .pekerkort__markor,
  .pekerkort[data-aktiv] .pekerkort__markor { opacity: 1; }

  .pekerkort__topp { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .pekerkort__tittel {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .pekerkort__nr { color: var(--ink-faint); }
  .pekerkort__tekst { margin: 0; color: var(--ink-muted); }
  .pekerkort__lenke { font-size: 14px; line-height: 20px; font-weight: 600; color: var(--ink); }
  .pekerkort:hover .pekerkort__lenke { color: var(--accent-text); }

  /* Inngangsgest. Kortet kommer inn med en liten vinkel og retter seg opp, i
     stedet for å tone inn rett. Vinkelen alternerer med `--i`, så en rad leses
     som spredte kort og ikke som en tabellrad.

     Langformene brukes med vilje: lightningcss slår `animation` og
     `animation-timeline` sammen til en ugyldig stenografi som begge nettlesere
     forkaster uten å si fra. Da forsvinner bevegelsen stille, og det har
     skjedd her før.

     Standardtilstanden er FERDIG – ingenting skjules før @supports aktivt
     skjuler det. Firefox, uten JavaScript og med redusert bevegelse ser derfor
     kortet som det skal se ut. */
  @supports (animation-timeline: view()) {
    .pekerkort {
      animation-name: pekerkort-inn;
      animation-duration: 1ms;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry calc(10% + var(--i, 0) * 7%) entry calc(85% + var(--i, 0) * 5%);
    }
  }
  @keyframes pekerkort-inn {
    from {
      opacity: 0;
      /* Annenhver vei: -1 opphøyd i --i gir +1, -1, +1 … uten JavaScript. */
      transform: translateY(26px) rotate(calc(var(--i, 0) * 0.9deg - 0.9deg));
    }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pekerkort {
      transition: border-color 120ms ease;
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .pekerkort__markor { transition: opacity 120ms ease; }
  }
</style>

<script>
  const kort = document.querySelectorAll<HTMLElement>("[data-pekerkort]");
  if (kort.length) {
    const rolig = matchMedia("(prefers-reduced-motion: reduce)");

    for (const k of kort) {
      let planlagt = false;
      let siste: PointerEvent | null = null;

      const tegn = () => {
        planlagt = false;
        if (!siste) return;
        // Én layout-lesing per ramme.
        const r = k.getBoundingClientRect();
        const px = Math.min(1, Math.max(0, (siste.clientX - r.left) / r.width));
        const py = Math.min(1, Math.max(0, (siste.clientY - r.top) / r.height));
        k.style.setProperty("--p", px.toFixed(3));
        if (k.hasAttribute("data-vipp") && !rolig.matches) {
          k.style.transform =
            `perspective(900px) rotateY(${((px - 0.5) * 4).toFixed(2)}deg) rotateX(${((0.5 - py) * 3).toFixed(2)}deg)`;
        }
      };

      k.addEventListener("pointermove", (e) => {
        if (e.pointerType === "touch") return; // berøring skal scrolle, ikke vippe
        siste = e;
        if (!planlagt) { planlagt = true; requestAnimationFrame(tegn); }
      }, { passive: true });

      const nullstill = () => {
        siste = null;
        k.style.transform = "";
        k.style.removeProperty("--p");
      };
      k.addEventListener("pointerleave", nullstill);
      k.addEventListener("blur", nullstill);
      // Tastatur: markøren vises i midten, samme signal som musa gir.
      k.addEventListener("focus", () => k.style.setProperty("--p", "0.5"));
    }
  }
</script>
