    .regstolper__tabell, .regstolper__tabell tbody,
    .regstolper__tabell tr, .regstolper__tabell td {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }
    .regstolper__tabell thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .regstolper__tabell tr { padding-block: var(--space-3); border-bottom: var(--hairline) solid var(--line); }
    .regstolper__tabell td { display: flex; gap: var(--space-3); justify-content: space-between; align-items: baseline; padding: var(--space-1) 0; border: 0; }
    .regstolper__tabell td::before { content: attr(data-kol); color: var(--ink-muted); flex: 0 0 auto; }
    .regstolper__navn { font-weight: 700; }
    .regstolper__verdi { display: block; }
    .regstolper__verdi::before { display: block; margin-block-end: var(--space-1); }
  }

