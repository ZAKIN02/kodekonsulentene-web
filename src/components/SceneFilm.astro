---
/**
 * Scenebakgrunn: scroll-spolt video i full bredde bak en seksjon.
 *
 * Samme mekanikk som HeroFilm, men gjenbrukbar: hver scene kan ha sitt eget motiv.
 * Spoles av scroll, spiller aldri av seg selv – derfor ingen pauseknapp etter
 * WCAG 2.2.2, og ingen CPU-bruk når siden står stille. Plakaten står ved redusert
 * bevegelse og Save-Data.
 *
 * Masken er det kritiske: teksten eier én side, filmen den andre. Mål alltid
 * kontrasten etterpå med .skudd/herokontrast.mjs – en maske som slipper motivet
 * inn under brødteksten er et AA-brudd, ikke en smaksak.
 */
interface Props {
  smal: string;
  bred: string;
  plakat: string;
  /** Hvilken side teksten står på. Masken åpner motsatt side. */
  tekst?: "venstre" | "hoyre";
  class?: string;
}
const { smal, bred, plakat, tekst = "venstre", class: cls } = Astro.props;
---
<div class:list={["scenefilm", `scenefilm--${tekst}`, cls]} data-scenefilm aria-hidden="true">
  <video data-scenefilm-video muted playsinline preload="none" poster={plakat} width="1920" height="1080">
    <source data-smal={smal} data-bred={bred} type="video/mp4" />
  </video>
</div>

<style>
  .scenefilm { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: 0.85; }
  .scenefilm video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .scenefilm--venstre {
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 46%, rgb(0 0 0 / 0.25) 58%, #000 76%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 46%, rgb(0 0 0 / 0.25) 58%, #000 76%);
  }
  .scenefilm--venstre video { object-position: 72% center; }
  .scenefilm--hoyre {
    -webkit-mask-image: linear-gradient(270deg, transparent 0%, transparent 46%, rgb(0 0 0 / 0.25) 58%, #000 76%);
    mask-image: linear-gradient(270deg, transparent 0%, transparent 46%, rgb(0 0 0 / 0.25) 58%, #000 76%);
  }
  .scenefilm--hoyre video { object-position: 28% center; }
  @media (max-width: 860px) {
    .scenefilm {
      opacity: 0.42;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, rgb(0 0 0 / 0.35) 68%, #000 88%);
      mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, rgb(0 0 0 / 0.35) 68%, #000 88%);
    }
    .scenefilm video { object-position: center 60%; }
  }
</style>

<script>
  for (const rot of document.querySelectorAll<HTMLElement>("[data-scenefilm]")) {
    const film = rot.querySelector<HTMLVideoElement>("[data-scenefilm-video]");
    const kilde = film?.querySelector<HTMLSourceElement>("source");
    const redusert = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sparData =
      (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!film || !kilde || redusert || sparData) continue;

    let planlagt = false;
    const oppdater = () => {
      planlagt = false;
      if (!film.duration) return;
      const r = rot.getBoundingClientRect();
      const andel = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
      film.currentTime = andel * film.duration;
    };
    const io = new IntersectionObserver((poster) => {
      if (!poster.some((p) => p.isIntersecting)) return;
      io.disconnect();
      kilde.src = window.innerWidth >= 1024 ? kilde.dataset.bred! : kilde.dataset.smal!;
      film.preload = "auto";
      film.load();
    }, { rootMargin: "150% 0px" });
    io.observe(rot);
    film.addEventListener("loadedmetadata", () => { rot.dataset.klar = "true"; oppdater(); });
    addEventListener("scroll", () => {
      if (!planlagt) { planlagt = true; requestAnimationFrame(oppdater); }
    }, { passive: true });
  }
</script>
