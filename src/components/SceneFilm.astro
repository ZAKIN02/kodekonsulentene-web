---
/**
 * Scenebakgrunn: scroll-spolt video i full bredde bak en seksjon.
 *
 * Samme mekanikk som HeroFilm, men gjenbrukbar: hver scene kan ha sitt eget motiv.
 * Spoles av scroll, spiller aldri av seg selv – derfor ingen pauseknapp etter
 * WCAG 2.2.2, og ingen CPU-bruk når siden står stille. Plakaten står ved redusert
 * bevegelse og Save-Data.
 *
 * Masken er det kritiske: teksten eier én side, filmen den andre. Mål alltid
 * kontrasten etterpå med .skudd/herokontrast.mjs – en maske som slipper motivet
 * inn under brødteksten er et AA-brudd, ikke en smaksak.
 */
interface Props {
  smal: string;
  bred: string;
  /** Valgfritt 2560-trinn. Hentes bare på brede skjermer og rask forbindelse. */
  stor?: string;
  /**
   * Speilvend filmen vannrett.
   *
   * Masken skjuler den halvdelen teksten står på. Er motivet komponert med
   * hovedobjektet der, blir det usynlig: på /apper-og-ai lå stabelen på sju plater
   * i venstre tredel, og kunden så bare kabelen og to små plater kuttet av
   * bildekanten. `object-position` hjelper ikke – object-fit: cover på en 16:9-film
   * i en 16:9-flate har ingenting å panorere i. Speilvending flytter motivet dit
   * masken faktisk slipper det fram, og et abstrakt materialmotiv tåler det.
   */
  vend?: boolean;
  /**
   * Hvor masken begynner å slippe filmen inn, i prosent av bredden.
   *
   * Dette MÅ være en prop. Sider forsøkte å overstyre masken med en scoped
   * <style>, men .scenefilm--venstre bærer DENNE komponentens scope-id mens
   * .scenefilm-ramme bærer sidens – en regel som krever begge matcher ingenting.
   * Overstyringen på /systemer var død CSS: maske 46 % og 92 % ga identisk måling.
   * En egendefinert CSS-variabel arver og er ikke scope-bundet, så den virker.
   */
  maske?: number;
  plakat: string;
  /**
   * Løkke i full styrke, uten maske og uten scroll-spoling.
   *
   * Målt mot kundens referanser: siden vår beveger seg BARE når du scroller.
   * jeton.com har tre ganger vårt pikselavvik når siden står helt stille, fordi
   * video går i løkke uavhengig av brukeren. Og vi viser ni klipp på 42 %
   * opasitet bak tekst – vi betaler megabyte uten å få effekten.
   *
   * `loope` gir klippet en egen flate: full opasitet, ingen maske, ingen tekst
   * oppå. Det koster at klippet spiller av seg selv, så bruk det ÉN gang per side
   * og aldri over folden på en lang side.
   */
  loope?: boolean;
  /** Hvilken side teksten står på. Masken åpner motsatt side. */
  tekst?: "venstre" | "hoyre";
  class?: string;
}
const { smal, bred, stor, plakat, tekst = "venstre", maske = 46, vend = false, loope = false, class: cls } = Astro.props;
---
<div class:list={["scenefilm", `scenefilm--${tekst}`, loope && "scenefilm--loope", cls]} style={`--maske: ${maske}%`} data-vend={vend ? "" : undefined} data-loope={loope ? "" : undefined} data-scenefilm aria-hidden="true">
  <video data-scenefilm-video muted playsinline preload="none" poster={plakat} width="1920" height="1080">
    <source data-smal={smal} data-bred={bred} data-stor={stor} type="video/mp4" />
  </video>
</div>

<style>
  .scenefilm { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: 0.85; }
  /* Løkkeflaten har ingen maske og ingen demping – klippet ER innholdet her. */
  .scenefilm--loope { position: relative; opacity: 1; aspect-ratio: 16 / 9; border-radius: var(--radius-md); border: var(--hairline) solid var(--line); }
  .scenefilm--loope.scenefilm--venstre,
  .scenefilm--loope.scenefilm--hoyre { -webkit-mask-image: none; mask-image: none; }
  @media (prefers-reduced-motion: reduce) {
    /* Plakaten står i stedet. Et klipp som spiller av seg selv er nøyaktig det
       en bruker som har bedt om mindre bevegelse ikke vil ha. */
    .scenefilm--loope video { display: none; }
    .scenefilm--loope { background: center / cover no-repeat var(--plakat); }
  }
  .scenefilm video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .scenefilm[data-vend] video { transform: scaleX(-1); }
  .scenefilm--venstre {
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent var(--maske), rgb(0 0 0 / 0.25) calc(var(--maske) + 12%), #000 calc(var(--maske) + 30%));
    mask-image: linear-gradient(90deg, transparent 0%, transparent var(--maske), rgb(0 0 0 / 0.25) calc(var(--maske) + 12%), #000 calc(var(--maske) + 30%));
  }
  .scenefilm--venstre video { object-position: 72% center; }
  .scenefilm--hoyre {
    -webkit-mask-image: linear-gradient(270deg, transparent 0%, transparent var(--maske), rgb(0 0 0 / 0.25) calc(var(--maske) + 12%), #000 calc(var(--maske) + 30%));
    mask-image: linear-gradient(270deg, transparent 0%, transparent var(--maske), rgb(0 0 0 / 0.25) calc(var(--maske) + 12%), #000 calc(var(--maske) + 30%));
  }
  .scenefilm--hoyre video { object-position: 28% center; }
  @media (max-width: 860px) {
    .scenefilm {
      opacity: 0.42;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, rgb(0 0 0 / 0.35) 68%, #000 88%);
      mask-image: linear-gradient(180deg, transparent 0%, transparent 52%, rgb(0 0 0 / 0.35) 68%, #000 88%);
    }
    .scenefilm video { object-position: center 60%; }
  }
</style>

<script>
  for (const rot of document.querySelectorAll<HTMLElement>("[data-scenefilm]")) {
    const film = rot.querySelector<HTMLVideoElement>("[data-scenefilm-video]");
    const kilde = film?.querySelector<HTMLSourceElement>("source");
    const redusert = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sparData =
      (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!film || !kilde || redusert || sparData) continue;

    let planlagt = false;
    const oppdater = () => {
      planlagt = false;
      if (!film.duration) return;
      const r = rot.getBoundingClientRect();
      const andel = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
      film.currentTime = andel * film.duration;
    };
    const io = new IntersectionObserver((poster) => {
      if (!poster.some((p) => p.isIntersecting)) return;
      io.disconnect();
      // Tre trinn. 2560-filene lå tidligere som 18,6 MB ingen lastet ned, fordi
      // komponenten bare kjente smal og bred.
      const nett = (navigator as Navigator & { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
      const treigt = nett?.saveData === true || /2g|3g/.test(nett?.effectiveType ?? "");
      const px = window.innerWidth * (window.devicePixelRatio || 1);
      kilde.src =
        !treigt && px >= 2200 && kilde.dataset.stor
          ? kilde.dataset.stor
          : window.innerWidth >= 1024
            ? kilde.dataset.bred!
            : kilde.dataset.smal!;
      film.preload = "auto";
      film.load();
      // 150 % lastet opptil 5685 kB på /nettsider FØR brukeren scrollet, fordi alt
      // innenfor 2,5 skjermhøyder regnes som nært. 60 % gir fortsatt god margin til
      // å rekke plakaten, uten å dra ned film ingen har sett ennå.
    }, { rootMargin: "60% 0px" });
    io.observe(rot);
    film.addEventListener("loadedmetadata", () => { rot.dataset.klar = "true"; oppdater(); });
    addEventListener("scroll", () => {
      if (!planlagt) { planlagt = true; requestAnimationFrame(oppdater); }
    }, { passive: true });
  }
</script>
