---
/**
 * Slepesammenligning – dra skillelinjen og gi den ene siden mer plass.
 *
 * MERK hvorfor dette er et DELT PANEL og ikke en klassisk «wipe»:
 * en wipe klipper det øverste laget i en loddrett kant. Det fungerer for
 * bilder, der begge lagene viser det samme motivet. Her er innholdet rader med
 * etikett til venstre og verdi til høyre – og da kutter wipen mellom etiketten
 * og verdien, slik at man ser den ene sidens overskrift sammen med den andre
 * sidens tall. Første utkast gjorde nettopp det: «En side vi sjekket» sto over
 * «6/6» og «Org.nr. bekreftet». Det er ikke en skjønnhetsfeil, det er en
 * påstand som ikke er sann.
 *
 * Et delt panel kan ikke lyve: hver side viser alltid sitt eget, komplette
 * innhold. Draingen bytter bare plass mellom dem.
 *
 * Begge kolonnene er målt med vår egen sjekk 6. oktober 2026. Den sjekkede
 * siden er ikke navngitt – docs/metode-skanning.md sier vi aldri publiserer
 * navn på sider som kommer dårlig ut.
 */
interface Props {
  id?: string;
  class?: string;
}
const { id = "sammenlign", class: cls } = Astro.props;

const sider = [
  {
    merke: "En side vi sjekket",
    sum: "50",
    rader: [
      { navn: "Sikkerhetsheadere", verdi: "3/6", status: "warn" },
      { navn: "Cookies før samtykke", verdi: "0", status: "ok" },
      { navn: "Universell utforming", verdi: "1 feil", status: "warn" },
      { navn: "Lovpålagt informasjon", verdi: "Org.nr. mangler", status: "fail" },
    ],
  },
  {
    merke: "Denne siden",
    sum: "90",
    rader: [
      { navn: "Sikkerhetsheadere", verdi: "6/6", status: "ok" },
      { navn: "Cookies før samtykke", verdi: "0", status: "ok" },
      { navn: "Universell utforming", verdi: "0 feil", status: "ok" },
      { navn: "Lovpålagt informasjon", verdi: "Org.nr. bekreftet", status: "ok" },
    ],
  },
] as const;
---
<figure class:list={["slep", cls]} data-slep>
  <div class="slep__flate" data-slep-flate>
    {sider.map((s, i) => (
      <section class={`slep__panel slep__panel--${i === 0 ? "for" : "etter"}`}>
        <div class="slep__innhold">
          <p class="slep__merke mono-label">{s.merke}</p>
          <dl class="slep__rader">
            {s.rader.map((r) => (
              <div class="slep__rad">
                <dt>{r.navn}</dt>
                <dd class={`slep__verdi slep__verdi--${r.status}`}>{r.verdi}</dd>
              </div>
            ))}
          </dl>
          <p class="slep__sum mono-stat">{s.sum}<span class="slep__av">/100</span></p>
        </div>
      </section>
    ))}
    <span class="slep__linje" aria-hidden="true"></span>
  </div>

  <div class="slep__kontroll">
    <label class="visually-hidden" for={`${id}-spak`}>Fordeling mellom de to sidene</label>
    <input
      class="spak"
      id={`${id}-spak`}
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      data-slep-spak
      aria-describedby={`${id}-status`}
    />
    <p class="interaksjon-hint">Dra skillelinjen, eller bruk piltastene.</p>
  </div>

  <figcaption class="small faint">
    Begge kolonnene er målt med vår egen sjekk 6. oktober 2026. Den sjekkede siden
    er ikke navngitt – vi publiserer ikke navn på sider som kommer dårlig ut.
  </figcaption>

  <p class="visually-hidden" id={`${id}-status`} aria-live="polite" data-slep-status>
    De to sidene deler bredden likt.
  </p>
</figure>

<style>
  .slep { margin: 0; display: grid; gap: var(--space-4); }

  .slep__flate {
    position: relative;
    display: grid;
    /* --p er 0–1. Venstre panel får andelen, høyre får resten. */
    grid-template-columns: calc(var(--p, 0.5) * 100%) 1fr;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    touch-action: pan-y;  /* fingeren skal fortsatt kunne scrolle siden */
    cursor: ew-resize;
  }
  .slep[data-drar] .slep__flate { cursor: grabbing; }

  .slep__panel {
    /* min-width: 0 lar sporet bli smalere enn innholdet, og overflow klipper
       det. Uten den ville rutenettet nekte å krympe og draingen stoppe. */
    min-width: 0;
    overflow: hidden;
  }
  .slep__panel--for { background: var(--bg-sunken); }
  .slep__panel--etter { background: var(--bg-raised); }

  /* Innholdet beholder sin bredde og klippes, i stedet for å flyte om til en
     uleselig smal spalte mens man drar. */
  .slep__innhold {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-5);
    min-width: 290px;
  }

  .slep__merke { color: var(--ink-faint); white-space: nowrap; }
  .slep__rader { margin: 0; display: grid; gap: 0; }
  .slep__rad {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: var(--hairline) solid var(--line);
    font-size: 14px;
    line-height: 20px;
  }
  .slep__rad dt { color: var(--ink-muted); white-space: nowrap; }
  .slep__rad dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .slep__verdi--ok { color: var(--ok); }
  .slep__verdi--warn { color: var(--warn); }
  .slep__verdi--fail { color: var(--fail); }

  .slep__sum { margin: 0; color: var(--ink); }
  .slep__av { font-size: 14px; color: var(--ink-faint); }

  .slep__linje {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--p, 0.5) * 100%);
    width: var(--focus-width);
    translate: calc(var(--focus-width) / -2) 0;
    background: var(--accent);
    pointer-events: none;
  }
  .slep__linje::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    translate: -50% -50%;
    border: var(--focus-width) solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--bg);
  }

  .slep__kontroll { display: grid; gap: var(--space-2); }

  /* Uten JavaScript: to like brede spalter, ingen skillelinje, ingen kontroll. */
  .slep:not([data-klar]) .slep__flate { grid-template-columns: 1fr 1fr; cursor: default; }
  .slep:not([data-klar]) .slep__linje,
  .slep:not([data-klar]) .slep__kontroll { display: none; }

  @media (max-width: 640px) {
    /* På smal skjerm blir et delt panel for trangt til å lese. Da står sidene
       under hverandre, og draingen gir ingen mening – derfor skjules den. */
    .slep__flate { grid-template-columns: 1fr !important; cursor: default; }
    .slep__panel--etter { border-top: var(--hairline) solid var(--line); }
    .slep__linje, .slep__kontroll { display: none; }
    .slep__innhold { min-width: 0; }
    .slep__rad dt { white-space: normal; }
  }
</style>

<script>
  for (const rot of document.querySelectorAll<HTMLElement>("[data-slep]")) {
    const flate = rot.querySelector<HTMLElement>("[data-slep-flate]")!;
    const spak = rot.querySelector<HTMLInputElement>("[data-slep-spak]")!;
    const status = rot.querySelector<HTMLElement>("[data-slep-status]")!;
    rot.dataset.klar = "true";

    // Under 640 px er panelene stablet og draingen er slått av i CSS.
    const smal = () => window.matchMedia("(max-width: 640px)").matches;

    let p = 0.5;
    const sett = (ny: number) => {
      // Begrenses så begge sider alltid viser noe. Et panel på null bredde er
      // ikke en sammenligning.
      p = Math.min(0.88, Math.max(0.12, ny));
      rot.style.setProperty("--p", p.toFixed(3));
      spak.value = String(Math.round(p * 100));
      status.textContent =
        p < 0.2
          ? "Nesten all plass til denne siden: 6 av 6 sikkerhetsheadere, ingen feil, org.nr. bekreftet."
          : p > 0.8
            ? "Nesten all plass til den sjekkede siden: 3 av 6 sikkerhetsheadere, 1 feil, org.nr. mangler."
            : `Den sjekkede siden har ${Math.round(p * 100)} prosent av bredden.`;
    };
    sett(0.5);

    let drar = false;
    const fraPeker = (e: PointerEvent) => {
      const r = flate.getBoundingClientRect();
      sett((e.clientX - r.left) / r.width);
    };
    flate.addEventListener("pointerdown", (e) => {
      if (smal()) return;
      drar = true;
      rot.dataset.drar = "";
      flate.setPointerCapture(e.pointerId);
      fraPeker(e);
    });
    flate.addEventListener("pointermove", (e) => { if (drar) fraPeker(e); });
    const slipp = (e: PointerEvent) => {
      if (!drar) return;
      drar = false;
      delete rot.dataset.drar;
      flate.releasePointerCapture?.(e.pointerId);
    };
    flate.addEventListener("pointerup", slipp);
    flate.addEventListener("pointercancel", slipp);

    spak.addEventListener("input", () => sett(Number(spak.value) / 100));
  }
</script>
