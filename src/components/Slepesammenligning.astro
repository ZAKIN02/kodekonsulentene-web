---
/**
 * Slepesammenligning – to målinger, én flate, og en skillelinje du flytter.
 *
 * MERK hvorfor dette er et DELT PANEL og ikke en klassisk «wipe»:
 * en wipe klipper det øverste laget i en loddrett kant. Det fungerer for
 * bilder, der begge lagene viser det samme motivet. Her er innholdet rader med
 * etikett til venstre og verdi til høyre – og da kutter wipen mellom etiketten
 * og verdien, slik at man ser den ene sidens overskrift sammen med den andre
 * sidens tall. Første utkast gjorde nettopp det: «En side vi sjekket» sto over
 * «6/6» og «Org.nr. bekreftet». Det er ikke en skjønnhetsfeil, det er en
 * påstand som ikke er sann.
 *
 * Et delt panel kan ikke lyve: hver side viser alltid sitt eget, komplette
 * innhold. Draingen bytter bare plass mellom dem.
 *
 * ── HVORFOR DEN BLE SKREVET OM (6. oktober 2026) ──────────────────────────
 *
 * Eieren meldte «fungerer ikke», og sju bredder, piltaster, musedrag og
 * berøring mot produksjon sa alle at den virket. Den gjorde det også – på
 * skrivebord. Målt på 390 px i headless Chrome med ekte berøringskontekst var
 * bildet et annet:
 *
 *   · Komponenten var 755 px høy i et 844 px visningsbilde med ~110 px fast
 *     topplinje. Du så ALDRI begge panelene samtidig.
 *   · Etikettene «En side vi sjekket» og «Denne siden» er 12 px mono øverst i
 *     hvert panel. De rullet opp under topplinjen før tallene kom i syne.
 *   · Det som faktisk sto på skjermen var to nesten like tabeller etter
 *     hverandre, med samme fire radnavn. Det ser ikke ut som en
 *     sammenligning. Det ser ut som innhold som er dublert ved et uhell.
 *   · Spak, skillelinje og hint var alle `display: none` under 640 px. Du
 *     kunne trykke hvor som helst – ingenting skjedde.
 *
 * «Fungerer ikke» var altså ikke en feil i skriptet. Det var en komponent som
 * på den viktigste bredden hverken gjorde noe eller fortalte hva den var.
 *
 * Tre endringer:
 *
 *   1. AKSEN FØLGER LAYOUTEN. Over 640 px står panelene ved siden av
 *      hverandre og skillelinjen er loddrett. Under 640 px står de over
 *      hverandre og skillelinjen er VANNRETT – samme `--p`, samme spak, samme
 *      historie, bare snudd. Flaten har fast høyde på smal skjerm, så begge
 *      sidene er på skjermen samtidig.
 *   2. SPAKEN VISES OVERALT. Overflatedraing er fortsatt av på smal skjerm:
 *      loddrett draing krever `touch-action: none`, og da mister fingeren
 *      rullingen. I stedet er et TRYKK på et panel nok til å gi det plassen.
 *      Det er et klikkmål, ikke en gest, så det kolliderer ikke med rulling.
 *   3. SUMMEN FLYTTER SEG. På smal skjerm klippes panelet nedenfra, og da må
 *      tallet stå ØVERST ved siden av etiketten – ellers er et sammenklemt
 *      panel innholdsløst. På bred skjerm klippes det fra høyre, og da
 *      overlever tallet nederst til venstre. Samme DOM, to rutenett.
 *
 * Og den demonstrerer seg selv: når flaten kommer inn i synsfeltet sveiper
 * skillelinjen ÉN gang – helt over til den sjekkede siden, helt over til vår,
 * og så til ro litt forbi midten. Én gang, aldri i løkke, aldri med
 * `prefers-reduced-motion: reduce`, og den avbrytes i samme øyeblikk brukeren
 * rører noe.
 *
 * Begge kolonnene er målt med vår egen sjekk 6. oktober 2026. Den sjekkede
 * siden er ikke navngitt – docs/metode-skanning.md sier vi aldri publiserer
 * navn på sider som kommer dårlig ut.
 */
interface Props {
  id?: string;
  class?: string;
}
const { id = "sammenlign", class: cls } = Astro.props;

const sider = [
  {
    nokkel: "for",
    merke: "En side vi sjekket",
    sum: "50",
    rader: [
      { navn: "Sikkerhetsheadere", verdi: "3/6", status: "warn" },
      { navn: "Cookies før samtykke", verdi: "0", status: "ok" },
      { navn: "Universell utforming", verdi: "1 feil", status: "warn" },
      { navn: "Lovpålagt informasjon", verdi: "Org.nr. mangler", status: "fail" },
    ],
  },
  {
    nokkel: "etter",
    merke: "Denne siden",
    sum: "90",
    rader: [
      { navn: "Sikkerhetsheadere", verdi: "6/6", status: "ok" },
      { navn: "Cookies før samtykke", verdi: "0", status: "ok" },
      { navn: "Universell utforming", verdi: "0 feil", status: "ok" },
      { navn: "Lovpålagt informasjon", verdi: "Org.nr. bekreftet", status: "ok" },
    ],
  },
] as const;
// Stilarket ble aldri importert utenfor /lab, så spakene hadde nettleserens
// blå knott og 16 px høyde mot WCAG 2.5.8 sitt krav om 24. Rettingen var meldt
// fra om to ganger og trodd levert – den manglet bare importen.
import "../styles/interaksjon.css";
---
<figure class:list={["slep", cls]} data-slep>
  <div class="slep__flate" data-slep-flate>
    {sider.map((s) => (
      <div class={`slep__panel slep__panel--${s.nokkel}`} data-slep-panel={s.nokkel}>
        <div class="slep__innhold">
          <p class="slep__merke mono-label">{s.merke}</p>
          <p class="slep__sum mono-stat">{s.sum}<span class="slep__av">/100</span></p>
          <dl class="slep__rader">
            {s.rader.map((r) => (
              <div class="slep__rad">
                <dt>{r.navn}</dt>
                <dd class={`slep__verdi slep__verdi--${r.status}`}>{r.verdi}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    ))}
    <span class="slep__linje" aria-hidden="true"><span class="slep__knott"></span></span>
  </div>

  <div class="slep__kontroll">
    {/* Fortelleren. Står synlig og sier hva du ser på akkurat nå – det er
        denne linjen som gjør sveipen til en historie og ikke bare bevegelse.
        Teksten under er den nøytrale utgangsteksten; skriptet overtar. */}
    <p class="slep__forteller" data-slep-forteller>To målinger, samme sjekk.</p>
    <label class="visually-hidden" for={`${id}-spak`}>Fordeling mellom de to sidene</label>
    <input
      class="spak"
      id={`${id}-spak`}
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      data-slep-spak
    />
    {/* To hint, ett per bredde. CSS velger, ikke JavaScript – da står riktig
        tekst i HTML-en og `display: none` holder den andre ute av
        tilgjengelighetstreet. */}
    <p class="interaksjon-hint slep__hint slep__hint--bred">Dra skillelinjen, eller bruk piltastene.</p>
    <p class="interaksjon-hint slep__hint slep__hint--smal">Trykk på en side for å se hele den, eller dra spaken.</p>
  </div>

  <figcaption class="small faint">
    Begge kolonnene er målt med vår egen sjekk 6. oktober 2026. Den sjekkede siden
    er ikke navngitt – vi publiserer ikke navn på sider som kommer dårlig ut.
  </figcaption>

  {/* Rolig status: oppdateres bare når noe har SATT SEG – ikke for hver piksel
      under draingen. Spaken melder seg selv gjennom aria-valuetext, så denne
      finnes for peker og trykk, der fokus aldri flytter seg. */}
  <p class="visually-hidden" id={`${id}-status`} role="status" aria-live="polite" data-slep-status>
    De to sidene deler flaten likt.
  </p>
</figure>

<style>
  .slep {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    /* Hvor langt det sammenklemte panelet kan presses. Settes per akse. */
    --slep-grense: 0.12;
  }

  .slep__flate {
    position: relative;
    display: grid;
    /* --p er 0–1. Første panel får andelen, det andre får resten. */
    grid-template-columns: calc(var(--p, 0.5) * 100%) 1fr;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    touch-action: pan-y;  /* fingeren skal fortsatt kunne scrolle siden */
    cursor: ew-resize;
  }
  .slep[data-drar] .slep__flate { cursor: grabbing; }

  /* Mykt bytte når brukeren TRYKKER et panel eller hopper med spaken. Av under
     draing og under sveipen, der skriptet setter --p for hver frame og en
     overgang bare ville ligge etter. */
  .slep:not([data-drar]):not([data-sveiper]) .slep__flate {
    transition: grid-template-columns 420ms cubic-bezier(0.2, 0, 0, 1),
                grid-template-rows 420ms cubic-bezier(0.2, 0, 0, 1);
  }
  .slep:not([data-drar]):not([data-sveiper]) .slep__linje {
    transition: left 420ms cubic-bezier(0.2, 0, 0, 1),
                top 420ms cubic-bezier(0.2, 0, 0, 1);
  }

  .slep__panel {
    /* min-width: 0 lar sporet bli smalere enn innholdet, og overflow klipper
       det. Uten den ville rutenettet nekte å krympe og draingen stoppe. */
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .slep__panel--for { background: var(--bg-sunken); }
  .slep__panel--etter { background: var(--bg-raised); }

  /* Innholdet beholder sin bredde og klippes, i stedet for å flyte om til en
     uleselig smal spalte mens man drar.

     Rutenettet er navngitt fordi de to aksene trenger hver sin plassering av
     summen: klippes det fra høyre, overlever et tall nederst til venstre;
     klippes det nedenfra, må tallet opp i topplinjen. Samme DOM. */
  .slep__innhold {
    display: grid;
    grid-template-areas: "merke" "rader" "sum";
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-5);
    min-width: 290px;
  }
  .slep__merke { grid-area: merke; color: var(--ink-faint); white-space: nowrap; }
  .slep__rader { grid-area: rader; margin: 0; display: grid; gap: 0; }
  .slep__sum { grid-area: sum; margin: 0; color: var(--ink); }

  .slep__rad {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: var(--hairline) solid var(--line);
    font-size: 14px;
    line-height: 20px;
  }
  .slep__rad dt { color: var(--ink-muted); white-space: nowrap; }
  .slep__rad dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .slep__verdi--ok { color: var(--slep-ok, var(--ok)); }
  .slep__verdi--warn { color: var(--slep-warn, var(--warn)); }
  .slep__verdi--fail { color: var(--slep-fail, var(--fail)); }

  /* Målt, ikke antatt: i lyst tema er --ok (#0b7a6b) 4,42:1 mot det senkede
     panelets #e9ecef. Under 4,5 – og «0» under «Cookies før samtykke» er
     nettopp en --ok-verdi som står på den flaten.

     Rettingen er temauavhengig med vilje, ikke låst til [data-theme="light"].
     Den blander statusfargen 12 % mot --ink, og --ink peker ALLTID bort fra
     bakgrunnen: nesten svart i lyst tema, nesten hvitt i mørkt. Et steg mot
     --ink kan derfor bare øke kontrasten, uansett tema – også i .flate--varm
     og i det mørke paletten forsiden låser seg til. Et [data-theme]-vilkår
     ville vært en gjetning om hvilken palett som gjelder; dette er sant
     uansett. Ingen hardkodet farge: begge leddene er tokens. */
  .slep {
    --slep-ok: color-mix(in srgb, var(--ok) 88%, var(--ink));
    --slep-warn: color-mix(in srgb, var(--warn) 88%, var(--ink));
    --slep-fail: color-mix(in srgb, var(--fail) 88%, var(--ink));
  }

  .slep__av { font-size: 14px; color: var(--ink-faint); }

  /* --accent-text, ikke --accent. Skillelinjen og knotten er bærende
     betjeningselementer og må klare WCAG 1.4.11 sine 3:1. Lime #b6e62a mot det
     lyse temaets #f5f6f7 er 1,6:1 – usynlig. --accent-text er den samme limen i
     mørkt tema og en dyp grønn (#3d6600) i lyst, der den ligger over 8:1. */
  .slep__linje {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--p, 0.5) * 100%);
    width: var(--focus-width);
    translate: calc(var(--focus-width) / -2) 0;
    background: var(--accent-text);
    pointer-events: none;
  }
  .slep__knott {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    translate: -50% -50%;
    border: var(--focus-width) solid var(--accent-text);
    border-radius: var(--radius-pill);
    background: var(--bg);
  }
  /* To vinkler som peker hver sin vei: affordansen «dette kan flyttes». */
  .slep__knott::before,
  .slep__knott::after {
    content: "";
    grid-area: 1 / 1;
    width: 5px;
    height: 5px;
    border-top: 2px solid var(--accent-text);
    border-right: 2px solid var(--accent-text);
  }
  .slep__knott::before { rotate: -135deg; translate: -4px 0; }
  .slep__knott::after { rotate: 45deg; translate: 4px 0; }

  /* Ett enkelt pust når sveipen har satt seg, så blikket finner håndtaket.
     To slag, ikke en løkke. */
  .slep[data-puls] .slep__knott { animation: slep-puls 900ms ease-out 2; }
  @keyframes slep-puls {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    40% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--accent-text) 22%, transparent); }
  }

  .slep__kontroll { display: grid; gap: var(--space-2); }
  .slep__forteller {
    margin: 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 20px;
    /* Fast høyde: teksten bytter mens man drar, og uten dette ville en linje
       som brytes til to flytte alt under seg. */
    min-height: 20px;
  }
  .slep__hint--smal { display: none; }

  /* Uten JavaScript: to like store felt, hele innholdet synlig, ingen
     skillelinje og ingen kontroll som ikke gjør noe. */
  .slep:not([data-klar]) .slep__flate {
    grid-template-columns: 1fr 1fr;
    height: auto;
    cursor: default;
  }
  .slep:not([data-klar]) .slep__linje,
  .slep:not([data-klar]) .slep__kontroll { display: none; }

  @media (max-width: 640px) {
    /* Et delt panel på 390 px blir for trangt til å lese, så panelene stables.
       Men da må skillelinjen snu med dem: aksen er LODDRETT her. Flaten får
       fast høyde slik at begge sidene er på skjermen samtidig – det var nettopp
       det som manglet da den leste som to dublerte tabeller. */
    .slep { --slep-grense: 0.2; }
    /* HØYDEN ER MÅLT, IKKE GJETTET.
       460 px var et tall satt for hånd, og panelinnholdet er 266 og 286 px på
       390 px. Ved hvile (p = 0,5) fikk hver halvdel 229 – altså 37 og 57 px
       klippet bort, MIDT I en tekstrad: «Lovpålagt informasjon — Org.nr.
       mangler» sto kuttet vannrett på midten, med halve bokstaver i begge
       temaer, og håndtaket oppå.
       --slep-hoyde settes av skriptet til 2 × det høyeste panelet, så ved
       hvile står begge sidene komplette. 460 px blir stående som fallback for
       det ene tilfellet der skriptet ikke rekker å måle. */
    .slep__flate {
      grid-template-columns: 1fr;
      grid-template-rows: calc(var(--p, 0.5) * 100%) 1fr;
      height: var(--slep-hoyde, 460px);
      cursor: default;
    }
    .slep__panel--etter { border-top: var(--hairline) solid var(--line); }
    .slep__innhold {
      grid-template-areas: "merke sum" "rader rader";
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: var(--space-3) var(--space-4);
      padding: var(--space-4) var(--space-5);
      min-width: 0;
    }
    .slep__sum { justify-self: end; }
    .slep__rad dt { white-space: normal; }

    .slep__linje {
      top: calc(var(--p, 0.5) * 100%);
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: var(--focus-width);
      translate: 0 calc(var(--focus-width) / -2);
    }
    /* Håndtaket legger seg ned. En sirkel på 30 px dekker 15 px på hver side av
       en VANNRETT linje, og radene har bare 12 px luft over og under teksten –
       knotten lå altså oppå bokstavene uansett hvor linja sto. Et liggende grep
       på 56 × 18 px dekker 9 px hver vei, innenfor radens egen luft, og er
       dessuten den riktige formen for en vannrett akse. Treffflaten er
       uendret: det er flaten og spaken som tar trykket, ikke knotten. */
    .slep__knott {
      rotate: none;
      width: 56px;
      height: 18px;
    }
    .slep__knott::before { rotate: -45deg; translate: 0 -3px; }
    .slep__knott::after { rotate: 135deg; translate: 0 3px; }

    .slep__hint--bred { display: none; }
    .slep__hint--smal { display: block; }

    .slep:not([data-klar]) .slep__flate {
      grid-template-rows: auto auto;
      height: auto;
    }
  }
</style>

<script>
  type Akse = "x" | "y";

  for (const rot of document.querySelectorAll<HTMLElement>("[data-slep]")) {
    const flate = rot.querySelector<HTMLElement>("[data-slep-flate]")!;
    const spak = rot.querySelector<HTMLInputElement>("[data-slep-spak]")!;
    const status = rot.querySelector<HTMLElement>("[data-slep-status]")!;
    const forteller = rot.querySelector<HTMLElement>("[data-slep-forteller]")!;
    rot.dataset.klar = "true";

    // Under 640 px er panelene stablet, skillelinjen er vannrett og
    // overflatedraingen er av – se kommentaren øverst.
    const smal = () => window.matchMedia("(max-width: 640px)").matches;
    const akse = (): Akse => (smal() ? "y" : "x");

    // Teksten hentes fra DOM-en, ikke skrives om her. Da finnes tallene bare
    // ett sted, og fortelleren kan ikke komme i utakt med tabellen.
    const les = (nokkel: string, velger: string) =>
      rot.querySelector<HTMLElement>(`[data-slep-panel="${nokkel}"] ${velger}`)
        ?.textContent?.trim() ?? "";
    const merkeFor = les("for", ".slep__merke");
    const merkeEtter = les("etter", ".slep__merke");
    const sumFor = les("for", ".slep__sum").replace("/100", "");
    const sumEtter = les("etter", ".slep__sum").replace("/100", "");

    // Grensen holder begge sidene i live. Et panel på null er ikke en
    // sammenligning. På smal skjerm må den være romsligere, ellers blir det
    // klemte panelet lavere enn sin egen topplinje.
    const grense = () => (smal() ? 0.2 : 0.12);

    let p = 0.5;
    const fortell = (v: number) =>
      v > 0.65
        ? `Slik så det ut: ${merkeFor} fikk ${sumFor} av 100.`
        : v < 0.35
          ? `Slik ble det: ${merkeEtter} fikk ${sumEtter} av 100.`
          : `${sumFor} mot ${sumEtter} av 100.`;

    const sett = (ny: number) => {
      const g = grense();
      p = Math.min(1 - g, Math.max(g, ny));
      rot.style.setProperty("--p", p.toFixed(3));
      spak.value = String(Math.round(p * 100));
      spak.setAttribute("aria-valuetext", fortell(p));
      forteller.textContent = fortell(p);
    };

    // ── høyden og snappingen ────────────────────────────────────────────────
    //
    // To feil med samme årsak: på smal skjerm klippes panelet NEDENFRA, og
    // ingenting passet på hvor kuttet landet.
    //
    //   1. Flaten hadde fast høyde 460 px mens panelene er 266 og 286 px.
    //      Ved hvile fikk hver halvdel 229, så BEGGE sidene var klippet
    //      samtidig – i hvilestillingen, der ingen hadde rørt noe ennå.
    //   2. Kuttet gikk tvers gjennom en tekstrad. Du leste halve bokstaver,
    //      og det ser ut som en feil i siden, ikke som et panel du kan dra.
    //
    // Høyden settes derfor til 2 × det høyeste panelet: ved p = 0,5 står begge
    // komplette. Og når noe har SATT SEG, flyttes linja til nærmeste radgrense.
    // Begge deler måles i DOM-en, så de følger skrift, språk og zoom av seg
    // selv – et tall skrevet for hånd gjør ikke det.
    const paneler = [...rot.querySelectorAll<HTMLElement>("[data-slep-panel]")];
    const innholdet = paneler
      .map((pa) => pa.querySelector<HTMLElement>(".slep__innhold"))
      .filter((el): el is HTMLElement => el !== null);

    const maalHoyde = () => {
      if (!smal() || innholdet.length === 0) {
        rot.style.removeProperty("--slep-hoyde");
        return;
      }
      // Innholdsdiven, ikke panelet: panelet ER høyden vi holder på å sette, og
      // å lese den ville latt tallet mate seg selv oppover for hver måling.
      const hoyest = Math.max(...innholdet.map((el) => el.getBoundingClientRect().height));
      rot.style.setProperty("--slep-hoyde", `${Math.round(hoyest * 2)}px`);
    };

    /** Avstandene fra et panels egen topp der et kutt ikke deler en rad. */
    const grenserI = (innhold: HTMLElement) => {
      const topp = innhold.getBoundingClientRect().top;
      const rader = [...innhold.querySelectorAll<HTMLElement>(".slep__rad")];
      const kanter = rader.map((r) => r.getBoundingClientRect().bottom - topp);
      if (rader[0]) kanter.push(rader[0].getBoundingClientRect().top - topp);
      kanter.push(innhold.getBoundingClientRect().height);
      return kanter;
    };

    // Maks 44 px flytting. Snappingen skal rette opp et stygt kutt, ikke
    // overstyre hvor brukeren satte linja.
    const SNAPP_MAKS = 44;

    const snapp = () => {
      if (!smal() || innholdet.length < 2) return;
      const H = flate.getBoundingClientRect().height;
      if (!H) return;
      const g = grense();
      // Øverste panel klippes ved y; nederste har høyden H − y, så dets egne
      // radgrenser ligger på y = H − d.
      const kandidater = [
        ...grenserI(innholdet[0]),
        ...grenserI(innholdet[1]).map((d) => H - d),
      ]
        .map((y) => y / H)
        .filter((v) => v >= g && v <= 1 - g);

      let beste = p;
      let naermest = Infinity;
      for (const v of kandidater) {
        const avstand = Math.abs(v - p) * H;
        if (avstand < naermest) { naermest = avstand; beste = v; }
      }
      if (naermest <= SNAPP_MAKS) sett(beste);
    };

    // Meldes bare når noe har satt seg, ikke for hver piksel under draingen.
    // Snappingen hører til samme øyeblikk: den skal rette kuttet når noe har
    // satt seg, aldri mens fingeren eller spaken er i bevegelse.
    const meld = () => { snapp(); status.textContent = fortell(p); };
    maalHoyde();
    sett(0.5);

    // ── draing ───────────────────────────────────────────────────────────────
    let drar = false;
    const fraPeker = (e: PointerEvent) => {
      const r = flate.getBoundingClientRect();
      sett(akse() === "y" ? (e.clientY - r.top) / r.height : (e.clientX - r.left) / r.width);
    };
    flate.addEventListener("pointerdown", (e) => {
      if (smal()) return;   // loddrett draing ville kostet rullingen
      stoppSveip();
      drar = true;
      rot.dataset.drar = "";
      flate.setPointerCapture(e.pointerId);
      fraPeker(e);
    });
    flate.addEventListener("pointermove", (e) => { if (drar) fraPeker(e); });
    const slipp = (e: PointerEvent) => {
      if (!drar) return;
      drar = false;
      delete rot.dataset.drar;
      flate.releasePointerCapture?.(e.pointerId);
      meld();
    };
    flate.addEventListener("pointerup", slipp);
    flate.addEventListener("pointercancel", slipp);

    // ── trykk et panel for å gi det plassen ─────────────────────────────────
    // Dette er mobilsvaret på «fungerer ikke»: et klikkmål, ikke en gest, så
    // det tar ikke rullingen fra fingeren. Spaken er fortsatt den
    // tilgjengelige inngangen – dette er en snarvei, ikke eneste vei inn.
    for (const panel of rot.querySelectorAll<HTMLElement>("[data-slep-panel]")) {
      panel.addEventListener("click", () => {
        if (!smal() || drar) return;
        stoppSveip();
        const aapen = panel.dataset.slepPanel === "for";
        const g = grense();
        // Allerede åpen? Trykk igjen stiller tilbake til delt.
        const maal = aapen
          ? (p > 0.6 ? 0.5 : 1 - g)
          : (p < 0.4 ? 0.5 : g);
        sett(maal);
        meld();
      });
    }

    spak.addEventListener("input", () => { stoppSveip(); sett(Number(spak.value) / 100); });
    spak.addEventListener("change", meld);

    // ── sveipen: komponenten demonstrerer seg selv, én gang ─────────────────
    //
    // Historien i tre slag: helt over til den sjekkede siden («slik så det
    // ut»), helt over til vår («slik ble det»), og til ro litt forbi midten –
    // ikke på midten, for en strek midt i flaten leser som en kant i layouten,
    // mens en strek som står litt skjevt leser som en POSISJON noen har satt,
    // og som altså kan flyttes.
    let sveip = 0;
    const stoppSveip = () => {
      if (!sveip) return;
      cancelAnimationFrame(sveip);
      sveip = 0;
      delete rot.dataset.sveiper;
    };

    const mykt = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const kjorSveip = () => {
      const g = grense();
      // [til, varighet, pause etter]
      const slag: Array<[number, number, number]> = [
        [1 - g, 760, 620],
        [g, 980, 620],
        [0.42, 620, 0],
      ];
      let i = 0;
      let fra = p;
      let start = 0;
      let hvile = 0;

      rot.dataset.sveiper = "";
      const steg = (na: number) => {
        if (!start) start = na;
        const [til, varighet, pause] = slag[i];
        const t = Math.min(1, (na - start - hvile) / varighet);
        sett(fra + (til - fra) * mykt(t));
        if (t < 1) { sveip = requestAnimationFrame(steg); return; }
        if (na - start - hvile < varighet + pause) { sveip = requestAnimationFrame(steg); return; }
        i += 1;
        if (i >= slag.length) {
          sveip = 0;
          delete rot.dataset.sveiper;
          meld();
          // Ett pust på håndtaket, så blikket finner det. Attributtet blir
          // stående; animasjonen har to slag og stopper selv.
          rot.dataset.puls = "";
          return;
        }
        fra = p; start = na; hvile = 0;
        sveip = requestAnimationFrame(steg);
      };
      sveip = requestAnimationFrame(steg);
    };

    // Bytter aksen (rotert telefon, endret vindu), kan p ligge utenfor den nye
    // grensen – 0,12 er lovlig vannrett, men for trangt loddrett. Sett den om
    // igjen gjennom samme vei inn, så klemmer den seg selv på plass.
    const bredde = window.matchMedia("(max-width: 640px)");
    bredde.addEventListener("change", () => { stoppSveip(); maalHoyde(); sett(p); meld(); });

    // Høyden må også regnes om når bredden endrer seg UTEN at aksen gjør det:
    // en rotert telefon, et delt vindu eller større skrift gir flere linjer i
    // en rad, og da er 2 × innholdet et annet tall. Vente til det har roet seg,
    // ellers måler vi midt i en pågående endring.
    let omregning: ReturnType<typeof setTimeout>;
    addEventListener("resize", () => {
      clearTimeout(omregning);
      omregning = setTimeout(() => { maalHoyde(); sett(p); }, 150);
    });

    const stille = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!stille.matches && "IntersectionObserver" in window) {
      const vakt = new IntersectionObserver(
        (poster) => {
          for (const post of poster) {
            if (!post.isIntersecting) continue;
            vakt.disconnect();           // én gang, aldri i løkke
            if (stille.matches) return;  // slått på mens siden sto åpen
            kjorSveip();
          }
        },
        { threshold: 0.55 },
      );
      vakt.observe(flate);
    }
  }
</script>
