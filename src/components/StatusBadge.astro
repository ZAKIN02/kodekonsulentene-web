---
// Status med ord OG ikon – fargen er aldri alene bærer av mening (WCAG 1.4.1).
// Ikonene er faste i brandboken: ok = hake, warn = trekant med utropstegn,
// fail = kryss i sirkel. De står alltid ved ordet, så de er dekorasjon og
// aria-hidden; Ikon gjør det selv når `tittel` ikke er satt.
import Ikon, { type IkonNavn } from "./Ikon.astro";
interface Props { status: "ok" | "warn" | "fail" | "neutral"; class?: string }
const { status, class: cls } = Astro.props;
const ord = { ok: "Bestått", warn: "Bør fikses", fail: "Brudd", neutral: "Ikke sjekket" } as const;
const ikon: Record<Props["status"], IkonNavn> = {
  ok: "check",
  warn: "triangle-alert",
  fail: "circle-x",
  neutral: "circle-minus",
};
// 14 px er det components.css faktisk maler merket i (.kk-badge svg).
---
<span class:list={["kk-badge", `kk-badge-${status}`, cls]}>
  <Ikon navn={ikon[status]} storrelse={14} />
  <slot>{ord[status]}</slot>
</span>
