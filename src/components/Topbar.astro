---
import { hovedmeny } from "../data/navigasjon";
import Button from "./Button.astro";
import { bookUrl } from "../data/firma";
import Ikon from "./Ikon.astro";
const sti = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="topbar">
  <div class="wrap topbar__inner">
    {/* 170x22 er den FAKTISKE malte størrelsen: SVG-en er 309x40, og CSS setter
        height: 22px med width: auto, altså 169,9 px bred. Sto det 220 her, reserverte
        nettleseren 50 px for mye og layouten hoppet når logoen lastet – målt CLS 0,145
        på /historie i produksjon. Usynlig lokalt, fordi fila da leses før første maling. */}
    <a class="topbar__logo" href="/" aria-label="KodeKonsulentene – til forsiden">
      <img src="/logo/kk-lockup-dark.svg" alt="" width="170" height="22" data-logo="dark" />
      <img src="/logo/kk-lockup-light.svg" alt="" width="170" height="22" data-logo="light" />
    </a>
    {/* Paa telefon var menyen en vannrett scroller: fire lenker synlige, tre
        usynlige, og ingen antydning om at den kunne dras. Tre av sju sider fantes
        ikke for en som var paa mobil.
        Naa er den en knapp som aapner en <dialog>. Dialogen er valgt framfor en
        egen meny-div fordi nettleseren selv tar fokusfellen, Escape og bakgrunnen –
        mindre kode og mer som virker. Uten JavaScript faller vi tilbake til
        scrolleren, som i det minste naar alt. */}
    <button class="topbar__meny" type="button" data-meny-knapp aria-expanded="false"
            aria-controls="hovedmeny-dialog" hidden>
      <span class="topbar__menylinjer" aria-hidden="true"></span>
      {/* Ordet staar i et eget element fordi det skjules VISUELT under 340 px –
          se stilblokken. `visually-hidden` og ikke `display: none`: knappens
          tilgjengelige navn skal fortsatt vaere «Meny», ogsaa naar bare streken
          er synlig. */}
      <span class="topbar__menyord">Meny</span>
    </button>
    <dialog class="menydialog" id="hovedmeny-dialog" data-meny-dialog>
      <nav aria-label="Hovedmeny">
        {hovedmeny.map((l) => (
          <a href={l.href} aria-current={sti === l.href || sti.startsWith(`${l.href}/`) ? "page" : undefined}>{l.label}</a>
        ))}
      </nav>
      <button class="kk-btn kk-btn-ghost" type="button" data-meny-lukk>Lukk</button>
    </dialog>
    <nav aria-label="Hovedmeny" data-meny-rad>
      {hovedmeny.map((l) => (
        <a href={l.href} aria-current={sti === l.href || sti.startsWith(`${l.href}/`) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <button class="iconbtn" type="button" data-theme-toggle aria-label="Bytt mellom mørkt og lyst tema">
      {/* data-icon MÅ bli stående: site.css bytter ikon med temaet via
          `[data-icon="sun"]`/`[data-icon="moon"]`. 18 px er det CSS maler dem i.
          Knappen har aria-label, så ikonene selv er dekorasjon. */}
      <Ikon navn="moon" storrelse={18} data-icon="moon" />
      <Ikon navn="sun" storrelse={18} data-icon="sun" />
    </button>
    <Button variant="primary" href={bookUrl} class="topbar__cta">Book 20 min</Button>
  </div>
</header>

<style>
  /* Logoen bytter med temaet. Begge er i markup, CSS velger – ingen flimring. */
  .topbar__logo img[data-logo="light"] { display: none; }
  :global(html[data-theme="light"]) .topbar__logo img[data-logo="dark"] { display: none; }
  :global(html[data-theme="light"]) .topbar__logo img[data-logo="light"] { display: block; }
  @media (max-width: 560px) { .topbar__cta { display: none; } }

  /* Flytende pille.
     Både jeton.com og osmo.supply lar menyen bli stående som en avrundet flate
     som svever over innholdet. Grepet koster ingenting og holder navigasjonen
     innen rekkevidde gjennom en forside på 9000 px.

     position: sticky tar ikke elementet ut av flyten, så CLS er uberørt. Det
     virker også med den globale `overflow-x: clip` på html og body – `clip`
     lager ingen scroll-beholder, og det var nettopp derfor den ble valgt
     framfor `hidden` da sperren mot sidelengs drag kom inn.

     z-index 40 ligger over scenefilmene (0–20) og under terminalmodalen (999). */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: transparent;
    border-bottom: 0;
    padding-block: var(--space-3);
    padding-inline: var(--space-3);
  }
  /* .topbar__inner ER .wrap, som allerede har padding-inline. Den blir pillens
     innvendige luft; den ytre luften ligger på .topbar over. */
  .topbar__inner {
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-menu);
    min-height: 56px;
  }
  /* Under 860 px bryter menyen til en vannrett scroller på egen linje. Da er
     pilleformen feil – den blir en høy kapsel – så flaten får kortets radius.
     Den ytre luften går samtidig fra 12 til 8 px: topplinja tok 166 px av en
     844 px skjerm, og 8 px er fortsatt en tydelig flytende pille mot kanten.
     Resten av innhentingen ligger i site.css, i samme blokk som forklarer den. */
  /* 8 PX SPREKK OVER PILLA.
   *
   * `.topbar` er klebrig med `top: 0`, gjennomsiktig bakgrunn og
   * `padding-block`. Pilla er altså ikke i toppen av det klebrige elementet –
   * det ligger 8 px (12 px over 860) luft foran den, og den luften er
   * gjennomsiktig. Innholdet på siden ruller FORBI i den glipa: du ser toppen
   * av bokstavene bli skrelt av skjermkanten rett over menyen. Verst i lyst
   * tema, der flaten under er nesten hvit og teksten nesten svart.
   *
   * HVORFOR IKKE BARE GI `.topbar` EN BAKGRUNN: den svever over seksjoner med
   * ulik grunnfarge – hvit, svart og `.flate--varm` på samme side – og
   * var(--bg) på topplinja leser rotas farge, ikke seksjonens. En ugjennomsiktig
   * stripe hadde vært feil farge på to av tre seksjoner. En uskarp bakgrunn er
   * utelukket; brandboken forbyr glassmorfisme.
   *
   * I stedet rulles luften bort. Med `top: -8px` stopper det klebrige elementet
   * 8 px over synsranden, og pillas egen overkant lander nøyaktig på 0. Før man
   * ruller er luften der som før – den flytende pilla er uendret i hvile. Når
   * noe først ruller, finnes det ingen glipe å rulle gjennom.
   *
   * `--topplinje-hoyde` er uberørt: elementet er like høyt som før. */
  .topbar { top: calc(-1 * var(--space-3)); }

  @media (max-width: 860px) {
    .topbar__inner { border-radius: var(--radius-md); }
    .topbar {
      padding-block: var(--space-2);
      padding-inline: var(--space-2);
      /* Luften er 8 px her, så sprekken som rulles bort er 8 px. */
      top: calc(-1 * var(--space-2));
    }

    /* TEMAKNAPPEN STO ALENE PÅ EN EGEN RAD.
     *
     * Målt på 390 px, hver eneste side: logo 170 + «Meny» 85 + knapp 36 = 291 px
     * innhold i 326 px tilgjengelig – det er 35 px til overs. Men gapet var 24 px
     * i to ledd, altså 48, og 291 + 48 = 339. Raden brøt, månen havnet nederst
     * til venstre med halve skjermen tom ved siden av seg, og topplinja ble
     * 122 px høy mot 78 px fra 414 px og opp. De smaleste telefonene ble
     * straffet hardest av et gap satt for brede skjermer.
     *
     * 12 px gir 291 + 24 = 315 i 326. Alt på én rad, med 11 px klaring.
     * Treffmålene er urørte: logolenka er fortsatt 44 px høy, menyknappen 44 og
     * temaknappen 36 × 36 med 12 px mellom seg – godt over WCAG 2.5.8 sitt krav
     * om at mål ikke skal overlappe. */
    .topbar__inner { column-gap: var(--space-3); }
  }

  /* Pillas egen innvendige luft hentes inn fra 24 til 12 px under 420 px.
     Regnestykket på 360 px – den vanligste Android-bredden – går ikke opp uten
     den: 360 − 16 (pillas luft mot skjermkanten) − 48 (innvendig luft) = 296 px
     tilgjengelig mot 315 px innhold. Med 12 px innvendig blir det 320 mot 315.
     Logoen står fortsatt 20 px fra skjermkanten, og ingen treffflate endrer seg. */
  @media (max-width: 420px) {
    .topbar__inner { padding-inline: var(--space-3); }
  }
</style>

{/* Menyen er en vannrett scroller på mobil: 535 px innhold i 316 px på 390 px
    skjerm. Står du på /om, /priser eller /verktøy, ligger lenken med
    `aria-current="page"` UTENFOR synsranden – merket som skal si hvor du er,
    er det eneste du ikke ser. Her dras den inn.

    `nav.scrollLeft` og ikke `scrollIntoView`: den siste kan rulle SIDEN også, og
    topplinja er klebrig, så et hopp der ville flyttet innholdet under linja.
    Dette rører bare scrollerens egen posisjon.

    Degraderingen er dagens tilstand: uten JavaScript står menyen på 0, nøyaktig
    som før, og alle lenkene er fortsatt tilgjengelige ved å dra. */}
<script>
  // MAA vaere `nav[data-meny-rad]`, ikke `.topbar nav`. Da mobilmenyen kom inn,
  // ble <dialog> lagt FOER raden i markup, og dialogen har sin egen <nav>. Fra den
  // dagen traff `.topbar nav` dialogens nav i stedet for raden. Den er lukket, saa
  // scrollWidth og clientWidth er begge 0, `mer` ble aldri sann, og hele
  // `data-mer`-mekanikken under har staatt doed.
  //
  // MAALT I BEGGE MOTORER paa /om, med den gamle velgeren:
  //   932 px (iPhone Pro Max i landskap): raden er 567 px i en boks paa 436 px.
  //     Uten `data-mer` staar nav paa `overflow-x: visible`, saa de siste lenkene
  //     males OPPAA naboene: temaknappen laa over «Priser», og «Book 20 min»
  //     dekket «Om» helt. To av sju lenker var umulige aa treffe.
  //   900 og 1000 px: 567 px i 404 / 504 px, og lenken med aria-current laa
  //     utenfor synsranden – nettopp det merket som skal si hvor du er.
  const meny = document.querySelector<HTMLElement>(".topbar nav[data-meny-rad]");
  const her = meny?.querySelector<HTMLElement>('[aria-current="page"]');

  // `data-mer` sier at menyen er bredere enn plassen sin. Det er den som slår på
  // scroll, maske og kantene i site.css. Den kan ikke avgjøres av en
  // mediespørring: om det finnes mer meny avhenger av lenkene, språket,
  // skriftstørrelsen og zoomen – ikke av skjermbredden alene. Målt uten den, på
  // 861–1024 px: raden var overtegnet og nettleseren krympet ordmerket til 77 px
  // og temaknappen til 20 px for å få plass.
  const vurder = () => {
    if (!meny) return;
    const mer = meny.scrollWidth > meny.clientWidth + 1;
    if (mer) meny.setAttribute("data-mer", "");
    else meny.removeAttribute("data-mer");
    return mer;
  };

  if (meny) {
    const mer = vurder();
    // Står du på /om, /priser eller /verktøy, ligger lenken med
    // `aria-current="page"` utenfor synsranden – merket som skal si hvor du er,
    // er det eneste du ikke ser. Her dras den inn.
    //
    // `scrollLeft` og ikke `scrollIntoView`: den siste kan rulle SIDEN også, og
    // topplinja er klebrig, så et hopp der ville flyttet innholdet under linja.
    // Dette rører bare scrollerens egen posisjon.
    if (mer && her) {
      meny.scrollLeft = Math.max(0, her.offsetLeft - (meny.clientWidth - her.offsetWidth) / 2);
    }
    let tid: ReturnType<typeof setTimeout>;
    addEventListener("resize", () => { clearTimeout(tid); tid = setTimeout(vurder, 150); });
  }

  // ── --topplinje-hoyde skal være MÅLT, ikke anslått ────────────────────────
  //
  // site.css setter `--topplinje-hoyde: 132px` under 860 px, og `html` bruker
  // den til `scroll-padding-top`. Tallet stemte ikke med noen bredde vi målte
  // 7. oktober 2026:
  //
  //     390 px   topplinja 122 px   (menyen brøt til to rader)
  //     414 px   topplinja  78 px
  //     768 px   topplinja  78 px
  //
  // Et ankerhopp fikk altså 132 + 12 px klaring der linja var 78 – 66 px for
  // mye, så overskriften man hoppet til havnet et godt stykke nede på skjermen.
  // Etter at gapet ble rettet (se stilblokken over) er den ÉN rad på alle
  // bredder, og da stemmer 132 enda dårligere.
  //
  // Høyden kan ikke avgjøres av en mediespørring. Den avhenger av skrift,
  // språk, zoom og om «Book 20 min» er med – akkurat som `data-mer` over.
  // Derfor måles den, og tallet legges på <html> som innlinjeverdi, som slår
  // stilarkets. Uten JavaScript står 132 px igjen, altså nøyaktig som i dag.
  //
  // `top` er negativ (sprekken over pilla rulles bort), og det er den SYNLIGE
  // tildekkingen vi er ute etter: når linja er klebret fast, dekker den fra 0
  // til høyde + top. Derfor legges top til i stedet for å ignoreres.
  const linje = document.querySelector<HTMLElement>(".topbar");
  if (linje) {
    const settHoyde = () => {
      const topp = parseFloat(getComputedStyle(linje).top) || 0;
      const h = Math.round(linje.getBoundingClientRect().height + topp);
      if (h > 0) document.documentElement.style.setProperty("--topplinje-hoyde", `${h}px`);
    };
    settHoyde();
    let t2: ReturnType<typeof setTimeout>;
    addEventListener("resize", () => { clearTimeout(t2); t2 = setTimeout(settHoyde, 150); });
  }
</script>

<style is:global>
  /* Knappen og dialogen finnes bare paa smal skjerm. Over 860 px staar lenkene
     som foer – der er det plass til alle sju. */
  .topbar__meny { display: none; }
  .menydialog { display: none; }

  @media (max-width: 860px) {
    /* Raden skjules NAAR skriptet har slaatt paa knappen. Uten JavaScript staar
       raden igjen, og da er scrolleren bedre enn ingenting. */
    .topbar:has(.topbar__meny:not([hidden])) nav[data-meny-rad] { display: none; }

    .topbar__meny {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      padding-inline: var(--space-3);
      border: var(--hairline) solid var(--line-strong);
      border-radius: 999px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 14px;
      cursor: pointer;
    }
    .topbar__menylinjer {
      inline-size: 16px;
      block-size: 2px;
      background: currentColor;
      box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
    }

    /* Under 340 px gaar regnestykket ikke opp uansett: 320 − 16 − 24 gir 280 px
       til 170 px logo, 85 px menyknapp, 36 px temaknapp og to gap – 315 px. Da
       maa noe vike, og det er ordet «Meny», ikke ordmerket og ikke et treffmaal.
       Knappen er fortsatt 44 px hoey, og navnet «Meny» staar igjen for
       skjermleser. 170 + 40 + 36 + 24 = 270 i 280. */
    @media (max-width: 340px) {
      .topbar__menyord {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }
    }

    .menydialog {
      display: revert;
      margin: 0 0 0 auto;
      inline-size: min(320px, 86vw);
      max-inline-size: none;
      block-size: 100dvh;
      max-block-size: none;
      border: 0;
      border-inline-start: var(--hairline) solid var(--line);
      padding: var(--space-6) var(--space-5);
      background: var(--bg);
      color: var(--ink);
    }
    .menydialog::backdrop { background: rgb(0 0 0 / 0.5); }
    .menydialog nav { display: grid; gap: var(--space-1); }
    .menydialog nav a {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding-inline: var(--space-3);
      border-radius: var(--radius-sm);
      color: var(--ink);
      text-decoration: none;
      font-size: 18px;
    }
    .menydialog nav a[aria-current="page"] { background: var(--bg-sunken); font-weight: 700; }
    .menydialog > .kk-btn { margin-block-start: var(--space-5); inline-size: 100%; }
  }

  /* BAKGRUNNEN MAA LAASES SELV. Kommentaren over dialogen lovet at «nettleseren
     selv tar fokusfellen, Escape og bakgrunnen». De to foerste stemmer; den
     tredje gjoer den ikke. En modal <dialog> gjoer resten av dokumentet inert,
     men den stopper IKKE rulling av rotelementet.
     MAALT paa /om med menyen aapen, i begge motorer: «End» rullet siden fra 0 til
     5488 px bak dialogen. Du lukket menyen og sto et helt annet sted enn du gikk
     inn fra.
     HVORFOR `position: fixed` OG IKKE BARE `overflow-y: hidden`. Begge ble maalt,
     og i denne nettleserparen er de like gode: null visuelt skift naar menyen
     aapnes, null bakgrunnsrulling bak dialogen, og samme punkt tilbake etterpaa.
     Valget staar likevel paa den foerste, fordi `overflow: hidden` paa rot er
     kjent for aa lekke for FINGEREN i Safari paa iOS – og det er nettopp dét
     tilfellet denne menyen finnes for. Playwrights WebKit kan ikke sende et
     beroeringsdrag, saa den lekkasjen er den ene tingen her som ikke lar seg
     etterproeve i maskinen; da velger vi grepet som holder i begge tilfeller.
     Prisen er at rulleposisjonen maa baeres over selv: `--meny-y` settes av
     skriptet rett foer attributtet, og skriptet ruller tilbake naar laasen slippes.
     Regelen staar UTENFOR mediespoerringen fordi dialogen bare kan aapnes av
     knappen, og knappen finnes bare under 860 px. */
  html[data-meny-aapen] {
    position: fixed;
    inset-inline: 0;
    top: var(--meny-y, 0);
    inline-size: 100%;
    overflow-y: hidden;
  }
</style>

<script>
  // Knappen vises foerst naar skriptet kjoerer. Da kan vi love at den virker.
  const knapp = document.querySelector<HTMLButtonElement>("[data-meny-knapp]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-meny-dialog]");
  if (knapp && dialog && typeof dialog.showModal === "function") {
    knapp.hidden = false;
    const lukk = () => { dialog.close(); };
    // Rulleposisjonen maa baeres over laasen. Se stilblokken over for maalingene.
    const rot = document.documentElement;
    let lagretY = 0;
    knapp.addEventListener("click", () => {
      lagretY = window.scrollY;
      rot.style.setProperty("--meny-y", `-${lagretY}px`);
      rot.setAttribute("data-meny-aapen", "");
      dialog.showModal();
      knapp.setAttribute("aria-expanded", "true");
      dialog.querySelector<HTMLAnchorElement>("nav a")?.focus();
    });
    // `close` og ikke bare den egne lukkeknappen: Escape og bakgrunnstrykket gaar
    // utenom `lukk()`, og da hadde laasen blitt staaende igjen paa <html> med
    // siden frosset etter at menyen var borte.
    dialog.addEventListener("close", () => {
      rot.removeAttribute("data-meny-aapen");
      rot.style.removeProperty("--meny-y");
      // Avlesningen tvinger fram omregningen foer vi ruller. Mens laasen stod var
      // <html> tatt ut av flyten, og dokumentet var bare én skjerm hoegt; ruller
      // vi tilbake foer nettleseren har regnet om, klippes maalet til den hoeyden.
      void rot.offsetHeight;
      window.scrollTo(0, lagretY);
      knapp.setAttribute("aria-expanded", "false");
    });
    dialog.querySelector("[data-meny-lukk]")?.addEventListener("click", lukk);
    // Trykk paa bakgrunnen lukker. Dialogen dekker hele hoeyden, saa vi sammenligner
    // mot dens egen boks i stedet for aa stole paa at target er dialogen selv.
    dialog.addEventListener("click", (e) => {
      const r = dialog.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) lukk();
    });
  }
</script>
