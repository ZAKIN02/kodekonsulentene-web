---
// Prisvelgeren og prislista (briefen del 6 punkt 9, designsystem v2 7.8):
// prislista ER prisvelgeren – hver pakke er en radioknapp, så hver pris står
// bare én gang på siden. Foreløpig statisk: radioknappene kobles til video i
// bølge 3.2. Uten JavaScript er dette en vanlig prisliste med Start valgt.
// Alle beløp leses fra src/data/priser.ts og skrives aldri av.
// Tekst ordrett fra docs/design/tekst/forside.md del 7.
import { pakker, loepende, prisvilkaar } from "../../data/priser";

const pris = (navn: string) => pakker.find((p) => p.navn === navn);
const start = pris("Start");
const bedrift = pris("Bedrift");
const system = pris("System");
const rad = (navn: string) => loepende.find((r) => r.navn === navn);
const abonnement = rad("Abonnement");
const drift = rad("Drift og vedlikehold");
const timepris = rad("Timepris");

// Manusets forkortede pakkelinjer; prisene kommer fra dataene over.
const velger = [
  {
    id: "pakke-start",
    navn: "Start",
    pris: start?.pris ?? "MANGLER: pris",
    prefiks: "",
    linje: "For deg som trenger å finnes, bli ringt og bestå lovkravene.",
    valgt: true,
    merke: "",
  },
  {
    id: "pakke-bedrift",
    navn: "Bedrift",
    pris: bedrift?.pris ?? "MANGLER: pris",
    prefiks: "",
    linje: "Du endrer innholdet selv, og siden synes i lokale søk. Pakken de fleste trenger.",
    valgt: false,
    merke: "Anbefalt",
  },
  {
    id: "pakke-system",
    navn: "System",
    pris: system?.pris ?? "MANGLER: pris",
    prefiks: system?.prefiks ?? "",
    linje: "Kundeportal, app eller kobling mot systemene du allerede betaler for.",
    valgt: false,
    merke: "",
  },
];

const lister = [
  {
    tittel: "Dette er med i Start",
    punkter: [
      "1–3 sider, skrevet ferdig",
      "Booking eller kontaktskjema",
      "Grunnleggende SEO og Google Bedriftsprofil",
      "Lovsjekk: org.nr., cookies, universell utforming",
    ],
    ikke: ["CMS – jeg endrer teksten for deg", "Lokal SEO per bydel"],
  },
  {
    tittel: "Dette er med i Bedrift",
    punkter: [
      "5–8 sider med CMS du kan redigere selv",
      "Lokal SEO per tjeneste og bydel",
      "Cookieløs analyse – ingen banner",
      "Lovsjekk og sikkerhetsheadere",
    ],
    ikke: [],
  },
  {
    tittel: "Dette er med i System",
    punkter: [
      "Booking, kundeportal eller intern app",
      "Vipps- eller Stripe-betaling",
      "Integrasjon mot Tripletex, Fiken eller PowerOffice",
      "BankID-innlogging ved behov",
      "Sikkerhetsgjennomgang før lansering",
    ],
    ikke: [],
  },
];

const loependeRader = [
  {
    navn: "Abonnement",
    pris: abonnement?.pris ?? "MANGLER: pris",
    linje: "Side bygget, hosting, endringer og sikkerhetsoppdateringer. Ingen oppstartskostnad.",
  },
  {
    navn: "Drift og vedlikehold",
    pris: drift?.pris ?? "MANGLER: pris",
    linje: "For deg som kjøpte siden som engangskjøp. Oppdateringer, backup og overvåkning.",
  },
  {
    navn: "Timepris",
    pris: timepris?.pris ?? "MANGLER: pris",
    linje: "Arbeid utenfor avtalt omfang. Faktureres per påbegynte halvtime.",
  },
];

// De tre første vilkårene fra priser.ts: mva, betaling, revisjoner.
// Eierskapslinja bæres av FAQ-svaret på forsiden (manuset, «Fjernet» punkt 8).
const vilkaar = prisvilkaar.slice(0, 3);
---

<section class="priser rytme-vanlig" aria-labelledby="priser-tittel">
  <div class="felt rutenett">
    <div class="ark">
      <h2 id="priser-tittel">Prisene står her</h2>
      <p class="priser__ingress">Fordi du skal kunne regne på det før du ringer.</p>

      <fieldset class="velger">
        <legend>Velg pakke</legend>
        {velger.map((v) => (
          <label class="pakke">
            <input type="radio" name="pakke" value={v.navn} checked={v.valgt} />
            <span class="pakke__navn">
              {v.navn}
              {v.merke && <span class="merkelapp">{v.merke}</span>}
            </span>
            <span class="pakke__pris">
              {v.prefiks && <span class="pakke__prefiks">{v.prefiks} </span>}{v.pris}
            </span>
            <span class="pakke__linje">{v.linje}</span>
          </label>
        ))}
      </fieldset>

      <div class="inkludert">
        {lister.map((l) => (
          <div class="inkludert__pakke">
            <h3>{l.tittel}</h3>
            <ul>
              {l.punkter.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            {l.ikke.length > 0 && (
              <p class="inkludert__ikke">
                Ikke med: {l.ikke.join(". ")}.
              </p>
            )}
          </div>
        ))}
      </div>

      <ul class="loepende">
        {loependeRader.map((r) => (
          <li>
            <span class="loepende__navn">{r.navn}</span>
            <span class="loepende__pris">{r.pris}</span>
            <span class="loepende__linje">{r.linje}</span>
          </li>
        ))}
      </ul>

      <ul class="vilkaar">
        {vilkaar.map((v) => (
          <li>{v}</li>
        ))}
      </ul>

      <p class="hele"><a href="/priser">Se hele prislisten</a></p>
    </div>

    <figure class="illustrasjon">
      <img
        src="/scener/hero/poster.avif"
        alt=""
        width="1920"
        height="1080"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Illustrasjon laget med KI</figcaption>
    </figure>
  </div>
</section>

<style>
  .rutenett {
    display: grid;
    gap: var(--rom-6) var(--spalteluke);
  }

  @media (min-width: 1024px) {
    .rutenett {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }
    .ark {
      grid-column: 1 / 9;
    }
    .illustrasjon {
      grid-column: 9 / 13;
      position: sticky;
      top: var(--rom-6);
    }
  }

  .ark {
    background: var(--ark);
    border-radius: var(--radius-ark);
    padding: clamp(var(--rom-5), 4vw, var(--rom-7));
  }

  .priser__ingress {
    margin-top: var(--rom-3);
    max-width: var(--maal-brod);
  }

  .velger {
    margin-top: var(--rom-6);
    padding: 0;
    border: none;
  }

  .velger legend {
    padding: 0;
    font-weight: 500;
    margin-bottom: var(--rom-3);
  }

  /* Hver rad er en radioknapp (7.8). Start er valgt ved innlasting. */
  .pakke {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "ring navn pris"
      "ring linje pris";
    column-gap: var(--rom-4);
    align-items: center;
    padding: var(--rom-4);
    border-top: var(--kant-1) solid var(--tekst);
    cursor: pointer;
  }

  .pakke:last-of-type {
    border-bottom: var(--kant-1) solid var(--tekst);
  }

  .pakke:hover {
    box-shadow: inset var(--kant-2) 0 0 var(--tekst);
  }

  /* Ringen: 24 px, kant i kontrollfargen, prikk i blekk når valgt. */
  .pakke input {
    grid-area: ring;
    appearance: none;
    width: 24px;
    height: 24px;
    margin: 0;
    border: var(--kant-2) solid var(--kant-kontroll);
    border-radius: var(--radius-rund);
    background: transparent;
    cursor: pointer;
  }

  .pakke:has(input:checked) {
    background: var(--refleksflate);
    color: var(--tekst-pa-refleks);
    box-shadow: inset 0 0 0 var(--kant-2) var(--kant-refleks);
  }

  /* Ring og prikk i blekk i begge temaer når raden er valgt (kritikerfunn). */
  .pakke input:checked {
    border-color: var(--blekk);
    background: radial-gradient(circle, var(--blekk) 0 6px, transparent 7px);
  }

  .pakke:has(input:focus-visible) {
    outline: var(--kant-2) solid var(--fokus);
    outline-offset: var(--fokus-avstand);
  }

  .pakke input:focus-visible {
    outline: none;
  }

  .pakke__navn {
    grid-area: navn;
    display: inline-flex;
    align-items: center;
    gap: var(--rom-3);
    font-size: var(--tekst-h3);
    font-weight: 700;
    line-height: 1.25;
  }

  .pakke__pris {
    grid-area: pris;
    text-align: right;
    font-family: var(--font-karakter);
    font-weight: 700;
    font-stretch: 75%;
    font-size: var(--tekst-pris);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .pakke__prefiks {
    font-family: var(--font-tekst);
    font-weight: 500;
    font-size: var(--tekst-liten);
  }

  .pakke__linje {
    grid-area: linje;
    max-width: var(--maal-brod);
  }

  @media (max-width: 767px) {
    .pakke {
      grid-template-areas:
        "ring navn navn"
        "ring pris pris"
        "ring linje linje";
      align-items: start;
    }
    .pakke input {
      margin-top: var(--rom-1);
    }
    .pakke__pris {
      text-align: left;
      margin-top: var(--rom-2);
    }
    .pakke__linje {
      margin-top: var(--rom-2);
    }
  }

  .inkludert {
    margin-top: var(--rom-7);
    display: grid;
    gap: var(--rom-6) var(--spalteluke);
  }

  @media (min-width: 768px) {
    .inkludert {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .inkludert ul {
    margin-top: var(--rom-3);
    padding-left: 1.2em;
  }

  .inkludert li {
    margin-top: var(--rom-2);
  }

  .inkludert__ikke {
    margin-top: var(--rom-3);
    font-size: var(--tekst-liten);
  }

  .loepende {
    margin-top: var(--rom-7);
    padding: 0;
    list-style: none;
  }

  .loepende li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "navn pris"
      "linje pris";
    column-gap: var(--rom-4);
    padding-block: var(--rom-3);
    border-top: var(--kant-1) solid var(--tekst);
  }

  .loepende__navn {
    grid-area: navn;
    font-weight: 700;
  }

  .loepende__pris {
    grid-area: pris;
    align-self: center;
    text-align: right;
    font-family: var(--font-karakter);
    font-weight: 700;
    font-stretch: 75%;
    font-variant-numeric: tabular-nums;
    font-size: var(--tekst-h3);
    white-space: nowrap;
  }

  .loepende__linje {
    grid-area: linje;
    max-width: var(--maal-brod);
    font-size: var(--tekst-liten);
  }

  .vilkaar {
    margin-top: var(--rom-6);
    padding: 0;
    border-top: var(--kant-1) solid var(--tekst);
    list-style: none;
    font-size: var(--tekst-liten);
  }

  .vilkaar li {
    margin-top: var(--rom-2);
  }

  .vilkaar li:first-child {
    margin-top: var(--rom-4);
  }

  .hele {
    margin-top: var(--rom-6);
  }

  .illustrasjon img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-ark);
    background: var(--scene-bunn);
  }

  .illustrasjon figcaption {
    margin-top: var(--rom-2);
    font-size: var(--tekst-liten);
  }
</style>
