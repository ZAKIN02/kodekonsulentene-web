---
// Befaringsrapporten i retning A «Befaring»: et papirark i A4-proporsjon,
// forhåndsutfylt med målte verdier for kodekonsulentene.no.
// Tekst ordrett fra docs/design/tekst/retning-a.md. Farger og mål fra
// docs/design/retning.md (retning A). Prisen leses fra src/data/priser.ts.
import { loepende, prisenhet } from '../../data/priser';

const lovsjekkPris = loepende.find((r) => r.navn === 'Lovsjekk-pakke')?.pris ?? 'MANGLER: pris';

const rader = [
  { navn: 'Cookies før samtykke', verdi: '0' },
  { navn: 'Sikkerhetsheadere', verdi: '6 av 6' },
  { navn: 'Svartid, målt fra Oslo', verdi: '0,1 s' },
  { navn: 'Org.nr. på siden', verdi: 'Funnet' },
  { navn: 'Ytelse', verdi: 'MANGLER: målt ytelsestall for kodekonsulentene.no', mangler: true },
];
---

<section id="rapport" class="rapport" aria-labelledby="rapport-tittel">
  <article class="ark">
    <header class="hode">
      <h2 id="rapport-tittel">Befaringsrapport</h2>
      <p class="emne">kodekonsulentene.no</p>
    </header>
    <p class="ingress">
      Forhåndsutfylt for min egen side. Kjører du befaringen øverst, fylles den ut for din – linje
      for linje.
    </p>
    <dl class="rader">
      {
        rader.map((r) => (
          <div class="rad" data-mangler={r.mangler ? '' : undefined}>
            <dt>{r.navn}</dt>
            <dd>{r.verdi}</dd>
          </div>
        ))
      }
    </dl>
    <div class="tomme" aria-hidden="true">
      <div class="linje"></div>
      <div class="linje"></div>
      <div class="linje"></div>
    </div>
    <p class="fastpris">
      Fast pris på utbedring: <strong>{lovsjekkPris}</strong>, {prisenhet}. Dekker cookie-samtykke,
      universell utforming, org.nr. og personvernerklæring.
    </p>
    <a class="book" href="/kontakt">Book 20 minutter</a>
  </article>
</section>

<style>
  .rapport {
    padding: clamp(4rem, 10vh, 7rem) clamp(1.25rem, 5vw, 5rem);
  }

  /* Arket er et dokument: det beholder papir og blekk også i mørkt tema. */
  .ark {
    display: flex;
    flex-direction: column;
    max-width: 44rem;
    aspect-ratio: 210 / 297;
    background: var(--papir);
    color: var(--blekk);
    border-radius: 2px;
    box-shadow: var(--skygge);
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }

  .hode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    border-bottom: 2px solid var(--blekk);
    padding-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-family: var(--skrift-vekt);
    font-weight: 800;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  /* Adressen står skrevet inn på emnelinja i skjemaet. */
  .emne {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ingress {
    margin: 1.25rem 0 0;
    max-width: 36rem;
    line-height: 1.5;
  }

  .rader {
    margin: 1.5rem 0 0;
  }

  .rad {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--blekk);
  }

  .rad dt {
    margin: 0;
  }

  .rad dd {
    margin: 0;
    text-align: right;
    font-family: var(--skrift-vekt);
    font-weight: 700;
  }

  /* Raden som venter på et målt tall er en plassholder, ikke en mangel. */
  .rad[data-mangler] dd {
    font-family: inherit;
    font-weight: 400;
  }

  /* Tomme, linjerte rader: her fylles besøkendes egen befaring ut linje for linje. */
  .tomme {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    min-height: 8rem;
  }

  .linje {
    border-bottom: 1px solid var(--blekk);
  }

  /* Fastprisen er ett av de store flate refleksfeltene i retning A. */
  .fastpris {
    margin: auto 0 0;
    padding: 1.25rem 1.5rem;
    margin-top: auto;
    background: var(--refleks);
    color: var(--blekk);
    border-radius: 2px;
    line-height: 1.5;
  }

  .fastpris strong {
    font-family: var(--skrift-vekt);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .fastpris + .book {
    margin-top: 1rem;
  }

  .book {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.75rem;
    background: var(--blekk);
    color: var(--papir);
    font-family: var(--skrift-vekt);
    font-weight: 700;
    text-decoration: none;
    border-radius: 2px;
  }

  .book:focus-visible {
    outline: 2px solid var(--snorblaa);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .ark {
      aspect-ratio: auto;
      min-height: 80svh;
    }
  }
</style>
