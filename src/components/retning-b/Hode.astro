---
// Sidehode for retning B-prototypen. Logo og dagens meny fra navigasjon.ts.
// Temaveksleren [◐] fra skissen er utelatt: temaet følger prefers-color-scheme
// uten JavaScript. Noteres som åpent punkt i rapporten.
import { hovedmeny } from '../../data/navigasjon';
---

<header class="hode">
  <a class="hode__logo" href="/">
    <picture>
      <source media="(prefers-color-scheme: light)" srcset="/logo/kk-lockup-light.svg" />
      <img src="/logo/kk-lockup-dark.svg" alt="KodeKonsulentene" width="214" height="40" />
    </picture>
  </a>
  <nav aria-label="Hovedmeny">
    <ul class="hode__meny">
      {
        hovedmeny.map((lenke) => (
          <li>
            <a href={lenke.href}>{lenke.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .hode {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
  }
  .hode__logo {
    display: inline-flex;
    flex: none;
  }
  .hode__logo img {
    display: block;
    height: 28px;
    width: auto;
  }
  .hode__meny {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    flex-wrap: wrap;
  }
  .hode__meny a {
    color: var(--tekst);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
    padding: 0.5rem 0;
  }
  @media (max-width: 767px) {
    .hode {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
