---
// Reelen (øyeblikk 6 i briefen del 8) som <details>, så den kan åpnes og leses
// uten JavaScript. Når skjermopptakene fra eier finnes, byttes innholdet til
// <dialog> med <video controls> som først lastes ved klikk.
---

<details class="reel">
  <summary>Spill av filmen</summary>
  <p class="reel__plasshold">
    [MANGLER: skjermopptak fra eier til reelen – 20–30 sekunder klippet sammen med scenene]
  </p>
</details>

<style>
  .reel summary {
    display: inline-block;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--tekst);
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-tittel);
    font-weight: 700;
    color: var(--tekst);
    transition: background-color var(--svar) var(--inn-ut);
  }
  .reel summary::-webkit-details-marker {
    display: none;
  }
  .reel summary:hover {
    background: var(--ark);
  }
  .reel__plasshold {
    margin: 1rem 0 0;
    padding: 2rem 1.5rem;
    aspect-ratio: 16 / 9;
    max-width: 40rem;
    border-radius: 8px;
    background: var(--plasshold-flate);
    color: var(--plasshold-tekst);
  }
</style>
