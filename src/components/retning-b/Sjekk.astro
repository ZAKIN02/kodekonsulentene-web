---
// Sjekken: neste seksjon etter scenen i retning B. Ark i benk på natt.
// Skjemaet virker uten JavaScript: GET til /sjekk med ?url=, samme som dagens side.
// All tekst ordrett fra docs/design/tekst/retning-b.md.
import { bookUrl } from '../../data/firma';
---

<section id="sjekk" class="sjekk" aria-labelledby="sjekk-tittel">
  <div class="sjekk__ark">
    <h2 id="sjekk-tittel">Sjekk nettsiden din gratis</h2>
    <p class="sjekk__ingress">
      78&nbsp;% av nordmenn undersøker om en nettside er trygg før de bruker den (NorSIS og Opinion,
      juni 2024). Skriv inn adressen, så ser du hva de finner på din.
    </p>
    <form class="sjekk__skjema" method="get" action="/sjekk">
      <label class="sjekk__ledetekst" for="sjekk-url">Nettadresse</label>
      <input
        class="sjekk__felt"
        id="sjekk-url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        required
        placeholder="dinbedrift.no"
        aria-describedby="sjekk-hint"
      />
      <button class="sjekk__knapp" type="submit">Sjekk nettsiden min</button>
    </form>
    <p class="sjekk__hint" id="sjekk-hint">
      Rapport på 30 sekunder: cookies, sikkerhet, fart og org.nr. Ingen innlogging.
    </p>
    <p class="sjekk__book"><a href={bookUrl}>Eller book 20 minutter</a></p>
  </div>
</section>

<style>
  .sjekk {
    padding: 4rem 1.5rem 6rem;
  }
  .sjekk__ark {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    border-radius: 24px;
    background: var(--ark);
    border: 1px solid var(--ark-kant);
  }
  .sjekk h2 {
    margin: 0 0 1rem;
    font-family: var(--font-tittel);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
  }
  .sjekk__ingress {
    margin: 0 0 2rem;
    max-width: 38rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .sjekk__ledetekst {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .sjekk__skjema {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .sjekk__felt {
    flex: 1 1 14rem;
    min-height: 48px;
    padding: 0.5rem 1rem;
    font: inherit;
    color: var(--tekst);
    background: var(--felt-flate);
    border: 1px solid var(--tekst);
    border-radius: 8px;
  }
  .sjekk__felt::placeholder {
    color: var(--tekst);
    opacity: 1;
  }
  .sjekk__knapp {
    min-height: 48px;
    padding: 0.5rem 1.5rem;
    font-family: var(--font-tittel);
    font-weight: 800;
    font-size: 1rem;
    color: var(--natt);
    background: var(--refleks);
    border: 1px solid var(--knapp-kant);
    border-radius: 8px;
    cursor: pointer;
    transition: filter var(--svar) var(--inn-ut);
  }
  .sjekk__knapp:hover {
    filter: brightness(1.08);
  }
  .sjekk__hint {
    margin: 1rem 0 0;
    max-width: 38rem;
  }
  .sjekk__book {
    margin: 2rem 0 0;
  }
  .sjekk__book a {
    color: var(--tekst);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 768px) {
    .sjekk__ark {
      padding: 3.5rem 3rem 4rem;
    }
  }
</style>

<script>
  // Norsk feilmelding fra manuset i stedet for nettleserens standardtekst.
  // Uten JavaScript validerer nettleseren og serveren på /sjekk tar resten.
  const felt = document.querySelector<HTMLInputElement>('#sjekk-url');
  felt?.addEventListener('invalid', () => {
    felt.setCustomValidity('Det ser ikke ut som en nettadresse. Prøv formen dinbedrift.no.');
  });
  felt?.addEventListener('input', () => felt.setCustomValidity(''));
</script>
