---
// Pakkevelgeren på første skjerm i retning C. Tre tekstrader som radioknapper.
// Tekst og tall ordrett fra docs/design/tekst/retning-c.md (hero.velger.*).
// Uten JavaScript står radene som en vanlig prisliste; valgt rad får refleksfelt.
interface Valg {
  navn: string;
  pris: string;
  prefiks?: string;
  hva: string;
}
const valg: Valg[] = [
  { navn: 'Start', pris: '14 900', hva: '1–3 sider, skrevet ferdig' },
  { navn: 'Bedrift', pris: '29 900', hva: '5–8 sider med CMS du redigerer selv' },
  { navn: 'System', pris: '60 000', prefiks: 'fra', hva: 'booking, kundeportal eller intern app' },
];
---

<form class="velger">
  <fieldset class="velger__gruppe">
    <legend class="velger__ledetekst">Velg pakke</legend>
    {
      valg.map((v, i) => (
        <label class="velger__rad">
          <input
            type="radio"
            name="pakke"
            value={v.navn}
            checked={i === 0}
            data-pris={v.pris}
            data-prefiks={v.prefiks ?? ''}
          />
          <span class="velger__navn">{v.navn}</span>
          <span class="velger__pris">{v.prefiks ? `${v.prefiks} ` : ''}{v.pris} kr</span>
          <span class="velger__hva">{v.hva}</span>
        </label>
      ))
    }
  </fieldset>
</form>

<style>
  .velger__gruppe {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .velger__ledetekst {
    padding: 0;
    margin-block-end: var(--rom-2);
    font-size: var(--tekst-liten);
    font-weight: 700;
    font-family: var(--font-tittel);
  }
  .velger__rad {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    column-gap: var(--rom-3);
    min-height: 3rem;
    padding-inline: var(--rom-2);
    border: 2px solid transparent;
    cursor: pointer;
  }
  .velger__rad:has(input:checked) {
    background: var(--refleks);
    border-color: var(--stempel);
    color: var(--stempel);
  }
  .velger__rad input {
    appearance: none;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin: 0;
    border: 2px solid currentColor;
    border-radius: 50%;
    cursor: pointer;
  }
  .velger__rad input:checked {
    border-width: 0.4375rem;
  }
  .velger__rad input:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }
  .velger__navn {
    font-family: var(--font-tittel);
    font-weight: 700;
    font-size: var(--tekst-mellom);
    min-inline-size: 5.5em;
  }
  .velger__pris {
    font-family: var(--font-tittel);
    font-weight: 700;
    font-size: var(--tekst-mellom);
    font-variant-numeric: tabular-nums;
    justify-self: end;
    text-align: right;
    min-inline-size: 8em;
  }
  .velger__hva {
    display: none;
  }
  @media (min-width: 768px) {
    .velger__rad {
      grid-template-columns: auto 9em 10em 1fr;
      min-height: 3.5rem;
    }
    .velger__pris {
      justify-self: start;
      text-align: left;
    }
    .velger__hva {
      display: block;
      font-size: var(--tekst-liten);
    }
  }
</style>
