---
// «Det som er med i prisen» (anker #med). Gjentar ikke beløpene fra første
// skjerm: bare innhold og vilkår. Tekst ordrett fra docs/design/tekst/retning-c.md
// (med.*), som siterer src/data/priser.ts.
interface Pakke {
  tittel: string;
  punkter: string[];
  ikke?: string[];
}
const pakker: Pakke[] = [
  {
    tittel: 'Start',
    punkter: [
      '1–3 sider, skrevet ferdig',
      'Booking eller kontaktskjema',
      'Grunnleggende SEO og Google Bedriftsprofil',
      'Lovsjekk: org.nr., cookies, universell utforming',
      'Du eier koden og domenet',
    ],
    ikke: ['CMS – jeg endrer teksten for deg', 'Lokal SEO per bydel'],
  },
  {
    tittel: 'Bedrift',
    punkter: [
      '5–8 sider med CMS du kan redigere selv',
      'Lokal SEO per tjeneste og bydel',
      'Cookieløs analyse – ingen banner',
      'Lovsjekk og sikkerhetsheadere',
      'To revisjonsrunder',
      'Du eier koden og domenet',
    ],
  },
  {
    tittel: 'System',
    punkter: [
      'Booking, kundeportal eller intern app',
      'Vipps- eller Stripe-betaling',
      'Integrasjon mot Tripletex, Fiken eller PowerOffice',
      'BankID-innlogging ved behov',
      'Sikkerhetsgjennomgang før lansering',
      'Du eier koden og databasen',
    ],
  },
];
const vilkaar: string[] = [
  '40 % faktureres ved oppstart, resten ved lansering.',
  'To revisjonsrunder er inkludert. Flere runder er timepris, 950 kr/t.',
  'Du eier koden, innholdet og domenet – også hvis du sier opp.',
];
---

<section id="med" class="med">
  <h2 class="med__tittel">Det som er med i prisen</h2>
  <div class="med__pakker">
    {
      pakker.map((p) => (
        <div class="med__pakke">
          <h3>{p.tittel}</h3>
          <ul class="med__punkter">
            {p.punkter.map((punkt) => (
              <li>{punkt}</li>
            ))}
          </ul>
          {p.ikke && (
            <div class="med__ikke">
              <p class="med__ikkeledd">Ikke med:</p>
              <ul class="med__punkter med__punkter--ikke">
                {p.ikke.map((punkt) => (
                  <li>{punkt}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))
    }
  </div>
  <ul class="med__vilkaar">
    {vilkaar.map((v) => <li>{v}</li>)}
  </ul>
</section>

<style>
  .med {
    padding-block: var(--rom-7) var(--rom-6);
  }
  .med__tittel {
    font-family: var(--font-tittel);
    font-weight: 700;
    font-size: var(--tekst-stor);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 var(--rom-5);
  }
  .med__pakker {
    display: grid;
    gap: var(--rom-5);
  }
  .med__pakke h3 {
    font-family: var(--font-tittel);
    font-weight: 700;
    font-size: var(--tekst-mellom);
    margin: 0 0 var(--rom-2);
  }
  .med__punkter {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 34rem;
  }
  .med__punkter li {
    padding-block: 0.3125rem;
  }
  .med__ikke {
    margin: var(--rom-3) 0 0;
    color: var(--mangel);
  }
  .med__ikkeledd {
    margin: 0;
  }
  .med__punkter--ikke {
    margin-block-start: 0;
  }
  .med__vilkaar {
    list-style: none;
    margin: var(--rom-6) 0 0;
    padding: var(--rom-3) 0 0;
    border-top: 2px solid var(--tekst);
    max-width: 34rem;
  }
  .med__vilkaar li {
    padding-block: 0.3125rem;
  }
  @media (min-width: 768px) {
    .med__pakker {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--rom-4);
    }
  }
</style>
