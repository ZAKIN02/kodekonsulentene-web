---
/**
 * «Mente du …?» i wow-drakt: 404-siden gjetter hva du lette etter.
 * Portert fra src/components/Mentedu.astro (wow-undersider.md del 3, bølge B4). Oppførselen,
 * kandidatlista, terskelen og skriptet er de samme; bare klassenavnene (wow-mentedu) og stilen er
 * nye. Stilen bruker bare var(--wow-*), og stien står i vanlig skrift, ikke monospace.
 * V1-komponenten slettes i bølge C.
 *
 * Avstanden mellom stien du ba om og hver sti som finnes måles (Levenshtein), og den nærmeste
 * tilbys som en stor lenke øverst.
 *
 * HVORFOR I NETTLESEREN: 404-siden er forhåndsbygget. Ved bygging er stien /404, ikke den
 * brukeren ba om; den finnes bare i location.pathname.
 *
 * TERSKELEN: et gjett som er feil, er verre enn ingen gjett. Høyst en tredjedel av den korteste
 * strengen kan være feil, og aldri mer enn fire tegn. /kontakt mot /caser er avstand 6 og blir
 * ikke foreslått. /priserr mot /priser er 1 og blir det.
 *
 * UTEN JAVASCRIPT er blokken tom og tar ingen plass: skriptet lager innholdet. Lenkelista over
 * sidene som finnes står ferdig i HTML-en, og er den egentlige utveien. Blokken har ingen
 * min-height, og luft under først når gjettet står der ([data-klar]), så ingenting hopper.
 *
 * Ingen bevegelse. Stilen er global fordi markupen lages i nettleseren.
 */
import { hovedmeny, footerLenker } from "../../../data/navigasjon";

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;

/**
 * Kandidatene. Alt som står i menyen eller footeren, pluss inngangene folk oftest skriver inn for
 * hånd. Ingen hardkodet liste over alle sider: da ville en ny side manglet her uten at noe sa fra.
 */
const sider = [...hovedmeny, ...footerLenker]
  .filter((l) => l.href.startsWith("/"))
  // Terminal-lenken heter «Terminal (~)» i footeren, og parentesen er støy i «Mente du Terminal (~)?».
  .map((l) => ({ href: l.href, label: l.label.replace(/\s*\(~\)\s*/, "") }))
  .concat([
    { href: "/sjekk", label: "Sjekk nettsiden din" },
    { href: "/kontakt", label: "Kontakt" },
    { href: "/caser", label: "Caser" },
    { href: "/verktoy/priskalkulator", label: "Priskalkulator" },
    { href: "/verktoy/dmarc", label: "DMARC-sjekk" },
    { href: "/verktoy/uu-sjekk", label: "Sjekk universell utforming" },
    { href: "/verktoy/cookie-sjekk", label: "Cookie-sjekk" },
  ])
  // Samme href kan stå både i meny og footer. Første forekomst vinner.
  .filter((l, i, alle) => alle.findIndex((a) => a.href === l.href) === i);

const data = JSON.stringify(sider);
---
<div class:list={["wow-mentedu", cls]} data-mentedu data-sider={data}></div>

<script>
  interface Side { href: string; label: string }

  /**
   * Levenshtein-avstand med to rader i stedet for en full matrise. Listen er på
   * under tjue sider, så dette er ikke en optimalisering som trengs – det er bare
   * mindre kode enn matrisen.
   */
  function avstand(a: string, b: string): number {
    if (a === b) return 0;
    if (!a.length) return b.length;
    if (!b.length) return a.length;
    let forrige = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i += 1) {
      const naa = [i];
      for (let j = 1; j <= b.length; j += 1) {
        naa[j] = Math.min(
          forrige[j] + 1,                                   // slett
          naa[j - 1] + 1,                                   // sett inn
          forrige[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1),  // bytt
        );
      }
      forrige = naa;
    }
    return forrige[b.length];
  }

  /** `/Priser/` og `/priser` er samme sti for et menneske. */
  const normaliser = (s: string) => s.toLowerCase().replace(/\/+$/, "") || "/";

  for (const rot of document.querySelectorAll<HTMLElement>("[data-mentedu]")) {
    let sider: Side[] = [];
    try {
      const raa = JSON.parse(rot.dataset.sider ?? "[]");
      if (Array.isArray(raa)) {
        sider = raa.filter(
          (s): s is Side => !!s && typeof s.href === "string" && typeof s.label === "string",
        );
      }
    } catch {
      // Ødelagt attributt. Da står blokken tom, og lenkelisten ved siden av gjør jobben.
    }
    if (!sider.length) continue;

    const bedt = normaliser(location.pathname);
    // På /404 selv, eller på forsiden, er det ingenting å gjette om.
    if (bedt === "/" || bedt === "/404") continue;

    let beste: Side | null = null;
    let bestAvstand = Infinity;
    for (const s of sider) {
      const d = avstand(bedt, normaliser(s.href));
      if (d < bestAvstand) { bestAvstand = d; beste = s; }
    }
    if (!beste) continue;

    // Terskelen. Se resonnementet øverst i filen: et gjett som er feil er verre
    // enn ingen gjett.
    const kortest = Math.min(bedt.length, normaliser(beste.href).length);
    const tak = Math.min(4, Math.floor(kortest / 3));
    if (bestAvstand > tak || bestAvstand === 0) continue;

    const p = document.createElement("p");
    p.className = "wow-mentedu__gjett";

    const foran = document.createElement("span");
    foran.className = "wow-mentedu__foran";
    foran.textContent = "Mente du ";

    const a = document.createElement("a");
    a.className = "wow-mentedu__lenke";
    a.href = beste.href;
    a.textContent = beste.label;

    const etter = document.createElement("span");
    etter.className = "wow-mentedu__foran";
    etter.textContent = "?";

    p.append(foran, a, etter);

    const sti = document.createElement("p");
    sti.className = "wow-mentedu__sti";
    // Stien skrives som tekst, aldri som HTML: den kommer fra adressefeltet, og
    // det er den klassiske veien inn for en XSS. `textContent` lukker den.
    const tegn = bestAvstand === 1 ? "ett tegn" : `${bestAvstand} tegn`;
    sti.textContent = `Du ba om ${bedt}. Det er ${tegn} fra ${normaliser(beste.href)}.`;

    rot.append(p, sti);
    rot.dataset.klar = "";
  }
</script>

<style is:global>
  .wow-mentedu {
    display: grid;
    gap: var(--wow-rom-2);
  }
  .wow-mentedu[data-klar] {
    margin-bottom: var(--wow-rom-7);
  }
  .wow-mentedu__gjett {
    margin: 0;
    font-family: var(--wow-font-tekst);
    font-size: var(--wow-tekst-mellom);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .wow-mentedu__foran {
    color: var(--wow-tekst-dempet);
  }
  .wow-mentedu__lenke {
    color: var(--wow-tekst);
    text-decoration: underline;
    text-decoration-color: var(--wow-refleks);
    text-decoration-thickness: var(--wow-kant-2);
    text-underline-offset: 0.18em;
    transition: color var(--wow-tid-kort) var(--wow-kurve);
  }
  @media (hover: hover) and (pointer: fine) {
    .wow-mentedu__lenke:hover {
      color: var(--wow-refleks);
    }
  }
  .wow-mentedu__sti {
    margin: 0;
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-liten);
    overflow-wrap: anywhere;
  }
</style>
