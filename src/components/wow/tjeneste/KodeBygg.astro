---
/**
 * «Kode blir til en nettside» (wow-r8-B1, portert fra src/components/KodeBygg.astro, som står
 * urørt). Sidens eget øyeblikk på /nettsider (wow-undersider.md del 1.3, punkt 2).
 *
 * Venstre side er oppskriften: ekte kode, lest fra disk ved bygg, skrevet inn linje for linje.
 * Høyre side er resultatet: den SAMME komponenten, rendret. Overskriften kommer når
 * overskriftslinja kommer, figuren når figurkoden kommer, knappen når knappelinja kommer.
 *
 * KODEN ER EKTE, OG KAN IKKE SLUTTE Å VÆRE DET. Utsnittet leses fra KodeEksempel.astro i samme
 * mappe med readFileSync ved bygg. Døper noen om en klasse der, finner ikke trinnsøket ankeret
 * sitt, og byggingen stopper med en feilmelding. Linjenumrene er filas EGNE.
 * Siden er prerendret, så lesingen skjer bare ved bygg.
 *
 * BEVEGELSEN er tidsdrevet og svarer på at blokken kommer i syne: den spiller én gang og slutter
 * i ferdig tilstand. Standardtilstanden i CSS er ferdig bygget; bare [data-klar], som skriptet
 * setter, skjuler noe, og bare [data-gaar] animerer. Uten JavaScript, ved redusert bevegelse og
 * i forced-colors står begge sider komplett. Alle tider er regnet av --wow-tid-*.
 *
 * Monospace brukes bare på koden (ekte kode) og på filstien.
 */
import { readFileSync } from "node:fs";
import KodeEksempel from "./KodeEksempel.astro";

const STI = "src/components/wow/tjeneste/KodeEksempel.astro";

const alle = readFileSync(STI, "utf8").split("\n");
const fra = alle.findIndex((l) => l.includes('<article class="kodeeks"'));
const til = alle.findIndex((l) => l.includes("</article>"));
if (fra < 0 || til <= fra) {
  throw new Error(`KodeBygg: fant ikke <article class="kodeeks"> … </article> i ${STI}`);
}
const linjer = alle.slice(fra, til + 1);

/**
 * Trinnene, i den rekkefølgen barna står i KodeEksempel.astro. Hver streng er et anker i kilden.
 * Linjene fra og med ankeret til linja før neste anker hører til samme trinn, og trinnets element
 * på høyre side kommer når den SISTE av dem er skrevet.
 */
const ANKRE = ['class="merke', 'class="tittel', 'class="tekst', 'class="figur', 'class="knapp'];
for (const a of ANKRE) {
  if (!linjer.some((l) => l.includes(a))) {
    throw new Error(`KodeBygg: ankeret ${a} finnes ikke i utsnittet fra ${STI}`);
  }
}

let teller = 0;
const trinnPerLinje = linjer.map((l) => {
  if (teller < ANKRE.length && l.includes(ANKRE[teller])) teller++;
  return teller;
});
/** Linja (indeks) der hvert trinn er ferdig skrevet. CSS regner tiden av den. */
const stil = [1, 2, 3, 4, 5].map((n) => `--t${n}:${trinnPerLinje.lastIndexOf(n)}`).join(";");

/** Minste mulige fargelegging: taggnavn, attributtnavn, strenger og {uttrykk}. */
const MONSTER = /(<\/?[A-Za-z][\w.-]*)|(\/?>)|("[^"]*")|(\{[^}]*\})|([A-Za-z-]+(?==))/g;
type Bit = { k: string | null; v: string };
function del(linje: string): Bit[] {
  const ut: Bit[] = [];
  let sist = 0;
  for (const m of linje.matchAll(MONSTER)) {
    const i = m.index ?? 0;
    if (i > sist) ut.push({ k: null, v: linje.slice(sist, i) });
    const k = m[1] || m[2] ? "kb-t" : m[3] ? "kb-s" : m[4] ? "kb-u" : "kb-a";
    ut.push({ k, v: m[0] });
    sist = i + m[0].length;
  }
  if (sist < linje.length) ut.push({ k: null, v: linje.slice(sist) });
  return ut;
}

const etikett =
  `Kodeutsnitt fra ${STI}, linje ${fra + 1} til ${til + 1}. ` +
  "Den samme koden er rendret som ferdig resultat ved siden av.";
---

<div class="kb" style={stil} data-kodebygg>
  <div class="kb__par">
    <figure class="kb__rute">
      <figcaption class="kb__hode">
        <span class="kb__rolle">Oppskriften</span>
        <span class="kb__kilde"><code>{STI}</code>, linje {fra + 1}–{til + 1}</span>
      </figcaption>
      {/* tabindex og role: flaten kan rulles vannrett og må kunne nås med tastatur (WCAG 2.1.1).
          Koden ER innholdet og er ikke skjult for skjermlesere. */}
      <pre class="kb__kode" tabindex="0" role="group" aria-label={etikett}>{linjer.map((l, i) => (
        <span class="kb__linje" style={`--i:${i}`}><span class="kb__nr" aria-hidden="true">{fra + 1 + i}</span>{del(l).map((b) => (b.k ? <span class={b.k}>{b.v}</span> : b.v))}</span>
      ))}</pre>
    </figure>

    <figure class="kb__rute">
      <figcaption class="kb__hode">
        <span class="kb__rolle">Resultatet</span>
        <span class="kb__kilde">det kunden ser i nettleseren</span>
      </figcaption>
      <div class="kb__ut"><KodeEksempel /></div>
    </figure>
  </div>

  <p class="kb__under">
    Venstre side er koden vi skriver. Høyre side er siden som blir av den. Hver
    linje bygger én ting: overskriften kommer når overskriftslinja kommer,
    figuren når figurkoden kommer, knappen til slutt.
  </p>

  {/* Skjult til JavaScript har slått på sekvensen. Uten JavaScript står alt ferdig. */}
  <button class="wow-knapp wow-knapp--strek wow-knapp--liten kb__om" type="button" hidden>
    <span class="wow-knapp__tekst">Spill sekvensen om</span>
  </button>
</div>

<style is:global>
  /* GLOBAL med vilje: halvparten av reglene må treffe barna til KodeEksempel.astro, som bærer en
     annen scope-id. Alt er prefikset kb-. */
  .kb {
    /* Takten: én linje per --kb-linje. 22 linjer gir om lag 2,4 s skriving. */
    --kb-start: var(--wow-tid-svar);
    --kb-linje: calc(var(--wow-tid-kort) * 0.6);
    --kb-linje-tid: calc(var(--wow-tid-lang) * 1.3);
    --kb-ut-tid: calc(var(--wow-tid-lang) * 1.5);
    --kb-lys: color-mix(in srgb, var(--wow-refleks) 14%, transparent);
    display: grid;
    gap: var(--wow-rom-5);
  }
  .kb__par {
    display: grid;
    gap: var(--wow-rom-6);
    align-items: start;
  }
  .kb__rute {
    display: grid;
    gap: var(--wow-rom-3);
    min-width: 0;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .kb__par {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--wow-luke);
      align-items: stretch;
    }
    .kb__rute {
      grid-template-rows: auto 1fr;
    }
  }
  .kb__hode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wow-rom-1) var(--wow-rom-4);
  }
  .kb__rolle {
    font-size: var(--wow-tekst-h3);
    font-weight: 700;
    line-height: 1.15;
  }
  .kb__kilde {
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-mikro);
    overflow-wrap: anywhere;
  }
  .kb__kilde code {
    font-family: var(--wow-font-kode);
  }
  .kb__kode {
    min-width: 0;
    margin: 0;
    padding: var(--wow-rom-4) var(--wow-rom-5);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    background: var(--wow-flate);
    border-radius: var(--wow-radius-m);
    color: var(--wow-tekst);
    font-family: var(--wow-font-kode);
    font-size: var(--wow-tekst-mikro);
    line-height: 1.65;
    white-space: pre;
    tab-size: 2;
  }
  .kb__kode:focus-visible {
    outline: var(--wow-kant-2) solid var(--wow-fokus);
    outline-offset: var(--wow-fokus-avstand);
  }
  .kb__linje {
    display: block;
    width: max-content;
    min-width: 100%;
    border-radius: var(--wow-rom-1);
  }
  .kb__nr {
    display: inline-block;
    width: 2ch;
    margin-right: 1.5ch;
    /* Dempet, ikke svak: mens linja lyser opp (--kb-lys) ga svak 4,04:1 mot den lyse flaten. */
    color: var(--wow-tekst-dempet);
    text-align: right;
    user-select: none;
  }
  /* Kontrast mot --wow-flate: refleks 13,6:1, dempet 7,4:1, lenke 7,3:1, tekst 15,8:1. */
  .kb-t { color: var(--wow-refleks); }
  .kb-a { color: var(--wow-tekst-dempet); }
  .kb-s { color: var(--wow-lenke); }
  .kb-u { color: var(--wow-tekst); }

  .kb__ut {
    display: grid;
    align-content: center;
    padding: var(--wow-rom-6) var(--wow-rom-5);
    border: var(--wow-kant-1) solid var(--wow-linje);
    border-radius: var(--wow-radius-m);
  }
  /* Luft rundt hvert element, så lyset som tennes bak det ikke ligger kant i kant med teksten. */
  .kb__ut .kodeeks > :not(.knapp) {
    margin-inline: calc(-1 * var(--wow-rom-2));
    padding-inline: var(--wow-rom-2);
    border-radius: var(--wow-rom-1);
  }
  .kb__under {
    max-width: var(--wow-maal-brod);
    color: var(--wow-tekst-dempet);
  }
  .kb__om {
    justify-self: start;
  }

  @media (prefers-reduced-motion: no-preference) {
    .kb[data-klar] .kb__linje,
    .kb[data-klar] .kb__ut .kodeeks > * {
      visibility: hidden;
    }
    .kb[data-gaar] .kb__linje {
      animation-name: kb-linje;
      animation-duration: var(--kb-linje-tid);
      animation-timing-function: var(--wow-kurve);
      animation-fill-mode: both;
      animation-iteration-count: 1;
      animation-delay: calc(var(--kb-start) + var(--i) * var(--kb-linje));
    }
    .kb[data-gaar] .kb__ut .kodeeks > * {
      animation-name: kb-ut;
      animation-duration: var(--kb-ut-tid);
      animation-timing-function: var(--wow-kurve);
      animation-fill-mode: both;
      animation-iteration-count: 1;
      animation-delay: calc(var(--kb-start) + var(--t) * var(--kb-linje) + var(--wow-tid-kort));
    }
    .kb[data-gaar] .kb__ut .kodeeks > .knapp {
      animation-name: kb-ut-rein;
    }
    .kb__ut .kodeeks > :nth-child(1) { --t: var(--t1); }
    .kb__ut .kodeeks > :nth-child(2) { --t: var(--t2); }
    .kb__ut .kodeeks > :nth-child(3) { --t: var(--t3); }
    .kb__ut .kodeeks > :nth-child(4) { --t: var(--t4); }
    .kb__ut .kodeeks > :nth-child(5) { --t: var(--t5); }
  }

  /* Linja skrives inn fra venstre og lyser et øyeblikk. */
  @keyframes kb-linje {
    0% {
      visibility: hidden;
      clip-path: inset(0 100% 0 0);
      background-color: transparent;
    }
    1% { visibility: visible; }
    14% {
      clip-path: inset(0 0 0 0);
      background-color: var(--kb-lys);
    }
    100% {
      visibility: visible;
      clip-path: inset(0 0 0 0);
      background-color: transparent;
    }
  }
  /* Elementet kommer i samme lys som linja som laget det. */
  @keyframes kb-ut {
    0% {
      visibility: hidden;
      opacity: 0;
      background-color: transparent;
    }
    1% { visibility: visible; }
    24% {
      opacity: 1;
      background-color: var(--kb-lys);
    }
    100% {
      visibility: visible;
      opacity: 1;
      background-color: transparent;
    }
  }
  @keyframes kb-ut-rein {
    0% { visibility: hidden; opacity: 0; }
    1% { visibility: visible; }
    24%, 100% { visibility: visible; opacity: 1; }
  }

  @media (forced-colors: active) {
    .kb__kode { border: var(--wow-kant-1) solid CanvasText; }
    .kb[data-klar] .kb__linje,
    .kb[data-klar] .kb__ut .kodeeks > *,
    .kb[data-gaar] .kb__linje,
    .kb[data-gaar] .kb__ut .kodeeks > * {
      animation-name: none;
      visibility: visible;
      opacity: 1;
      clip-path: none;
    }
  }

  /* Smal skjerm: koden brytes i stedet for å rulle sidelengs, med hengende innrykk. */
  @media (max-width: 767px) {
    .kb__kode {
      padding-inline: var(--wow-rom-4);
      overflow-x: visible;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .kb__linje {
      width: auto;
      padding-left: 3.5ch;
      text-indent: -3.5ch;
    }
  }
</style>

<script>
  /**
   * Sekvensen starter når blokken kommer i syne, spiller én gang og slutter i ferdig tilstand.
   * data-klar (skjul) settes FØR blokken kan komme i syne, og data-gaar (spill) når den gjør det.
   * Uten dette skriptet settes ingen av dem, og CSS-ens standardtilstand er ferdig bygget.
   */
  const blokker = document.querySelectorAll<HTMLElement>("[data-kodebygg]");
  if (blokker.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const blokk of blokker) {
      blokk.dataset.klar = "";

      const start = () => {
        delete blokk.dataset.gaar;
        // Ny stilberegning, ellers starter ingenting på nytt.
        void blokk.offsetWidth;
        blokk.dataset.gaar = "";
      };

      const io = new IntersectionObserver(
        (poster) => {
          for (const p of poster) {
            if (!p.isIntersecting) continue;
            io.disconnect();
            start();
          }
        },
        { threshold: 0.15 },
      );
      io.observe(blokk);

      // Sikkerhetsnett: fyrer ikke observeren, skal begge sider stå synlige uansett.
      setTimeout(() => {
        if (blokk.dataset.gaar === undefined) {
          io.disconnect();
          delete blokk.dataset.klar;
        }
      }, 8000);

      const om = blokk.querySelector<HTMLButtonElement>(".kb__om");
      if (om) {
        om.hidden = false;
        om.addEventListener("click", start);
      }
    }
  }
</script>
