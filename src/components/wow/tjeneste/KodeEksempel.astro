---
/**
 * Den EKTE komponenten KodeBygg forteller historien om (wow-r8-B1, portert fra
 * src/components/KodeEksempel.astro).
 *
 * KodeBygg.astro leser denne fila fra disk ved bygg, viser markeringen under som kode til venstre,
 * og rendrer den samme komponenten til høyre. Ingen av de to sidene er en tegning av den andre:
 * endrer du en linje her, endrer begge seg i neste bygg.
 *
 * DERFOR ER DEN KORT. Alt som står her blir lest av en besøkende som ikke kan kode. Tjue linjer kan
 * hun følge; åtti kan hun ikke.
 *
 * REKKEFØLGEN PÅ BARNA ER KOBLINGEN. KodeBygg finner hvert trinn ved å søke etter klassenavnene
 * «merke», «tittel», «tekst», «figur» og «knapp» i kildekoden, og tidsstyrer resultatet med
 * :nth-child i samme rekkefølge. Bytter du om på barna, eller døper om en klasse, må KodeBygg følge.
 *
 * TALLENE ER MÅLT, IKKE SKREVET. Alt som ser ut som data kommer fra src/data/maalinger.json, der
 * «oss» er vår egen side og «typisk» er medianen fra masseskanningen.
 *
 * ETT LINJESKIFT RETT FØR ET {uttrykk} SPISER MELLOMROMMET (Astro følger JSX). Setninger med data
 * i står derfor på ÉN linje her.
 */
import maalinger from "../../../data/maalinger.json";

const oss = maalinger.oss;
const t = maalinger.typisk;

/** «6. oktober 2026» av «2026-10-06». */
const maalt = new Date(`${oss.maalt}T12:00:00Z`).toLocaleDateString("nb-NO", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

/** Stolpelengder i viewBox-enheter. 180 enheter = alle seks headerne. */
const SPOR = 180;
const b1 = Math.round((SPOR * t.headereAv6) / 6);
const b2 = Math.round((SPOR * oss.headereAv6) / 6);
---
<article class="kodeeks">
  <p class="merke">Målt {maalt}</p>
  <h3 class="tittel">Siden du ser på nå</h3>
  <p class="tekst">
    {oss.cookiesForSamtykke} cookies, {oss.ttfbMs} ms svartid.
  </p>
  <figure class="figur">
    <svg viewBox="0 0 300 50" aria-hidden="true">
      <rect class="spor" x="80" y="6" width="180" height="14" />
      <rect class="fyll" x="80" y="6" width={b1} height="14" />
      <rect class="spor" x="80" y="30" width="180" height="14" />
      <rect class="fyll oss" x="80" y="30" width={b2} height="14" />
      <text x="0" y="17">Typisk</text>
      <text x="272" y="17">{t.headereAv6}</text>
      <text x="0" y="41">Vår side</text>
      <text x="272" y="41">{oss.headereAv6}</text>
    </svg>
    <figcaption>Sikkerhetsheadere, av 6</figcaption>
  </figure>
  <a class="knapp wow-knapp" href="/sjekk">Sjekk siden din</a>
</article>

<style>
  .kodeeks {
    display: grid;
    gap: var(--wow-rom-4);
    justify-items: start;
  }
  .merke {
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-liten);
  }
  .tittel {
    font-size: var(--wow-tekst-h3);
    font-weight: 700;
    line-height: 1.15;
  }
  .tekst {
    max-width: 32ch;
    color: var(--wow-tekst-dempet);
  }
  .figur {
    display: grid;
    gap: var(--wow-rom-2);
    width: 100%;
    margin: 0;
  }
  /* viewBox-bredden er 300 og maksbredden 300 px, så skalaen er 1:1 eller mindre: 14 px tekst
     males aldri større eller mindre enn den er satt. */
  svg {
    width: 100%;
    max-width: 300px;
    height: auto;
  }
  text {
    fill: var(--wow-tekst-dempet);
    font-family: var(--wow-font-tekst);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  /* Tallene står i figuren, så stolpene bærer ikke mening alene. */
  .spor {
    fill: var(--wow-linje);
  }
  .fyll {
    fill: var(--wow-linje-sterk);
  }
  .fyll.oss {
    fill: var(--wow-refleks);
  }
  figcaption {
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-liten);
  }
</style>
