---
// Fontene er selvhostet. Se src/styles/fonter.css for hvorfor.
import "../styles/fonter.css";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/site.css";
import Topbar from "../components/Topbar.astro";
import LegalFooter from "../components/LegalFooter.astro";
import Apning from "../components/Apning.astro";
import { firma, erUferdig } from "../data/firma";
import { footerLenker } from "../data/navigasjon";
import { foretak, nettsted, brodsmuler } from "../data/schema";
import { TEMA_SCRIPT } from "../../sikkerhet.mjs";

interface Props {
  tittel: string;
  beskrivelse: string;
  /** Settes bare på sider som ikke skal indekseres (takkesider, rapportvisninger). */
  noindex?: boolean;
  /** Ekstra JSON-LD utover LocalBusiness, f.eks. Service eller FAQPage. */
  schema?: Record<string, unknown>[];
  /** Filnavn i /og/ uten endelse. Faller tilbake på forsidekortet. */
  ogBilde?: string;
  /**
   * Settes bare på artikler. Gir `og:type=article` og de to datoene Facebook,
   * LinkedIn og Slack leser når de bygger forhåndsvisningen. Datoene skal være
   * de samme som står i brødteksten og i Article-markupen – ikke «i dag».
   */
  artikkel?: { publisert: string; oppdatert: string };
}
// Uferdig side skal aldri indekseres, uansett hva siden selv ber om.
const {
  tittel,
  beskrivelse,
  noindex = erUferdig,
  schema = [],
  ogBilde = "forside",
  artikkel,
} = Astro.props;
const ogUrl = new URL(`/og/${ogBilde}.png`, Astro.site ?? firma.url).href;
/**
 * Forsiden får navnet først og et kort tillegg; alle andre sider får sitt eget
 * navn først og foretaket bak. Rekkefølgen er bevisst: det er sidens eget emne
 * som avgjør om noen klikker, men navnet skal stå i hver tittel, fordi det er
 * navnet vi forsøker å bli funnet på.
 */
const fullTittel =
  tittel === firma.navn ? `${firma.navn} – ${firma.titteltillegg}` : `${tittel} – ${firma.navn}`;
const kanonisk = new URL(Astro.url.pathname, Astro.site ?? firma.url).href;

/**
 * Strukturerte data bygges i src/data/schema.ts, av de samme tallene som står i
 * teksten. Tre noder går på hver side:
 *
 *  - foretaket, med fast `@id` så alle sider peker på SAMME virksomhet
 *  - nettstedet, som knytter sidene sammen under én utgiver
 *  - brødsmuler, utledet av stien – Google viser dem i stedet for rå URL
 *
 * Sider som er merket noindex får ingen av dem. Strukturerte data på en side vi
 * ber Google la være, er bare støy.
 */
/**
 * Åpningen går bare på forsiden. Den er et førsteinntrykk, ikke en overgang –
 * og en som kommer rett inn på /priser fra et søk skal ha prisen, ikke en
 * sekvens. Komponenten passer selv på at den vises én gang per økt og aldri ved
 * redusert bevegelse.
 */
const visApning = Astro.url.pathname === "/";

const basisSchema = noindex
  ? []
  : [foretak(), nettsted(), brodsmuler(Astro.url.pathname, tittel)].filter(
      (n): n is Record<string, unknown> => n !== null,
    );
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTittel}</title>
    <meta name="description" content={beskrivelse} />
    <link rel="canonical" href={kanonisk} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={artikkel ? "article" : "website"} />
    <meta property="og:site_name" content={firma.navn} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={fullTittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={tittel} />
    {artikkel && <meta property="article:published_time" content={artikkel.publisert} />}
    {artikkel && <meta property="article:modified_time" content={artikkel.oppdatert} />}
    {/* Twitter/X arver og:title og og:description når de mangler, men bare noen
        av lesebrettene gjør det. Slack, Discord og flere leser twitter:-feltene
        først. Det koster to linjer å slippe å gjette. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTittel} />
    <meta name="twitter:description" content={beskrivelse} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={tittel} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* 180x180, ikke 1024. apple-touch-icon pekte på en fil beregnet for App Store –
        flere hundre kilobyte der det skulle vært tre. */}
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
    {/* Forhåndslast de to latinske subsettene. Uten dem oppdages fontene først når
        CSS-en er parset, og `font-display: swap` bytter skrift ETTER første maling –
        på /nettsider ga det CLS 0,174. Isolert ved å blokkere fontfilene: skiftet
        falt til 0,000. Rammer hardest der Mega er størst, altså på skrivebord.
        Bare latin-subsettene; latin-ext lastes bare hvis teksten trenger den. */}
    <link rel="preload" href="/fonts/schibsted-grotesk-700_800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-400_600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0d10" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />


    <!-- Temavalget settes før første maling. Teksten kommer fra lib/tema-script.ts,
         som middleware.ts regner CSP-hashen av. Ikke skriv den av her. -->
    <script is:inline set:html={TEMA_SCRIPT} />

    {basisSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}
    {!noindex && schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}
  </head>

  <body>
    {visApning && <Apning />}
    <a class="skip" href="#innhold">Hopp til innhold</a>
    <Topbar />
    <main id="innhold">
      <slot />
    </main>
    <div class="wrap">
      <LegalFooter
        name={firma.navn}
        legalName={firma.foretaksnavn}
        tagline={firma.tagline}
        orgnr={firma.orgnr}
        vat={firma.mva}
        address={firma.adresse}
        email={firma.epost}
        phone={firma.telefon}
        links={footerLenker}
        cookieNote={firma.cookieNote}
        meta={`Bygget i Oslo · Uten cookies · ${new Date().getFullYear()}`}
      />
    </div>

    <script>
      // Tema: knappen i topbaren, valget huskes. Ingen cookie – localStorage er ikke sporing.
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      toggle?.addEventListener("click", () => {
        const lys = document.documentElement.dataset.theme === "light";
        const neste = lys ? "dark" : "light";
        document.documentElement.dataset.theme = neste;
        try { localStorage.setItem("kk-tema", neste); } catch {}
      });
    </script>

    {/* Opptellingen i åpningen. Lastes bare der åpningen finnes, og er ren pynt:
        tallene står ferdig i HTML-en og overlegget forsvinner av CSS uansett. */}
    {visApning && <script src="/apning.js" defer />}
    <script src="/terminal.js" defer></script>
    <script src="/hero-live.js" defer></script>
  </body>
</html>
