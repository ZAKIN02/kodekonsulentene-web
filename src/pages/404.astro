---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import { hovedmeny } from "../data/navigasjon";
---
<Base tittel="Siden finnes ikke" beskrivelse="Fant ikke siden du lette etter." noindex>
  <Section nivaa={1} n={4} eyebrow="404" tittel="Den siden finnes ikke">
    <div class="grid-2">
      <div class="stack">
        <p class="body-lg muted">
          Lenken er enten gammel eller feilskrevet. Her er de sidene som finnes:
        </p>
        <ul class="stack stack--tight" style="list-style: none; margin: 0; padding: 0">
          {hovedmeny.map((l) => (
            <li><a class="kk-link" href={l.href}>{l.label}</a></li>
          ))}
          <li><a class="kk-link" href="/sjekk">Sjekk nettsiden din</a></li>
          <li><a class="kk-link" href="/kontakt">Kontakt</a></li>
        </ul>
        <Button variant="primary" href="/">Til forsiden</Button>
      </div>
      <Terminal
        title="~/kodekonsulentene"
        lines={[
          { type: "cmd", text: "cat denne-siden" },
          { type: "fail", text: "cat: denne-siden: finnes ikke" },
          { type: "cmd", text: "ls" },
          { type: "out", text: "nettsider systemer apper-og-ai sikkerhet" },
          { type: "out", text: "priser caser om kontakt sjekk" },
        ]}
        label="Terminalutsnitt: filen finnes ikke, etterfulgt av en liste over sidene som finnes."
      />
    </div>
  </Section>
</Base>
