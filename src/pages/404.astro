---
/**
 * 404 i wow-drakten (wow-undersider.md del 1.9, «rolig»). En blindvei er det dårligste stedet å
 * miste noen.
 *
 * Rekkefølge: H1 → gjettet («Mente du …?») → den innfelte terminalen og lista over sider som
 * finnes. Gjettet står først: en 404 har én jobb nummer én, å få folk videre dit de skulle.
 *
 * Terminalen er ikke en skjult detalj her, men halve siden: du kan skrive kommandoer rett i den,
 * lese andre sider med `cat`, og kjøre den ekte nettsidesjekken med `sjekk <url>`. MalWow henter
 * /terminal.js med en gang når siden har [data-kkterm-innfelt]. Monospace er lov i den: det er
 * en ekte terminal (stil i wow-terminal.css).
 *
 * Uten JavaScript står feilmeldingen ferdig skrevet i HTML-en, og lenkelista gjør jobben.
 * Inputfeltet er `disabled` til skriptet slår det på, så ingen får et felt som ikke svarer.
 * Snarveikartet («?») ligger i MalWow på alle sider og står derfor ikke her lenger.
 */
import MalWow from "../layouts/MalWow.astro";
import { SideHode } from "../components/wow/side";
import Mentedu from "../components/wow/info/Mentedu.astro";
import { hovedmeny } from "../data/navigasjon";

// Bare det hovedmenyen ikke allerede har – «Verktøy» ligger der fra før.
const snarveier = [
  { label: "Sjekk nettsiden din", href: "/sjekk" },
  { label: "Kontakt", href: "/kontakt" },
].filter((s) => !hovedmeny.some((h) => h.href === s.href));
---

<MalWow
  tittel="Siden finnes ikke"
  beskrivelse="Fant ikke siden du lette etter. Men terminalen virker."
  noindex
  bevegelse="rolig"
  bookHref="/kontakt"
>
  <SideHode
    tittel="Den siden finnes ikke"
    ingress="Lenken er gammel eller feilskrevet. Siden du står på nå er likevel ikke tom – den er en terminal. Skriv noe."
    storrelse="tjeneste"
  />

  <div class="wow-rute fire-null">
    {/* Tom til skriptet finner en sti som er nær nok, og tar da ingen plass. */}
    <Mentedu class="fire-null__gjett" />

    <div class="kkterm fire-null__term" data-kkterm-innfelt>
      <div class="kkterm__bar">
        <span>~/kodekonsulentene</span>
        <span>help for kommandoer</span>
      </div>
      {/* Plassholder for dem uten JavaScript. Skriptet kjenner den ekte stien
          og bytter ut hele blokken når det kjører. */}
      <div class="kkterm__out" role="log" aria-live="polite">{`$ cat /siden-du-ba-om
cat: finnes ikke
`}</div>
      <div class="kkterm__line">
        <span class="kkterm__ps" aria-hidden="true">$</span>
        <label class="visually-hidden" for="kkterm-404">Kommando</label>
        <input
          class="kkterm__in"
          id="kkterm-404"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          disabled
          placeholder="krever JavaScript"
        />
      </div>
    </div>

    <nav class="fire-null__ut" aria-labelledby="fire-null-sider">
      <h2 class="fire-null__tittel" id="fire-null-sider">Sider som finnes</h2>
      <ul class="fire-null__liste" role="list">
        {[...hovedmeny, ...snarveier].map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <a class="wow-knapp" href="/">
        <span class="wow-knapp__tekst">Til forsiden</span>
      </a>
    </nav>
  </div>
</MalWow>

<style>
  .fire-null {
    row-gap: var(--wow-rom-7);
    align-items: start;
    padding-top: var(--wow-rom-7);
    padding-bottom: var(--wow-seksjon-tett);
  }
  /* Gjettet har sin egen luft under ([data-klar]); uten gjett skal raden ikke ta plass. */
  .fire-null > :global(.fire-null__gjett) {
    margin-bottom: calc(-1 * var(--wow-rom-7));
  }
  .fire-null > :global(.fire-null__gjett[data-klar]) {
    margin-bottom: 0;
  }

  /* .kkterm har ramme, bakgrunn og skrift fra wow-terminal.css. Her bare det som skiller den
     innfelte flaten fra modalen: full bredde i spalten og høyere utskrift. */
  .fire-null__term {
    max-width: none;
  }
  .fire-null__term :global(.kkterm__out) {
    min-height: 16rem;
    max-height: 50svh;
  }

  .fire-null__ut {
    display: grid;
    gap: var(--wow-rom-5);
    justify-items: start;
  }
  .fire-null__tittel {
    font-size: var(--wow-tekst-h3);
    font-weight: 700;
    line-height: 1.15;
  }
  .fire-null__liste {
    display: grid;
    width: 100%;
    margin: 0;
    padding: 0;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .fire-null__liste a {
    display: flex;
    align-items: center;
    min-height: var(--wow-trykkflate);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
    color: var(--wow-tekst);
    font-size: var(--wow-tekst-ingress);
    font-weight: 500;
    transition: color var(--wow-tid-kort) var(--wow-kurve);
  }
  @media (hover: hover) and (pointer: fine) {
    .fire-null__liste a:hover {
      color: var(--wow-refleks);
    }
  }
  @media (min-width: 1024px) {
    .fire-null__term {
      grid-column: 1 / 8;
    }
    .fire-null__ut {
      grid-column: 8 / 13;
    }
  }
</style>
