---
/**
 * /apper-og-ai i wow-drakten (wow-undersider.md del 1.3 og del 4, wow-r8-B1).
 * Rekkefølge: kapittel 3 (rørleggeren) → «To flater, én kobling» (flyt og ekte skjermbilder) →
 * «Tre ting en app løser» → «Fire steg» → «AI som gjør en jobb» → reglene for AI-flater →
 * AiTekst (sidens eget øyeblikk: demoen man kan røre) → kontakt.
 * Ute fra v1: løpenumrene på kortene, Horisont og terminalutsnittet «I praksis» (de fem reglene
 * står som nummerert liste).
 */
import MalWow from "../layouts/MalWow.astro";
import { Seksjon, Prosa, Flyt, Tekstrader, Kontaktblokk, Ramme } from "../components/wow/side";
import Kapittel from "../components/wow/Kapittel.astro";
import Rader from "../components/wow/tjeneste/Rader.astro";
import AiTekst from "../components/wow/tjeneste/AiTekst.astro";
import { kapittelForhandslast } from "../scripts/wow/kapittel-klipp";
import { tjeneste } from "../data/schema";
import { flyter } from "../data/flyter";
import { synligeCaser } from "../data/caser";
import { bookUrl } from "../data/firma";
import { tjenester } from "../data/historie";

/**
 * `synligeCaser`, ikke `caser`. Den ufiltrerte listen inneholder app-caser som fortsatt er merket
 * TODO, og et internt notat skal aldri vises: har vi ikke navn å vise til, skal raden ikke finnes.
 */
const apper = synligeCaser.filter((c) => c.type === "App");

const loser = [
  { tittel: "Varsler", tekst: "Push når en ny jobb kommer inn, eller når en time avbestilles. Ingen venter på at noen skal sjekke e-posten." },
  { tittel: "Offline", tekst: "Montøren registrerer timer og bilder i kjelleren uten dekning, og det synkes når telefonen får nett igjen." },
  { tittel: "Kamera og posisjon", tekst: "Befaringsbilder, strekkoder og GPS rett inn i ordren. Det er her feltarbeid faktisk sparer tid." },
];

const steg = [
  { tittel: "Vi finner den ene jobben", tekst: "Nesten alle app-ideer er tre ideer i en trenchcoat. Vi skiller ut den ene oppgaven som faktisk gjentar seg hver uke, og lar resten vente." },
  { tittel: "Du får se den på egen telefon", tekst: "Lenge før den er ferdig. En app som bare er sett på en skjerm i et møterom, oppdager man feilene i først etter lansering." },
  { tittel: "Den kobles til det du har", tekst: "Appen henter fra samme sted som nettsiden og regnskapet. Et eget datasett ved siden av er en ny kilde til uenighet om hvilke tall som gjelder." },
  { tittel: "Den legges ut i ditt navn", tekst: "App Store og Google Play krever en utviklerkonto. Den står på din bedrift, ikke på oss, så appen blir værende din også om du bytter leverandør." },
];

/** De fem reglene for AI-flater. Sto som terminalutsnitt i v1; innholdet er det samme. */
const regler = [
  "Alltid merket som AI",
  "Aldri pris eller avtale uten menneske",
  "Ingen personopplysninger i loggen",
  "Databehandleravtale før produksjon",
  "Feiler den, sier den det – og sender deg videre",
];

/** Fra `tjeneste()`. */
const schema = tjeneste({
  type: "Utvikling av apper og AI-assistenter",
  navn: "Apper og AI",
  beskrivelse:
    "iOS-app, intern app for felt og verksted, og AI-assistent med databehandleravtale. Utviklerkontoen staar paa kundens foretak.",
  sti: "/apper-og-ai",
});
---

<MalWow
  tittel="Apper og AI for små bedrifter"
  beskrivelse="iOS-app, intern app og AI-assistent fra samme utvikler som bygger nettsiden. Oslo, fast pris og databehandleravtale. Utviklerkontoen står på din bedrift."
  schema={[schema]}
  bevegelse="film"
  forhandslast={kapittelForhandslast(3, "skrubb")}
>
  <Kapittel
    nummer={3}
    tittel="Få leverandører tar både nettside og app"
    ingress="De fleste som bygger nettsider setter ut apputvikling. Vi gjør begge deler selv, slik at nettsiden, systemet bak og appen oppå henger sammen fra start."
    problem={tjenester.apper.problem}
    losning={tjenester.apper.losning}
    handlinger={[
      { tekst: "Book 20 minutter", href: bookUrl, type: "primar" },
      { tekst: "Hva en app løser", href: "#apper", type: "lenke" },
    ]}
  />

  <Seksjon id="kobling" tittel="To flater, én kobling" storrelse="stor">
    <div class="app-kobling">
      <Prosa>
        <p>
          En app som ikke snakker med nettsiden og systemet bak, er bare en ny
          innboks noen må huske å sjekke.
        </p>
        <p>
          Derfor bygges appen mot de samme dataene som alt annet: én kundeliste,
          én ordre, ett sted tallene kommer fra. Det er den koblingen som gjør at
          en app sparer tid i stedet for å lage mer arbeid.
        </p>
        <p><a href="/systemer">Se hvordan vi kobler systemer</a></p>
      </Prosa>
      {/* Ekte skjermbilder (public/media/wow/ekte/), samme par som på forsiden. */}
      <div class="app-flater">
        <Ramme
          type="nettleser"
          bilde="apper-kobling"
          adresse="kodekonsulentene.no/apper-og-ai"
          alt="Skjermbilde av hvordan app, database og nettside deler de samme tallene."
          sizes="(min-width: 1024px) 46vw, 80vw"
          class="app-flater__stor"
          avdekk
        />
        <Ramme
          type="telefon"
          bilde="apper-m"
          alt="Skjermbilde av siden om apper og AI på mobil."
          sizes="(min-width: 1024px) 13vw, 26vw"
          class="app-flater__liten"
          parallax="-0.14"
        />
      </div>
    </div>
    {/* Diagram med EKTE navn på systemene, ikke abstrakte former. */}
    <div class="app-flyt">
      <Flyt flyt={flyter.apper} />
    </div>
  </Seksjon>

  <Seksjon id="apper" tittel="Tre ting en app løser som en nettside ikke gjør" storrelse="tjeneste" tone="flate">
    <Tekstrader rader={loser} />
    {apper.length > 0 && (
      <dl class="app-caser">
        {apper.map((a) => (
          <div><dt>{a.tittel}</dt><dd>{a.stack.join(", ")}</dd></div>
        ))}
      </dl>
    )}
  </Seksjon>

  {/* En ekte rekkefølge, derfor nummerert (<ol>). */}
  <Seksjon id="steg" tittel="Fire steg, ingen overraskelser" storrelse="tjeneste">
    <Rader ordnet rader={steg} />
  </Seksjon>

  {/*
    «SSB MELDER AT 48 % … MOT TRE AV TI ÅRET FØR» – ETT TALL HOLDT, ETT GJORDE IKKE (v1).
    Kontrollert mot SSBs statistikkbank 7. oktober 2026, tabell 14942, oppdatert 25. september
    2026: alle sysselsette 48 %, 10–19 sysselsette 37 %. Tabellnummeret står på siden.
    «Mot tre av ti året før» er fjernet: SSB byttet næringsstandard (SN2007 → SN2025), og seriene
    kan ikke sammenlignes direkte. Forbeholdet som betyr mest: SSB dekker bare foretak med minst
    ti sysselsatte, så målgruppen vår er ikke med i tallet.
  */}
  <Seksjon
    id="ai"
    tittel="AI som gjør en jobb, ikke AI som pynt"
    ingress="SSB målte at 48 % av foretakene med minst ti ansatte brukte KI i 2026. Blant de minste som er med – de med 10–19 ansatte – var det 37 %. Konkurrentene dine prøver. De fleste prøver på feil sted."
    storrelse="stor"
    tone="flate"
  >
    <Prosa>
      <p class="wow-notat">
        Kilde: <a href="https://www.ssb.no/statbank/table/14942" rel="nofollow">SSB, tabell 14942 «Bruk av kunstig intelligens-teknologi (prosent), etter næring (SN2025), sysselsette»</a>,
        2026-tall, oppdatert 25. september 2026, lest 7. oktober 2026. Undersøkelsen dekker bare
        foretak med minst ti sysselsatte: enkeltpersonforetak og de minste bedriftene – altså
        flertallet av dem denne siden er skrevet for – er ikke med i tallet. 2026-tallene følger ny
        næringsstandard (SN2025) og kan ikke sammenlignes direkte med tidligere år.
      </p>
    </Prosa>
  </Seksjon>

  <Seksjon id="i-praksis" tittel="Ett lag som gjør én ting" storrelse="tjeneste">
    <div class="app-praksis">
      <Prosa>
        <p>
          Det som faktisk virker for en småbedrift er smalt og kjedelig: en assistent som
          svarer på de tjue spørsmålene du får hver uke, et verktøy som leser en PDF-faktura
          og fyller ut skjemaet, eller en oppsummering av ukens henvendelser.
        </p>
        <p>
          Det som ikke virker er en chatbot som later som den er en ansatt. Derfor merkes
          alle AI-flater tydelig, de lover aldri priser på egen hånd, og de logger ikke
          sensitive data. Og det skrives databehandleravtale før noe settes i drift.
        </p>
        <p><a href="/sikkerhet">Hvordan vi sikrer det</a></p>
      </Prosa>
      <ol class="app-regler">
        {regler.map((r) => <li>{r}</li>)}
      </ol>
    </div>
  </Seksjon>

  {/* DEMOEN. Står etter reglene med vilje: seksjonene over setter regelen – AI skal gjøre én
      jobb, og den skal merkes – og demoen er den jobben. Teknikken ligger i
      src/components/wow/tjeneste/AiTekst.astro og src/pages/api/ai-tekst.ts; kostnad, tak og
      hemmeligheter står i docs/ai-tekst.md. */}
  <AiTekst />

  <Kontaktblokk />
</MalWow>

<style>
  .app-kobling,
  .app-praksis {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--wow-rom-7) var(--wow-luke);
  }
  /* Et stort nettleservindu og en telefon forskjøvet over hjørnet, som på forsiden. */
  .app-flater {
    position: relative;
    padding-bottom: var(--wow-rom-5);
  }
  .app-flater :global(.app-flater__stor) {
    margin-right: 14%;
  }
  .app-flater :global(.app-flater__liten) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
  }
  .app-flyt {
    margin-top: var(--wow-rom-8);
  }
  .app-caser {
    display: grid;
    gap: var(--wow-rom-3);
    margin: var(--wow-rom-6) 0 0;
  }
  .app-caser > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--wow-rom-1) var(--wow-rom-5);
  }
  .app-caser dt {
    font-weight: 700;
  }
  .app-caser dd {
    margin: 0;
    color: var(--wow-tekst-dempet);
  }
  /* Reglene: nummerert fordi de gjelder i denne rekkefølgen, satt som overskrifter. */
  .app-regler {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: regel;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .app-regler li {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    column-gap: var(--wow-rom-4);
    align-items: baseline;
    padding-block: var(--wow-rom-4);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
    counter-increment: regel;
    font-size: var(--wow-tekst-ingress);
    font-weight: 700;
    line-height: 1.25;
  }
  .app-regler li::before {
    content: counter(regel);
    color: var(--wow-tekst-dempet);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1024px) {
    .app-kobling,
    .app-praksis {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .app-kobling > :global(.wow-prosa),
    .app-praksis > :global(.wow-prosa) {
      grid-column: 1 / 6;
    }
    .app-flater,
    .app-regler {
      grid-column: 6 / 13;
    }
    .app-praksis > .app-regler {
      grid-column: 7 / 13;
    }
    .app-flater :global(.app-flater__stor) {
      margin-right: 0;
      margin-left: 20%;
    }
    .app-flater :global(.app-flater__liten) {
      right: auto;
      left: 0;
      width: 24%;
    }
  }
</style>
