---
/**
 * Artikkel i wow-drakten (wow-undersider.md del 1.7, mønster: cookies-for-samtykke.astro).
 * «rolig»: ingenting beveger seg uten at leseren har gjort noe. Teksten er uendret fra v1.
 */
import MalWow from "../../layouts/MalWow.astro";
import { SideHode, Artikkelkropp, UrlFelt, Sporsmal, Kontaktblokk } from "../../components/wow/side";
import Handlinger from "../../components/wow/side/Handlinger.astro";
import { finnArtikkel } from "../../data/artikler";
import { artikkel, faqSide } from "../../data/schema";
import { firma, orgnrVist } from "../../data/firma";
import { kilde } from "../../data/kilder";
import maalinger from "../../data/maalinger.json";

const a = finnArtikkel("orgnr-pa-nettsiden");
const andel = maalinger.andelProsent;
const utvalg = maalinger.utvalg;

// ÉN liste: den synlige FAQ-en nederst og FAQPage-markupen bygges av den samme (i v1 sto
// spørsmålene bare i markupen). Spørsmål og svar er ordrett de som sto i markupen.
const sporsmaal = [
  {
    q: "Må en norsk nettside ha organisasjonsnummer?",
    a: "Ja, men hjemmelen avhenger av hvilket register du står i. Foretaksregisterloven § 10-2 krever organisasjonsnummer og foretaksnavn på nettsidene til foretak som er registrert i Foretaksregisteret. Et enkeltpersonforetak som bare står i Enhetsregisteret treffes ikke av § 10-2, men ehandelsloven § 8 krever de samme opplysningene av enhver som tilbyr en informasjonssamfunnstjeneste. Aksjeselskaper må i tillegg oppgi registeret foretaket er registrert i, selskapsform og forretningskontor.",
  },
  {
    q: "Hvilken informasjon krever ehandelsloven § 8 på en nettside?",
    a: "Navn, geografisk adresse, e-postadresse og annen informasjon som gjør det mulig å komme i direkte kontakt. I tillegg registeret du er registrert i, organisasjonsnummer, om virksomheten er mva-registrert, og eventuelle nødvendige tillatelser.",
  },
  {
    q: "Hvor på nettsiden skal organisasjonsnummeret stå?",
    a: "Loven sier ikke hvor. Den vanlige løsningen er footeren, fordi den står på alle sider. Kravet er at opplysningene er lett og direkte tilgjengelige, så en kontaktside alene er svakere enn en footer.",
  },
];

// `Article` først, så FAQPage. Datoene kommer fra artikler.ts og er de samme som står i
// brødteksten: `publisert` og datoen innholdet sist ble kontrollert mot kilden.
const schema = [artikkel(a), faqSide(sporsmaal)];

const innhold = [
  { id: "lovene", tittel: "To lover, to ulike krav" },
  { id: "omfang", tittel: "Hvor mange som mangler det" },
  { id: "hvorfor", tittel: "Hvorfor det er verdt å bry seg" },
  { id: "hva-og-hvor", tittel: "Hva som skal stå, og hvor" },
  { id: "sjekk-selv", tittel: "Sjekk din egen side" },
];
---
<MalWow
  tittel={a.tittel}
  beskrivelse={a.beskrivelse}
  schema={schema}
  artikkel={{ publisert: a.publisert, oppdatert: a.oppdatert }}
  ogBilde="forside"
  bevegelse="rolig"
>
  <article>
    <SideHode tittel="Org.nr. på nettsiden" storrelse="tjeneste" bredde="les" brodsmuler />
    <Artikkelkropp
      kortSvar="Det er ikke en anbefaling. Står foretaket i Foretaksregisteret, krever foretaksregisterloven § 10-2 organisasjonsnummer og foretaksnavn på nettsidene. Står det bare i Enhetsregisteret, krever ehandelsloven § 8 det samme. To av tre sider vi målte manglet det."
      publisert={a.publisert}
      oppdatert={a.oppdatert}
      metaTillegg="Dette er ikke juridisk rådgivning."
      innhold={innhold}
    >
      <UrlFelt slot="verktoy" id="url-artikkel" action={a.verktoy!.href} knapp={a.verktoy!.tekst} />

      <h2 id="lovene">To lover, to ulike krav</h2>
      <p>
        Dette blandes sammen hele tiden, så det er verdt å skille dem.
      </p>

      <h3>Foretaksregisterloven § 10-2</h3>
      {/*
        TO FEIL I DETTE AVSNITTET, RETTET 7. OKTOBER 2026.

        1. Lenketeksten var «Paragrafen», men URL-en pekte på HELE loven. Den som
           klikket for å lese § 10-2 landet i en lov på ti kapitler. Nå går den
           rett på paragrafen, med henvisningen fra src/data/kilder.ts.

        2. «Det gjelder alle registrerte foretak» var GALT, og det er den feilen
           som koster mest her: § 10-2 retter seg mot foretak registrert i
           FORETAKSREGISTERET. Et enkeltpersonforetak som bare står i
           Enhetsregisteret treffes ikke – vårt eget er ett av dem
           (`registrertIForetaksregisteret: false`). For dem er hjemmelen
           ehandelsloven § 8. Forbeholdet står ordrett i kilder.ts under
           `foretaksregisterloven-10-2`, og det slutter med «Skriv aldri at
           § 10-2 gjelder alle foretak».
      */}
      <p>
        <a href={kilde("foretaksregisterloven-10-2").url} rel="nofollow">Paragrafen</a>{" "}
        sier at foretakets nettsider, brev og forretningsdokumenter skal inneholde{" "}
        <strong>organisasjonsnummeret og foretaksnavnet</strong>.
        Det gjelder uansett medium – men det gjelder foretak som er registrert i{" "}
        <strong>Foretaksregisteret</strong>, ikke alle som har et
        organisasjonsnummer. Står enkeltpersonforetaket ditt bare i Enhetsregisteret, er
        det ehandelsloven § 8 under som er hjemmelen for deg. Kravet til hva som skal stå
        er i praksis det samme.
      </p>
      <p class="wow-notat">
        Kilde: {kilde("foretaksregisterloven-10-2").henvisning}. Lest {kilde("foretaksregisterloven-10-2").hentet}.
      </p>
      <p>
        Er du aksjeselskap, kommer det mer: du skal også oppgi hvilket register foretaket er
        registrert i, selskapsform, forretningskontor, og eventuelt at selskapet er under
        avvikling. Et enkeltpersonforetak slipper det – der er det bare nummer og navn.
      </p>
      <p>
        Merk at det er det <em>registrerte foretaksnavnet</em> som skal stå, ikke
        merkenavnet du markedsfører deg under. Heter foretaket noe annet i Enhetsregisteret
        enn det som står øverst på siden, er det foretaksnavnet som må med.
      </p>

      <h3>Ehandelsloven § 8</h3>
      <p>
        <a href={kilde("ehandelsloven-8").url} rel="nofollow">Denne</a>{" "}
        gjelder hvis du tilbyr en informasjonssamfunnstjeneste – i praksis nesten enhver
        kommersiell nettside. Den krever at du gir{" "}
        <strong>navn, geografisk adresse, e-postadresse</strong> og annen
        informasjon som gjør det mulig å komme i direkte kontakt med deg. I tillegg registeret
        du står i, organisasjonsnummeret, om du er mva-registrert, og eventuelle tillatelser
        virksomheten krever.
      </p>
      <p>
        «Geografisk adresse» er den som felles flest. En e-postadresse og et kontaktskjema er
        ikke nok. Og et poststed uten gateadresse er heller ikke en geografisk adresse –
        det er noe vi selv står og rydder opp i akkurat nå.
      </p>

      <h3>Er du mva-registrert, skal det stå «MVA»</h3>
      <p>
        Mva-registrerte foretak skal ha bokstavene <code>MVA</code> etter organisasjonsnummeret.
        Ikke er du det, skal de ikke stå der. Dette er en liten detalj som avslører at
        nummeret er kopiert fra et sted det ikke hørte hjemme.
      </p>

      <h2 id="omfang">Hvor mange som mangler det</h2>
      <p>
        Vi skannet {utvalg.trukket} tilfeldig trukne nettsider fra foretak med{" "}
        {utvalg.stoerrelse}. {utvalg.svarte} svarte.{" "}
        <strong>{andel.manglerOrgnr} % hadde ikke organisasjonsnummer på forsiden.</strong>
      </p>
      <p class="wow-notat">
        Forbeholdet som hører med: vi hentet forsiden, ikke hele nettstedet. Står nummeret på
        en egen «Om oss»-side, teller det som manglende her. Det er strengere enn loven, som
        ikke sier hvor opplysningene skal stå – men det er nær det en besøkende faktisk
        opplever, siden få leter.
      </p>
      <p>
        Vi navngir ingen av dem. Metoden, inkludert hva vi ikke har målt, står i{" "}
        <a href="/handbok">håndboken</a>.
      </p>

      <h2 id="hvorfor">Hvorfor det er verdt å bry seg</h2>
      <p>
        Den ærlige grunnen er ikke frykt for tilsyn. Vi kjenner ingen småbedrift som har
        fått bot for dette. Grunnen er at opplysningene gjør deg mulig å kontrollere.
      </p>
      <p>
        En potensiell kunde som vurderer å overføre penger til deg, kan slå opp nummeret i
        Enhetsregisteret og se at foretaket finnes, hvor lenge det har eksistert, og at det
        ikke er under avvikling. Står nummeret ikke der, må de ta deg på ordet. Noen gjør
        det. Andre lukker fanen.
      </p>
      <p>
        Det er også et av de få signalene som skiller en ekte virksomhet fra en nettside
        satt opp på en ettermiddag. Det koster deg én linje.
      </p>

      <h2 id="hva-og-hvor">Hva som skal stå, og hvor</h2>
      <p>
        Loven sier ikke hvor på siden opplysningene skal stå, bare at de skal være lett og
        direkte tilgjengelige. Den praktiske løsningen er footeren, fordi den står på alle
        sider. En kontaktside alene er svakere: den krever at noen leter.
      </p>
      <p>
        Slik ser vår egen ut. Foretaksnavnet er et annet enn merkenavnet, fordi
        foretaksnavnloven § 2-2 krever at et enkeltpersonforetak har innehaverens etternavn i
        navnet – derfor står det bare her, aldri i brødteksten.
      </p>
      {/* `orgnrVist`, ikke `firma.orgnr`. Utsnittet skal vise footeren slik den
          FAKTISK står nederst på siden, og den grupperer tre og tre. Sto nummeret
          her i rå form, viste artikkelen om org.nr.-kravet et org.nr. i en annen
          form enn sidens eget – på den ene siden som ikke tåler det. */}
      {/* V1 hadde et terminalutsnitt her. Det viste verken en måling eller en kommando, bare
          de fire linjene i footeren, og står derfor som en liste (migreringsoppskriften:
          «Terminal som pynt → innholdet som liste eller tekst»). Linjene er de samme. */}
      <ul class="footer-utsnitt" role="list">
        <li>{firma.foretaksnavn}</li>
        <li>org.nr. {orgnrVist}</li>
        <li>{firma.adresse}</li>
        <li>{firma.epost}</li>
      </ul>
      <p>
        Sjekklista er kort:
      </p>
      <ul>
        <li>Registrert foretaksnavn, slik det står i Enhetsregisteret</li>
        <li>Organisasjonsnummer, med <code>MVA</code> etter hvis du er mva-registrert</li>
        <li>Geografisk adresse – gateadresse, ikke bare poststed</li>
        <li>E-postadresse eller et annet direkte kontaktpunkt</li>
        <li>For AS: register, selskapsform og forretningskontor</li>
      </ul>

      <h2 id="sjekk-selv">Sjekk din egen side</h2>
      <p>
        Sjekken vår leter etter et organisasjonsnummer på forsiden, og slår det opp mot
        Enhetsregisteret for å se at det finnes og hvilket foretak det hører til. Den sier
        også fra når den ikke fant en geografisk adresse.
      </p>
      <p>
        Den påstår ikke at det er <em>riktig</em> foretak – bare at nummeret er gyldig og
        hvem det tilhører. Resten må du vurdere selv.
      </p>

      <Fragment slot="etter">
        <Sporsmal liste={sporsmaal} id="sporsmal" tittel="Spørsmål og svar om org.nr. på nettsiden" storrelse="les" innfelt />
        <Handlinger
          handlinger={[
            { tekst: a.verktoy!.tekst, href: a.verktoy!.href, type: "primar" },
            { tekst: "Neste: de 35 WCAG-kravene", href: "/artikler/35-wcag-krav", type: "strek" },
          ]}
        />
      </Fragment>
    </Artikkelkropp>
  </article>

  <Kontaktblokk />
</MalWow>

<style>
  .footer-utsnitt {
    display: grid;
    gap: var(--wow-rom-1);
    margin: 0;
    padding: var(--wow-rom-4) var(--wow-rom-5);
    border: var(--wow-kant-1) solid var(--wow-linje);
    border-radius: var(--wow-radius-s);
    background: var(--wow-flate);
    list-style: none;
    font-size: var(--wow-tekst-liten);
    line-height: 1.5;
  }
</style>
