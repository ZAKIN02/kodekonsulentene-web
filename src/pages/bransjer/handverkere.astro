---
/**
 * /bransjer/handverkere i wow-drakten (wow-undersider.md del 1.4 og del 4, wow-r8-B1).
 * Rekkefølge: kapittel 3 som stillbilde (rørleggeren) → tallene fra SSB, med kilde og forbehold,
 * og flyten → demo (ekte rekkefølge, id «demo») → «Det du allerede betaler for» → «Sjekk den
 * siden du har» → kontakt med sidens egen tittel.
 * Ute fra v1: terminalutsnittet (tallene står som tall), det genererte stillbildet med seksjonen
 * som viste det, og løpenumrene 01–04.
 */
import MalWow from "../../layouts/MalWow.astro";
import { Seksjon, Prosa, Flyt, Steg, Tekstrader, UrlFelt, Kontaktblokk } from "../../components/wow/side";
import Kapittel from "../../components/wow/Kapittel.astro";
import { kapittelForhandslast } from "../../scripts/wow/kapittel-klipp";
import { flyter } from "../../data/flyter";
import { bookUrl } from "../../data/firma";
import { tjeneste } from "../../data/schema";
import { pakker, prisenhet } from "../../data/priser";
import { kilde } from "../../data/kilder";

/** SSB-tabellen de to tallene i denne seksjonen står i. Se kommentaren ved bruken. */
const ssb = kilde("ssb-14933");
/** «7. oktober 2026» av «2026-10-07». En ISO-dato midt i en setning leses ikke. */
const norskDato = (iso: string): string =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("nb-NO", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const steg = [
  { navn: "Kunden fyller ut", naar: "Fra telefonen", tekst: "Fire felt og tre bilder fra telefonen. Ikke et kontaktskjema – en befaringsforespørsel." },
  { navn: "Du får varsel", naar: "Straks", tekst: "Push eller SMS med adresse, bilder og beskrivelse. Du ser om det er verdt turen før du setter deg i bilen." },
  { navn: "Du foreslår tid", naar: "1 klikk", tekst: "Kunden velger blant tidene du faktisk har ledig. Ingen telefonrunde." },
  { navn: "Tilbudet går ut", naar: "Samme dag", tekst: "Mal med dine priser, signert digitalt. Blir det ja, ligger ordren i regnskapet." },
];

const kobles = [
  { tittel: "Tripletex og Fiken", tekst: "Godtatt tilbud blir ordre blir faktura. Ingen taster timene inn på nytt om kvelden." },
  { tittel: "Vipps", tekst: "Depositum eller sluttbetaling med én skanning. Norske kunder forventer det." },
  { tittel: "Mittanbud", tekst: "Siden din er det kunden sjekker etter at de har sett deg der. Da bør den si noe mer enn navnet ditt." },
  { tittel: "SMS og push", tekst: "Varselet om ny befaring kommer dit du faktisk ser det, ikke i en innboks du leser om kvelden." },
];

/** Fra `tjeneste()`. */
const schema = tjeneste({
  type: "Nettside og befaringssystem for håndverkere",
  navn: "Nettside og befaringssystem for håndverkere",
  beskrivelse:
    "Befaringsforespørsel med bilder fra kunden, tilbud samme dag og ordre rett i Tripletex eller Fiken.",
  sti: "/bransjer/handverkere",
  pakker: ["Start", "Bedrift"],
});
---

<MalWow
  tittel="Nettside for håndverkere i Oslo"
  beskrivelse={`Nettside og befaringssystem for håndverkere: bilder fra kunden, tilbud samme dag, ordre rett i Tripletex eller Fiken. Fast pris fra ${pakker[0].pris} – ${prisenhet}.`}
  schema={[schema]}
  bevegelse="film"
  forhandslast={kapittelForhandslast(3, "still")}
>
  {/* Problem og løsning på platen er setninger som allerede står på siden (planen del 4):
      ingressens første setning og beskrivelsen i schemaet. */}
  <Kapittel
    nummer={3}
    modus="still"
    tittel="Slutt å kjøre på befaring du ikke ville tatt"
    ingress="De fleste håndverkersider er et telefonnummer og et skjema. Det gir deg forespørsler du må ringe tilbake på for å finne ut om de er noe verdt."
    problem="De fleste håndverkersider er et telefonnummer og et skjema."
    losning="Befaringsforespørsel med bilder fra kunden, tilbud samme dag og ordre rett i Tripletex eller Fiken."
    handlinger={[
      { tekst: "Book 20 minutter", href: bookUrl, type: "primar" },
      { tekst: "Se befaringsflyten", href: "#demo", type: "lenke" },
    ]}
  />

  <Seksjon id="tallene" tittel="Bransjen henger etter – det er en fordel for deg" storrelse="stor">
    <div class="bransje-tall">
      {/* De to tallene fra SSB, satt som tall. Etikettene sier hvem tallet gjelder. */}
      <dl class="bransje-tall__tall">
        <div>
          <dt>Bygg og anlegg, 10–19 ansatte</dt>
          <dd>72 %</dd>
        </div>
        <div>
          <dt>Alle foretak med minst ti ansatte</dt>
          <dd>86 %</dd>
        </div>
      </dl>
      <Prosa>
        <p>
          SSB oppgir at 72 % av foretakene i bygg og anlegg med 10–19 ansatte har nettside.
          Snittet for alle foretak med minst ti ansatte er 86 %.
        </p>
        <p>
          Det betyr to ting. For det første at omtrent én av fire konkurrenter på din
          størrelse ikke har noe å bli funnet på i det hele tatt. For det andre at listen
          for å ligge øverst lokalt er lavere i din bransje enn i de fleste andre.
        </p>
        {/*
          HENVISNINGEN SA «SSB», OG DET ER IKKE NOK (v1). Tallene 72 % og 86 % er riktige. SSB
          flyttet 2026-tallene fra tabell 10975 (SN2007) til tabell 14933 (SN2025), og de to
          tabellene gir ulike tall for samme næring. Henvisningen hentes fra `ssb-14933` i
          src/data/kilder.ts med tabellnummer, næringsstandard og dato, og forbeholdene står
          ordrett fra samme oppføring. test/kilder.test.ts krever at henvisningen bærer både
          14933 og SN2025.
        */}
        <p class="wow-notat">
          Kilde: <a href={ssb.url} rel="nofollow">{ssb.henvisning}</a>.
          Lest {norskDato(ssb.hentet)}.
        </p>
        <ul class="wow-notat">
          {ssb.forbehold?.slice(0, 2).map((f) => <li>{f}</li>)}
        </ul>
      </Prosa>
    </div>

    {/* Diagram med EKTE navn på systemene, ikke abstrakte former. */}
    <div class="bransje-flyt">
      <Flyt flyt={flyter.handverkere} />
    </div>
  </Seksjon>

  <Seksjon
    id="demo"
    tittel="Befaring uten telefonrunde"
    ingress="Dette er flyten vi bygger for håndverkere. Den er ikke en kontaktside med flere felt – den er laget for å sortere bort turene du ikke vil ha."
    storrelse="tjeneste"
    tone="flate"
  >
    <Steg steg={steg} />
    <div class="bransje-se">
      <h3 class="bransje-se__tittel">Se den på skjerm</h3>
      <p class="bransje-se__tekst">
        Vi går gjennom flyten med deg i stedet for å beskrive den her. Da ser du
        feltene, varselet og tilbudsmalen med dine egne priser i.
      </p>
      <a class="wow-knapp wow-knapp--strek" href="/kontakt" data-magnetic>
        <span class="wow-knapp__tekst" data-magnetic-tekst>Be om en gjennomgang</span>
      </a>
    </div>
  </Seksjon>

  <Seksjon id="kobles" tittel="Det du allerede betaler for" storrelse="tjeneste">
    <Tekstrader rader={kobles} />
  </Seksjon>

  <Seksjon
    id="start"
    tittel="Sjekk den siden du har"
    ingress="Før vi snakker om ny side: kjør den gratis sjekken. Mangler org.nr. eller settes det cookies før samtykke, er det raskt fikset – og det er billigere enn en ny side."
    storrelse="stor"
    tone="flate"
  >
    <UrlFelt id="url-bransje" knapp="Kjør sjekken" hint="30 sekunder. Du ser hva som er galt før du bruker penger." />
  </Seksjon>

  <Kontaktblokk
    tittel="Ring, så tar vi det på fem minutter"
    ingress="Vi vet hva en befaring koster deg i tid. Fortell hvor mange forespørsler du får i uka, så regner vi på om dette lønner seg."
  />
</MalWow>

<style>
  .bransje-tall {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--wow-rom-7) var(--wow-luke);
  }
  .bransje-tall__tall {
    display: grid;
    gap: var(--wow-rom-5);
    align-content: start;
    margin: 0;
  }
  .bransje-tall__tall > div {
    display: grid;
    gap: var(--wow-rom-2);
    padding-top: var(--wow-rom-4);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .bransje-tall__tall dt {
    color: var(--wow-tekst-dempet);
  }
  .bransje-tall__tall dd {
    margin: 0;
    font-family: var(--wow-font-display);
    font-size: var(--wow-tekst-tall);
    font-weight: var(--wow-display-vekt);
    font-stretch: var(--wow-display-bredde);
    font-variant-numeric: tabular-nums;
    line-height: var(--wow-display-linje);
  }
  .bransje-flyt {
    margin-top: var(--wow-rom-8);
  }
  .bransje-se {
    display: grid;
    gap: var(--wow-rom-4);
    justify-items: start;
    margin-top: var(--wow-rom-7);
    padding-top: var(--wow-rom-5);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .bransje-se__tittel {
    font-size: var(--wow-tekst-h3);
    font-weight: 700;
    line-height: 1.15;
  }
  .bransje-se__tekst {
    max-width: var(--wow-maal-brod);
    color: var(--wow-tekst-dempet);
  }
  @media (min-width: 1024px) {
    .bransje-tall {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .bransje-tall__tall {
      grid-column: 1 / 6;
    }
    .bransje-tall > :global(.wow-prosa) {
      grid-column: 6 / 13;
    }
    .bransje-se {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--wow-luke);
    }
    .bransje-se__tittel {
      grid-column: 1 / 6;
    }
    .bransje-se__tekst,
    .bransje-se > .wow-knapp {
      grid-column: 6 / 13;
    }
  }
</style>
