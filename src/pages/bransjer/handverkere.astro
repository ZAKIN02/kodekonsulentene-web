---
import Base from "../../layouts/Base.astro";
import Scene from "../../components/Scene.astro";
import Mega from "../../components/Mega.astro";
import Avslor from "../../components/Avslor.astro";
import Button from "../../components/Button.astro";
import Terminal from "../../components/Terminal.astro";
import UrlCheck from "../../components/UrlCheck.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import Stillbilde from "../../components/Stillbilde.astro";
import Horisont from "../../components/Horisont.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import { bookUrl } from "../../data/firma";

import "../../styles/scener.css";

const steg = [
  { title: "Kunden fyller ut", time: "2 vår", text: "Fire felt og tre bilder fra telefonen. Ikke et kontaktskjema – en befaringsforespørsel." },
  { title: "Du får varsel", time: "Straks", text: "Push eller SMS med adresse, bilder og beskrivelse. Du ser om det er verdt turen før du setter deg i bilen." },
  { title: "Du foreslår tid", time: "1 klikk", text: "Kunden velger blant tidene du faktisk har ledig. Ingen telefonrunde." },
  { title: "Tilbudet går ut", time: "Samme dag", text: "Mal med dine priser, signert digitalt. Blir det ja, ligger ordren i regnskapet." },
];

const kobles = [
  { nr: "01", tittel: "Tripletex og Fiken", tekst: "Godtatt tilbud blir ordre blir faktura. Ingen taster timene inn på nytt om kvelden." },
  { nr: "02", tittel: "Vipps", tekst: "Depositum eller sluttbetaling med én skanning. Norske kunder forventer det." },
  { nr: "03", tittel: "Mittanbud", tekst: "Siden din er det kunden sjekker etter at de har sett deg der. Da bør den si noe mer enn navnet ditt." },
  { nr: "04", tittel: "SMS og push", tekst: "Varselet om ny befaring kommer dit du faktisk ser det, ikke i en innboks du leser om kvelden." },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Nettside og befaringssystem for håndverkere",
  provider: { "@type": "ProfessionalService", name: "KodeKonsulentene" },
  areaServed: { "@type": "City", name: "Oslo" },
};
---
<Base
  tittel="Nettside for håndverkere i Oslo"
  beskrivelse="Nettside og befaringssystem for håndverkere: bilder fra kunden, tilbud samme dag, ordre rett i Tripletex eller Fiken. Fast pris fra 14 900 kr eks. mva."
  schema={[schema]}
>
  <Scene lav>
    <Mega som="h1" merke="Håndverkere" n={1} tekst="Slutt å kjøre på befaring du ikke ville tatt" aksent="befaring" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">De fleste håndverkersider er et telefonnummer og et skjema. Det gir deg forespørsler du må ringe tilbake på for å finne ut om de er noe verdt.</p>
    </Avslor>

    <Avslor>
    <div class="row">
      <Button variant="primary" href={bookUrl}>Book 20 minutter</Button>
      <Button variant="ghost" href="#demo">Se befaringsflyten</Button>
    </div>
    </Avslor>
  </Scene>

  <Scene n={2} eyebrow="Tallene" tittel="Bransjen henger etter – det er en fordel for deg">
    <Avslor>
    <div class="grid-2">
      <div class="stack">
        <p class="body-lg muted">
          SSB oppgir at 72 % av foretakene i bygg og anlegg med 10–19 ansatte har nettside.
          Snittet for alle foretak med minst ti ansatte er 86 %.
        </p>
        <p class="muted">
          Det betyr to ting. For det første at omtrent én av fire konkurrenter på din
          størrelse ikke har noe å bli funnet på i det hele tatt. For det andre at listen
          for å ligge øverst lokalt er lavere i din bransje enn i de fleste andre.
        </p>
        <p class="small faint">
          Kilde: SSB, bruk av IKT i næringslivet. Tallene gjelder foretak med minst ti
          sysselsatte, så enkeltpersonforetak og de minste bedriftene er ikke med.
          2026-tallene bruker ny næringsstandard og kan ikke sammenlignes direkte med
          tidligere år.
        </p>
      </div>
      <Terminal
        skriv
        title="~/bransje/bygg"
        lines={[
          { type: "cmd", text: "nettsidedekning --bransje=bygg --ansatte=10-19" },
          { type: "warn", text: "72 %" },
          { type: "cmd", text: "nettsidedekning --alle --ansatte=10+" },
          { type: "out", text: "86 %" },
          { type: "cmd", text: "echo $GAP" },
          { type: "ok", text: "14 prosentpoeng å ta" },
        ]}
        label="Terminalutsnitt: nettsidedekning i bygg og anlegg for foretak med ti til nitten ansatte er 72 prosent, mot 86 prosent for alle foretak med minst ti ansatte. Gapet er fjorten prosentpoeng."
      />
    </div>
    </Avslor>
  </Scene>

  <Scene n={3} eyebrow="Forespørslene" tittel="Slik ser de ut før noen har sett på dem">
    <Avslor>
      <p class="body-lg muted">
        Sju forespørsler i uka er sju like anonyme klumper til noen gjør jobben med å
        skille dem. Den jobben gjør du i dag på telefon, etter at du har kjørt.
      </p>
      <Stillbilde id="bransje-handverk" sizes="(min-width: 1120px) 1120px, 100vw" />
    </Avslor>
  </Scene>

  <Scene
    n={4}
    eyebrow="Demo"
    tittel="Befaring uten telefonrunde"
    ingress="Dette er flyten vi bygger for håndverkere. Den er ikke en kontaktside med flere felt – den er laget for å sortere bort turene du ikke vil ha."
    id="demo"
  >
    <ProcessSteps steps={steg} />
    <div class="card" style="margin-top: var(--space-6)">
      <h3 class="heading">Se den på skjerm</h3>
      <p class="muted">
        Vi går gjennom flyten med deg i stedet for å beskrive den her. Da ser du
        feltene, varselet og tilbudsmalen med dine egne priser i.
      </p>
      <Button variant="secondary" href="/kontakt">Be om en gjennomgang</Button>
    </div>
  </Scene>

  <Horisont
    n={5}
    merke="Kobles mot"
    tittel="Det du allerede betaler for"
    navn="Systemer vi kobler siden mot"
    poster={kobles}
  />

  <Scene n={6} eyebrow="Start her" tittel="Sjekk den siden du har" ingress="Før vi snakker om ny side: kjør den gratis sjekken. Mangler org.nr. eller settes det cookies før samtykke, er det raskt fikset – og det er billigere enn en ny side.">
    <UrlCheck buttonLabel="Kjør sjekken" hint="30 sekunder. Du ser hva som er galt før du bruker penger." />
  </Scene>

  <ContactBlock n={7} tittel="Ring, så tar vi det på fem minutter" ingress="Vi vet hva en befaring koster deg i tid. Fortell hvor mange forespørsler du får i uka, så regner vi på om dette lønner seg." />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
