---
import Base from "../../layouts/Base.astro";
import Flyt from "../../components/Flyt.astro";
import { flyter } from "../../data/flyter";
import Scene from "../../components/Scene.astro";
import Mega from "../../components/Mega.astro";
import Avslor from "../../components/Avslor.astro";
import Button from "../../components/Button.astro";
import Terminal from "../../components/Terminal.astro";
import UrlCheck from "../../components/UrlCheck.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import SceneFilm from "../../components/SceneFilm.astro";
import Pekerkort from "../../components/Pekerkort.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import { bookUrl } from "../../data/firma";

import "../../styles/scener.css";

const steg = [
  { title: "Kunden booker selv", time: "Døgnet rundt", text: "Ledige timer per behandler og behandlingstype. De fleste bestillinger kommer utenom åpningstiden." },
  { title: "Betaler ved bestilling", time: "Vipps", text: "Forskuddsbetaling eller depositum. Det alene fjerner mesteparten av de som ikke møter opp." },
  { title: "Påminnelse går ut", time: "24 t før", text: "SMS med tid, behandler og avbestillingslenke. Avbestiller de, frigis timen automatisk." },
  { title: "Oppgjøret stemmer", time: "Automatisk", text: "Betalingen ligger som ordre i regnskapet. Ingen avstemming av Vipps mot timeboken." },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Bookingsystem og nettside for klinikker og treningssentre",
  provider: { "@type": "ProfessionalService", name: "KodeKonsulentene" },
  areaServed: { "@type": "City", name: "Oslo" },
};
---
<Base
  tittel="Nettside og booking for klinikker"
  beskrivelse="Timebestilling, Vipps-betaling, SMS-påminnelse og medlemsregister for klinikker, treningssentre og kampsportklubber i Oslo. System fra 60 000 kr eks. mva."
  schema={[schema]}
>
  <Scene lav>
    <Mega som="h1" merke="Klinikker og trening" n={1} tekst="Timer som bestilles mens dere er stengt" aksent="stengt" storrelse="stor" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Telefonbestilling betyr at dere bare kan selge timer i åpningstiden, og at noen må avbryte en behandling for å ta telefonen.</p>
    </Avslor>

    <Avslor>
    <div class="row">
      <Button variant="primary" href={bookUrl}>Book 20 minutter</Button>
      <Button variant="ghost" href="#demo">Se bookingflyten</Button>
    </div>
    </Avslor>
  </Scene>

  {/* Filmen ERSTATTER stillbildet som lå i scenen over. Første ramme av klippet er
      nøyaktig den komposisjonen stillbildet viste – en målestokk der de aller fleste
      feltene står tomme – og gjennom klippet fylles de.

      Den ligger i «Problemet» og ikke i «Fra bestilling til oppgjør», selv om den
      sistnevnte passer bedre tematisk. Grunnen er målt: demo-scenen er fire
      tekstkolonner i full bredde, og kolonne 03 og 04 havner rett oppå skinnen.
      Kontrast mot FAKTISKE piksler der: 1,23:1. Her skjermer terminalkortet den
      lyseste delen av motivet, og teksten står i den klare venstre halvdelen. */}
  <div class="scenefilm-ramme">
    <SceneFilm
      smal="/scener/lev2-klinikk-960.mp4"
      bred="/scener/lev2-klinikk-1280.mp4"
      stor="/scener/lev2-klinikk-1920.mp4"
      plakat="/scener/lev2-klinikk-poster.avif"
      tekst="venstre"
    />
  <Scene n={2} eyebrow="Problemet" tittel="Tre tall dere kjenner igjen">
    <Avslor>
    <div class="grid-2">
      <div class="stack">
        {/* Tankestrek, ikke «TODO». Intensjonen er den samme – vi finner ikke på
            kundens tall – men TODO er et internt notat, og det sto på en salgsside.
            Samme redaksjonelle linje som /caser, der tomheten forklares i stedet
            for å skjules. */}
        <dl class="kv">
          <div><dt>Timer brukt på telefon i uka</dt><dd aria-label="Ikke utfylt">–</dd></div>
          <div><dt>Timer som ikke møtes opp</dt><dd aria-label="Ikke utfylt">–</dd></div>
          <div><dt>Tid på avstemming per måned</dt><dd aria-label="Ikke utfylt">–</dd></div>
        </dl>
        <p class="muted">
          Radene står tomme fordi tallene er deres, ikke våre. Vi kunne satt inn et
          bransjesnitt og latt det se ut som en analyse, men da hadde dere tatt en
          beslutning på et tall vi fant på. Fyll dem ut i samtalen, så regner vi
          sammen på hva systemet må spare for å lønne seg. Blir svaret at det ikke
          lønner seg, sier vi det.
        </p>
      </div>
      <Terminal
        skriv
        title="~/bransje/klinikk"
        lines={[
          { type: "cmd", text: "når bestiller folk time" },
          { type: "out", text: "mest kveld og helg" },
          { type: "cmd", text: "når tar dere telefonen" },
          { type: "warn", text: "hverdager 09–16" },
          { type: "cmd", text: "echo $PROBLEM" },
          { type: "fail", text: "dere selger når kundene ikke kjøper" },
        ]}
        label="Terminalutsnitt: folk bestiller time mest kveld og helg, men klinikken tar telefonen hverdager ni til seksten. Problemet er at dere selger når kundene ikke kjøper."
      />
    </div>
    </Avslor>

    <Avslor trinn={2}>
      {/* Diagram med EKTE navn på systemene, ikke abstrakte former. Brandboken
          rangerer dette over generert materiale: det forklarer hva kunden får,
          og koster 0 kB. */}
      <Flyt flyt={flyter.klinikker} />
    </Avslor>
  </Scene>
  </div>

  <Scene
    n={3}
    eyebrow="Demo"
    tittel="Fra bestilling til oppgjør"
    ingress="Fire steg som skjer uten at noen i resepsjonen gjør noe. Det er dette som skiller et system fra en nettside med et skjema."
    id="demo"
  >
    <ProcessSteps steps={steg} />
    <div class="card" style="margin-top: var(--space-6)">
      <h3 class="heading">Se den på skjerm</h3>
      <p class="muted">
        Vi går gjennom flyten med dere på skjerm i stedet for å beskrive den her.
        Da ser dere kalenderen, betalingen og påminnelsen med deres egne tider i.
      </p>
      <Button variant="secondary" href="/kontakt">Be om en gjennomgang</Button>
    </div>
  </Scene>

  <Scene n={4} eyebrow="Også aktuelt" tittel="Medlemmer, ikke bare timer">
    <Avslor>
    <div class="grid-3">
      <Pekerkort nr={1} tittel="Medlemsregister" tekst="Månedstrekk, frysing av medlemskap og oversikt over hvem som faktisk møter opp. Aktuelt for treningssentre og kampsportklubber." />
      <Pekerkort nr={2} tittel="Medlemsapp" tekst="Booking av gruppetimer, innsjekk og varsler. Vi lager både nettsiden og appen, så det er ett system og ikke to." />
      <Pekerkort nr={3} tittel="Journal og personvern" tekst="Behandler dere helseopplysninger, gjelder strengere krav. Da settes det opp med databehandleravtale og tilgangsstyring fra start." />
    </div>
    </Avslor>
  </Scene>

  <Scene n={5} eyebrow="Start her" tittel="Sjekk den siden dere har" ingress="Mange klinikksider laster Google Analytics før samtykke. Det bryter ekomloven § 3-15, og det er fikset på en ettermiddag.">
    <UrlCheck buttonLabel="Kjør sjekken" hint="30 sekunder. Gratis, uten innlogging." />
  </Scene>

  <ContactBlock n={6} tittel="Ta en prat før dere bytter system" ingress="Har dere allerede et bookingsystem dere betaler for, er ofte svaret å koble det sammen med resten i stedet for å bytte. Det sier vi gjerne før dere kjøper noe." />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

</style>
