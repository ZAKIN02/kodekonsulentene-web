---
/**
 * /bransjer/klinikker i wow-drakten (wow-undersider.md del 1.4 og del 4, wow-r8-B1).
 * Rekkefølge: kapittel 2 som stillbilde (kontoret) → «Tre tall dere kjenner igjen» (radene står
 * tomme med vilje) og flyten → demo (ekte rekkefølge, id «demo») → «Medlemmer, ikke bare timer»
 * → «Sjekk den siden dere har» → kontakt med sidens egen tittel.
 * Ute fra v1: bakgrunnsfilmen, terminalutsnittet (påstander om når folk bestiller, som ikke er
 * målt) og løpenumrene på kortene.
 */
import MalWow from "../../layouts/MalWow.astro";
import { Seksjon, Prosa, Flyt, Steg, Tekstrader, UrlFelt, Kontaktblokk } from "../../components/wow/side";
import Kapittel from "../../components/wow/Kapittel.astro";
import { kapittelForhandslast } from "../../scripts/wow/kapittel-klipp";
import { flyter } from "../../data/flyter";
import { bookUrl } from "../../data/firma";
import { tjeneste } from "../../data/schema";
import { pakker, prisenhet } from "../../data/priser";

/* «Eks. mva» traff hardest nettopp her: merverdiavgiftsloven § 3-2 unntar
   helsetjenester fra avgift, og unntaket gir ingen fradragsrett. En klinikk som
   leser «eks. mva» regner 25 % reell merkostnad – på en pris det ikke engang
   påløper avgift på. Se src/data/priser.ts og kilden `mval-3-2` i kilder.ts. */
const systemPris = pakker.find((p) => p.navn === "System")?.pris ?? "";

/**
 * TO PÅSTANDER ER FJERNET FRA STEGENE UNDER (v1).
 *
 * «De fleste bestillinger kommer utenom åpningstiden» og «Det alene fjerner
 * mesteparten av de som ikke møter opp» er begge kvantifiserte funn om hva som
 * skjer hos en klinikk. Vi har ikke målt noen av dem: `booking-demo` i
 * src/data/caser.ts er merket «Ikke et levert oppdrag». Et tall uten tallsymbol
 * er fortsatt et tall. Begge er erstattet med det systemet GJØR. Ingen av
 * formuleringene lover en effekt.
 */
const steg = [
  { navn: "Kunden booker selv", naar: "Døgnet rundt", tekst: "Ledige timer per behandler og behandlingstype, også når dere er stengt og ingen kan ta telefonen." },
  { navn: "Betaler ved bestilling", naar: "Vipps", tekst: "Forskuddsbetaling eller depositum, slik at den som bestiller har noe å miste på å ikke møte opp." },
  { navn: "Påminnelse går ut", naar: "24 t før", tekst: "SMS med tid, behandler og avbestillingslenke. Avbestiller de, frigis timen automatisk." },
  { navn: "Oppgjøret stemmer", naar: "Automatisk", tekst: "Betalingen ligger som ordre i regnskapet. Ingen avstemming av Vipps mot timeboken." },
];

/** Radene står tomme fordi tallene er klinikkens, ikke våre. */
const tall = ["Timer brukt på telefon i uka", "Timer som ikke møtes opp", "Tid på avstemming per måned"];

const medlemmer = [
  { tittel: "Medlemsregister", tekst: "Månedstrekk, frysing av medlemskap og oversikt over hvem som faktisk møter opp. Aktuelt for treningssentre og kampsportklubber." },
  { tittel: "Medlemsapp", tekst: "Booking av gruppetimer, innsjekk og varsler. Vi lager både nettsiden og appen, så det er ett system og ikke to." },
  { tittel: "Journal og personvern", tekst: "Behandler dere helseopplysninger, gjelder strengere krav. Da settes det opp med databehandleravtale og tilgangsstyring fra start." },
];

/** Fra `tjeneste()`, ikke skrevet her. `provider` peker på `/#foretak`, den ene med org.nr. */
const schema = tjeneste({
  type: "Bookingsystem og nettside for klinikker og treningssentre",
  navn: "Nettside og bookingsystem for klinikker",
  beskrivelse:
    "Timebestilling, Vipps-betaling, SMS-paaminnelse og medlemsregister for klinikker, treningssentre og kampsportklubber.",
  sti: "/bransjer/klinikker",
  pakker: ["System"],
});
---

<MalWow
  tittel="Nettside og booking for klinikker"
  beskrivelse={`Timebestilling, Vipps-betaling, SMS-påminnelse og medlemsregister for klinikker, treningssentre og kampsportklubber i Oslo. System fra ${systemPris} – ${prisenhet}.`}
  schema={[schema]}
  bevegelse="film"
  forhandslast={kapittelForhandslast(2, "still")}
>
  {/* Problem og løsning på platen er setninger som allerede står på siden (planen del 4):
      ingressen, og tjenestene fra metabeskrivelsen. */}
  <Kapittel
    nummer={2}
    modus="still"
    tittel="Timer som bestilles mens dere er stengt"
    ingress="Telefonbestilling betyr at dere bare kan selge timer i åpningstiden, og at noen må avbryte en behandling for å ta telefonen."
    problem="Telefonbestilling betyr at dere bare kan selge timer i åpningstiden."
    losning="Timebestilling, Vipps-betaling, SMS-påminnelse og medlemsregister."
    handlinger={[
      { tekst: "Book 20 minutter", href: bookUrl, type: "primar" },
      { tekst: "Se bookingflyten", href: "#demo", type: "lenke" },
    ]}
  />

  <Seksjon id="tallene" tittel="Tre tall dere kjenner igjen" storrelse="stor">
    <div class="bransje-tall">
      {/* Tankestrek, ikke et oppdiktet bransjesnitt. Skjermlesere får «Ikke utfylt». */}
      <dl class="bransje-tall__rader">
        {tall.map((t) => (
          <div>
            <dt>{t}</dt>
            <dd><span aria-hidden="true">–</span><span class="wow-usynlig">Ikke utfylt</span></dd>
          </div>
        ))}
      </dl>
      <Prosa>
        <p>
          Radene står tomme fordi tallene er deres, ikke våre. Vi kunne satt inn et
          bransjesnitt og latt det se ut som en analyse, men da hadde dere tatt en
          beslutning på et tall vi fant på. Fyll dem ut i samtalen, så regner vi
          sammen på hva systemet må spare for å lønne seg. Blir svaret at det ikke
          lønner seg, sier vi det.
        </p>
      </Prosa>
    </div>

    {/* Diagram med EKTE navn på systemene, ikke abstrakte former. */}
    <div class="bransje-flyt">
      <Flyt flyt={flyter.klinikker} />
    </div>
  </Seksjon>

  <Seksjon
    id="demo"
    tittel="Fra bestilling til oppgjør"
    ingress="Fire steg som skjer uten at noen i resepsjonen gjør noe. Det er dette som skiller et system fra en nettside med et skjema."
    storrelse="tjeneste"
    tone="flate"
  >
    <Steg steg={steg} />
    <div class="bransje-se">
      <h3 class="bransje-se__tittel">Se den på skjerm</h3>
      <p class="bransje-se__tekst">
        Vi går gjennom flyten med dere på skjerm i stedet for å beskrive den her.
        Da ser dere kalenderen, betalingen og påminnelsen med deres egne tider i.
      </p>
      <a class="wow-knapp wow-knapp--strek" href="/kontakt" data-magnetic>
        <span class="wow-knapp__tekst" data-magnetic-tekst>Be om en gjennomgang</span>
      </a>
    </div>
  </Seksjon>

  <Seksjon id="medlemmer" tittel="Medlemmer, ikke bare timer" storrelse="tjeneste">
    <Tekstrader rader={medlemmer} />
  </Seksjon>

  <Seksjon
    id="start"
    tittel="Sjekk den siden dere har"
    ingress="Mange klinikksider laster Google Analytics før noen har klikket i samtykkebanneret. Om det er et lovbrudd, kommer an på hva som faktisk lagres – og det er nettopp det sjekken måler."
    storrelse="stor"
    tone="flate"
  >
    <UrlFelt id="url-bransje" knapp="Kjør sjekken" hint="30 sekunder. Gratis, uten innlogging." />
  </Seksjon>

  <Kontaktblokk
    tittel="Ta en prat før dere bytter system"
    ingress="Har dere allerede et bookingsystem dere betaler for, er ofte svaret å koble det sammen med resten i stedet for å bytte. Det sier vi gjerne før dere kjøper noe."
  />
</MalWow>

<style>
  .bransje-tall {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--wow-rom-7) var(--wow-luke);
  }
  .bransje-tall__rader {
    margin: 0;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .bransje-tall__rader > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wow-rom-5);
    padding-block: var(--wow-rom-4);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .bransje-tall__rader dt {
    font-size: var(--wow-tekst-ingress);
    font-weight: 700;
    line-height: 1.25;
  }
  .bransje-tall__rader dd {
    position: relative;
    margin: 0;
    color: var(--wow-tekst-dempet);
    font-family: var(--wow-font-display);
    font-size: var(--wow-tekst-h3);
    font-weight: var(--wow-display-vekt);
  }
  .bransje-flyt {
    margin-top: var(--wow-rom-8);
  }
  .bransje-se {
    display: grid;
    gap: var(--wow-rom-4);
    justify-items: start;
    margin-top: var(--wow-rom-7);
    padding-top: var(--wow-rom-5);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .bransje-se__tittel {
    font-size: var(--wow-tekst-h3);
    font-weight: 700;
    line-height: 1.15;
  }
  .bransje-se__tekst {
    max-width: var(--wow-maal-brod);
    color: var(--wow-tekst-dempet);
  }
  @media (min-width: 1024px) {
    .bransje-tall {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .bransje-tall__rader {
      grid-column: 1 / 7;
    }
    .bransje-tall > :global(.wow-prosa) {
      grid-column: 8 / 13;
    }
    .bransje-se {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--wow-luke);
    }
    .bransje-se__tittel {
      grid-column: 1 / 6;
    }
    .bransje-se__tekst,
    .bransje-se > .wow-knapp {
      grid-column: 6 / 13;
    }
  }
</style>
