---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { caser } from "../data/caser";
---
<Base
  tittel="Caser"
  beskrivelse="Problem, løsning og resultat med tall. Egne iOS-apper, demo-systemer og konseptarbeid fra KodeKonsulentene i Oslo."
>
  <Section
    n={1}
    eyebrow="Caser"
    tittel="Problem, løsning, resultat"
    ingress="Hver case sier hva som var problemet, hva jeg bygde, og hva det ga i tall. Konseptarbeid er alltid merket, slik at du vet hva som er oppdrag og hva som er øvelse."
  >
    <div class="stack">
      {caser.map((c) => (
        <article class="card">
          <div class="row" style="justify-content: space-between">
            <Eyebrow>{c.type}</Eyebrow>
            <span class="mono faint">{c.kunde}</span>
          </div>
          <h2 class="heading">{c.tittel}</h2>
          <div class="grid-2">
            <div class="stack stack--tight">
              <p class="muted"><strong class="body-strong">Problem.</strong> {c.problem}</p>
              <p class="muted"><strong class="body-strong">Løsning.</strong> {c.losning}</p>
              <p class="mono faint">{c.stack.join(" · ")}</p>
            </div>
            <dl class="kv">
              {c.resultat.map((r) => (
                <div><dt>{r.tekst}</dt><dd>{r.verdi}</dd></div>
              ))}
            </dl>
          </div>
          {c.href && <Button variant="ghost" href={c.href}>Se mer</Button>}
        </article>
      ))}
    </div>
  </Section>

  <ContactBlock n={2} tittel="Vil du bli den neste?" ingress="Jeg tar inn to til tre pilotprosjekter til redusert pris mot at jeg får bruke tallene som case. Si fra hvis det er aktuelt." />
</Base>
