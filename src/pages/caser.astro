---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Demo from "../components/Demo.astro";
import SceneFilm from "../components/SceneFilm.astro";
import Horisont from "../components/Horisont.astro";
import Button from "../components/Button.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { synligeCaser } from "../data/caser";

// Siden viser én case. Det er ikke en feil – synligeCaser filtrerer bort alt som
// ennå inneholder TODO, fordi plassholdertekst i Google er verre enn en kort liste.
// Kravene under er grunnen til at listen er kort, og de er verdt å si høyt:
// de forteller leseren hva en case her ER, og hvorfor den kan stoles på.
const krav = [
  { nr: "01", tittel: "Problemet først", tekst: "Hva som faktisk kostet tid eller penger, i kundens ord. Ikke en teknologiliste." },
  { nr: "02", tittel: "Løsningen i én setning", tekst: "Hva som ble bygget, uten teknologinavn. Rammeverket står nederst, der det hører hjemme." },
  { nr: "03", tittel: "Tall vi har målt", tekst: "Resultatlisten står tom til tallet er målt. Et anslag presentert som en måling er en løgn med desimaler." },
  { nr: "04", tittel: "Konsept er merket konsept", tekst: "Demo og øvelse står merket som det. Du skal aldri lure på om noe er levert til en kunde." },
];

import "../styles/scener.css";
---
<Base
  tittel="Caser"
  beskrivelse="Problem, løsning og resultat med tall. Egne iOS-apper, demo-systemer og konseptarbeid fra KodeKonsulentene i Oslo."
>
  <Scene lav>
    <Mega som="h1" merke="Caser" n={1} tekst="Problem, løsning, resultat" aksent="resultat" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Hver case sier hva som var problemet, hva vi bygde, og hva det ga i tall. Konseptarbeid er alltid merket, slik at du vet hva som er oppdrag og hva som er øvelse.</p>
    </Avslor>

    <Avslor trinn={2} fra="skjev" skjev={2.2}>
      {/* Ekte bevegelse, ikke et stillbilde. Bare LYSET endrer seg mellom første og
          siste ramme – geometrien står bom stille, så Kling har ingenting å morfe.
          Det er den tekniske grunnen til at klippet ikke ser ut som billig AI-video. */}
      {/* LØKKE i full styrke, ikke scroll-spolt og ikke maskert.
          Målt mot referansene: siden vår beveget seg BARE når brukeren scroller.
          jeton.com har tre ganger vårt pikselavvik når siden står helt stille,
          fordi video går i løkke uavhengig av leseren. Og vi viste ni klipp på
          42 % opasitet bak tekst – vi betalte megabyte uten å få effekten. */}
      <SceneFilm
        loope
        smal="/scener/lev-caser-960.mp4"
        bred="/scener/lev-caser-1280.mp4"
        stor="/scener/lev-caser-1920.mp4"
        plakat="/scener/lev-caser-poster.avif"
      />
      <p class="small muted" style="margin-top: var(--space-3)">
        Fire stabler, én tent. Linjen tegner seg bare på den nærmeste – de tre bak
        finnes, men er ikke noe vi kan vise fram ennå.
      </p>
    </Avslor>

    <Avslor>
    <div class="stack">
      {synligeCaser.map((c) => (
        <article class="card">
          <div class="row" style="justify-content: space-between">
            <Eyebrow>{c.type}</Eyebrow>
            <span class="mono faint">{c.kunde}</span>
          </div>
          <h2 class="heading">{c.tittel}</h2>
          <div class="grid-2">
            <div class="stack stack--tight">
              <p class="muted"><strong class="body-strong">Problem.</strong> {c.problem}</p>
              <p class="muted"><strong class="body-strong">Løsning.</strong> {c.losning}</p>
              <p class="mono faint">{c.stack.join(" · ")}</p>
            </div>
            {c.resultat ? (
              <dl class="kv">
                {c.resultat.map((r) => (
                  <div><dt>{r.tekst}</dt><dd>{r.verdi}</dd></div>
                ))}
              </dl>
            ) : (
              <p class="small faint">
                Ingen målte tall ennå. Når denne løsningen er levert til en kunde,
                står resultatet her – ikke før.
              </p>
            )}
          </div>
          {c.href && <Button variant="ghost" href={c.href}>Se mer</Button>}
        </article>
      ))}
    </div>
    </Avslor>
  </Scene>

  <Horisont
    poster={krav}
    navn="Fire krav hver case på denne siden må oppfylle"
    merke="Krav"
    n={2}
    tittel="Derfor er listen kort"
    hoyde={3}
  />

  <ContactBlock n={3} tittel="Vil du bli den neste?" ingress="Vi tar inn to til tre pilotprosjekter til redusert pris mot at vi får bruke tallene som case. Si fra hvis det er aktuelt." />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
