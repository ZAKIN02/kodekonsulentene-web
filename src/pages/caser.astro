---
/**
 * /caser i wow-drakten (wow-undersider.md del 1.6, «film»).
 * Rekkefølge: H1 → casene, sortert etter kapitlene i filmen (nettsider, systemer, apper) →
 * «Derfor er listen kort» → kontaktblokken med pilottilbudet.
 *
 * Siden viser én case. Det er ikke en feil: synligeCaser filtrerer bort alt som ennå
 * inneholder TODO, fordi plassholdertekst i Google er verre enn en kort liste. Kravene under er
 * grunnen til at listen er kort, og de er verdt å si høyt: de forteller leseren hva en case
 * her ER, og hvorfor den kan stoles på.
 *
 * Resultatlista vises bare når casen har målte tall. Uten tall står det at den står uten.
 */
import MalWow from "../layouts/MalWow.astro";
import { SideHode, Seksjon, Tekstrader, Kontaktblokk, Ramme, Lampe } from "../components/wow/side";
import { tittelKlasser } from "../components/wow/side/tittel";
import { synligeCaser, type Case } from "../data/caser";

// Rekkefølgen i filmen på forsiden: bakeriet (nettsider), kontoret (systemer), rørleggeren
// (apper). Demo og konsept hører til systemene til de er levert.
const kapittel: Record<Case["type"], number> = { Nettside: 1, System: 2, Demo: 2, Konsept: 2, App: 3 };
const caser = [...synligeCaser].sort((a, b) => kapittel[a.type] - kapittel[b.type]);

// Ekte skjermbilder fra public/media/wow/ekte/ (tatt med Playwright av sider på dette nettstedet).
// En case uten bilde her rendres uten ramme, aldri med en plassholder.
const bilder: Record<string, { bilde: string; adresse: string; alt: string }> = {
  "booking-demo": {
    bilde: "klinikker-flyt",
    adresse: "kodekonsulentene.no/bransjer/klinikker",
    alt: "Skjermbilde av bookingflyten på siden for klinikker: fire steg fra bestilling til oppgjør.",
  },
};

const krav = [
  { tittel: "Problemet først", tekst: "Hva som faktisk kostet tid eller penger, i kundens ord. Ikke en teknologiliste." },
  { tittel: "Løsningen i én setning", tekst: "Hva som ble bygget, uten teknologinavn. Rammeverket står nederst, der det hører hjemme." },
  { tittel: "Tall vi har målt", tekst: "Resultatlisten står tom til tallet er målt. Et anslag presentert som en måling er en løgn med desimaler." },
  { tittel: "Konsept er merket konsept", tekst: "Demo og øvelse står merket som det. Du skal aldri lure på om noe er levert til en kunde." },
];
---

<MalWow
  tittel="Caser: apper, systemer og konsepter"
  beskrivelse="Problem, løsning og resultat med tall. Egne iOS-apper, demo-systemer og konseptarbeid fra KodeKonsulentene i Oslo. Hver case sier hva som er målt."
  bevegelse="film"
>
  <SideHode
    tittel="Problem, løsning, resultat"
    ingress="Hver case sier hva som var problemet, hva vi bygde, og hva det ga i tall. Konseptarbeid er alltid merket, slik at du vet hva som er oppdrag og hva som er øvelse."
    storrelse="stor"
  />

  {caser.map((c, i) => {
    const b = bilder[c.slug];
    return (
      <article class="case" aria-labelledby={`case-${c.slug}`}>
        <div class="wow-rute case__rute">
          <header class="case__hode">
            <p class="case__merker">
              <span class="wow-merke">{c.type}</span>
              <span class="wow-merke wow-merke--strek">{c.kunde}</span>
            </p>
            <h2 id={`case-${c.slug}`} class:list={tittelKlasser("tjeneste", c.tittel)} data-split="lines">{c.tittel}</h2>
          </header>

          {b && (
            <Ramme
              class="case__ramme"
              bilde={b.bilde}
              type="nettleser"
              adresse={b.adresse}
              alt={b.alt}
              sizes="94vw"
              avdekk={i === 0}
              zoom
            />
          )}

          <div class="case__tekst">
            <p><strong>Problem.</strong> {c.problem}</p>
            <p><strong>Løsning.</strong> {c.losning}</p>
            <p class="case__stack">{c.stack.join(", ")}</p>
          </div>

          <div class="case__resultat">
            {c.resultat ? (
              <dl class="case__tall">
                {c.resultat.map((r) => (
                  <div>
                    <dt>{r.tekst}</dt>
                    <dd><Lampe status="bestatt" />{r.verdi}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="case__uten">
                Ingen målte tall ennå. Når denne løsningen er levert til en kunde,
                står resultatet her – ikke før.
              </p>
            )}
            {c.href && (
              <a class="wow-knapp wow-knapp--strek" href={c.href} data-magnetic>
                <span class="wow-knapp__tekst" data-magnetic-tekst>Se mer</span>
              </a>
            )}
          </div>
        </div>
      </article>
    );
  })}

  <Seksjon id="krav" tittel="Derfor er listen kort" storrelse="tjeneste">
    <Tekstrader rader={krav} />
  </Seksjon>

  <Kontaktblokk
    tittel="Vil du bli den neste?"
    ingress="Vi tar inn to til tre pilotprosjekter til redusert pris mot at vi får bruke tallene som case. Si fra hvis det er aktuelt."
  />
</MalWow>

<style>
  .case {
    padding-top: var(--wow-seksjon-tett);
  }
  .case__rute {
    row-gap: var(--wow-rom-6);
    align-items: start;
  }
  .case__hode {
    display: grid;
    gap: var(--wow-rom-4);
    justify-items: start;
  }
  .case__merker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wow-rom-2);
  }
  /* Skjermbildet er 16:10 med en lys stripe nederst (neste seksjon på siden som er avbildet).
     16:9 fra toppen kutter stripa, så bildet slutter i den mørke flaten. */
  .case :global(.case__ramme .wow-ramme__skjerm) {
    aspect-ratio: 16 / 9;
  }
  .case__tekst {
    display: grid;
    gap: var(--wow-rom-4);
    max-width: var(--wow-maal-brod);
  }
  .case__tekst p {
    color: var(--wow-tekst-dempet);
    text-wrap: pretty;
  }
  .case__tekst strong {
    color: var(--wow-tekst);
    font-weight: 700;
  }
  .case__tekst .case__stack {
    font-size: var(--wow-tekst-liten);
  }
  .case__resultat {
    display: grid;
    gap: var(--wow-rom-5);
    justify-items: start;
  }
  .case__uten {
    max-width: 34ch;
    padding-left: var(--wow-rom-4);
    border-left: var(--wow-kant-2) solid var(--wow-linje-sterk);
    color: var(--wow-tekst-dempet);
  }
  .case__tall {
    display: grid;
    width: 100%;
    margin: 0;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .case__tall > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wow-rom-2) var(--wow-rom-5);
    padding-block: var(--wow-rom-4);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .case__tall dt {
    color: var(--wow-tekst-dempet);
  }
  .case__tall dd {
    display: inline-flex;
    align-items: center;
    gap: var(--wow-rom-3);
    margin: 0;
    font-size: var(--wow-tekst-h3);
    font-weight: 700;
  }
  @media (max-width: 599px) {
    .case__resultat .wow-knapp {
      width: 100%;
    }
  }
  @media (min-width: 1024px) {
    .case__hode {
      grid-column: 1 / 10;
    }
    .case__tekst {
      grid-column: 1 / 8;
    }
    .case__resultat {
      grid-column: 8 / 13;
    }
  }
</style>
