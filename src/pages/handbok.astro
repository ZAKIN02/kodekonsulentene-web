---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import Button from "../components/Button.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Flyt from "../components/Flyt.astro";
import Horisont from "../components/Horisont.astro";
import { firma } from "../data/firma";
import { prisvilkaar } from "../data/priser";
import { flyter } from "../data/flyter";

// Rutinene sto som seks kulepunkter midt i en vegg av fjorten overskrifter.
// De er det mest konkrete på siden, og det eneste en kunde kan etterprøve –
// derfor står de nå som et eget spor i stedet for å drukne.
const rutiner = [
  { nr: "01", tittel: "Ingen hemmeligheter i koden", tekst: "Nøkler ligger i plattformens hemmelighetslager, aldri i Git. Et repo som lekker er et repo som lekker for alltid." },
  { nr: "02", tittel: "Egne nøkler per kunde", tekst: "Ingen delte innlogginger. Mister én tjeneste en nøkkel, står resten urørt." },
  { nr: "03", tittel: "Avhengigheter skannes", tekst: "Automatisk, og kjent sårbarhet lappes innen fem arbeidsdager på driftsavtaler." },
  { nr: "04", tittel: "Radnivå-sikkerhet", tekst: "Databaser med persondata låses på rad, ikke på applikasjonslaget alene." },
  { nr: "05", tittel: "Lest tilbake hver måned", tekst: "Daglig sikkerhetskopi, og test av gjenoppretting hver måned. En backup du ikke har lest tilbake, er ikke en backup." },
  { nr: "06", tittel: "Lovsjekk hver leveranse", tekst: "Sikkerhetsheadere og lovsjekk kjøres på hver leveranse, ikke bare på den første." },
];

import "../styles/scener.css";
---
<Base
  tittel="Åpen håndbok: slik jobber vi"
  beskrivelse="Hvordan vi jobber, hva ting koster, hvilke sikkerhetsrutiner som gjelder og hva som skjer hvis vi ikke kan fullføre. Åpent, slik at du vet hva du kjøper."
>
  <Scene lav>
    <Mega som="h1" merke="Håndbok" n={1} tekst="Hvordan vi jobber, åpent" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Det er rimelig å vite hvordan en leverandør jobber før du betaler. Derfor står det her i stedet for i en e-post du må be om.</p>
    </Avslor>

    <Avslor trinn={2} fra="dybde" dybde={60}>
      {/* HER LÅ ET GENERERT STILLBILDE (side-handbok), BYTTET UT MED EN FIGUR SOM
          SIER NOE.

          Bildet var en stabel aluminiumsplater viftet opp fra ett hengsel, med
          bildeteksten «det er det siden gjør med arbeidsmåten vår». Dekk over den
          setningen og prøven i brandboken: en rørleggeren ser grå hyller. Metaforen
          bodde i bildeteksten, ikke i bildet – og da er det bildeteksten som gjør
          jobben, ikke bildet.

          I stedet står flyten `prosess`, som allerede fantes i src/data/flyter.ts og
          som INGEN side brukte. Den har ekte navn og våre egne tider: Samtale 20 min,
          Prototype 72 timer, Bygging 2–3 uker, Drift løpende. Det er nøyaktig det
          håndboken handler om, og det er andreplassen i brandbokens rangering.

          Den beveger seg også hele tiden, i løkke, med begynnelse, midte og slutt –
          en pakke som reiser gjennom kjeden og tenner ett ledd om gangen – til 0 kB
          JavaScript. Tidene er de samme som i src/data/prosess.ts; endres den ene,
          skal den andre endres i samme slengen, ellers lyver figuren om tilbudet. */}
      <Flyt flyt={flyter.prosess} />
    </Avslor>

    <Avslor>
    <div class="prose">
      <h2>Arbeidstid og svartid</h2>
      <p class="muted">
        Vi svarer på henvendelser innen {firma.svartid} på hverdager. Haster det og du er
        kunde med driftsavtale, ring – da er det telefonen som gjelder, ikke e-post.
        Vi jobber ikke kvelder og helger, bortsett fra når noe er nede.
      </p>

      <h2>Hvor mange prosjekter om gangen</h2>
      <p class="muted">
        Maks tre byggeprosjekter samtidig. Det er grunnen til at vi av og til sier at
        du må vente to uker. Alternativet er å si ja til alt og levere sent til alle,
        og det er en dårligere avtale for deg.
      </p>

      <h2>Hva et prosjekt koster og når du betaler</h2>
      <ul class="muted">
        {prisvilkaar.map((v) => <li>{v}</li>)}
        <li>Timeprisen er {firma.timepris} eks. mva for arbeid utenfor avtalt omfang, alltid avtalt skriftlig først.</li>
      </ul>
      <p class="muted">
        Fullstendig prisliste står på <a class="kk-link" href="/priser">prissiden</a>,
        og de juridiske formuleringene i <a class="kk-link" href="/vilkar">salgsvilkårene</a>.
      </p>

      <h2>Hva som er inkludert, og hva som ikke er det</h2>
      <p class="muted">
        Inkludert: tekstarbeid på sidene vi avtaler, bildebehandling av bilder du sender,
        SEO-grunnarbeid, lovsjekk, sikkerhetsheadere, to revisjonsrunder og opplæring på
        en halvtime ved lansering.
      </p>
      <p class="muted">
        Ikke inkludert: nye bilder (fotograf), tekstforfatter, annonsebudsjett, oversettelse,
        og innhold du ikke har. Trenger du det, sier vi fra tidlig og foreslår noen.
      </p>

      <h2>Revisjoner og endringer underveis</h2>
      <p class="muted">
        To revisjonsrunder er med i prisen. En runde er samlede tilbakemeldinger, ikke
        enkeltmeldinger over fjorten dager. Kommer det nye sider eller ny funksjonalitet
        etter at vi er enige om omfanget, får du en pris på det før vi begynner.
        Du får aldri en faktura du ikke har sagt ja til på forhånd.
      </p>

      <h2 id="tilgang">Hvem har tilgang til hva</h2>
      <p class="muted">
        Alle kontoer – domene, hosting, analyse, database – står i ditt foretaks navn
        med deg som eier. Vi er lagt til som bruker. Sier du opp, fjerner du oss;
        du trenger ikke be oss om å overføre noe.
      </p>

      <h2>Hva skjer hvis vi ikke kan fullføre</h2>
      <p class="muted">
        Siden din står uansett – den ligger ikke på vår maskin, og du eier alle kontoene.
        Blir vi borte i mer enn fem arbeidsdager, får du beskjed, full dokumentasjon og
        tilganger, og navn på to utviklere vi har avtale med og som kan ta over.
        Dette står også i salgsvilkårene, slik at det er noe du kan holde oss til.
      </p>

      <h2>Hva vi ikke gjør</h2>
      <p class="muted">
        Design uten utvikling. Annonsekampanjer. Nettbutikker på plattformer vi ikke kan
        vedlikeholde. Prosjekter uten skriftlig omfang. Og vi tar ikke oppdrag der
        oppgaven i praksis er å legge et nytt lag maling på et system som burde byttes –
        da sier vi det i stedet.
      </p>

      <h2>Underleverandører</h2>
      <p class="muted">
        Per i dag ingen. Blir det aktuelt – for eksempel foto, tekst eller
        oversettelse – spør vi deg først, og det er fortsatt vi som er ansvarlig
        overfor deg.
      </p>

      <h2>Når noe går galt</h2>
      <p class="muted">
        Er det vår feil, fikser vi det uten å fakturere. Er det uklart hvem sin feil
        det er, fikser vi det først og vi tar diskusjonen etterpå. Er du ikke fornøyd
        med prototypen, betaler du ingenting og vi skiller lag som venner.
      </p>
    </div>

    </Avslor>
  </Scene>

  <Horisont
    poster={rutiner}
    navn="Seks sikkerhetsrutiner som gjelder hver leveranse"
    merke="Sikkerhet"
    n={2}
    tittel="Seks rutiner, hver leveranse"
    hoyde={3}
  />

  <Scene n={3} eyebrow="Videre" tittel="Det som står skrevet, kan du holde oss til" ingress="Håndboken er arbeidsmåten. Salgsvilkårene er det juridiske, og sikkerhetssiden viser hva som faktisk måles på en leveranse.">
    <div class="row">
      <Button variant="primary" href="/kontakt">Book 20 minutter</Button>
      <Button variant="ghost" href="/vilkar">Les salgsvilkårene</Button>
      <Button variant="ghost" href="/sikkerhet">Se sikkerhetsarbeidet</Button>
    </div>
  </Scene>

  <ContactBlock n={4} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
