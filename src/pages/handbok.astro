---
/**
 * Håndboken i wow-drakten (wow-undersider.md del 1.7): lesemalen uten kort svar og verktøy, med
 * innholdsliste over de ti overskriftene. «rolig»: ingenting beveger seg uten at leseren har
 * gjort noe. Teksten er uendret fra v1.
 */
import MalWow from "../layouts/MalWow.astro";
import { SideHode, Artikkelkropp, Flyt, Tekstrader, Seksjon, Kontaktblokk } from "../components/wow/side";
import { firma } from "../data/firma";
import { prisvilkaar, prisenhet } from "../data/priser";
import { flyter } from "../data/flyter";

// Rutinene sto som seks kulepunkter midt i en vegg av fjorten overskrifter.
// De er det mest konkrete på siden, og det eneste en kunde kan etterprøve –
// derfor står de som et eget spor i stedet for å drukne. De er seks uavhengige rutiner, ikke
// en rekkefølge, og står derfor uten nummer (v1 hadde 01–06).
const rutiner = [
  { tittel: "Ingen hemmeligheter i koden", tekst: "Nøkler ligger i plattformens hemmelighetslager, aldri i Git. Et repo som lekker er et repo som lekker for alltid." },
  { tittel: "Egne nøkler per kunde", tekst: "Ingen delte innlogginger. Mister én tjeneste en nøkkel, står resten urørt." },
  { tittel: "Avhengigheter skannes", tekst: "Automatisk, og kjent sårbarhet lappes innen fem arbeidsdager på driftsavtaler." },
  { tittel: "Radnivå-sikkerhet", tekst: "Databaser med persondata låses på rad, ikke på applikasjonslaget alene." },
  { tittel: "Lest tilbake hver måned", tekst: "Daglig sikkerhetskopi, og test av gjenoppretting hver måned. En backup du ikke har lest tilbake, er ikke en backup." },
  { tittel: "Lovsjekk hver leveranse", tekst: "Sikkerhetsheadere og lovsjekk kjøres på hver leveranse, ikke bare på den første." },
];

// «tilgang» er et anker andre sider lenker til. Det skal ikke endres.
const innhold = [
  { id: "svartid", tittel: "Arbeidstid og svartid" },
  { id: "kapasitet", tittel: "Hvor mange prosjekter om gangen" },
  { id: "betaling", tittel: "Hva et prosjekt koster og når du betaler" },
  { id: "inkludert", tittel: "Hva som er inkludert, og hva som ikke er det" },
  { id: "revisjoner", tittel: "Revisjoner og endringer underveis" },
  { id: "tilgang", tittel: "Hvem har tilgang til hva" },
  { id: "fullfore", tittel: "Hva skjer hvis vi ikke kan fullføre" },
  { id: "ikke", tittel: "Hva vi ikke gjør" },
  { id: "underleverandorer", tittel: "Underleverandører" },
  { id: "feil", tittel: "Når noe går galt" },
];
---

<MalWow
  tittel="Åpen håndbok: slik jobber vi"
  beskrivelse="Hvordan vi jobber, hva ting koster, hvilke sikkerhetsrutiner som gjelder og hva som skjer hvis vi ikke kan fullføre. Åpent, slik at du vet hva du kjøper."
  bevegelse="rolig"
>
  <article>
    <SideHode
      tittel="Hvordan vi jobber, åpent"
      ingress="Det er rimelig å vite hvordan en leverandør jobber før du betaler. Derfor står det her i stedet for i en e-post du må be om."
      storrelse="tjeneste"
      bredde="les"
    />
    <Artikkelkropp variant="handbok" innhold={innhold}>
      {/* Flyten `prosess` fra src/data/flyter.ts, med ekte navn og våre egne tider: Samtale
          20 min, Prototype 72 timer, Bygging 2–3 uker, Drift løpende. Tidene er de samme som i
          src/data/prosess.ts; endres den ene, skal den andre endres i samme slengen, ellers
          lyver figuren om tilbudet. (I v1 sto et generert stillbilde her først; det ble byttet
          mot figuren fordi metaforen bodde i bildeteksten, ikke i bildet.) */}
      <Flyt slot="verktoy" flyt={flyter.prosess} niva={2} />

      <h2 id="svartid">Arbeidstid og svartid</h2>
      <p>
        Vi svarer på henvendelser innen {firma.svartid} på hverdager. Haster det og du er
        kunde med driftsavtale, ring – da er det telefonen som gjelder, ikke e-post.
        Vi jobber ikke kvelder og helger, bortsett fra når noe er nede.
      </p>

      <h2 id="kapasitet">Hvor mange prosjekter om gangen</h2>
      <p>
        Maks tre byggeprosjekter samtidig. Det er grunnen til at vi av og til sier at
        du må vente to uker. Alternativet er å si ja til alt og levere sent til alle,
        og det er en dårligere avtale for deg.
      </p>

      <h2 id="betaling">Hva et prosjekt koster og når du betaler</h2>
      <ul>
        {prisvilkaar.map((v) => <li>{v}</li>)}
        <li>Timeprisen er {firma.timepris} – {prisenhet} – for arbeid utenfor avtalt omfang, alltid avtalt skriftlig først.</li>
      </ul>
      <p>
        Fullstendig prisliste står på <a href="/priser">prissiden</a>,
        og de juridiske formuleringene i <a href="/vilkar">salgsvilkårene</a>.
      </p>

      <h2 id="inkludert">Hva som er inkludert, og hva som ikke er det</h2>
      <p>
        Inkludert: tekstarbeid på sidene vi avtaler, bildebehandling av bilder du sender,
        SEO-grunnarbeid, lovsjekk, sikkerhetsheadere, to revisjonsrunder og opplæring på
        en halvtime ved lansering.
      </p>
      <p>
        Ikke inkludert: nye bilder (fotograf), tekstforfatter, annonsebudsjett, oversettelse,
        og innhold du ikke har. Trenger du det, sier vi fra tidlig og foreslår noen.
      </p>

      <h2 id="revisjoner">Revisjoner og endringer underveis</h2>
      <p>
        To revisjonsrunder er med i prisen. En runde er samlede tilbakemeldinger, ikke
        enkeltmeldinger over fjorten dager. Kommer det nye sider eller ny funksjonalitet
        etter at vi er enige om omfanget, får du en pris på det før vi begynner.
        Du får aldri en faktura du ikke har sagt ja til på forhånd.
      </p>

      <h2 id="tilgang">Hvem har tilgang til hva</h2>
      <p>
        Alle kontoer – domene, hosting, analyse, database – står i ditt foretaks navn
        med deg som eier. Vi er lagt til som bruker. Sier du opp, fjerner du oss;
        du trenger ikke be oss om å overføre noe.
      </p>

      <h2 id="fullfore">Hva skjer hvis vi ikke kan fullføre</h2>
      <p>
        Siden din står uansett – den ligger ikke på vår maskin, og du eier alle kontoene.
        Blir vi borte i mer enn fem arbeidsdager, får du beskjed, full dokumentasjon og
        tilganger, og navn på to utviklere vi har avtale med og som kan ta over.
        Dette står også i salgsvilkårene, slik at det er noe du kan holde oss til.
      </p>

      <h2 id="ikke">Hva vi ikke gjør</h2>
      <p>
        Design uten utvikling. Annonsekampanjer. Nettbutikker på plattformer vi ikke kan
        vedlikeholde. Prosjekter uten skriftlig omfang. Og vi tar ikke oppdrag der
        oppgaven i praksis er å legge et nytt lag maling på et system som burde byttes –
        da sier vi det i stedet.
      </p>

      <h2 id="underleverandorer">Underleverandører</h2>
      <p>
        Per i dag ingen. Blir det aktuelt – for eksempel foto, tekst eller
        oversettelse – spør vi deg først, og det er fortsatt vi som er ansvarlig
        overfor deg.
      </p>

      <h2 id="feil">Når noe går galt</h2>
      <p>
        Er det vår feil, fikser vi det uten å fakturere. Er det uklart hvem sin feil
        det er, fikser vi det først og vi tar diskusjonen etterpå. Er du ikke fornøyd
        med prototypen, betaler du ingenting og vi skiller lag som venner.
      </p>

      <section slot="etter" class="rutiner" aria-labelledby="rutiner-tittel">
        <h2 id="rutiner-tittel" class="wow-les-h2">Seks rutiner, hver leveranse</h2>
        <Tekstrader rader={rutiner} />
      </section>
    </Artikkelkropp>
  </article>

  <Seksjon
    id="videre"
    tittel="Det som står skrevet, kan du holde oss til"
    ingress="Håndboken er arbeidsmåten. Salgsvilkårene er det juridiske, og sikkerhetssiden viser hva som faktisk måles på en leveranse."
    storrelse="les"
    bredde="les"
    tett
  >
    {/* Tre handlinger, som i v1: én primær, én sekundær, én lenke (Handlinger tar bare to). */}
    <div class="videre">
      <a class="wow-knapp" href="/kontakt"><span class="wow-knapp__tekst">Book 20 minutter</span></a>
      <a class="wow-knapp wow-knapp--strek" href="/vilkar"><span class="wow-knapp__tekst">Les salgsvilkårene</span></a>
      <a class="wow-lenke" href="/sikkerhet">Se sikkerhetsarbeidet</a>
    </div>
  </Seksjon>

  <Kontaktblokk />
</MalWow>

<style>
  .rutiner {
    display: grid;
    gap: var(--wow-rom-5);
  }
  .videre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wow-rom-4) var(--wow-rom-5);
  }
  .videre .wow-lenke {
    display: inline-flex;
    align-items: center;
    min-height: var(--wow-trykkflate);
    background-position: 0 calc(100% - 0.6rem), 0 calc(100% - 0.6rem);
  }
  @media (max-width: 599px) {
    .videre {
      flex-direction: column;
      align-items: stretch;
    }
    .videre .wow-lenke {
      align-self: flex-start;
    }
  }
</style>
