---
// Forsiden, retning A «Befaring». Rekkefølgen er fast (briefen del 6):
// Tilbudet → Scenen → Rapporten → Arbeid → Garantien → Det jeg bygger →
// Prisvelgeren og prislista → Slik går det → Hvem jeg er → Spørsmål →
// Kontakt → Footer. Tekst ordrett fra docs/design/tekst/forside.md.
// Øyeblikk 2, 3, 5 og 6 felles inn i bølge 3.2 – seksjonene står klare.
import MalV2 from "../layouts/MalV2.astro";
import Scene from "../components/bevegelse/Scene.astro";
import Tilbud from "../components/forside/Tilbud.astro";
import Rapport from "../components/forside/Rapport.astro";
import Arbeid from "../components/forside/Arbeid.astro";
import Garanti from "../components/forside/Garanti.astro";
import Tjenester from "../components/forside/Tjenester.astro";
import Prisliste from "../components/forside/Prisliste.astro";
import Prosess from "../components/forside/Prosess.astro";
import Hvem from "../components/forside/Hvem.astro";
import Sporsmal from "../components/forside/Sporsmal.astro";
import Kontakt from "../components/forside/Kontakt.astro";
import { firma } from "../data/firma";
import { faqSide } from "../data/schema";
import type { Sporsmaal } from "../data/faq";

const beskrivelse =
  "Gratis befaring av nettsiden din: rapport på 30 sekunder. Nettsider og systemer for norske småbedrifter i Oslo, til fast pris.";

// Scenen, variant «A→B alene» (tekstmanuset del 2): tre steg, der det siste
// peker videre til rapporten.
const steg = [
  {
    tittel: "Dette er nettsiden din",
    tekst: "Fire lag og fem kabler i rot. Utenfra ser du bare det øverste laget.",
  },
  {
    tittel: "Jeg tar den fra hverandre",
    tekst: "Lag for lag: design, kode, sikkerhet og integrasjoner.",
  },
  {
    tittel: "Hvert lag blir målt",
    tekst: "Laster siden raskt? Er den trygg? Snakker systemene bak sammen? Svaret står i rapporten under.",
  },
];

// Datoene i «Slik går det» regnes ut ved bygg (tekstmanuset del 8):
// prototypen er dagens dato + 3 døgn, lanseringen er ISO-uka for dagens dato
// + 24 døgn (72 timer prototype + 3 uker bygging, øvre grense av «2–3 uker»).
const DOGN = 86_400_000;
const naa = new Date();
const prototypedato = new Intl.DateTimeFormat("nb-NO", {
  weekday: "long",
  day: "numeric",
  month: "long",
}).format(new Date(naa.getTime() + 3 * DOGN));

function isoUke(d: Date): number {
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const dag = t.getUTCDay() || 7;
  t.setUTCDate(t.getUTCDate() + 4 - dag);
  const start = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t.getTime() - start.getTime()) / DOGN + 1) / 7);
}
const lanseringsuke = isoUke(new Date(naa.getTime() + 24 * DOGN));

// Spørsmålene, ordrett fra tekstmanuset del 10. Samme liste går til
// FAQPage-markupen, så tekst og strukturerte data ikke kan komme i utakt.
const sporsmaal: Sporsmaal[] = [
  {
    q: "Eier jeg koden og domenet?",
    a: "Ja. Domenet står registrert på ditt foretak fra dag én, og koden ligger i en konto i ditt navn fra lansering. Sier du opp et abonnement, får du en kjørbar kopi av siden og databasen – ingen innlåsing.",
  },
  {
    q: "Hva er bindingstiden?",
    a: "Abonnement har 12 måneder binding, fordi byggekostnaden ligger i de første månedene. Drift og vedlikehold på en side du har kjøpt har ingen binding og kan sies opp med én måneds varsel.",
  },
  {
    q: "Hva skjer hvis du ikke kan fullføre?",
    a: "Du har koden, domenet og alle kontoer i ditt navn, så siden står uansett. Avtalen sier at du får full dokumentasjon og alle tilganger utlevert innen fem arbeidsdager hvis jeg ikke kan fullføre, og jeg oppgir to andre utviklere som kan overta.",
  },
  {
    q: "Trenger siden min cookie-banner?",
    a: "Sannsynligvis ikke. Jeg bruker cookieløs analyse, og da er det ingenting å samtykke til. Fra 1. januar 2025 krever ekomloven § 3-15 at cookie-samtykke oppfyller GDPR-kravene – ingen forhåndsavkryssing, «avvis» like lett som «godta», ingen sporing før samtykke. Den enkleste måten å overholde det på er å ikke sette cookies.",
  },
  {
    q: "Må siden være universelt utformet?",
    a: "Private virksomheter skal oppfylle 35 krav i WCAG 2.0 nivå A og AA. Jeg bygger etter WCAG 2.2 AA, som er strengere, fordi det koster lite ekstra og gjør at du også kan levere til det offentlige. Du får en rapport som viser hva som er testet.",
  },
  {
    q: "Hva koster det å endre noe etterpå?",
    a: "Småting er inkludert i drift eller abonnement, med tak på én time per måned. Utover det gjelder timeprisen i prislista over, alltid avtalt skriftlig på forhånd. Du får aldri en faktura du ikke har sagt ja til.",
  },
  {
    q: "Hva om jeg allerede har en WordPress-side?",
    a: "Da er lovsjekk-pakken ofte riktig sted å starte. Hva den dekker og hva den koster, står nederst i befaringsrapporten lenger opp. Virker resten av siden, trenger du ikke en ny.",
  },
];
---

<MalV2 tittel={firma.navn} beskrivelse={beskrivelse} schema={[faqSide(sporsmaal)]}>
  <Tilbud />

  <Scene
    navn="hero"
    etikett="Slik befarer jeg en nettside"
    hoppTil="rapport"
    prioritet
    bakgrunn="#080809"
    steg={steg}
  />
  <p class="kolofon felt">Illustrasjon laget med KI</p>

  <Rapport />
  <Arbeid />
  <Garanti />
  <Tjenester />
  <Prisliste />
  <Prosess prototypedato={prototypedato} lanseringsuke={lanseringsuke} />
  <Hvem />
  <Sporsmal liste={sporsmaal} />
  <Kontakt />
</MalV2>
