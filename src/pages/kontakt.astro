---
/**
 * /kontakt i wow-drakten (wow-undersider.md del 1.9, «rolig»).
 * Kontaktblokken er hele toppdelen (niva 1): H1, booking og skjemaet i første skjerm. Kvittering
 * (?sendt=1) og feil (?feil=1 / ?feil=2) står over booking og skjema, med lampe og role="status".
 * Deretter «Kjør sjekken først». Terminalutsnittet fra v1 er tatt ut (planen).
 *
 * Skjemaet står i Kontaktblokk og sender en vanlig POST til /api/kontakt med feltnavnene
 * navn, epost, nettside og melding. Valideringen, CSRF-kontrollen og omdirigeringene ligger i
 * src/pages/api/kontakt.ts og er ikke rørt.
 */
import MalWow from "../layouts/MalWow.astro";
import { Seksjon, Kontaktblokk } from "../components/wow/side";
import Handlinger from "../components/wow/side/Handlinger.astro";

// Siden rendres på serveren, ikke ved bygg. Grunnen er kvitteringen: skjemaet poster
// til /api/kontakt, som sender deg tilbake hit med ?sendt=1. Var siden statisk, måtte
// den meldingen vises med JavaScript – og da virker ikke skjemaet uten JavaScript.
export const prerender = false;

const sendt = Astro.url.searchParams.get("sendt") === "1";
const feil = Astro.url.searchParams.get("feil");

// Samme regel som i v1: ?sendt=1 gir kvittering, ?feil=1 og ?feil=2 hver sin feiltekst, alt annet
// ingenting. Tekstene står i Kontaktblokk, ordrett fra v1 (telefonvakten også).
const tilstand = sendt ? "sendt" : feil === "1" ? "feil-1" : feil === "2" ? "feil-2" : undefined;
---

<MalWow
  tittel="Kontakt"
  beskrivelse="Book 20 minutter på telefon, eller skriv kort hva som tar tid i dag. Svar innen 24 timer. Utvikler i Oslo."
  noindex={sendt || Boolean(feil)}
  bevegelse="rolig"
>
  <Kontaktblokk
    niva={1}
    tittel="Snakk med den som koder"
    ingress="20 minutter på telefon, ingen presentasjon. Du får et prisspenn og en ærlig vurdering av om du trenger det du tror du trenger."
    tilstand={tilstand}
    fakta="full"
  />

  <Seksjon
    id="sjekk-forst"
    tittel="Kjør sjekken først"
    ingress="Har du en side i dag, bruk et halvt minutt på den gratis sjekken. Da ser vi begge hva som faktisk er problemet før vi snakker om pris."
    storrelse="tjeneste"
    tett
    class="kontakt-siste"
  >
    <Handlinger handlinger={[{ tekst: "Sjekk nettsiden din", href: "/sjekk", type: "strek" }]} />
  </Seksjon>
</MalWow>

<style>
  /* Siden slutter uten kontaktblokk nederst: luft mellom siste seksjon og bunnen. */
  :global(.kontakt-siste) {
    padding-bottom: var(--wow-seksjon-tett);
  }
</style>
