---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import opptak from "../data/opptak.json";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import { firma, bookUrl } from "../data/firma";

import "../styles/scener.css";

// Siden rendres på serveren, ikke ved bygg. Grunnen er kvitteringen: skjemaet poster
// til /api/kontakt, som sender deg tilbake hit med ?sendt=1. Var siden statisk, måtte
// den meldingen vises med JavaScript – og da virker ikke skjemaet uten JavaScript.
export const prerender = false;

// firma er `as const`, så firma.telefon har literal-typen "" når feltet står tomt.
// Uten en bredere type smalner `{firma.telefon && ...}` den sanne grenen til `never`,
// og .replace finnes ikke der. Samme grep som i ContactBlock.astro.
const telefon: string = firma.telefon;

const sendt = Astro.url.searchParams.get("sendt") === "1";
const feil = Astro.url.searchParams.get("feil");

const feilmelding =
  feil === "1"
    ? "Noe manglet i skjemaet. Fyll ut navn, en gyldig e-postadresse og hva du trenger hjelp til."
    : feil === "2"
      ? `Skjemaet kom ikke fram. Send en e-post til ${firma.epost} i stedet, så svarer vi like raskt.`
      : null;
---
<Base
  tittel="Kontakt"
  beskrivelse="Book 20 minutter på telefon, eller skriv kort hva som tar tid i dag. Svar innen 24 timer. Utvikler i Oslo."
  noindex={sendt || Boolean(feil)}
>
  <Scene lav>
    <Mega som="h1" merke="Kontakt" n={1} tekst="Snakk med den som koder" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">20 minutter på telefon, ingen presentasjon. Du får et prisspenn og en ærlig vurdering av om du trenger det du tror du trenger.</p>
    </Avslor>

    <Avslor trinn={2}>
      {/* Ekte opptak av vaar egen side i drift. Brandboken rangerer dette oeverst:
          det BEVISER paastanden i stedet for aa illustrere den. */}
      <Demo
        smal={opptak.skjema.smal}
        bred={opptak.skjema.bred}
        stor={opptak.skjema.stor}
        plakat={opptak.skjema.plakat}
        tekst={opptak.skjema.tekst}
        kilde={opptak.skjema.kilde}
      />
    </Avslor>

    {sendt && (
      <div class="card kvittering" style="border-color: var(--ok)">
        <h2 class="heading">Takk – meldingen kom fram</h2>
        {/* firma.telefon er tomt til vi har et ekte nummer. Uten vakten her ble
            setningen «Haster det, ring .» med en tom <a href="tel:"> uten tekst –
            en lenke skjermlesere annonserer uten å kunne si hvor den fører.
            Bryter WCAG 2.4.4 og 4.1.2, og lå live. ContactBlock hadde vakten,
            denne hadde den ikke. */}
        <p class="muted">
          Vi svarer innen {firma.svartid}, som regel raskere.
          {telefon && (
            <> Haster det, ring <a class="kk-link" href={`tel:${telefon.replace(/\s/g, "")}`}>{telefon}</a>.</>
          )}
        </p>
      </div>
    )}

    {feilmelding && (
      <div class="card kvittering" style="border-color: var(--fail)">
        <h2 class="heading">Det stoppet opp</h2>
        <p class="muted">{feilmelding}</p>
      </div>
    )}

    <Avslor>
    <div class="grid-2" style="margin-top: var(--space-6)">
      <div class="stack">
        <div class="card">
          <h2 class="heading">Book et kvarter</h2>
          <p class="muted">
            Velg et ledig tidspunkt. Du får bekreftelse med lenke med én gang – ingen
            e-post fram og tilbake for å finne en tid.
          </p>
          <Button variant="primary" href={bookUrl}>Åpne kalenderen</Button>
          <dl class="kv">
            <div><dt>E-post</dt><dd><a class="kk-link" href={`mailto:${firma.epost}`}>{firma.epost}</a></dd></div>
            {/* Samme vakt som i ContactBlock. Uten den ble raden «Telefon» stående
                med en tom <a href="tel:"> uten tekst – lenken gjorde ingenting, og
                skjermlesere annonserte «lenke» uten å kunne si hvor. */}
            {telefon && (
              <div><dt>Telefon</dt><dd><a class="kk-link" href={`tel:${telefon.replace(/\s/g, "")}`}>{telefon}</a></dd></div>
            )}
            <div><dt>Svartid</dt><dd>{firma.svartid}</dd></div>
            <div><dt>Sted</dt><dd>{firma.adresse}</dd></div>
          </dl>
        </div>

        <Terminal
          skriv
          title="~/kodekonsulentene/kontakt"
          lines={[
            { type: "cmd", text: "hva koster en prat" },
            { type: "ok", text: "ingenting" },
            { type: "cmd", text: "hva skjer etterpå" },
            { type: "out", text: "du får et prisspenn på telefonen," },
            { type: "out", text: "og et skriftlig tilbud innen to dager" },
            { type: "cmd", text: "er vi bundet til noe" },
            { type: "ok", text: "nei" },
          ]}
          label="Terminalutsnitt: en prat koster ingenting, du får prisspenn på telefonen og skriftlig tilbud innen to dager, og du er ikke bundet til noe."
        />
      </div>

      <form class="card" method="post" action="/api/kontakt">
        <h2 class="heading">Eller skriv kort</h2>
        <p class="small muted">Fire felt. Ikke flere enn det som trengs for å svare deg.</p>
        <div class="field">
          <label for="navn">Navn</label>
          <input class="control" id="navn" name="navn" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="epost">E-post</label>
          <input class="control" id="epost" name="epost" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="nettside">Nettside i dag</label>
          <input class="control" id="nettside" name="nettside" type="text" inputmode="url" placeholder="dinbedrift.no" />
          <span class="hint">Har du ingen ennå, la feltet stå tomt.</span>
        </div>
        <div class="field">
          <label for="melding">Hva tar tid i dag?</label>
          <textarea class="control" id="melding" name="melding" required></textarea>
          <span class="hint">Skriv det som en setning. «Vi bruker en halv dag i måneden på å avstemme Vipps» sier mer enn «vi trenger ny nettside».</span>
        </div>
        <Button variant="primary" type="submit">Send</Button>
        <p class="small faint">
          Vi bruker opplysningene bare for å svare deg, og sletter dem etter seks måneder
          hvis det ikke blir et oppdrag. Se <a class="kk-link" href="/personvern">personvernerklæringen</a>.
        </p>
      </form>
    </div>
    </Avslor>
  </Scene>

  <Scene n={2} eyebrow="Før du ringer" tittel="Kjør sjekken først" ingress="Har du en side i dag, bruk et halvt minutt på den gratis sjekken. Da ser vi begge hva som faktisk er problemet før vi snakker om pris.">
    <Button variant="secondary" href="/sjekk">Sjekk nettsiden din</Button>
  </Scene>
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
