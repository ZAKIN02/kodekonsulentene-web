---
import Base from "../../layouts/Base.astro";
import Sveip from "../../components/Sveip.astro";
---
<Base tittel="Sveip – lab" beskrivelse="Lyssveip over rutenett, bygget i CSS. Null kilobyte, beveger seg uten scroll." noindex>
  <main class="wrap" style="padding-block: var(--space-8); display: grid; gap: var(--space-6)">
    <h1 class="display-lg">Sveip</h1>
    <Sveip />
    <p class="muted">Motivet kom fra Higgsfield. Klippet sto nesten stille – 8,29 av 255 i
      total endring – så det er bygget i CSS i stedet. Null kilobyte, og det går uten scroll.</p>
  </main>
</Base>
