---
/**
 * Målelab: SVG-linjer som tegner seg selv mens man scroller.
 *
 * KONKLUSJON, målt: ren CSS holder. Ingen av SVG-bibliotekene bør tas inn.
 *
 * Hele grunnen til at vivus (4,53 kB), lazy-line-painter (5,60 kB) og
 * walkway.js (1,80 kB) finnes, er å måle banelengden med JavaScript
 * (`getTotalLength()`) for å sette `stroke-dasharray` riktig. Det problemet
 * forsvinner med SVG-attributtet `pathLength="1"`: banen normaliseres til
 * lengde 1, og da er `stroke-dasharray: 1` og `stroke-dashoffset: 1 → 0`
 * alt som skal til. Null JavaScript, null måling, og det virker uansett hvor
 * lang eller kompleks banen er.
 *
 * Se docs/research-svg.md for kandidattabellen og målingene.
 *
 * Figuren lå tidligere hardkodet i denne fila og ble aldri tatt i bruk noe sted.
 * Den er nå komponenten src/components/Flyt.astro, med flytene som data i
 * src/data/flyter.ts. Denne siden viser alle variantene ved siden av hverandre,
 * så en endring i komponenten kan ses på tvers av nodeantall med én gang.
 */
import Base from "../../layouts/Base.astro";
import Flyt from "../../components/Flyt.astro";
import { flyter } from "../../data/flyter";

const varianter = [
  { nokkel: "systemer", hvor: "/systemer – i bruk" },
  { nokkel: "klinikker", hvor: "/bransjer/klinikker – foreslått" },
  { nokkel: "handverkere", hvor: "/bransjer/handverkere – foreslått" },
  { nokkel: "apper", hvor: "/apper-og-ai – foreslått" },
] as const;
---

<Base
  tittel="Målelab – SVG"
  beskrivelse="Intern målelab for SVG-linjer som tegner seg med scroll."
  noindex
>
  <div class="wrap lab">
    <div class="stack">
      <p class="kk-eyebrow"><span class="kk-eyebrow-n" aria-hidden="true">//</span> <span>Målelab</span></p>
      <h1 class="display-lg">Linjer som tegner seg selv</h1>
      <p class="body-lg muted" style="max-width: 62ch">
        Ren CSS, null JavaScript. Trikset er <code>pathLength="1"</code> på banen:
        da normaliseres lengden til 1, og <code>stroke-dashoffset</code> kan animeres
        uten at noe må måles med JavaScript først. Scroll ned – hver variant tegner
        seg når den kommer inn i skjermbildet.
      </p>
      <p class="small faint" style="max-width: 62ch">
        Standardtilstanden i CSS er <strong>ferdig tegnet</strong>. Bare der
        <code>animation-timeline: view()</code> finnes, skjules figuren og tegnes på
        nytt. I Firefox, som ikke har den ennå, står alt komplett av seg selv – ingen
        reserve trengs, og ingenting kan bli stående usynlig.
      </p>
    </div>

    <!-- Luft, så første figur kommer inn nedenfra og faktisk har noe å scrolle gjennom. -->
    <div style="height: 50svh" aria-hidden="true"></div>

    {varianter.map((v) => (
      <section class="lab__sak">
        <p class="mono-label faint">{v.hvor} · {flyter[v.nokkel].noder.length} ledd</p>
        <Flyt flyt={flyter[v.nokkel]} nivaa={2} />
      </section>
    ))}

    <div style="height: 60svh" aria-hidden="true"></div>
  </div>
</Base>

<style>
  .lab { padding-block: var(--space-8); display: grid; gap: var(--space-8); }
  .lab__sak { display: grid; gap: var(--space-3); }
</style>
