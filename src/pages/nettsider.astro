---
/**
 * /nettsider i wow-drakten (wow-undersider.md del 1.3 og del 4, wow-r8-B1).
 * Rekkefølge: kapittel 1 (bakeriet) → KodeBygg (sidens eget øyeblikk) → fire krav, med ekte
 * måling og dato der det finnes en, og ekte skjermbilder → prosess → pris → kontakt.
 *
 * Ute fra v1: Snitt (de fire kravene sier det samme), Storflate (KI utenfor et kapittel),
 * opptaket av lagstabelen (erstattet av ekte skjermbilder), terminalutsnittet og seksjonen
 * «Hva det er bygget av». Den siste venter på faktasjekk (planens åpne punkt 3: «Hosting
 * Cloudflare» og «0 kB JS på forsiden» stemmer ikke med nettstedet i dag), se rapporten.
 */
import MalWow from "../layouts/MalWow.astro";
import { Seksjon, Kravrader, Prosess, Prisliste, Kontaktblokk, Ramme } from "../components/wow/side";
import Kapittel from "../components/wow/Kapittel.astro";
import KodeBygg from "../components/wow/tjeneste/KodeBygg.astro";
import { kapittelForhandslast } from "../scripts/wow/kapittel-klipp";
import { tjeneste } from "../data/schema";
import { bookUrl } from "../data/firma";
import { pakker, prisenhet, mvaSetning } from "../data/priser";
import { tjenester, malinger, maltDato, maltDatoIso } from "../data/historie";

/**
 * Markupen kom fra `tjeneste()` i src/data/schema.ts, ikke skrevet her.
 *
 * Den som sto her før hadde `provider: { "@type": "ProfessionalService", name:
 * "KodeKonsulentene" }` – en NY foretaksnode uten `@id`. Google så da to
 * virksomheter på samme side: den ekte med org.nr. og en navnløs kopi. Nå peker
 * `provider` på `/#foretak`.
 */
const schema = tjeneste({
  type: "Utvikling av nettsider",
  navn: "Nettside til fast pris",
  beskrivelse:
    "Nettside bygget fra grunnen av: ytelse, lokal SEO, universell utforming og lovpålagt informasjon på plass før lansering. Du eier koden og domenet.",
  sti: "/nettsider",
  pakker: ["Start", "Bedrift"],
});

/**
 * Målingen bak et krav, når det finnes en: verdien og datoen fra historie.ts (samme kilde som
 * filmen og befaringsrapporten på forsiden). Finnes ikke raden, står kravet uten måling.
 */
/** historie.ts sier «mangler» der lampa heter «brudd». */
const lampe = (s: "bestatt" | "mangler" | "ikke-sjekket") => (s === "mangler" ? ("brudd" as const) : s);
const maalt = (etikett: string) => {
  const m = malinger.find((x) => x.etikett === etikett);
  return m ? { verdi: m.verdi, status: lampe(m.status), dato: maltDato, datoIso: maltDatoIso } : undefined;
};

const krav = [
  {
    tittel: "Rask på mobil",
    tekst:
      "Lighthouse 95 eller bedre på alle fire kategorier, målt på mobil. Største innhold malt under 2,5 sekunder. Vi viser tallet for vår egen side i footeren, så du kan sjekke at vi holder det vi selger.",
  },
  {
    tittel: "Funnet lokalt",
    tekst:
      "Google Bedriftsprofil satt opp riktig, samme navn, adresse og telefon overalt, og egne landingssider per tjeneste og bydel. Strukturert data slik at både Google og ChatGPT kan sitere deg.",
  },
  {
    tittel: "Lovlig fra dag én",
    tekst:
      "Org.nr. og foretaksnavn på siden, adresse og kontaktinfo etter ehandelsloven § 8, personvernerklæring, og WCAG 2.2 AA – strengere enn de 35 kravene private virksomheter må oppfylle.",
    maaling: maalt("Lovpålagt informasjon"),
  },
  {
    /* «Banneret som halvparten av besøkende lukker uten å lese» er fjernet (v1): et kvantifisert
       funn uten kilde. Hjemmelen er kontrollert mot Lovdata og står i src/data/kilder.ts. */
    tittel: "Uten cookie-banner",
    tekst:
      "Vi setter ingen cookies. Da er det ingenting å samtykke til, og du slipper banneret helt. Det er også den enkleste måten å overholde ekomloven § 3-15.",
    maaling: maalt("Cookies før samtykke"),
  },
];
---

<MalWow
  tittel="Nettsider til fast pris i Oslo"
  beskrivelse={`Nettside til fast pris i Oslo: Lighthouse 95+, lokal SEO, WCAG 2.2 AA og cookieløs analyse. ${pakker[0].navn} ${pakker[0].pris}, ${pakker[1].navn} ${pakker[1].pris} – ${prisenhet}.`}
  schema={[schema]}
  bevegelse="film"
  forhandslast={kapittelForhandslast(1, "skrubb")}
>
  <Kapittel
    nummer={1}
    tittel="En nettside som faktisk blir funnet"
    ingress="De fleste småbedriftssider er for trege på mobil, bryter cookie-reglene og mangler org.nr. Det er tre ting som koster kunder, og alle tre er løsbare."
    problem={tjenester.nettsider.problem}
    losning={tjenester.nettsider.losning}
    handlinger={[
      { tekst: "Book 20 minutter", href: bookUrl, type: "primar" },
      { tekst: "Sjekk siden du har i dag", href: "/sjekk", type: "lenke" },
    ]}
  />

  {/* Det vi selger, vist én gang i stedet for påstått. Sekvensen er tidsdrevet og starter når
      blokken kommer i syne (se KodeBygg). */}
  <Seksjon
    id="slik-blir-den-til"
    tittel="Fra kode til ferdig side"
    ingress="Til venstre står en ekte fil fra dette nettstedet, linje for linje. Til høyre står den samme fila rendret. Du trenger ikke lese koden – se hvor hver linje havner."
    storrelse="stor"
  >
    <KodeBygg />
  </Seksjon>

  <Seksjon id="krav" tittel="Fire krav vi setter selv" storrelse="tjeneste" tone="flate">
    <Kravrader rader={krav} />
  </Seksjon>

  {/* Ekte skjermbilder av sider vi har bygget (public/media/wow/ekte/), samme par som på
      forsiden. Lenket til siden det store bildet viser. Ikke KI, og merkes derfor ikke. */}
  <div class="wow-rute nett-arbeid">
    <a class="nett-arbeid__flater" href="/bransjer/klinikker">
      <Ramme
        type="nettleser"
        bilde="klinikker-d"
        adresse="kodekonsulentene.no/bransjer/klinikker"
        alt="Skjermbilde av bransjesiden for klinikker på kodekonsulentene.no."
        sizes="(min-width: 1024px) 60vw, 80vw"
        class="nett-arbeid__stor"
        avdekk
      />
      <Ramme
        type="telefon"
        bilde="handverkere-m"
        alt="Skjermbilde av bransjesiden for håndverkere på mobil."
        sizes="(min-width: 1024px) 16vw, 26vw"
        class="nett-arbeid__liten"
        parallax="-0.14"
      />
    </a>
  </div>

  <Prosess tittel="Fra samtale til lansering" />

  <Prisliste
    variant="kort"
    pakker={["Start", "Bedrift"]}
    id="priser-nettsider"
    gruppe="pakke-nettsider"
    tittel={`${pakker[0].pris} eller ${pakker[1].pris}`}
    ingress={`Start-pakken er for deg som trenger å finnes og bli ringt. Bedrift er for deg som skal rangere lokalt og endre teksten selv. ${mvaSetning}`}
  />

  <Kontaktblokk />
</MalWow>

<style>
  .nett-arbeid {
    padding-top: var(--wow-seksjon);
  }
  /* Et stort nettleservindu og en telefon forskjøvet over hjørnet, som på forsiden. */
  .nett-arbeid__flater {
    position: relative;
    display: block;
    grid-column: 1 / -1;
    padding-bottom: var(--wow-rom-5);
  }
  .nett-arbeid__flater:focus-visible {
    outline: var(--wow-kant-2) solid var(--wow-fokus);
    outline-offset: var(--wow-fokus-avstand);
    border-radius: var(--wow-radius-m);
  }
  .nett-arbeid__flater :global(.nett-arbeid__stor) {
    margin-right: 14%;
  }
  .nett-arbeid__flater :global(.nett-arbeid__liten) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
  }
  @media (min-width: 1024px) {
    .nett-arbeid__flater {
      grid-column: 2 / 12;
    }
    .nett-arbeid__flater :global(.nett-arbeid__stor) {
      margin-right: 16%;
    }
    .nett-arbeid__flater :global(.nett-arbeid__liten) {
      width: 22%;
    }
  }
</style>
