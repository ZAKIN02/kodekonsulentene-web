---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import SceneFilm from "../components/SceneFilm.astro";
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { prosess } from "../data/prosess";
import { pakker } from "../data/priser";
import { bookUrl } from "../data/firma";

import "../styles/scener.css";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Utvikling av nettsider",
  provider: { "@type": "ProfessionalService", name: "KodeKonsulentene" },
  areaServed: { "@type": "City", name: "Oslo" },
  offers: pakker.slice(0, 2).map((p) => ({
    "@type": "Offer",
    name: p.navn,
    price: p.pris.replace(/\D/g, ""),
    priceCurrency: "NOK",
    description: p.beskrivelse,
  })),
};
---
<Base
  tittel="Nettsider"
  beskrivelse="Nettside til fast pris i Oslo: Lighthouse 95+, lokal SEO, WCAG 2.2 AA og cookieløs analyse. Start 14 900 kr, Bedrift 29 900 kr eks. mva."
  schema={[schema]}
>
  <Scene lav>
    <Mega som="h1" merke="Nettsider" n={1} tekst="En nettside som faktisk blir funnet" aksent="funnet" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">De fleste småbedriftssider er for trege på mobil, bryter cookie-reglene og mangler org.nr. Det er tre ting som koster kunder, og alle tre er løsbare.</p>
    </Avslor>

    <Avslor>
    <div class="row">
      <Button variant="primary" href={bookUrl}>Book 20 minutter</Button>
      <Button variant="ghost" href="/sjekk">Sjekk siden du har i dag</Button>
    </div>
    </Avslor>
  </Scene>

  <Scene n={2} eyebrow="Hva du får" tittel="Fire krav vi setter selv">
    <Avslor>
    <div class="grid-2">
      <div class="card">
        <h3 class="heading">Rask på mobil</h3>
        <p class="muted">
          Lighthouse 95 eller bedre på alle fire kategorier, målt på mobil. Største innhold
          malt under 2,5 sekunder. Vi viser tallet for vår egen side i footeren, så du kan
          sjekke at vi holder det vi selger.
        </p>
      </div>
      <div class="card">
        <h3 class="heading">Funnet lokalt</h3>
        <p class="muted">
          Google Bedriftsprofil satt opp riktig, samme navn, adresse og telefon overalt, og
          egne landingssider per tjeneste og bydel. Strukturert data slik at både Google og
          ChatGPT kan sitere deg.
        </p>
      </div>
      <div class="card">
        <h3 class="heading">Lovlig fra dag én</h3>
        <p class="muted">
          Org.nr. og foretaksnavn på siden, adresse og kontaktinfo etter ehandelsloven § 8,
          personvernerklæring, og WCAG 2.2 AA – strengere enn de 35 kravene private
          virksomheter må oppfylle.
        </p>
      </div>
      <div class="card">
        <h3 class="heading">Uten cookie-banner</h3>
        <p class="muted">
          Vi bruker cookieløs analyse. Da er det ingenting å samtykke til, og du slipper
          banneret som halvparten av besøkende lukker uten å lese. Det er også den
          enkleste måten å overholde ekomloven § 3-15.
        </p>
      </div>
    </div>
    </Avslor>
  </Scene>

  <Scene n={3} eyebrow="Teknisk" tittel="Hva det er bygget av" ingress="Du trenger ikke å bry deg om dette. Det står her fordi noen spør, og fordi du skal kunne ta det med deg til en annen utvikler.">
    <Avslor>
    <div class="grid-2">
      <Terminal
        skriv
        title="~/din-side"
        lines={[
          { type: "cmd", text: "npm run build" },
          { type: "out", text: "astro build · 14 sider · 0 kB JS på forsiden" },
          { type: "cmd", text: "sjekk --budsjett" },
          { type: "ok", text: "0 cookies · 0 wcag-feil · 6/6 headere" },
          { type: "cmd", text: "curl -I din-side.no | grep -ci 'content-security'" },
          { type: "ok", text: "1" },
        ]}
        label="Terminalutsnitt: Astro-bygg med fjorten sider og null kilobyte JavaScript på forsiden, null cookies, null WCAG-feil, seks av seks sikkerhetsheadere, og Content-Security-Policy satt."
      />
      <dl class="kv">
        <div><dt>Rammeverk</dt><dd>Astro</dd></div>
        <div><dt>Hosting</dt><dd>Cloudflare</dd></div>
        <div><dt>Innhold</dt><dd>Markdown eller Sanity</dd></div>
        <div><dt>Analyse</dt><dd>Plausible, cookieløs</dd></div>
        <div><dt>Skjema</dt><dd>E-post + CRM</dd></div>
        <div><dt>Booking</dt><dd>Cal.com</dd></div>
        <div><dt>Eierskap</dt><dd>Ditt Git-repo</dd></div>
      </dl>
    </div>
    </Avslor>
  </Scene>

  <div class="scenefilm-ramme">
    <SceneFilm
      smal="/scener/nettsider-1280.mp4"
      bred="/scener/nettsider-1920.mp4"
      plakat="/scener/nettsider-poster.avif"
      tekst="venstre"
    />
  <Scene n={4} eyebrow="Prosess" tittel="Fra samtale til lansering">
    <ProcessSteps steps={prosess} />
  </Scene>
  </div>

  <Scene n={5} eyebrow="Pris" tittel="14 900 kr eller 29 900 kr" ingress="Start-pakken er for deg som trenger å finnes og bli ringt. Bedrift er for deg som skal rangere lokalt og endre teksten selv. Begge eks. mva.">
    <Button variant="primary" href="/priser">Se hele prislisten</Button>
  </Scene>

  <ContactBlock n={6} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  .scene:first-of-type .avslor {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
<style is:global>
  /* Scenetittelen bryter ut til 1320 px over 1200 px bredde (se
     .scene__head .stortekst i scener.css) og møter da filmen der masken
     slipper den inn. Masken skyves ut så overskriften står på ren bakgrunn.

     is:global er IKKE valgfritt her. .scenefilm ligger inne i SceneFilm.astro
     og får dét komponentens scope-id, mens .scenefilm-ramme får sidens. En
     vanlig <style> kompilerer til en selektor som krever sidens id på begge,
     og regelen matcher da ingenting – den er død CSS. Verifisert 6. oktober
     2026: med vanlig <style> ga maske 46 % og maske 92 % nøyaktig samme måling
     (5,11:1), fordi ingen av dem ble brukt. Med is:global flyttet tallet seg. */
  @media (min-width: 1200px) {
    .scenefilm-ramme .scenefilm--venstre {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 62%, rgb(0 0 0 / 0.25) 72%, #000 86%);
      mask-image: linear-gradient(90deg, transparent 0%, transparent 62%, rgb(0 0 0 / 0.25) 72%, #000 86%);
    }
  }
</style>
