---
import Base from "../layouts/Base.astro";
import Snitt from "../components/Snitt.astro";
import { snitt } from "../data/flyter";
import opptak from "../data/opptak.json";
import Demo from "../components/Demo.astro";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import KodeBygg from "../components/KodeBygg.astro";
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { prosess } from "../data/prosess";
import { pakker } from "../data/priser";
import { bookUrl } from "../data/firma";

import "../styles/scener.css";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Utvikling av nettsider",
  provider: { "@type": "ProfessionalService", name: "KodeKonsulentene" },
  areaServed: { "@type": "City", name: "Oslo" },
  offers: pakker.slice(0, 2).map((p) => ({
    "@type": "Offer",
    name: p.navn,
    price: p.pris.replace(/\D/g, ""),
    priceCurrency: "NOK",
    description: p.beskrivelse,
  })),
};
---
<Base
  tittel="Nettsider"
  beskrivelse="Nettside til fast pris i Oslo: Lighthouse 95+, lokal SEO, WCAG 2.2 AA og cookieløs analyse. Start 14 900 kr, Bedrift 29 900 kr eks. mva."
  schema={[schema]}
>
  <Scene lav>
    <Mega som="h1" merke="Nettsider" n={1} tekst="En nettside som faktisk blir funnet" aksent="funnet" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">De fleste småbedriftssider er for trege på mobil, bryter cookie-reglene og mangler org.nr. Det er tre ting som koster kunder, og alle tre er løsbare.</p>
    </Avslor>

    <Avslor trinn={2}>
      {/* Tegning med EKTE navn, hentet ordrett fra det som allerede står på siden.
          Brandboken rangerer diagram over generert materiale: det forklarer hva
          kunden får, og koster 0 kB. */}
      <Snitt snitt={snitt.nettside} nivaa={2} />
    </Avslor>

    <Avslor>
    <div class="row">
      <Button variant="primary" href={bookUrl}>Book 20 minutter</Button>
      <Button variant="ghost" href="/sjekk">Sjekk siden du har i dag</Button>
    </div>
    </Avslor>
  </Scene>

  {/* Det vi selger, vist én gang i stedet for påstått fem ganger.
      Her, rett etter overskriften, fordi det er sidens eneste innhold som
      forklarer HVA en nettside er for den som ikke har bygget en. Den står
      bevisst IKKE i en Avslor: avdekkingen er scroll-drevet og beveger seg bare
      mens noen scroller, og KodeBygg har sin egen tidsdrevne sekvens som spiller
      av seg selv når blokken er i syne. To lag bevegelse på samme element ville
      dessuten gjort at koden sto halvgjennomsiktig mens den ble skrevet. */}
  <Scene n={2} eyebrow="Slik blir den til" tittel="Fra kode til ferdig side" ingress="Til venstre står en ekte fil fra dette nettstedet, linje for linje. Til høyre står den samme fila rendret. Du trenger ikke lese koden – se hvor hver linje havner.">
    <KodeBygg />
  </Scene>

  <Scene n={3} eyebrow="Hva du får" tittel="Fire krav vi setter selv">
    {/* Karakteren paa denne sida er LAG – det er det snittegningen over viser, og
        det er det vi selger. De fire kravene ligger derfor i ulik dybde og drar fra
        hverandre mens du scroller, i stedet for aa staa som fire like ruter.
        Vekslende fortegn gir to plan, ikke en skraaning. */}
    <div class="grid-2">
      <Avslor trinn={0} fra="dybde" dybde={18} as="div" class="card">
        <h3 class="heading">Rask på mobil</h3>
        <p class="muted">
          Lighthouse 95 eller bedre på alle fire kategorier, målt på mobil. Største innhold
          malt under 2,5 sekunder. Vi viser tallet for vår egen side i footeren, så du kan
          sjekke at vi holder det vi selger.
        </p>
      </Avslor>
      <Avslor trinn={1} fra="dybde" dybde={-14} as="div" class="card">
        <h3 class="heading">Funnet lokalt</h3>
        <p class="muted">
          Google Bedriftsprofil satt opp riktig, samme navn, adresse og telefon overalt, og
          egne landingssider per tjeneste og bydel. Strukturert data slik at både Google og
          ChatGPT kan sitere deg.
        </p>
      </Avslor>
      <Avslor trinn={2} fra="dybde" dybde={12} as="div" class="card">
        <h3 class="heading">Lovlig fra dag én</h3>
        <p class="muted">
          Org.nr. og foretaksnavn på siden, adresse og kontaktinfo etter ehandelsloven § 8,
          personvernerklæring, og WCAG 2.2 AA – strengere enn de 35 kravene private
          virksomheter må oppfylle.
        </p>
      </Avslor>
      <Avslor trinn={3} fra="dybde" dybde={-20} as="div" class="card">
        <h3 class="heading">Uten cookie-banner</h3>
        <p class="muted">
          Vi bruker cookieløs analyse. Da er det ingenting å samtykke til, og du slipper
          banneret som halvparten av besøkende lukker uten å lese. Det er også den
          enkleste måten å overholde ekomloven § 3-15.
        </p>
      </Avslor>
    </div>

    {/* Flyttet ned fra aapningsscenen. Over folden kostet det 294 kB av sidens 420 –
        Demo henter 60 % av skjermhoeyden i forkant, saa 1074 px ned var innenfor
        rekkevidde. Her ligger det utenfor, OG det staar riktigere: beviset kommer
        etter de fire kravene det beviser, ikke foer. */}
    <Avslor trinn={2}>
      <Demo
        smal={opptak.lagstabel.smal}
        bred={opptak.lagstabel.bred}
        stor={opptak.lagstabel.stor}
        plakat={opptak.lagstabel.plakat}
        tekst={opptak.lagstabel.tekst}
        kilde={opptak.lagstabel.kilde}
      />
    </Avslor>
  </Scene>

  <Scene n={4} class="flate--varm" eyebrow="Teknisk" tittel="Hva det er bygget av" ingress="Du trenger ikke å bry deg om dette. Det står her fordi noen spør, og fordi du skal kunne ta det med deg til en annen utvikler.">
    <Avslor>
    <div class="grid-2">
      <Terminal
        skriv
        title="~/din-side"
        lines={[
          { type: "cmd", text: "npm run build" },
          { type: "out", text: "astro build · 14 sider · 0 kB JS på forsiden" },
          { type: "cmd", text: "sjekk --budsjett" },
          { type: "ok", text: "0 cookies · 0 wcag-feil · 6/6 headere" },
          { type: "cmd", text: "curl -I din-side.no | grep -ci 'content-security'" },
          { type: "ok", text: "1" },
        ]}
        label="Terminalutsnitt: Astro-bygg med fjorten sider og null kilobyte JavaScript på forsiden, null cookies, null WCAG-feil, seks av seks sikkerhetsheadere, og Content-Security-Policy satt."
      />
      <dl class="kv">
        <div><dt>Rammeverk</dt><dd>Astro</dd></div>
        <div><dt>Hosting</dt><dd>Cloudflare</dd></div>
        <div><dt>Innhold</dt><dd>Markdown eller Sanity</dd></div>
        <div><dt>Analyse</dt><dd>Plausible, cookieløs</dd></div>
        <div><dt>Skjema</dt><dd>E-post + CRM</dd></div>
        <div><dt>Booking</dt><dd>Cal.com</dd></div>
        <div><dt>Eierskap</dt><dd>Ditt Git-repo</dd></div>
      </dl>
    </div>
    </Avslor>
  </Scene>

  {/* Scenefilmen laa bak «Fire krav» og ble hentet foer brukeren scrollet:
      442 kB av sidens 568. Den er dessuten det MINST forklarende mediet her –
      snittegningen navngir lagene for 0 kB, og opptaket beviser dem. Brandboken
      rangerer generert materiale lavest, saa den bakker naa prosess-seksjonen
      lenger ned i stedet, der den er bakgrunn og ingen venter paa den. */}
  <div class="scenefilm-ramme">
  <Scene n={5} eyebrow="Prosess" tittel="Fra samtale til lansering">
    <ProcessSteps steps={prosess} />
  </Scene>
  </div>

  <Scene n={6} eyebrow="Pris" tittel="14 900 kr eller 29 900 kr" ingress="Start-pakken er for deg som trenger å finnes og bli ringt. Bedrift er for deg som skal rangere lokalt og endre teksten selv. Begge eks. mva.">
    <Button variant="primary" href="/priser">Se hele prislisten</Button>
  </Scene>

  <ContactBlock n={7} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
<style is:global>
  /* Filmen dempes i stedet for å maskeres bort.

     Scenetittelen bryter ut til 1320 px over 1200 px bredde (se
     .scene__head .stortekst i scener.css). Å skyve masken langt nok ut til å
     klarere den krevde 72 %, og da var filmen praktisk talt usynlig – den
     løste kontrasten ved å fjerne grunnen til at den var der. Lavere opasitet
     med standardmasken gir filmen tilbake over hele høyre halvdel og består
     likevel AA.

     Målt 6. oktober 2026 på /nettsider, verste tekst i rammen:
       opasitet 0,85 maske 62 %  ->  2,75:1  stryker
       opasitet 0,85 maske 72 %  ->  7,16:1  består, men filmen er borte
       opasitet 0,45 maske 52 %  ->  3,86:1  stryker
       opasitet 0,35 maske 46 %  ->  5,32:1  består, filmen synlig  <- valgt

     is:global er IKKE valgfritt. .scenefilm ligger inne i SceneFilm.astro og
     får dén komponentens scope-id, mens .scenefilm-ramme får sidens. En vanlig
     <style> kompilerer til en selektor som krever sidens id på begge, og
     matcher da ingenting. Verifisert: med vanlig <style> ga maske 46 % og
     maske 92 % nøyaktig samme måling, fordi ingen av dem ble brukt. */
  .scenefilm-ramme .scenefilm { opacity: 0.35; }
</style>
