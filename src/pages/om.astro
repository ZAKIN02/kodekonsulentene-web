---
import Base from "../layouts/Base.astro";
import opptak from "../data/opptak.json";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Lagstabel from "../components/Lagstabel.astro";
import Pekerkort from "../components/Pekerkort.astro";
import Demo from "../components/Demo.astro";
import Button from "../components/Button.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { bevis } from "../data/bevis";
import { firma } from "../data/firma";

const avslag = [
  { tittel: "Design uten utvikling", tekst: "Vi tegner ikke sider andre skal bygge. Da forsvinner ansvaret for at det faktisk virker." },
  { tittel: "Annonsekampanjer", tekst: "Vi bygger det folk lander på, ikke trafikken dit. Andre er bedre på det enn oss." },
  { tittel: "Nettbutikk på fremmed plattform", tekst: "Selger vi noe vi ikke kan vedlikeholde, sitter du igjen med en leverandør vi ikke styrer." },
  { tittel: "Prosjekt uten skriftlig omfang", tekst: "Uten avtalt omfang blir sluttregningen en diskusjon. Du får fast pris før vi begynner." },
];

import "../styles/scener.css";
---
<Base
  tittel="Om"
  beskrivelse="KodeKonsulentene er et utviklermiljø i Oslo med sikkerhet som spesialfelt. Du snakker med utvikleren som skriver koden."
>
  <Scene lav>
    <Mega som="h1" merke="Om" n={1} tekst="Du snakker med den som koder" aksent="koder" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Det er hele forskjellen mellom oss og et byrå. Det er også grunnen til at vi ikke kan ta inn tjue prosjekter i måneden.</p>
    </Avslor>

  </Scene>

  <Scene n={2} eyebrow="Oppsett" tittel="Hvorfor det er bygget slik" id="oppsett">
    <div class="grid-2">
      <div class="stack prose">
        <p class="body-lg muted">
          KodeKonsulentene er et utviklermiljø i Oslo. Vi kommer fra dataingeniørfaget
          med sikkerhet som spesialfelt, og bygger nettsider, interne systemer og apper
          for norske småbedrifter.
        </p>
        <h3>Hvorfor ingen mellomledd</h3>
        <p class="muted">
          I et byrå selger en senior, en junior bygger, og en prosjektleder forklarer
          hvorfor det tok lengre tid. Hos oss snakker du med utvikleren som skriver koden,
          hele veien. Du får svar innen {firma.svartid}.
        </p>
        <h3>Hvorfor sikkerhet</h3>
        <p class="muted">
          Fordi det er den delen ingen spør om før det er for sent. En nettside som setter
          Google Analytics før samtykke, eller som kan legges i en ramme på et annet domene,
          er et problem du ikke oppdager selv – du får det i fanget når noen klager.
          Derfor står sikkerhetsarbeidet i prisen, ikke i tilleggsmenyen.
        </p>
        <Button variant="ghost" href="/handbok">Les håndboken</Button>
      </div>

      <div class="stack">
        {/* Her sto det en grå plassholderboks med teksten «TODO: bilde fra arbeidet»,
            live på en salgsside. Lagstabelen er ikke pynt i stedet: den er en
            demonstrasjon du kan dra i, og den viser det avsnittene ved siden av
            påstår – at en nettside er lag, og at vi jobber i alle sammen. Vis,
            ikke påstå. */}
        <Lagstabel id="om-lag" />
        <p class="small faint">
          Dra i stabelen. De fire lagene er de samme vi leverer i hvert prosjekt –
          du betaler ikke for et byråledd mellom dem.
        </p>
      </div>
    </div>
      {/* Flyttet ned fra aapningsscenen. Over folden lastet de to opptakene 1999 kB
        av sidens 2155 ved foerstelast – maalt 433 og 134 px OVER folden, altsaa
        synlige uten aa scrolle, saa den late lastingen gjorde akkurat det den skal.
        Det var plasseringen som kostet. Forsiden viser alternativet: 0 kB film foer
        scroll. */}
    <Avslor trinn={2} fra="naer">
      {/* Ekte opptak av vaar egen side i drift. Brandboken rangerer dette oeverst:
          det BEVISER paastanden i stedet for aa illustrere den. */}
      <Demo
        smal={opptak.flyt.smal}
        bred={opptak.flyt.bred}
        stor={opptak.flyt.stor}
        plakat={opptak.flyt.plakat}
        tekst={opptak.flyt.tekst}
        kilde={opptak.flyt.kilde}
      />
    </Avslor>

    <Avslor trinn={2}>
      {/* Ekte bevegelse, ikke et stillbilde. Bare LYSET endrer seg mellom første og
          siste ramme – geometrien står bom stille, så Kling har ingenting å morfe.
          Det er den tekniske grunnen til at klippet ikke ser ut som billig AI-video. */}
      <Demo
        smal="/scener/lev-om-960.mp4"
        bred="/scener/lev-om-1280.mp4"
        stor="/scener/lev-om-1920.mp4"
        plakat="/scener/lev-om-poster.avif"
        tekst="Kantene på hvert lag i den samme stabelen. Den grønne linjen vandrer innover gjennom lagene, ett om gangen."
      />
    </Avslor>

  </Scene>

  <Scene n={3} eyebrow="Grenser" tittel="Hva vi ikke gjør" ingress="Et nei tidlig er billigere for deg enn et ja som ikke holder. Dette er de fire vi sier nei til oftest.">
    <div class="grid-2">
      {avslag.map((a, i) => (
        <Pekerkort nr={i + 1} tittel={a.tittel} tekst={a.tekst} />
      ))}
    </div>
    <p class="small faint">
      Trenger du noe av dette, sier vi det og sender deg videre til noen som er bedre på det.
    </p>
  </Scene>

  <div class="wrap">
    <ProofStrip items={bevis} label="Målbare påstander" />
  </div>

  <ContactBlock n={4} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
