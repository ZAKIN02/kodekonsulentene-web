---
/**
 * /om i wow-drakten (wow-undersider.md del 1.6 og 2.1, «film»).
 * Rekkefølge: kapittelet fra filmen (verkstedet, klipp 4) → «Hvorfor det er bygget slik» med det
 * ekte opptaket ved siden → «Hva vi ikke gjør» → de fire målingene av denne siden → kontakt.
 *
 * Siden snakker som «vi», og ingen person nevnes ved navn. «Hvem jeg er» med portrett rendres
 * ikke før eier har levert bilde og tekst.
 */
import MalWow from "../layouts/MalWow.astro";
import Kapittel from "../components/wow/Kapittel.astro";
import { Seksjon, Prosa, Tekstrader, Rapportark, Maaling, Opptak, Kontaktblokk } from "../components/wow/side";
import Handlinger from "../components/wow/side/Handlinger.astro";
import { kapittelFor, kapittelForhandslast } from "../scripts/wow/kapittel-klipp";
import { malinger, maltDato, maltDatoIso, maltAdresse } from "../data/historie";
import { firma } from "../data/firma";
import registeret from "../data/uu-register.json";

const kapittel = kapittelFor("/om")!;

const avslag = [
  { tittel: "Design uten utvikling", tekst: "Vi tegner ikke sider andre skal bygge. Da forsvinner ansvaret for at det faktisk virker." },
  { tittel: "Annonsekampanjer", tekst: "Vi bygger det folk lander på, ikke trafikken dit. Andre er bedre på det enn oss." },
  { tittel: "Nettbutikk på fremmed plattform", tekst: "Selger vi noe vi ikke kan vedlikeholde, sitter du igjen med en leverandør vi ikke styrer." },
  { tittel: "Prosjekt uten skriftlig omfang", tekst: "Uten avtalt omfang blir sluttregningen en diskusjon. Du får fast pris før vi begynner." },
];
---

<MalWow
  tittel="Om oss: utviklermiljø i Oslo"
  beskrivelse="KodeKonsulentene er et utviklermiljø i Oslo med sikkerhet som spesialfelt. Du snakker med utvikleren som skriver koden. Fast pris og åpne priser."
  bevegelse="film"
  forhandslast={kapittelForhandslast(kapittel.nummer, kapittel.modus)}
>
  {/* Platen og ingressen følger docs/design/tekst/r8-rettelser.md 3.2 og 3.3. Den andre setningen
      i v1-ingressen står nå sist i «Hvorfor ingen mellomledd». */}
  <Kapittel
    nummer={kapittel.nummer}
    modus={kapittel.modus}
    tittel="Du snakker med den som koder"
    ingress="Det er hele forskjellen mellom oss og et byrå."
    handlinger={[
      { tekst: "Book 20 minutter", href: "#kontakt", type: "primar" },
      { tekst: "Sjekk siden du har i dag", href: "/sjekk", type: "lenke" },
    ]}
    problem="Pulten. Tegninger kan ikke måles, så vi målte siden du leser nå."
    losning="Fire målinger av denne siden, med samme sjekk som du får."
  />

  <Seksjon id="oppsett" tittel="Hvorfor det er bygget slik" storrelse="tjeneste">
    <div class="om-oppsett">
      <div class="om-oppsett__tekst">
        <Prosa>
          <p>
            KodeKonsulentene er et utviklermiljø i Oslo. Vi kommer fra dataingeniørfaget
            med sikkerhet som spesialfelt, og bygger nettsider, interne systemer og apper
            for norske småbedrifter.
          </p>
          <h3>Hvorfor ingen mellomledd</h3>
          <p>
            I et byrå selger en senior, en junior bygger, og en prosjektleder forklarer
            hvorfor det tok lengre tid. Hos oss snakker du med utvikleren som skriver koden,
            hele veien. Du får svar innen {firma.svartid}. Det er også grunnen til at vi ikke
            kan ta inn tjue prosjekter i måneden.
          </p>
          <h3>Hvorfor sikkerhet</h3>
          <p>
            Fordi det er den delen ingen spør om før det er for sent. En nettside som setter
            Google Analytics før samtykke, eller som kan legges i en ramme på et annet domene,
            er et problem du ikke oppdager selv – du får det i fanget når noen klager.
            Derfor står sikkerhetsarbeidet i prisen, ikke i tilleggsmenyen.
          </p>
          {/* Ett tall, fra en kilde som ikke er oss. Avsnittene over er påstander om
              hvordan vi jobber; dette er den eneste setningen i kolonnen som kan
              kontrolleres hos tredjepart. Tallet hentes fra datafilen, ikke skrevet av –
              se src/data/uu-register.json. */}
          <p>
            Og det er ikke bare oss som mener det er vanskelig. Av{" "}
            {registeret.erklaeringer.toLocaleString("nb-NO")} tilgjengelighetserklæringer i
            Uu-tilsynets åpne register rapporterer{" "}
            {registeret.andelMedBrudd.toLocaleString("nb-NO", { minimumFractionDigits: 1, maximumFractionDigits: 1 })}{" "}
            prosent av virksomhetene selv at løsningen deres bryter minst ett WCAG-krav.
            Vi har regnet om tallene og skrevet opp hvilke krav det gjelder.
          </p>
        </Prosa>
        <Handlinger
          handlinger={[
            { tekst: "Les håndboken", href: "/handbok", type: "strek" },
            { tekst: "Kravene som brytes oftest", href: "/artikler/wcag-i-registeret", type: "strek" },
          ]}
        />
      </div>
      {/* Ekte opptak av vår egen side i drift: det beviser påstanden i stedet for å illustrere
          den. Ingenting hentes før opptaket skal spille (preload="none"). */}
      <Opptak class="om-oppsett__opptak" navn="flyt" adresse="kodekonsulentene.no/systemer" />
    </div>
  </Seksjon>

  <Seksjon
    id="grenser"
    tittel="Hva vi ikke gjør"
    ingress="Et nei tidlig er billigere for deg enn et ja som ikke holder. Dette er de fire vi sier nei til oftest."
    storrelse="tjeneste"
    tone="flate"
  >
    <Tekstrader rader={avslag} />
    <Prosa class="om-under">
      <p class="wow-notat">
        Trenger du noe av dette, sier vi det og sender deg videre til noen som er bedre på det.
      </p>
    </Prosa>
  </Seksjon>

  {/* V1 hadde en bevisstripe med fire tall. Her står bare det som er målt, med adresse og dato:
      de fire målingene fra /api/sjekk som også står i filmen og i rapporten på forsiden
      (src/data/historie.ts). «0,1 s svartid» er ikke dokumentert og står ikke; svartiden på
      henvendelser er et løfte og står i teksten over og i kontaktblokken. */}
  <Seksjon id="maalt" tittel="Det sjekken fant hos oss" storrelse="tjeneste">
    <Rapportark niva={3} skjultTittel adresse={maltAdresse} dato={maltDato} datoIso={maltDatoIso}>
        {malinger.map((m) => (
          <Maaling navn={m.etikett} verdi={m.verdi} status={m.status === "mangler" ? "brudd" : m.status} forbehold={m.forbehold} />
        ))}
    </Rapportark>
  </Seksjon>

  <Kontaktblokk />
</MalWow>

<style>
  .om-oppsett {
    display: grid;
    gap: var(--wow-rom-7) var(--wow-luke);
    align-items: start;
  }
  .om-oppsett__tekst {
    display: grid;
    gap: var(--wow-rom-6);
    min-width: 0;
  }
  .om-oppsett > :global(.om-oppsett__opptak) {
    min-width: 0;
  }
  :global(.om-under) {
    margin-top: var(--wow-rom-5);
  }
  @media (min-width: 1024px) {
    .om-oppsett {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .om-oppsett__tekst {
      grid-column: 1 / 8;
    }
    .om-oppsett > :global(.om-oppsett__opptak) {
      grid-column: 8 / 13;
      position: sticky;
      top: calc(var(--wow-hode-hoyde) + var(--wow-rom-6));
    }
  }
</style>
