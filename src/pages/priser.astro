---
/**
 * /priser i wow-drakten (wow-undersider.md del 1.5, mønsterside for wow-r8-grunnmur).
 * Rekkefølge: H1 + prisliste → tre ferdig regnede oppdrag → løpende priser og vilkår → tre år →
 * sammenligning med kilder → garantien → spørsmål → «Vet du ikke hva du trenger?» → kontakt.
 *
 * Alle beløp leses fra src/data/priser.ts, beregn() og markedspriser.ts. Også <title> og
 * description bygges derfra (de sto skrevet av for hånd i v1), og gir samme streng som før.
 */
import MalWow from "../layouts/MalWow.astro";
import { Seksjon, Prosa, Prisrader, Prisliste, Sporsmal, Refleksfelt, Kontaktblokk } from "../components/wow/side";
import Handlinger from "../components/wow/side/Handlinger.astro";
import { pakker, loepende, prisvilkaar, mvaSetning, treAar, MAANEDER } from "../data/priser";
import { markedspriser, markedTimepris } from "../data/markedspriser";
import { firma } from "../data/firma";
import { faq } from "../data/faq";
import { beregn, formaterKr } from "../lib/priskalkyle";

const prisFaq = faq.filter((f) => /binding|endre|koster|eier/i.test(f.q));

/**
 * TRE FERDIGE EKSEMPLER OVER SKYVEBRYTERNE.
 *
 * Prisvelgeren under er god, men den er bygget som den kalkulatoren NN/g
 * advarer mot: fire valg brukeren må ta før han får et tall. Rådet derfra er
 * eksplisitt – ved kompleks prising skal man vise eksempelpriser for typiske
 * scenarier, ikke kreve presise input. («Show Prices for Common Scenarios»,
 * Nielsen, 09.04.2006.)
 *
 * Så: ferdige svar først, kalkulatoren står igjen for den som vil regne selv.
 *
 * Tallene er IKKE skrevet inn. De kommer ut av `beregn()` – samme motor som
 * prisvelgeren og /verktoy/priskalkulator – med valgene som står i `valg`
 * under. Da kan et eksempel ikke love noe annet enn det kalkulatoren svarer
 * når kunden selv huker av det samme.
 */
const eksempler = [
  {
    hvem: "Rørlegger som skal finnes og bli ringt",
    hva: "3 sider, kontaktskjema, lovsjekk",
    valg: { sider: 3, cms: false, integrasjoner: [] as const, app: false },
  },
  {
    hvem: "Klinikk som vil endre teksten selv",
    hva: "6 sider med CMS, lokal SEO",
    valg: { sider: 6, cms: true, integrasjoner: [] as const, app: false },
  },
  {
    hvem: "Klinikk med timebestilling og Vipps i siden",
    hva: "6 sider med CMS, booking og Vipps-betaling",
    valg: { sider: 6, cms: true, integrasjoner: ["booking", "vipps"] as const, app: false },
  },
].map((e) => {
  const r = beregn({ ...e.valg, integrasjoner: [...e.valg.integrasjoner] });
  return {
    ...e,
    pakke: r.pakke,
    sum: r.lav === r.hoy ? formaterKr(r.lav) : `${formaterKr(r.lav)}–${formaterKr(r.hoy)}`,
    gulv: r.aapentOppe,
  };
});

/**
 * SAMMENLIGNINGSTABELLEN HENTER TALLENE SINE, DEN SKRIVER DEM IKKE AV.
 *
 * Her sto fire tall uten kilde, og ett av dem var målbart galt:
 *
 *   «499 kr/mnd» (i overskriften og i abonnementsraden) kom fra klarosites.no,
 *   et domene som ikke finnes – NXDOMAIN, ingen navnetjener. Raden er for lengst
 *   ute av markedspriser.ts og erstattet av WebPack 349 kr/mnd, som står på en
 *   side som svarer. Overskriften og raden hentes derfor fra `markedspriser` nå,
 *   og kan ikke komme i utakt med registeret igjen.
 *
 *   «Wix, Squarespace, Webflow: 150–180 kr/mnd» hadde ingen kilde noe sted.
 *   Kontrollert 7. oktober 2026: Squarespace priser i NOK (179/249/340/359/490
 *   per måned), mens Wix og Webflow serverer priser i USD til norske besøkende.
 *   Det finnes altså ikke ett norsk kronebeløp som dekker de tre, og 150–180 er
 *   under det laveste av dem. Raden er FJERNET, ikke justert: vi har ikke et
 *   tall vi kan forsvare for den gruppen.
 *
 *   «AI-byggere: fra 250 kr/mnd» hadde heller ingen kilde, og er fjernet.
 *
 * Reglen som gjelder videre: en rad i denne tabellen skal enten hente beløpet
 * fra src/data/markedspriser.ts, som test/kilder.test.ts holder i live, eller
 * bære kilde og dato synlig i raden selv.
 */
const abonnement = markedspriser.find((m) => m.enhet === "mnd");
if (!abonnement) {
  throw new Error(
    "Fant ingen abonnementsrad i markedspriser.ts. Sammenligningstabellen på /priser " +
      "henter billigste månedspris derfra, og skal ikke falle tilbake på et tall skrevet inn her.",
  );
}
/** «349» / «1 740» – vanlig mellomrom som tusenskiller, som ellers i huset. */
const nb = (n: number): string => n.toLocaleString("nb-NO").replace(/ | /g, " ");
const abonnementSpenn = `${nb(abonnement.lav ?? 0)}–${nb(abonnement.hoy ?? 0)} kr/mnd`;
const etablert = markedspriser.find(
  (m) => m.leverandor === "Etablerte byråer" && m.enhet === "engang" && m.hoy !== null,
);
/** Vår egen inngangspris, lest ut av prislisten og aldri skrevet av. */
const rimeligstePakke = pakker[0].pris;
/** «7. oktober 2026» av «2026-10-07». En ISO-dato midt i en setning leses ikke. */
const norskDato = (iso: string): string =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("nb-NO", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

// <title> og description: samme setninger som i v1, men tallene leses fra prislista.
const pakke = (navn: string) => pakker.find((p) => p.navn === navn)!;
const abonnementHosOss = loepende.find((r) => r.navn === "Abonnement")!;
const tittel = `Priser: nettside fra ${rimeligstePakke}`;
const beskrivelse =
  `Åpne priser: nettside fra ${rimeligstePakke}, Bedrift ${pakke("Bedrift").pris}, ` +
  `system fra ${pakke("System").pris}, abonnement ${abonnementHosOss.pris}. Timepris ${firma.timepris}. ` +
  (firma.mva ? mvaSetning : "Prisene er endelige – foretaket er ikke mva-registrert.");
---

<MalWow tittel={tittel} beskrivelse={beskrivelse} bevegelse="film">
  <div class="priser-topp">
    <Prisliste
      variant="kort"
      niva={1}
      id="prisliste"
      lenkeTilPriser={false}
      ingress={`Fordi du skal kunne regne på det før du ringer, og fordi den som skjuler prisen sjelden gjør det til din fordel. ${mvaSetning}`}
    />
  </div>

  {/* Ferdige svar før noen må velge noe. Se kommentaren ved `eksempler`. */}
  <Seksjon id="eksempler" tittel="Tre typiske oppdrag, ferdig regnet" storrelse="tjeneste">
    <Prisrader
      storrelse="pris"
      rader={eksempler.map((e) => ({
        navn: e.hvem,
        tekst: `${e.hva}, ${e.pakke}-pakken`,
        verdi: e.gulv ? `fra ${e.sum}` : e.sum,
      }))}
    />
    <Prosa class="priser-under">
      <p class="wow-notat">
        {/* V1: «… den samme kalkulatoren som står under». Kalkulatoren står ikke lenger på denne
            siden (Prislista erstatter v1-prisvelgeren), så de tre ordene er tatt ut og lenken
            peker dit den står. Tekstforfatter bør godkjenne (rapport wow-r8-grunnmur). */}
        Regnet ut av <a href="/verktoy/priskalkulator">den samme kalkulatoren</a>,
        med de valgene som er beskrevet. Står det «fra», er beløpet et gulv og ikke et tak – et
        systemoppdrag prises etter en samtale, og da er prisen fast.
      </p>
    </Prosa>
  </Seksjon>

  <Seksjon id="loepende" tittel="Drift, abonnement og timer" storrelse="tjeneste" tone="flate">
    <Prisrader rader={loepende.map((r) => ({ navn: r.navn, tekst: r.tekst, verdi: r.pris }))} />
    <Prosa class="priser-under">
      <ul class="wow-notat">
        {prisvilkaar.map((v) => <li>{v}</li>)}
        {/* Beløpene, lenken og datoen hentes fra markedspriser.ts, og Innovenas eget forbehold om
            at dette er veiledende anslag står med – ellers leser det som en måling. */}
        <li>
          Timeprisen er {firma.timepris}. Norske byråer tar {nb(markedTimepris.byraaLav)}–{nb(markedTimepris.byraaHoy)} kr/t
          og frilansere {nb(markedTimepris.frilansLav)}–{nb(markedTimepris.frilansHoy)} kr/t, etter{" "}
          <a href={markedTimepris.kilde[0]} rel="nofollow">Innovenas prisartikkel</a>,
          lest {norskDato(markedTimepris.sistSjekket)}. Innovena oppgir selv at tallene er veiledende anslag og
          ikke en markedsundersøkelse.
        </li>
      </ul>
    </Prosa>
  </Seksjon>

  {/* TOTALPRIS OVER TRE ÅR. Kjøperens første spørsmål, og det som avgjør mot et abonnement.
      Vi regner bare på VÅRE egne tall og gir formelen, så kan den som vil kjøre den på hvem som
      helst. Samme grep som at /sjekk sier «ikke sjekket» framfor å gjette. */}
  <Seksjon id="tre-aar" tittel="Hva det koster over tre år" storrelse="tjeneste">
    <Prisrader rader={treAar.map((r) => ({ navn: r.navn, tekst: r.forklaring, verdi: r.total }))} />
    <Prosa class="priser-under">
      <p class="wow-notat">
        Formelen er byggepris + {MAANEDER} × månedspris + avtalte ekstra.
        Kjør den på hvilket som helst tilbud du får, også våre. Et abonnement uten
        oppstartskostnad er ikke billigere enn et engangskjøp før du har ganget med
        antall måneder du faktisk blir værende.
      </p>
    </Prosa>
  </Seksjon>

  <Seksjon
    id="sammenligning"
    tittel={`Hvorfor ikke ${nb(abonnement.lav ?? 0)} kr i måneden`}
    ingress="Fordi du får noe annet. Her er hva pengene faktisk kjøper, slik at du kan ta valget selv."
    storrelse="tjeneste"
  >
    <Prosa>
      <table>
        <thead>
          <tr><th scope="col">Alternativ</th><th scope="col">Pris</th><th scope="col">Hva du får – og ikke får</th></tr>
        </thead>
        <tbody>
          {/* TO RADER ER FJERNET HERFRA MED VILJE («Wix, Squarespace, Webflow» og «AI-byggere»): de
              sto uten kilde. En rad her skal enten hente beløpet fra src/data/markedspriser.ts,
              som test/kilder.test.ts holder i live, eller bære kilde og dato synlig i raden. */}
          <tr><th scope="row">Abonnementsbyrå</th><td class="wow-ubrutt">{abonnementSpenn}</td><td>Malbasert side, levert raskt. Lite skreddersøm av systemer, og bindingstid.</td></tr>
          <tr>
            <th scope="row">Norsk byrå med pakkepris</th>
            {/* Ingen linjeskift mellom lenkene og tankestreken: Astro beholder mellomrommet rundt
                et inline-element, og spennet ble rendret som «4 900 – 9 990 kr». */}
            <td class="wow-ubrutt"><a href="https://skaatunweb.no/" rel="nofollow">4 900</a>–<a href="https://www.hjemmesidehelten.no/nettside-bedrift/" rel="nofollow">9 990 kr</a></td>
            <td>Ferdig oppsett, ofte på mal. Billigst i markedet. Sjekk hva som skjer med siden hvis du slutter å betale, og hvem som eier koden.</td>
          </tr>
          <tr><th scope="row">KodeKonsulentene</th><td class="wow-ubrutt">fra {rimeligstePakke}</td><td>Egenutviklet side, integrasjoner mot de systemene du har, sikkerhetsarbeid, og du eier koden.</td></tr>
          <tr><th scope="row">Etablert byrå</th><td class="wow-ubrutt">fra {nb(etablert?.lav ?? 0)} kr</td><td>Team, prosess og prosjektleder. For dyrt og for tregt for de fleste småbedrifter.</td></tr>
        </tbody>
      </table>
      <p class="wow-notat">
        Tallene for andre leverandører er lest på deres egne nettsider {norskDato(abonnement.sistSjekket)} og kan ha
        endret seg siden. De har kommersielle interesser og ulike definisjoner av «enkel nettside».
        Bruk dem som markedssignal, ikke som fasit. Hele oppstillingen med kilde og dato per rad står
        i <a href="/verktoy/priskalkulator#markedet">priskalkulatoren</a>.
      </p>
      {/* Pilottilbudet: ordrett samme setning som på /caser. Et tilbud skal lyde likt overalt. */}
      <p class="wow-notat">
        Vi tar inn to til tre pilotprosjekter til redusert pris mot at vi får bruke
        tallene som case. Si fra hvis det er aktuelt.
      </p>
    </Prosa>
  </Seksjon>

  <Refleksfelt />

  <Sporsmal liste={prisFaq} tittel="Om pris og binding" id="pris-faq" storrelse="tjeneste" />
  <div class="wow-rute priser-etter-faq">
    <Prosa>
      {/* Mellomrommet må stå eksplisitt: Astro fjerner linjeskiftet foran et inline-element. */}
      <p class="wow-notat">
        <a href="/vilkar">Salgsvilkårene</a> står i klartekst, og{" "}
        <a href="/handbok">håndboken</a> forklarer hvordan vi jobber.
      </p>
    </Prosa>
  </div>

  <Seksjon
    id="usikker"
    tittel="Vet du ikke hva du trenger?"
    ingress="Kjør den gratis sjekken på siden du har i dag. Da ser vi begge hva som er problemet før vi snakker om pris."
    storrelse="tjeneste"
  >
    <Handlinger
      handlinger={[
        { tekst: "Sjekk nettsiden din", href: "/sjekk", type: "primar" },
        { tekst: "Book 20 minutter", href: "/kontakt", type: "strek" },
      ]}
    />
  </Seksjon>

  <Kontaktblokk />
</MalWow>

<style>
  /* Prislista er sidens toppdel: H1 skal stå under det faste toppfeltet. */
  .priser-topp {
    padding-top: var(--wow-hode-hoyde);
  }
  .priser-under {
    margin-top: var(--wow-rom-5);
  }
  .priser-etter-faq {
    padding-top: var(--wow-rom-6);
  }
</style>
