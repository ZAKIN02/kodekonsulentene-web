---
// Prototype for retning A «Befaring». Frittstående side: ingen felles maler,
// stiler eller tokens – alt ligger her og i src/components/retning-a/.
// Tekst ordrett fra docs/design/tekst/retning-a.md.
// Farger, typografi og mål fra docs/design/retning.md (retning A).
// Scene-komponenten brukes slik docs/design/bevegelse.md beskriver.
// Siden har noindex og lenkes ikke fra menyen.
import Scene from '../../components/bevegelse/Scene.astro';
import Rapport from '../../components/retning-a/Rapport.astro';
import { hovedmeny } from '../../data/navigasjon';

const tittel = 'KodeKonsulentene – nettsider og systemer i Oslo';
const beskrivelse =
  'Gratis befaring av nettsiden din: rapport på 30 sekunder. Nettsider og systemer for norske småbedrifter i Oslo, til fast pris.';

const steg = [
  { tittel: 'Dette er nettsiden din', tekst: 'Fire lag og fem kabler. Utenfra ser du bare det øverste laget.' },
  { tittel: 'Jeg tar den fra hverandre', tekst: 'Lag for lag: design, kode, sikkerhet og integrasjoner.' },
  { tittel: 'Hvert lag blir målt', tekst: 'Laster siden raskt? Er den trygg? Henger booking, betaling og regnskap sammen?' },
  { tittel: 'Alt settes sammen igjen', tekst: 'Du får rapporten under – med det som er i orden, og det som mangler.' },
];
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={beskrivelse} />
    <title>{tittel}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="hode ramme">
        <a class="logo" href="/" aria-label="KodeKonsulentene – til forsiden">
          <img class="logo--lys" src="/logo/kk-lockup-light.svg" alt="" width="170" height="22" />
          <img class="logo--moerk" src="/logo/kk-lockup-dark.svg" alt="" width="170" height="22" />
        </a>
        <nav class="meny meny--bred" aria-label="Hovedmeny">
          <ul>
            {hovedmeny.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
        <details class="meny meny--smal">
          <summary>Meny</summary>
          <nav aria-label="Hovedmeny">
            <ul>
              {hovedmeny.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        </details>
    </header>

    <main>
      <section class="hero ramme" aria-labelledby="hero-tittel">
        <h1 id="hero-tittel">Gratis befaring av nettsiden din</h1>
        <p class="ingress">
          Rapport på 30 sekunder: cookies, sikkerhet, fart og om org.nr. står på siden.
        </p>
        <form class="sjekk" method="get" action="/sjekk">
          <label class="usynlig" for="adresse">Nettadresse</label>
          <input
            id="adresse"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="dinbedrift.no"
            required
            pattern="[^ ]+\.[^ ]+"
            aria-describedby="adresse-feil"
          />
          <button type="submit">Start befaringen</button>
          <p class="feil" id="adresse-feil">Det ser ikke ut som en nettadresse. Prøv formen dinbedrift.no.</p>
        </form>
        <p class="hint">Ingen innlogging. Du velger selv om rapporten skal sendes på e-post.</p>
        <p class="booklenke"><a href="/kontakt">Eller book 20 minutter</a></p>
      </section>

      <Scene navn="test" etikett="Slik befarer jeg en nettside" hoppTil="rapport" steg={steg} />
      <p class="kolofon ramme">Illustrasjon laget med KI</p>

      <Rapport />
    </main>
  </body>
</html>

<style is:global>
  /* Fontene er allerede selvhostet i public/fonts (700–800). Ingen tredjepartskall. */
  @font-face {
    font-family: 'Schibsted Grotesk';
    font-style: normal;
    font-weight: 700 800;
    font-display: swap;
    src: url('/fonts/schibsted-grotesk-700_800-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308,
      U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113,
      U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Schibsted Grotesk';
    font-style: normal;
    font-weight: 700 800;
    font-display: swap;
    src: url('/fonts/schibsted-grotesk-700_800-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304,
      U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Tokens for retning A, fra docs/design/retning.md. */
  :root {
    --betong: #e9eae6;
    --papir: #fbfbf9;
    --blekk: #111315;
    --refleks: #c8f24a;
    --snorblaa: #2443e0;
    --mangelroed: #b3301b;
    --lenke-natt: #8fa2ff;
    --mangel-natt: #ff8a73;

    --bunn: var(--betong);
    --tekst: var(--blekk);
    --lenke: var(--snorblaa);
    --skygge: 0 2px 24px #11131522;

    --skrift-tekst: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --skrift-vekt: 'Schibsted Grotesk', ui-sans-serif, system-ui, sans-serif;

    --ut: cubic-bezier(0.16, 1, 0.3, 1);
    --inn-ut: cubic-bezier(0.65, 0, 0.35, 1);
    --svar: 160ms;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bunn: var(--blekk);
      --tekst: var(--papir);
      --lenke: var(--lenke-natt);
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--bunn);
    color: var(--tekst);
    font-family: var(--skrift-tekst);
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--lenke);
    text-underline-offset: 0.2em;
  }

  :focus-visible {
    outline: 2px solid var(--lenke);
    outline-offset: 3px;
  }
</style>

<style>
  .ramme {
    padding-inline: clamp(1.25rem, 5vw, 5rem);
  }

  .hode {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .logo--moerk {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .logo--lys {
      display: none;
    }
    .logo--moerk {
      display: block;
    }
  }

  .meny--bred ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .meny--bred a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .meny--smal {
    position: relative;
    display: none;
  }

  .meny--smal summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-family: var(--skrift-vekt);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .meny--smal summary::-webkit-details-marker {
    display: none;
  }

  .meny--smal[open] nav {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 5;
    min-width: 13rem;
    background: var(--papir);
    border: 1px solid var(--blekk);
    border-radius: 2px;
    box-shadow: var(--skygge);
  }

  .meny--smal ul {
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }

  .meny--smal a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1.25rem;
    color: var(--snorblaa);
  }

  @media (max-width: 767px) {
    .meny--bred {
      display: none;
    }
    .meny--smal {
      display: block;
    }
  }

  /* Første skjerm slutter 64 px over folden, så toppen av scenen stikker opp. */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - 72px - 64px);
    padding-block: clamp(2rem, 6vh, 4rem) clamp(2.5rem, 8vh, 5rem);
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--skrift-vekt);
    font-weight: 800;
    font-size: clamp(2.75rem, 1.6rem + 5.2vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .ingress {
    margin: 1.5rem 0 0;
    max-width: 38rem;
    font-size: 1.125rem;
  }

  .sjekk {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    max-width: 44rem;
  }

  .usynlig {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .sjekk input {
    flex: 1 1 18rem;
    min-height: 56px;
    padding-inline: 1rem;
    background: var(--papir);
    color: var(--blekk);
    border: 2px solid var(--blekk);
    border-radius: 2px;
    font: inherit;
    font-size: 1.125rem;
  }

  .sjekk input::placeholder {
    color: var(--blekk);
    opacity: 0.55;
  }

  .sjekk button {
    min-height: 56px;
    padding-inline: 2rem;
    background: var(--refleks);
    color: var(--blekk);
    border: 1px solid var(--blekk);
    border-radius: 2px;
    font-family: var(--skrift-vekt);
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    transition: translate var(--svar) var(--ut);
  }

  .sjekk button:active {
    translate: 0 1px;
  }

  .feil {
    display: none;
    flex-basis: 100%;
    margin: 0;
    color: var(--mangelroed);
  }

  @media (prefers-color-scheme: dark) {
    .feil {
      color: var(--mangel-natt);
    }
  }

  .sjekk:has(input:user-invalid) .feil {
    display: block;
  }

  .hint {
    margin: 1rem 0 0;
    max-width: 38rem;
    font-size: 0.9375rem;
  }

  .booklenke {
    margin: 1.5rem 0 0;
  }

  .kolofon {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
  }
</style>
