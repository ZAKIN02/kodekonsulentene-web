---
// Prototype for retning B «Verkstedet om natta». Oppdrag f1-bygger-b.
// Frittstående side: ingen felles maler, stiler eller tokens. Fargene og kurvene
// er hentet fra docs/design/retning.md (retning B) og briefen del 8.
// Scenen bruker testklippene i public/scener/test/ til hero-klippene er klare.
// Tekst ordrett fra docs/design/tekst/retning-b.md.
import Scene from '../../components/bevegelse/Scene.astro';
import Hode from '../../components/retning-b/Hode.astro';
import Reel from '../../components/retning-b/Reel.astro';
import Sjekk from '../../components/retning-b/Sjekk.astro';

const steg = [
  { tittel: 'Fire lag og fem kabler', tekst: 'Utenpå ser alt greit ut. Rotet ligger inni.' },
  {
    tittel: 'Hvert lag løftes ut',
    tekst: 'Design, kode, sikkerhet og integrasjoner – hver del får navn og mål.',
  },
  {
    tittel: 'Hver del får en jobb',
    tekst: 'Siden skal laste raskt, være trygg å betale på, og booking skal snakke med regnskapet.',
  },
  {
    tittel: 'Så settes alt sammen',
    tekst: 'Ett system som henger sammen. Når delene passer, slutter du å være limet.',
  },
];
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KodeKonsulentene – nettsider og systemer i Oslo</title>
    <meta
      name="description"
      content="For norske småbedrifter som har vokst ut av Wix-siden: nettsider og systemer som henger sammen med booking, Vipps og regnskap – sikkert, raskt og til fast pris."
    />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-700_800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Hode />
    <main>
      <h1 class="setning">Slik ser en nettside ut innvendig</h1>
      <Scene
        navn="test"
        etikett="Nettsiden tatt fra hverandre og satt sammen igjen"
        hoppTil="sjekk"
        prioritet
        steg={steg}
      />
      <div class="etter-scenen">
        <p class="kolofon">Illustrasjon laget med KI</p>
        <Reel />
      </div>
      <Sjekk />
    </main>
  </body>
</html>

<style is:global>
  /* Verdier fra retningsplanen for B i docs/design/retning.md og briefen del 8. */
  :root {
    --natt: #0f1b2d;
    --benk: #18283f;
    --kritt: #eef1ec;
    --refleks: #c8f24a;
    --signalrod: #ff8a73;
    --mangelrod: #b3301b;

    /* Grå plassholder for materiale som mangler fra eier (kortets regel). */
    --plasshold-flate: #595959;
    --plasshold-tekst: #ffffff;

    /* Bevegelse, briefen del 8. */
    --ut: cubic-bezier(0.16, 1, 0.3, 1);
    --inn-ut: cubic-bezier(0.65, 0, 0.35, 1);
    --svar: 160ms;

    /* Mørkt er standard i retning B. */
    --bunn: var(--natt);
    --tekst: var(--kritt);
    --ark: var(--benk);
    --ark-kant: var(--benk);
    --felt-flate: var(--natt);
    --knapp-kant: var(--refleks);
    --fokus: var(--refleks);

    --font-tittel: 'Schibsted Grotesk', system-ui, sans-serif;
    --font-brodtekst: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    /* Erstatning til Big Shoulders Stencil er selvhostet (åpent punkt). */
    --font-sjablong: 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif;
  }

  @media (prefers-color-scheme: light) {
    :root {
      /* Lyst tema: kritt er bunn og natt er tekst. Signalrød byttes med mangelrød. */
      --bunn: var(--kritt);
      --tekst: var(--natt);
      --ark: var(--kritt);
      --ark-kant: var(--natt);
      --felt-flate: var(--kritt);
      --knapp-kant: var(--natt);
      --fokus: var(--natt);
    }
  }

  @font-face {
    font-family: 'Schibsted Grotesk';
    src: url('/fonts/schibsted-grotesk-700_800-latin.woff2') format('woff2');
    font-weight: 700 800;
    font-display: swap;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bunn);
    color: var(--tekst);
    font-family: var(--font-brodtekst);
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  :focus-visible {
    outline: 2px solid var(--fokus);
    outline-offset: 2px;
  }

  .setning {
    margin: 1.5rem 0 2rem;
    padding: 0 1.5rem;
    max-width: 18ch;
    font-family: var(--font-sjablong);
    font-weight: 700;
    font-size: clamp(2.875rem, 6.5vw, 5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  /* Uten JavaScript eller med redusert bevegelse er scenen et avrundet kort
     med luft rundt. Aktiv scene er i full bredde: klippbanen gir innrykket. */
  .scene:not([data-aktiv]) {
    margin-inline: 1.5rem;
  }

  /* Stegtekstene i scenen står på plater i benk, kritt på benk (13,03:1).
     Lesbarheten er den samme uansett hva filmen viser. */
  .scene__steg h2,
  .scene__steg p {
    margin: 0;
    background: var(--benk);
    color: var(--kritt);
  }
  .scene__steg h2 {
    padding: 1.25rem 1.5rem 0.25rem;
    border-radius: 12px 12px 0 0;
    font-family: var(--font-tittel);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
  }
  .scene__steg p {
    padding: 0.5rem 1.5rem 1.25rem;
    border-radius: 0 0 12px 12px;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .etter-scenen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.5rem;
    max-width: 74rem;
    margin: 0 auto;
  }
  .kolofon {
    margin: 0;
  }

  @media (min-width: 768px) {
    .setning {
      margin: 2rem 0 2.5rem;
      padding: 0 2.5rem;
      max-width: 24ch;
    }
    .scene:not([data-aktiv]) {
      margin-inline: 2.5rem;
    }
    .etter-scenen {
      padding: 1.5rem 2.5rem;
    }
  }
</style>
