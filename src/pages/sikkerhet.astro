---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import UrlCheck from "../components/UrlCheck.astro";
import CheckReport from "../components/CheckReport.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { loepende } from "../data/priser";

/**
 * Dette er ikke et salgsargument skrevet for hånd – det er svaret /api/sjekk og
 * /api/cookie-sjekk gir om vår egen forside. Målt 6. oktober 2026.
 * Endrer siden seg, skal disse tallene endres med den. Står det noe her vi ikke
 * kan måle på nytt i dag, er det en feil.
 */
const egenSjekk = [
  { name: "Ytelse", status: "neutral" as const, value: "204 ms", note: "Svartid målt fra Oslo. Lighthouse-score er ikke hentet inn her, og da sier vi «ikke sjekket» i stedet for å vise et tall vi ikke har målt." },
  { name: "Sikkerhetsheadere", status: "ok" as const, value: "6/6", note: "CSP, HSTS, X-Content-Type-Options, Referrer-Policy, Permissions-Policy og rammevern." },
  { name: "Cookies før samtykke", status: "ok" as const, value: "0", note: "Målt med en ekte nettleser, uten å klikke på noe: null cookies, null lagringsnøkler og null tredjepartskall." },
  { name: "Universell utforming", status: "ok" as const, value: "0 feil", note: "Ingen av de maskinelt testbare feilene. Kontrast, tastaturflyt og skjermleserrekkefølge må testes manuelt, og det er ikke gjort her." },
  { name: "Lovpålagt informasjon", status: "ok" as const, value: "Org.nr. bekreftet", note: "Nummeret er slått opp i Enhetsregisteret og tilhører KODEKONSULENTENE ELKASSMI." },
];

const tiltak = [
  ["Sikkerhetsheadere", "CSP, HSTS, X-Content-Type-Options, Referrer-Policy, Permissions-Policy og rammevern settes på alle leveranser – ikke bare de som ber om det."],
  ["Avhengighetsskanning", "Automatisk varsel ved kjent sårbarhet i en pakke, og oppdatering innen fem arbeidsdager på alle driftsavtaler."],
  ["Minste tilgang", "Databaser med radnivå-sikkerhet, egne nøkler per tjeneste, ingen delte innlogginger. Du eier alle kontoer."],
  ["Hemmeligheter", "Ingen nøkler i koden eller i Git. Alt ligger i plattformens hemmelighetslager, og roteres når noen slutter."],
  ["Sikkerhetskopi", "Daglig backup med test av gjenoppretting hver måned. En backup du ikke har prøvd å lese tilbake, er ikke en backup."],
  ["Rapport", "Du får en kort rapport ved lansering som sier hva som er testet og hva som ikke er det. Den er lesbar uten utviklerbakgrunn."],
];
---
<Base
  tittel="Sikkerhet"
  beskrivelse="Sikkerhetsheadere, avhengighetsskanning, GDPR og universell utforming på hver leveranse. Lovsjekk-pakke til fast pris: 7 900 kr eks. mva."
>
  <Section nivaa={1}
    n={1}
    eyebrow="Sikkerhet"
    tittel="Siden vår består sin egen sjekk"
    ingress="Det er lett å selge sikkerhet. Det er vanskeligere å bevise det. Derfor kjører vi den samme sjekken på vår egen side og viser resultatet her – også raden vi ikke består."
  >
    <CheckReport
      url="kodekonsulentene.no"
      date="oppdatert ved hver lansering"
      rows={egenSjekk}
      footer="Samlet: 90 av 100, målt 6. oktober 2026. Ytelsesraden står som «ikke sjekket» fordi Lighthouse ikke er kjørt."
    >
      <Button slot="action" variant="ghost" href="/sjekk">Kjør den på din side</Button>
    </CheckReport>
  </Section>

  <Section n={2} eyebrow="Et funn" tittel="Verktøyet tok oss selv" ingress="6. oktober 2026 kjørte vi cookie-skanningen mot vår egen forside. Den fant to tredjepartskall vi ikke visste om.">
    <div class="grid-2">
      <div class="stack">
        <p class="muted">
          Fontene våre lå hos Google. Ingen cookies ble satt, så den gamle sjekken –
          som bare leste HTML – meldte alt grønt. Men hver besøkende sendte
          IP-adressen sin til <span class="mono">fonts.gstatic.com</span> før de
          hadde gjort noe. På en side som selger «ingen tredjeparter før samtykke»
          er det en påstand vi ikke kunne forsvare.
        </p>
        <p class="muted">
          Fontene ligger nå på vår egen server. Det tok en time, og det er grunnen
          til at skanningen bruker en ekte nettleser i stedet for å lese kildekoden:
          forskjellen er nettopp funn som dette.
        </p>
      </div>
      <Terminal
        title="~/kodekonsulentene"
        lines={[
          { type: "cmd", text: "cookie-sjekk kodekonsulentene.no" },
          { type: "warn", text: "tredjepart: fonts.googleapis.com" },
          { type: "warn", text: "tredjepart: fonts.gstatic.com" },
          { type: "out", text: "" },
          { type: "cmd", text: "# fontene hentet hjem, ny kjøring" },
          { type: "ok", text: "cookies 0 · lagring 0 · tredjeparter 0" },
        ]}
        label="Terminalutsnitt: cookie-sjekken fant tredjepartskall til Google Fonts på vår egen side. Etter at fontene ble flyttet til egen server: null cookies, null lagring, null tredjeparter."
      />
    </div>
  </Section>

  <Section n={3} eyebrow="Hva som gjøres" tittel="Seks ting på hver leveranse" ingress="Dette er ikke et tillegg du kjøper. Det er en del av prisen, fordi en side som kan misbrukes til å lure dine kunder ikke er ferdig.">
    <div class="grid-2">
      {tiltak.map(([t, b]) => (
        <div class="card">
          <h3 class="subheading">{t}</h3>
          <p class="muted">{b}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section
    n={4}
    eyebrow="Lovkrav"
    tittel="Fire krav som er konkrete og testbare"
    ingress="De færreste bryter dem med vilje. De fleste vet ikke at de gjelder."
  >
    <div class="prose">
      <h3>Org.nr. og foretaksnavn</h3>
      <p class="muted">Registrert foretaksnavn og organisasjonsnummer skal stå på nettsiden. Er du mva-registrert, skal «MVA» stå etter nummeret.</p>
      <h3>Kontaktinformasjon (ehandelsloven § 8)</h3>
      <p class="muted">Geografisk adresse, e-postadresse og et nummer kunden kan nå deg på. Et kontaktskjema alene er ikke nok.</p>
      <h3>Cookie-samtykke (ekomloven § 3-15)</h3>
      <p class="muted">Fra 1. januar 2025 må samtykke oppfylle GDPR-kravene: ingen forhåndsavkryssing, «avvis» like lett tilgjengelig som «godta», og ingen sporing før samtykke er gitt. Den enkleste måten å overholde dette er å ikke sette cookies i det hele tatt.</p>
      <h3>Universell utforming</h3>
      <p class="muted">Private virksomheter skal oppfylle 35 krav i WCAG 2.0 nivå A og AA. Offentlig sektor har 48 krav i WCAG 2.1. Vi bygger etter WCAG 2.2 AA, som dekker begge.</p>
      <p class="small faint">Dette er ikke juridisk rådgivning. Få standardvilkår og personvernerklæring kvalitetssikret av advokat før du bruker dem i avtaler.</p>
    </div>
  </Section>

  <Section n={5} eyebrow="Lovsjekk" tittel="Rydd opp i den siden du har" ingress="Du trenger ikke ny nettside for å bli lovlig. Lovsjekk-pakken er fastpris på den du har, også om den er WordPress.">
    <div class="stack">
      <dl class="kv">
        {loepende.filter((r) => r.navn === "Lovsjekk-pakke").map((r) => (
          <div><dt><strong class="body-strong">{r.navn}</strong><br /><span class="small muted">{r.tekst}</span></dt><dd class="nowrap">{r.pris}</dd></div>
        ))}
      </dl>
      <UrlCheck buttonLabel="Sjekk gratis først" hint="Kjør den gratis sjekken før du bestemmer deg. Du ser selv hva som må gjøres." />
    </div>
  </Section>

  <ContactBlock n={6} />
</Base>
