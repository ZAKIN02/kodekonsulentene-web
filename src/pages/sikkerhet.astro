---
/**
 * /sikkerhet i wow-drakten (wow-undersider.md del 1.3b og del 4, wow-r8-B1). Tjenesteside uten
 * klipp. Rekkefølge: toppdel med rapportarket for vår egen side → SamtykkeSekvens → «Verktøyet
 * tok oss selv» (fortelling og ekte opptak) → «Seks ting på hver leveranse» → «Fire krav som er
 * konkrete og testbare» → Lovsjekk-pakken med pris og adressefeltet → kontakt.
 *
 * Målingene står ÉN gang på siden: rapportarket i toppen, med verdiene fra src/data/historie.ts
 * (/api/sjekk mot kodekonsulentene.no 18. nov. 2026, samme kilde som forsiden). V1 hadde en egen
 * rapport lenger ned med målingen fra 6. oktober; den er slått sammen med toppen (planen).
 * Ute fra v1: Storflate «Det sto åpent.» (generert klipp utenfor et kapittel) og terminalutsnittet
 * (funnet 6. oktober står som tekst).
 */
import MalWow from "../layouts/MalWow.astro";
import {
  SideHode,
  Seksjon,
  Prosa,
  Prisrader,
  Rapportark,
  Maaling,
  Tekstrader,
  Opptak,
  UrlFelt,
  Kontaktblokk,
} from "../components/wow/side";
import SamtykkeSekvens from "../components/wow/tjeneste/SamtykkeSekvens.astro";
import Rader from "../components/wow/tjeneste/Rader.astro";
import { tjeneste } from "../data/schema";
import { loepende, prisenhet } from "../data/priser";
import maalinger from "../data/maalinger.json";
import { malinger, maltDato, maltDatoIso, maltAdresse } from "../data/historie";

const tiltak = [
  ["Sikkerhetsheadere", "CSP, HSTS, X-Content-Type-Options, Referrer-Policy, Permissions-Policy og rammevern settes på alle leveranser – ikke bare de som ber om det."],
  ["Avhengighetsskanning", "Automatisk varsel ved kjent sårbarhet i en pakke, og oppdatering innen fem arbeidsdager på alle driftsavtaler."],
  ["Minste tilgang", "Databaser med radnivå-sikkerhet, egne nøkler per tjeneste, ingen delte innlogginger. Du eier alle kontoer."],
  ["Hemmeligheter", "Ingen nøkler i koden eller i Git. Alt ligger i plattformens hemmelighetslager, og roteres når noen slutter."],
  ["Sikkerhetskopi", "Daglig backup med test av gjenoppretting hver måned. En backup du ikke har prøvd å lese tilbake, er ikke en backup."],
  ["Rapport", "Du får en kort rapport ved lansering som sier hva som er testet og hva som ikke er det. Den er lesbar uten utviklerbakgrunn."],
];

/**
 * De fire lovkravene. Overskriften på det første navngir begge lovene, fordi hvilken som treffer
 * avhenger av registeret – se src/data/kilder.ts. Hjemmelen for cookie-samtykke er kontrollert
 * mot Lovdata 6. oktober 2026: ekomloven er LOV-2024-12-13-76, og § 3-15 heter «Bruk av
 * informasjonskapsler mv.». Den gamle § 2-7b i ekomloven av 2003 er opphevet. Ikke skriv om
 * dette uten å slå det opp på nytt.
 */
const lovkrav = [
  {
    tittel: "Org.nr. og foretaksnavn (foretaksregisterloven § 10-2 / ehandelsloven § 8)",
    tekst:
      "Registrert foretaksnavn og organisasjonsnummer skal stå på nettsiden. Står foretaket i Foretaksregisteret, følger kravet av foretaksregisterloven § 10-2; gjør det ikke det, krever ehandelsloven § 8 det samme av alle som tilbyr en tjeneste på nett. Er du mva-registrert, skal «MVA» stå etter nummeret.",
  },
  {
    tittel: "Kontaktinformasjon (ehandelsloven § 8)",
    tekst: "Geografisk adresse, e-postadresse og et nummer kunden kan nå deg på. Et kontaktskjema alene er ikke nok.",
  },
  {
    tittel: "Cookie-samtykke (ekomloven § 3-15)",
    forst: { tekst: "Ekomloven § 3-15", url: "https://lovdata.no/lov/2024-12-13-76/§3-15" },
    tekst:
      ", «Bruk av informasjonskapsler mv.», forbyr å lagre eller skaffe seg tilgang til opplysninger i utstyret til den som besøker siden uten at vedkommende har samtykket. Fra 1. januar 2025 må samtykket oppfylle kravene i personvernforordningen: ingen forhåndsavkryssing, «avvis» like lett tilgjengelig som «godta», og ingenting lagret før samtykke er gitt. Unntaket gjelder det som er strengt nødvendig for å levere tjenesten. Den enkleste måten å overholde dette på er å ikke sette cookies i det hele tatt.",
  },
  {
    tittel: "Universell utforming",
    tekst:
      "Private virksomheter skal oppfylle 35 krav i WCAG 2.0 nivå A og AA. Offentlig sektor har 48 krav i WCAG 2.1. Vi bygger etter WCAG 2.2 AA, som dekker begge.",
  },
];

/**
 * Fra `tjeneste()`, uten `pakker`: lovsjekk-pakken ligger i `loepende` i priser.ts, ikke i
 * `pakker`, og hjelperen leser bare den siste. Heller ingen pris i markupen enn en pris hentet
 * fra feil liste.
 */
const schema = tjeneste({
  type: "Sikkerhetsgjennomgang og lovsjekk av nettsider",
  navn: "Sikkerhet og lovsjekk",
  beskrivelse:
    "Sikkerhetsheadere, avhengighetsskanning, tilgangsstyring og sikkerhetskopi paa hver leveranse, og lovsjekk av cookie-samtykke, universell utforming, org.nr.-krav og personvernerklaering.",
  sti: "/sikkerhet",
});

/** Lovsjekk-prisen hentes fra prislisten, aldri skrevet av. */
const lovsjekk = loepende.filter((r) => r.navn === "Lovsjekk-pakke");
const lovsjekkPris = lovsjekk[0]?.pris ?? "";
---

<MalWow
  tittel="Sikkerhet og lovkrav på nettsider"
  beskrivelse={`Sikkerhetsheadere, avhengighetsskanning, GDPR og universell utforming på hver leveranse. Lovsjekk-pakke til fast pris: ${lovsjekkPris} – ${prisenhet}.`}
  schema={[schema]}
  bevegelse="film"
>
  {/*
    «LOVBRUDDET DE FLESTE NORSKE NETTSIDER GJØR» VAR EN PÅSTAND VI IKKE HAR MÅLT (v1). Vi har målt
    38 forsider, trukket fra Enhetsregisteret innenfor sju næringskoder. 79 % av dem satte cookies
    før samtykke. Det er et funn i ET UTVALG, ikke i «norske nettsider». Ingressen sier hva vi
    faktisk fant og hvor mange det var; lenken til sjekken står som handling under.
  */}
  <SideHode
    tittel="Siden vår består sin egen sjekk"
    ingress={`Det er lett å selge sikkerhet. Det er vanskeligere å bevise det. Her er bruddet vi fant på ${maalinger.andelProsent.settercookiesForSamtykke} % av de ${maalinger.utvalg.svarte} sidene vi målte, vist steg for steg – og det sjekken fant på vår egen side.`}
    storrelse="stor"
    handlinger={[{ tekst: "Kjør den på din side", href: "/sjekk", type: "primar" }]}
  >
    <Rapportark slot="side" skjultTittel adresse={maltAdresse} dato={maltDato} datoIso={maltDatoIso}>
      {malinger.map((m) => (
        <Maaling navn={m.etikett} verdi={m.verdi} status={m.status === "mangler" ? "brudd" : m.status} forbehold={m.forbehold} />
      ))}
    </Rapportark>

    {/* Sekvensen spiller når den kommer i syne, én gang. Uten JavaScript står den ferdig. */}
    <div class="wow-rute sik-sekvens">
      {/* To målinger, to datoer (r8-rettelser.md punkt 7). Notatet fjernes når begge er kjørt på
          nytt samme dag. */}
      <Prosa>
        <p class="wow-notat">
          Rapporten over er nettsidesjekken, kjørt 18. november 2026. Sekvensen under bygger på
          cookie-skanningen i ekte nettleser, kjørt 6. oktober 2026. Derfor to datoer.
        </p>
      </Prosa>
      <SamtykkeSekvens />
    </div>
  </SideHode>

  {/* Bekjennelsen står på egen flate: seksjonen er et annet register – vi innrømmer en feil. */}
  <Seksjon
    id="funn"
    tittel="Verktøyet tok oss selv"
    ingress="6. oktober 2026 kjørte vi cookie-skanningen mot vår egen forside. Den fant to tredjepartskall vi ikke visste om."
    storrelse="stor"
    tone="flate"
  >
    <Prosa>
      <p>
        Fontene våre lå hos Google. Ingen cookies ble satt, så den gamle sjekken –
        som bare leste HTML – meldte alt grønt. Men hver besøkende sendte
        IP-adressen sin til <code>fonts.gstatic.com</code> før de
        hadde gjort noe. På en side som selger «ingen tredjeparter før samtykke»
        er det en påstand vi ikke kunne forsvare.
      </p>
      <p>
        Fontene ligger nå på vår egen server. Det tok en time, og det er grunnen
        til at skanningen bruker en ekte nettleser i stedet for å lese kildekoden:
        forskjellen er nettopp funn som dette.
      </p>
      {/* Sto som terminalutsnitt i v1. Setningen er utsnittets skjermlesertekst. */}
      <p class="wow-notat">
        Cookie-sjekken fant tredjepartskall til Google Fonts på vår egen side. Etter at fontene ble
        flyttet til egen server: null cookies, null lagring, null tredjeparter.
      </p>
    </Prosa>
    {/* Terminalen kjører de samme sjekkene som verktøyene, her mot vårt EGET domene. Regelen om å
        ikke navngi sider som kommer dårlig ut, gjelder ikke oss selv. Ekte opptak, ikke KI. */}
    <Opptak navn="terminal" adresse="kodekonsulentene.no/terminal" class="sik-opptak" />
  </Seksjon>

  <Seksjon
    id="tiltak"
    tittel="Seks ting på hver leveranse"
    ingress="Dette er ikke et tillegg du kjøper. Det er en del av prisen, fordi en side som kan misbrukes til å lure dine kunder ikke er ferdig."
    storrelse="tjeneste"
  >
    <Tekstrader rader={tiltak.map(([tittel, tekst]) => ({ tittel, tekst }))} />
  </Seksjon>

  <Seksjon
    id="lovkrav"
    tittel="Fire krav som er konkrete og testbare"
    ingress="De færreste bryter dem med vilje. De fleste vet ikke at de gjelder."
    storrelse="tjeneste"
    tone="flate"
  >
    <Rader rader={lovkrav} />
    <Prosa class="sik-under">
      <p class="wow-notat">Dette er ikke juridisk rådgivning. Få standardvilkår og personvernerklæring kvalitetssikret av advokat før du bruker dem i avtaler.</p>
    </Prosa>
  </Seksjon>

  <Seksjon
    id="lovsjekk"
    tittel="Rydd opp i den siden du har"
    ingress="Du trenger ikke ny nettside for å bli lovlig. Lovsjekk-pakken er fastpris på den du har, også om den er WordPress."
    storrelse="stor"
  >
    <Prisrader storrelse="pris" rader={lovsjekk.map((r) => ({ navn: r.navn, tekst: r.tekst, verdi: r.pris }))} />
    <div class="sik-sjekk">
      <UrlFelt
        id="url-sikkerhet"
        knapp="Sjekk gratis først"
        hint="Kjør den gratis sjekken før du bestemmer deg. Du ser selv hva som må gjøres."
      />
    </div>
  </Seksjon>

  <Kontaktblokk />
</MalWow>

<style>
  .sik-sekvens {
    padding-top: var(--wow-seksjon-tett);
  }
  .sik-sekvens > :global(*) {
    grid-column: 1 / -1;
  }
  :global(.sik-opptak) {
    margin-top: var(--wow-rom-7);
  }
  :global(.sik-under) {
    margin-top: var(--wow-rom-5);
  }
  .sik-sjekk {
    margin-top: var(--wow-rom-7);
    max-width: 44rem;
  }
</style>
