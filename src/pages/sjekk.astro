---
/**
 * /sjekk i wow-drakten (wow-undersider.md del 1.8 og tabellen i del 4, runde wow-r8-B2).
 * Rekkefølge: Verktoyramme (brødsmuler, H1, feltet, resultatet) → de fem punktene → hva sjekken
 * faktisk finner (målte tall og ekte opptak) → «Etterpå» → kontaktblokk. «rolig»: ingenting
 * beveger seg uten at brukeren har gjort noe.
 *
 * Uendret fra v1: API-kallet (POST /api/sjekk med { url }, og { url, epost } for e-posten),
 * id-ene `#url-sjekk`, `#resultat` og `#r-epost`, feltnavnene `url` og `epost`, alle feiltekster,
 * forbeholdene, `?url=`-oppførselen (tests/sjekk-url.spec.ts) og WebApplication-markupen.
 * Nytt: resultatet står i rapportspråket (lampe + status som ord), og fokus flyttes til
 * rapportens tittel når den er klar.
 *
 * Ute: SjekkSekvens (sekvensen spilte av seg selv, og «rolig» har ingen bevegelse uten handling),
 * terminalutsnittet «sjekk --hva» (kommandoen finnes ikke; linjene står som liste) og
 * `$ sjekk …`-teksten mens sjekken går.
 */
import MalWow from "../layouts/MalWow.astro";
import { Verktoyramme, UrlFelt, Seksjon, Prosa, Tekstrader, Opptak, Kontaktblokk } from "../components/wow/side";
import Handlinger from "../components/wow/side/Handlinger.astro";
import ForOgEtter from "../components/wow/verktoy/ForOgEtter.astro";
import { verktoy } from "../data/schema";
import { firma } from "../data/firma";
import { loepende, prisenhet } from "../data/priser";

/* Prisen hentes fra prislisten, aldri skrevet av. */
const lovsjekkPris = loepende.find((r) => r.navn === "Lovsjekk-pakke")?.pris ?? "";

// Siden er statisk. Sjekken kjøres av skriptet under mot /api/sjekk. I bygget er searchParams
// tom; skriptet leser ?url= fra location.search. Linja under fyller feltet bare i `astro dev`.
const forhandsutfylt = Astro.url.searchParams.get("url") ?? "";
/**
 * `WebApplication` fra `verktoy()` i src/data/schema.ts. `price: "0"` og
 * `isAccessibleForFree` er sanne: verktøyet krever ingen innlogging og koster ingenting.
 */
const schema = verktoy({
  navn: "Sjekk nettsiden din",
  beskrivelse:
    "Sjekker ytelse, sikkerhetsheadere, cookies satt foer samtykke, maskinelt testbare WCAG-feil og lovpaalagt informasjon paa en nettside, og verifiserer org.nr. mot Enhetsregisteret.",
  sti: "/sjekk",
});

/** De fem punktene, i rekkefølgen sjekken rapporterer dem. */
const punkter = [
  { tittel: "Ytelse", tekst: "Lighthouse, mobil" },
  { tittel: "Sikkerhetsheadere", tekst: "CSP, HSTS, +4" },
  { tittel: "Cookies før samtykke", tekst: "ekomloven § 3-15" },
  { tittel: "Universell utforming", tekst: "WCAG 2.0 A/AA" },
  { tittel: "Lovpålagt informasjon", tekst: "org.nr., ehandelsloven § 8" },
];
---

<MalWow
  tittel="Sjekk nettsiden din"
  beskrivelse="Gratis sjekk av ytelse, sikkerhetsheadere, cookies før samtykke, universell utforming og lovpålagt informasjon. Rapport på 30 sekunder."
  schema={[schema]}
  bevegelse="rolig"
>
  <Verktoyramme
    tittel="Sjekk nettsiden din"
    ingress="Fem ting som er konkrete, testbare og som svært mange norske småbedriftssider bryter minst ett av. Du får svaret i klartekst, ikke i utviklersjargong."
  >
    <UrlFelt
      slot="skjema"
      id="url-sjekk"
      knapp="Kjør sjekken"
      verdi={forhandsutfylt}
      hint="Vi laster forsiden din én gang, slik en besøkende får den. Ingenting lagres."
    />
    <p slot="noscript">
      Sjekken krever JavaScript. Send adressen til{" "}
      <a class="wow-lenke" href={`mailto:${firma.epost}?subject=Nettsidesjekk`}>{firma.epost}</a>,
      så kjører vi den manuelt og sender rapporten samme dag.
    </p>
  </Verktoyramme>

  <Seksjon id="punktene" tittel="Fem punkter, i denne rekkefølgen" storrelse="tjeneste" tett>
    <div class="wow-vt-stabel">
      <Tekstrader rader={punkter} />
      <Prosa>
        <p class="wow-notat">
          Private virksomheter skal oppfylle 35 krav i WCAG 2.0 nivå A og AA. Fra 1. januar 2025
          krever ekomloven § 3-15 at cookie-samtykke oppfyller GDPR-kravene: ingen forhåndsavkryssing,
          «avvis» like lett som «godta», ingen sporing før samtykke.
        </p>
        {/* V1 hadde et terminalutsnitt («sjekk --hva») her. Kommandoen finnes ikke, så det var
            pynt. Linjene står som liste, med de samme ordene. */}
        <ul>
          <li>Henter forsiden én gang, uten å kjøre JavaScript</li>
          <li>Leser svarheadere og HTML</li>
          <li>Rapporterer bare det som er målt</li>
          <li>Kontrast og tastaturbruk må testes manuelt</li>
        </ul>
        <p class="wow-notat">
          Verktøyet overdriver aldri funnene. Det som ikke kan måles, får status «Ikke sjekket» og
          en setning om hvorfor. Dette er ikke juridisk rådgivning.
        </p>
      </Prosa>
    </div>
  </Seksjon>

  <Seksjon id="malt" tittel="Hva sjekken faktisk finner" storrelse="tjeneste">
    <div class="wow-vt-stabel">
      {/* Ekte tall fra vår egen motor mot sider trukket fra Enhetsregisteret, ikke håndplukket.
          Ingen av dem navngis (docs/metode-skanning.md). Raden om oss selv viser våre egne feil
          med rød lampe når vi har noen. */}
      <ForOgEtter />
      {/* Opptak av vår egen sjekk: 50 av 100 mot 90, med radene som skiller dem navngitt. */}
      <div class="wow-vt-opptak">
        <Opptak navn="sammenlign" adresse="kodekonsulentene.no/sjekk" />
      </div>
    </div>
  </Seksjon>

  <Seksjon
    id="etterpa"
    tittel="Vil du at vi fikser det?"
    ingress={`Lovsjekk-pakken er ${lovsjekkPris} – ${prisenhet} – og dekker cookies, universell utforming, lovpålagt informasjon og personvernerklæring på den siden du har i dag. Du trenger ikke ny nettside for det.`}
    storrelse="tjeneste"
  >
    <Handlinger
      handlinger={[
        { tekst: "Se hva det koster", href: "/priser", type: "primar" },
        { tekst: "Les om sikkerhetsarbeidet", href: "/sikkerhet", type: "strek" },
      ]}
    />
  </Seksjon>

  <Kontaktblokk
    tittel="Eller bare ring"
    ingress="Har du rapporten foran deg og vil vite hva som er viktigst å starte med, tar det fem minutter på telefon."
  />
</MalWow>

<script>
  import { maalingHtml, rapportarkHtml, fraSjekk } from "../components/wow/side/maaling";

  type Status = "ok" | "warn" | "fail" | "neutral";
  interface Rad { name: string; status: Status; value: string; note: string }
  interface Rapport { url: string; dato: string; rader: Rad[]; totalt: number; forbehold: string[]; sendt: boolean }

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const boks = document.querySelector<HTMLElement>("#resultat")!;
  const felt = document.querySelector<HTMLInputElement>("#url-sjekk")!;
  const skjema = felt.closest("form");

  // De fem radene sjekken rapporterer (src/lib/sjekk.ts). Samme navn mens den venter.
  const RADER = ["Ytelse", "Sikkerhetsheadere", "Cookies før samtykke", "Universell utforming", "Lovpålagt informasjon"] as const;

  /** Én rad utenfor et rapportark: sjekken kjørte ikke. «Ikke sjekket», aldri «Bestått» eller «Brudd». */
  const stoppet = (hvorfor: string) => {
    boks.innerHTML = maalingHtml({ navn: "Sjekken stoppet", status: "ikke-sjekket", merknad: hvorfor }, "div");
  };

  function tegn(r: Rapport) {
    boks.innerHTML =
      rapportarkHtml({
        tittelId: "rapport-tittel",
        // Statusen kommer fra sjekken, uendret: «neutral» er «Ikke sjekket», med årsaken i `note`.
        rader: r.rader.map((x) => ({ navn: x.name, verdi: x.value, status: fraSjekk[x.status], merknad: x.note })),
        adresse: r.url,
        dato: `${r.dato}. Samlet: ${r.totalt} av 100`,
      }) +
      `<form class="wow-skjema wow-vt-send" data-send>
         <h3>Få rapporten på e-post</h3>
         <div class="wow-skjema__felt">
           <label for="r-epost">E-post</label>
           <input id="r-epost" name="epost" type="email" autocomplete="email" required placeholder="din@bedrift.no" aria-describedby="r-epost-hint" />
           <p class="wow-skjema__hint" id="r-epost-hint">Vi bruker adressen til å sende denne rapporten. Ingen nyhetsbrev.</p>
         </div>
         <button class="wow-knapp wow-knapp--strek" type="submit"><span class="wow-knapp__tekst">Send rapporten</span></button>
         <p data-send-status></p>
       </form>` +
      `<div class="wow-prosa">
         <details>
           <summary>Forbehold – hva sjekken ikke ser</summary>
           <ul class="wow-notat">${r.forbehold.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>
         </details>
       </div>`;

    const sendSkjema = boks.querySelector<HTMLFormElement>("[data-send]")!;
    const status = boks.querySelector<HTMLElement>("[data-send-status]")!;
    sendSkjema.addEventListener("submit", async (e) => {
      e.preventDefault();
      const epost = sendSkjema.querySelector<HTMLInputElement>("#r-epost")!.value;
      status.textContent = "Sender …";
      try {
        const svar = await fetch("/api/sjekk", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ url: felt.value, epost }),
        });
        const data = (await svar.json()) as { sendt?: boolean; feil?: string };
        status.textContent = data.sendt
          ? "Sendt. Sjekk innboksen – og søppelposten, for sikkerhets skyld."
          : "Klarte ikke å sende e-posten nå. Rapporten står fortsatt over, og du kan kopiere den.";
      } catch {
        status.textContent = "Klarte ikke å sende e-posten nå. Rapporten står fortsatt over.";
      }
    });

    // Resultatet er klart: flytt fokus til rapportens tittel, så skjermleseren starter der.
    document.getElementById("rapport-tittel")?.focus({ preventScroll: false });
  }

  async function kjor(url: string) {
    if (!url.trim()) return;
    boks.setAttribute("aria-busy", "true");
    // Venter: de samme fem radene, uten verdi. Ingen spinner.
    boks.innerHTML =
      rapportarkHtml({ rader: RADER.map((navn) => ({ navn, status: "venter" as const })), adresse: url }) +
      `<p class="wow-vt-venter">Dette tar vanligvis 10–30 sekunder. Lighthouse-målingen er den som bruker tid.</p>`;
    try {
      const svar = await fetch("/api/sjekk", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ url }),
      });
      const data = (await svar.json()) as Rapport & { feil?: string };
      if (!svar.ok || data.feil) {
        stoppet(data.feil ?? "Ukjent feil.");
        return;
      }
      tegn(data);
    } catch {
      stoppet("Fikk ikke svar fra serveren. Prøv igjen om et øyeblikk.");
    } finally {
      boks.setAttribute("aria-busy", "false");
    }
  }

  skjema?.addEventListener("submit", (e) => {
    e.preventDefault();
    const url = felt.value;
    history.replaceState(null, "", `/sjekk?url=${encodeURIComponent(url)}`);
    void kjor(url);
  });

  // Kom brukeren hit fra hero-feltet eller terminalmodus, kjør med en gang.
  // /sjekk er forhåndsbygget, så ?url= kommer ikke med i feltets value fra
  // serveren (Astro.url.searchParams er tom ved bygg). Adressen leses derfor
  // her, fylles inn i feltet og kjøres. Testen er tests/sjekk-url.spec.ts.
  const fraAdresse = new URLSearchParams(location.search).get("url")?.trim() ?? "";
  if (fraAdresse && !felt.value.trim()) felt.value = fraAdresse;
  if (felt.value.trim()) void kjor(felt.value);
</script>
