---
/**
 * /status i wow-drakten (wow-undersider.md del 1.9, «rolig»).
 * Rekkefølge: H1 → tjenestene som målingsrader → forbeholdet om oppetid → ytelsesbudsjettet
 * som rader → avviksløpet som steg → «Du trenger ikke melde fra» med to lenker.
 *
 * Siden brukes også som helsesjekk av Fly (http_service.checks → GET /status).
 * Den er bevisst statisk og uten avhengigheter: svarer den ikke, er noe virkelig galt.
 * Ingen egne skript, ingen bilder, ingen eksterne forespørsler.
 */
import MalWow from "../layouts/MalWow.astro";
import { SideHode, Seksjon, Prosa, Maaling, Steg } from "../components/wow/side";
import Handlinger from "../components/wow/side/Handlinger.astro";
import { firma } from "../data/firma";

// «Bestått» er samme ord som v1-merket (StatusBadge status="ok") viste. Hva det betyr her,
// står i forbeholdet rett under radene: serveren svarer akkurat nå, det er ikke en oppetidsprosent.
const tjenester = [
  { navn: "kodekonsulentene.no", status: "bestatt" as const, note: "Nettsiden" },
  { navn: "/api/sjekk", status: "bestatt" as const, note: "Nettsidesjekken" },
  { navn: "/api/kontakt", status: "bestatt" as const, note: "Kontaktskjemaet" },
];

// firma er `as const`, så firma.telefon har literal-typen "" mens feltet står tomt.
// Ingressen under het «Ring ${firma.telefon}.», som ble til «Ring .» – en instruks
// uten nummer, på siden som skal fortelle deg hva du gjør når noe er nede.
const telefon: string = firma.telefon;
const avvikIngress = telefon
  ? `Ring ${telefon}. Kunder med driftsavtale får beskjed fra oss før de rekker å oppdage det selv.`
  : "Kunder med driftsavtale får beskjed fra oss før de rekker å oppdage det selv – du trenger ikke melde fra.";

// Stegene er ikke nye løfter: de står allerede i håndboken og salgsvilkårene.
// Her ligger de som en tidslinje fordi det er den rekkefølgen som betyr noe
// for den som lurer på hva som skjer når noe faktisk ryker.
const avviksloep = [
  { naar: "00:00", navn: "Overvåkningen slår ut", tekst: "Oppetid, sertifikat og ytelse sjekkes løpende. Varselet går til oss, ikke til deg." },
  { naar: "Steg 2", navn: "Vi ser på det først", tekst: "Er det vår feil, retter vi det uten å fakturere. Er det uklart hvem sin feil det er, retter vi først og tar diskusjonen etterpå." },
  { naar: "5 dager", navn: "Sårbarheter lappes", tekst: "Kjent sårbarhet i en avhengighet lappes innen fem arbeidsdager på driftsavtaler. Det er en frist, ikke en ambisjon." },
  { naar: "Hver måned", navn: "Du får rapporten", tekst: "Ytelse, oppetid og endringer siden sist. Og en gjenopprettingstest – en sikkerhetskopi du ikke har lest tilbake, er ikke en sikkerhetskopi." },
];

// Grenser, ikke målinger: derfor rader uten lampe (wow-undersider.md del 1.9).
// V1 løftet fire av disse fram en gang til som store tall. De står nå én gang.
const budsjett = [
  ["Lighthouse, mobil", "≥ 95 på alle fire kategorier"],
  ["LCP", "≤ 2,5 s – målet er under 1 s"],
  ["CLS", "< 0,1"],
  ["INP", "< 200 ms"],
  ["Webfonter", "maks 2, latin, font-display: swap"],
  ["Tredjepartsskript før samtykke", "0"],
  ["WCAG", "2.2 AA"],
  ["Sikkerhetsheadere", "6 av 6"],
];
---

<MalWow
  tittel="Driftsstatus og ytelsesbudsjett"
  beskrivelse="Driftsstatus, ytelsesbudsjett og hva som overvåkes på kodekonsulentene.no og kundesider med driftsavtale. Denne siden er også helsesjekken serveren svarer på."
  bevegelse="rolig"
  bookHref="/kontakt"
>
  <SideHode
    tittel="Driftsstatus"
    ingress="Denne siden er også helsesjekken serveren svarer på. Får du opp denne teksten, står nettsiden."
    storrelse="tjeneste"
  />

  <div class="wow-rute status-tjenester">
    <div class="status-tjenester__kolonne">
      <ol class="wow-maalinger" role="list" aria-label="Tjenester">
        {tjenester.map((t) => <Maaling navn={t.navn} status={t.status} merknad={t.note} />)}
      </ol>
      <Prosa>
        <p class="wow-notat">
          Merkene over sier at serveren svarer akkurat nå. De er ikke en oppetidsprosent,
          og vi oppgir ingen før vi måler den over tid – et tall uten historikk er bare
          en påstand.
        </p>
      </Prosa>
    </div>
  </div>

  <Seksjon
    id="budsjett"
    tittel={"Ytelses\u00ADbudsjettet vi holder oss til"}
    ingress="Dette er ikke mål. Det er grenser. Går en leveranse over dem, er den ikke ferdig."
    storrelse="tjeneste"
    tett
  >
    <div class="status-kolonne">
      <dl class="status-budsjett">
        {budsjett.map(([navn, verdi]) => (
          <div>
            <dt>{navn}</dt>
            <dd>{verdi}</dd>
          </div>
        ))}
      </dl>
      {/* V1 hadde dette som et terminalutsnitt. Innholdet står her som vanlig tekst, ordrett fra
          utsnittets skjermlesertekst (uten ordet «Terminalutsnitt:»). */}
      <Prosa>
        <p class="wow-notat">
          Det som overvåkes er oppetid, sertifikat, ytelse, sårbare avhengigheter og sikkerhetskopi.
          Varselet går til utvikleren først, og kunden får månedsrapport med ytelse, oppetid og endringer.
        </p>
      </Prosa>
    </div>
  </Seksjon>

  <Seksjon id="avvik" tittel="Hvis noe er nede" storrelse="tjeneste" tett>
    <Steg steg={avviksloep} tegn={false} />
  </Seksjon>

  <Seksjon id="varsel" tittel="Du trenger ikke melde fra" ingress={avvikIngress} storrelse="tjeneste" tett class="status-siste">
    <Handlinger
      handlinger={[
        { tekst: "Hvordan vi jobber", href: "/handbok", type: "strek" },
        { tekst: "Hva du kan holde oss til", href: "/vilkar", type: "strek" },
      ]}
    />
  </Seksjon>
</MalWow>

<style>
  .status-tjenester {
    padding-top: var(--wow-rom-7);
  }
  .status-tjenester__kolonne,
  .status-kolonne {
    display: grid;
    gap: var(--wow-rom-5);
  }
  /* Siden har ingen kontaktblokk: luft mellom siste seksjon og bunnen. */
  :global(.status-siste) {
    padding-bottom: var(--wow-seksjon-tett);
  }
  /* Grensene som rader: navn til venstre, grensen til høyre, strek mellom. Vanlig skrift, ikke
     displayskrift: dette er grenser i en tabell, ikke sidens store tall. */
  .status-budsjett {
    margin: 0;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .status-budsjett > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wow-rom-1) var(--wow-rom-6);
    padding-block: var(--wow-rom-4);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .status-budsjett dt {
    color: var(--wow-tekst-dempet);
  }
  .status-budsjett dd {
    margin: 0;
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .status-tjenester__kolonne {
      grid-column: 1 / 9;
    }
    /* Samme høyrekant som tjenestene over (åtte av tolv spalter). */
    .status-kolonne {
      max-width: calc((100% - 11 * var(--wow-luke)) / 12 * 8 + 7 * var(--wow-luke));
    }
  }
</style>
