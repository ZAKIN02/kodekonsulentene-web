---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import Nokkeltall from "../components/Nokkeltall.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Terminal from "../components/Terminal.astro";
import Button from "../components/Button.astro";
import Demo from "../components/Demo.astro";
import Horisont from "../components/Horisont.astro";
import { firma } from "../data/firma";

import "../styles/scener.css";

// Siden brukes også som helsesjekk av Fly (http_service.checks → /status).
// Den er bevisst statisk og uten avhengigheter: svarer den ikke, er noe virkelig galt.
const tjenester = [
  { navn: "kodekonsulentene.no", status: "ok" as const, note: "Nettsiden" },
  { navn: "/api/sjekk", status: "ok" as const, note: "Nettsidesjekken" },
  { navn: "/api/kontakt", status: "ok" as const, note: "Kontaktskjemaet" },
];

// Samme tall som i budsjett-listen under, bare løftet fram som grafikk.
// firma er `as const`, så firma.telefon har literal-typen "" mens feltet står tomt.
// Ingressen under het «Ring ${firma.telefon}.», som ble til «Ring .» – en instruks
// uten nummer, på siden som skal fortelle deg hva du gjør når noe er nede.
const telefon: string = firma.telefon;
const avvikIngress = telefon
  ? `Ring ${telefon}. Kunder med driftsavtale får beskjed fra oss før de rekker å oppdage det selv.`
  : "Kunder med driftsavtale får beskjed fra oss før de rekker å oppdage det selv – du trenger ikke melde fra.";

const budsjettTall = [
  { value: "95", label: "Lighthouse, mobil – alle fire kategorier", accent: true },
  { value: "2,5 s", label: "LCP, øvre grense" },
  { value: "0", label: "Tredjepartsskript før samtykke" },
  { value: "6", label: "Sikkerhetsheadere av 6" },
];

// Stegene er ikke nye løfter: de står allerede i håndboken og salgsvilkårene.
// Her ligger de som en tidslinje fordi det er den rekkefølgen som betyr noe
// for den som lurer på hva som skjer når noe faktisk ryker.
const avviksloep = [
  { nr: "00:00", tittel: "Overvåkningen slår ut", tekst: "Oppetid, sertifikat og ytelse sjekkes løpende. Varselet går til oss, ikke til deg." },
  { nr: "Steg 2", tittel: "Vi ser på det først", tekst: "Er det vår feil, retter vi det uten å fakturere. Er det uklart hvem sin feil det er, retter vi først og tar diskusjonen etterpå." },
  { nr: "5 dager", tittel: "Sårbarheter lappes", tekst: "Kjent sårbarhet i en avhengighet lappes innen fem arbeidsdager på driftsavtaler. Det er en frist, ikke en ambisjon." },
  { nr: "Hver måned", tittel: "Du får rapporten", tekst: "Ytelse, oppetid og endringer siden sist. Og en gjenopprettingstest – en sikkerhetskopi du ikke har lest tilbake, er ikke en sikkerhetskopi." },
];

const budsjett = [
  ["Lighthouse, mobil", "≥ 95 på alle fire kategorier"],
  ["LCP", "≤ 2,5 s – målet er under 1 s"],
  ["CLS", "< 0,1"],
  ["INP", "< 200 ms"],
  ["Webfonter", "maks 2, latin, font-display: swap"],
  ["Tredjepartsskript før samtykke", "0"],
  ["WCAG", "2.2 AA"],
  ["Sikkerhetsheadere", "6 av 6"],
];
---
<Base
  tittel="Driftsstatus"
  beskrivelse="Driftsstatus, ytelsesbudsjett og hva som overvåkes på kodekonsulentene.no og kundesider med driftsavtale."
>
  <Scene lav>
    <Mega som="h1" merke="Status" n={1} tekst="Driftsstatus" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Denne siden er også helsesjekken serveren svarer på. Får du opp denne teksten, står nettsiden.</p>
    </Avslor>

    <div class="stack">
      <dl class="kv">
        {tjenester.map((t) => (
          <div>
            <dt><span class="mono">{t.navn}</span><br /><span class="small faint">{t.note}</span></dt>
            <dd><StatusBadge status={t.status} /></dd>
          </div>
        ))}
      </dl>
      <p class="small faint">
        Merkene over sier at serveren svarer akkurat nå. De er ikke en oppetidsprosent,
        og vi oppgir ingen før vi måler den over tid – et tall uten historikk er bare
        en påstand.
      </p>
      {/* Ekte bevegelse, ikke et stillbilde. Bare LYSET endrer seg mellom første og
          siste ramme – geometrien står bom stille, så Kling har ingenting å morfe.
          Det er den tekniske grunnen til at klippet ikke ser ut som billig AI-video. */}
      <Demo
        smal="/scener/lev-status-960.mp4"
        bred="/scener/lev-status-1280.mp4"
        stor="/scener/lev-status-1920.mp4"
        plakat="/scener/lev-status-poster.avif"
        tekst="Linjen tegner seg nedover kantene. Den blir ubrutt bare fordi hvert lag ligger der det skal."
      />
    </div>
  </Scene>

  <Scene n={2} eyebrow="Budsjett" tittel="Ytelsesbudsjettet vi holder oss til" ingress="Dette er ikke mål. Det er grenser. Går en leveranse over dem, er den ikke ferdig.">
    <Avslor>
      <Nokkeltall poster={budsjettTall} navn="Ytelsesbudsjettets fire viktigste grenser" />
    </Avslor>
    <div class="grid-2">
      <dl class="kv">
        {budsjett.map(([k, v]) => (
          <div><dt>{k}</dt><dd class="nowrap">{v}</dd></div>
        ))}
      </dl>
      <Terminal
        skriv
        title="~/kodekonsulentene/drift"
        lines={[
          { type: "cmd", text: "hva overvåkes" },
          { type: "out", text: "oppetid · sertifikat · ytelse" },
          { type: "out", text: "sårbare avhengigheter · sikkerhetskopi" },
          { type: "cmd", text: "hvem får varselet" },
          { type: "ok", text: "vi – før du merker det" },
          { type: "cmd", text: "hva får du" },
          { type: "out", text: "månedsrapport: ytelse, oppetid, endringer" },
        ]}
        label="Terminalutsnitt: det som overvåkes er oppetid, sertifikat, ytelse, sårbare avhengigheter og sikkerhetskopi. Varselet går til utvikleren først, og kunden får månedsrapport med ytelse, oppetid og endringer."
      />
    </div>
  </Scene>

  <Horisont
    poster={avviksloep}
    navn="Hva som skjer fra et avvik oppstår til du har rapporten"
    merke="Avvik"
    n={3}
    tittel="Hvis noe er nede"
    hoyde={3}
  />

  <Scene n={4} eyebrow="Varsel" tittel="Du trenger ikke melde fra" ingress={avvikIngress}>
    <Button variant="ghost" href="/handbok">Hvordan vi jobber</Button>
    <Button variant="ghost" href="/vilkar">Hva du kan holde oss til</Button>
  </Scene>
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
