---
/**
 * /systemer i wow-drakten (wow-undersider.md del 1.3 og del 4, wow-r8-B1).
 * Rekkefølge: kapittel 2 (kontoret) → «Hvordan det ser ut i praksis» (sidens bevis: flyten med
 * ekte systemnavn og ekte skjermbilder) → «Det vi kobler oftest» → pris → kontakt.
 * Ute fra v1: terminalutsnittet (pynt; flyten sier det samme).
 */
import MalWow from "../layouts/MalWow.astro";
import { Seksjon, Prosa, Flyt, Prisliste, Kontaktblokk, Ramme } from "../components/wow/side";
import Kapittel from "../components/wow/Kapittel.astro";
import Rader from "../components/wow/tjeneste/Rader.astro";
import { kapittelForhandslast } from "../scripts/wow/kapittel-klipp";
import { bookUrl } from "../data/firma";
import { flyter } from "../data/flyter";
import { tjeneste } from "../data/schema";
import { pakker, prisenhet, mvaSetning } from "../data/priser";
import { tjenester } from "../data/historie";

/* Systemprisen sto skrevet av i metabeskrivelsen, med «eks. mva» på et foretak
   som ikke kan fakturere mva. Hentes nå fra prislisten. */
const systemPris = pakker.find((p) => p.navn === "System")?.pris ?? "";

/**
 * TO TREDJEPARTSFAKTA STO HER UTEN KILDE OG UTEN DATO.
 *
 * Det er andres priser og andres abonnementsvilkår. De endrer seg uten at vi får
 * beskjed, og en kunde som planlegger ut fra et gammelt gebyr hos oss, oppdager
 * det først i sin egen faktura. Begge er derfor slått opp på nytt og merket med
 * hvor og når – `kilde` vises i teknisk-kolonnen, ikke bare i kildekoden.
 *
 * Vipps, kontrollert 7. oktober 2026 på vippsmobilepay.com/nb-NO/pricing:
 *   «Faste betalinger: 2,99 % + 1 NOK per transaksjon»
 *   «Betalingslenker: 2,49 % + 1 NOK per transaksjon»
 * Tallene på siden stemte. De sto bare uten noe å etterprøve dem mot.
 *
 * Tripletex, kontrollert 7. oktober 2026 på tripletex.no/priser: her STEMTE det
 * ikke helt. Prissiden sier at Smart-pakken kan «utvides med integrasjoner», at
 * «Integrasjoner» er en tilleggstjeneste til 129 kr/mnd, at Pro inneholder
 * «alt fra Smart + integrasjoner», og at «noen integrasjoner krever
 * Komplett-pakken». Betegnelsen «API 2.0» står ikke på prissiden i det hele
 * tatt – den er hentet fra hjelpesidene. Teksten er rettet til det som faktisk
 * står der, og forbeholdet om Komplett er lagt til, siden det er det som kan
 * gjøre integrasjonen dyrere enn kunden regnet med.
 */
const integrasjoner = [
  { navn: "Booking", verdi: "Timer bestilles og betales døgnet rundt, uten en telefon.", teknisk: "Cal.com eller eget system i Supabase" },
  {
    navn: "Vipps",
    verdi: "Norske kunder betaler med det de allerede har på telefonen.",
    teknisk: "2,99 % + 1 kr for integrert betaling, 2,49 % + 1 kr på betalingslenke",
    kilde: { tekst: "vippsmobilepay.com, lest 7. oktober 2026", url: "https://vippsmobilepay.com/nb-NO/pricing" },
  },
  {
    navn: "Tripletex / Fiken / PowerOffice",
    verdi: "Tilbud blir ordre blir faktura – uten at noen skriver tallene inn på nytt.",
    teknisk: "Tripletex: «Integrasjoner» er et tillegg på 129 kr/mnd fra Smart-pakken, og noen integrasjoner krever Komplett",
    kilde: { tekst: "tripletex.no/priser, lest 7. oktober 2026", url: "https://www.tripletex.no/priser/" },
  },
  { navn: "Skjema til CRM", verdi: "Ingen henvendelse blir liggende i en innboks.", teknisk: "HubSpot, Pipedrive eller egen tabell" },
  { navn: "BankID", verdi: "Avtaler signeres på minutter, juridisk bindende.", teknisk: "Criipto/Idura eller Signicat – ferdig tjeneste til du har volum" },
  { navn: "Kundeportal", verdi: "Kunden ser status, filer og fakturaer selv.", teknisk: "Supabase med radnivå-sikkerhet" },
];
/**
 * Siden hadde ingen strukturerte data i det hele tatt. `tjeneste()` har ligget
 * ubrukt i src/data/schema.ts hele tiden – ingen side importerte den.
 */
const schema = tjeneste({
  type: "Systemutvikling og integrasjoner",
  navn: "Systemer og integrasjoner",
  beskrivelse:
    "Booking, betaling og regnskap koblet sammen: Vipps, Tripletex, Fiken, PowerOffice, BankID og kundeportal.",
  sti: "/systemer",
  pakker: ["System"],
});
---

<MalWow
  tittel="Systemer og integrasjoner"
  beskrivelse={`Booking, Vipps, Tripletex, Fiken, PowerOffice og BankID koblet sammen til ett system, slik at ingen skriver samme tall to ganger. Fra ${systemPris} – ${prisenhet}.`}
  schema={[schema]}
  bevegelse="film"
  forhandslast={kapittelForhandslast(2, "skrubb")}
>
  <Kapittel
    nummer={2}
    tittel="Få systemene du betaler for til å snakke sammen"
    ingress="De fleste småbedrifter har allerede booking, regnskap og betaling. Problemet er at ingen av dem vet om hverandre, så noen taster samme tall tre ganger."
    problem={tjenester.systemer.problem}
    losning={tjenester.systemer.losning}
    handlinger={[
      { tekst: "Book 20 minutter", href: bookUrl, type: "primar" },
      { tekst: "Se hva som kan kobles", href: "#integrasjoner", type: "lenke" },
    ]}
  />

  <Seksjon id="eksempel" tittel="Hvordan det ser ut i praksis" storrelse="stor">
    {/*
      HER STO ET KUNDEFORLØP SOM IKKE FINNES (v1): «En klinikk med fire behandlere brukte to timer
      i uken …». Det finnes ingen slik kunde i src/data/caser.ts. Avsnittet beskriver flyten
      systemet er bygget for, i presens, uten tall vi ikke har målt, og sier rett ut at det er et
      eksempel. Kommer det en ekte klinikk med målt tidsbruk, hører den hjemme i caser.ts.
    */}
    <div class="sys-praksis">
      <Prosa>
        <p>
          Et eksempel, ikke en kunde: en klinikk tar timebestillinger på telefon i
          åpningstiden, ringer tilbake om ledige timer, og avstemmer Vipps mot regnskapet
          for hånd etterpå.
        </p>
        <p>
          Med et system: kunden booker og betaler selv, timen havner i behandlerens
          kalender, betalingen havner som ordre i Fiken, og påminnelsen går ut på SMS
          24 timer før. Ingen taster noe. Det er dette vi mener med «system» – ikke en
          nettside med et skjema på.
        </p>
        <p class="wow-notat">
          Dette er flyten i demoen vår, ikke et levert oppdrag. Vi har ikke målt tidsbruk
          hos en klinikk, og setter derfor ingen tall på hva det sparer. Hva vi har levert,
          og hva som er øvelse, står på <a href="/caser">caser</a>.
        </p>
        <p><a href="/bransjer/klinikker">Se bransjesiden for klinikker</a></p>
      </Prosa>
      {/* Ekte skjermbilder (public/media/wow/ekte/), samme par som på forsiden. */}
      <div class="sys-flater">
        <Ramme
          type="nettleser"
          bilde="systemer-flyt"
          adresse="kodekonsulentene.no/systemer"
          alt="Skjermbilde av flyten fra booking til regnskap: kunde, booking, Vipps, Fiken og SMS."
          sizes="(min-width: 1024px) 46vw, 80vw"
          class="sys-flater__stor"
          avdekk
        />
        <Ramme
          type="telefon"
          bilde="systemer-m"
          alt="Den samme flyten på mobil, steg for steg fra kunde til SMS-påminnelse."
          sizes="(min-width: 1024px) 13vw, 26vw"
          class="sys-flater__liten"
          parallax="-0.14"
        />
      </div>
    </div>

    {/* Figuren med navnene på systemene vi faktisk kobler. */}
    <div class="sys-flyt">
      <Flyt flyt={flyter.systemer} />
    </div>
  </Seksjon>

  <Seksjon id="integrasjoner" tittel="Det vi kobler oftest" storrelse="tjeneste" tone="flate">
    {/* Står det et gebyr eller et abonnementskrav i den tekniske linja, skal leseren kunne åpne
        siden det er lest fra: kilden står med lenke og dato i raden. */}
    <Rader
      rader={integrasjoner.map((i) => ({
        tittel: i.navn,
        tekst: i.verdi,
        detalj: i.teknisk,
        kilde: "kilde" in i ? i.kilde : undefined,
      }))}
    />
  </Seksjon>

  <Prisliste
    variant="kort"
    pakker={["System"]}
    valgt="system"
    id="priser-systemer"
    gruppe="pakke-systemer"
    tittel={`System fra ${systemPris}`}
    ingress={`Prisen følger antall integrasjoner og hvor mye som må holdes i orden etterpå. Du får fast pris før vi begynner, og 40 % faktureres ved oppstart. ${mvaSetning}`}
  />
  <div class="wow-rute sys-etter-pris">
    <a class="wow-lenke" href="/kontakt">Beskriv behovet</a>
  </div>

  <Kontaktblokk />
</MalWow>

<style>
  .sys-praksis {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--wow-rom-7) var(--wow-luke);
  }
  /* Et stort nettleservindu og en telefon forskjøvet over hjørnet, som på forsiden. */
  .sys-flater {
    position: relative;
    padding-bottom: var(--wow-rom-5);
  }
  .sys-flater :global(.sys-flater__stor) {
    margin-right: 14%;
  }
  .sys-flater :global(.sys-flater__liten) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
  }
  .sys-flyt {
    margin-top: var(--wow-rom-8);
  }
  .sys-etter-pris {
    padding-top: var(--wow-rom-5);
  }
  .sys-etter-pris > * {
    grid-column: 1 / -1;
    justify-self: start;
  }
  @media (min-width: 1024px) {
    .sys-praksis {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .sys-praksis > :global(.wow-prosa) {
      grid-column: 1 / 6;
    }
    .sys-flater {
      grid-column: 6 / 13;
    }
    .sys-flater :global(.sys-flater__stor) {
      margin-right: 0;
      margin-left: 20%;
    }
    .sys-flater :global(.sys-flater__liten) {
      right: auto;
      left: 0;
      width: 24%;
    }
  }
</style>
