---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Mega from "../components/Mega.astro";
import Avslor from "../components/Avslor.astro";
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import Flyt from "../components/Flyt.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { bookUrl } from "../data/firma";
import { flyter } from "../data/flyter";
import { tjeneste } from "../data/schema";

import "../styles/scener.css";

const integrasjoner = [
  { navn: "Booking", verdi: "Timer bestilles og betales døgnet rundt, uten en telefon.", teknisk: "Cal.com eller eget system i Supabase" },
  { navn: "Vipps", verdi: "Norske kunder betaler med det de allerede har på telefonen.", teknisk: "2,99 % + 1 kr integrert, 2,49 % + 1 kr på betalingslenke" },
  { navn: "Tripletex / Fiken / PowerOffice", verdi: "Tilbud blir ordre blir faktura – uten at noen skriver tallene inn på nytt.", teknisk: "Tripletex krever Smart-pakke og tillegget «Integrasjoner» (API 2.0)" },
  { navn: "Skjema til CRM", verdi: "Ingen henvendelse blir liggende i en innboks.", teknisk: "HubSpot, Pipedrive eller egen tabell" },
  { navn: "BankID", verdi: "Avtaler signeres på minutter, juridisk bindende.", teknisk: "Criipto/Idura eller Signicat – ferdig tjeneste til du har volum" },
  { navn: "Kundeportal", verdi: "Kunden ser status, filer og fakturaer selv.", teknisk: "Supabase med radnivå-sikkerhet" },
];
/**
 * Siden hadde ingen strukturerte data i det hele tatt. `tjeneste()` har ligget
 * ubrukt i src/data/schema.ts hele tiden – ingen side importerte den.
 */
const schema = tjeneste({
  type: "Systemutvikling og integrasjoner",
  navn: "Systemer og integrasjoner",
  beskrivelse:
    "Booking, betaling og regnskap koblet sammen: Vipps, Tripletex, Fiken, PowerOffice, BankID og kundeportal.",
  sti: "/systemer",
  pakker: ["System"],
});
---
<Base
  tittel="Systemer og integrasjoner"
  beskrivelse="Booking, Vipps, Tripletex, Fiken, PowerOffice og BankID koblet sammen til ett system, slik at ingen skriver samme tall to ganger. Fra 60 000 kr eks. mva."
  schema={[schema]}
>
  <Scene lav>
    <Mega som="h1" merke="Systemer" n={1} tekst="Få systemene du betaler for til å snakke sammen" aksent="sammen" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">De fleste småbedrifter har allerede booking, regnskap og betaling. Problemet er at ingen av dem vet om hverandre, så noen taster samme tall tre ganger.</p>
    </Avslor>

    <div class="row">
      <Button variant="primary" href={bookUrl}>Book 20 minutter</Button>
      <Button variant="ghost" href="#integrasjoner">Se hva som kan kobles</Button>
    </div>
  </Scene>

  <Scene n={2} eyebrow="Typisk" tittel="Hvordan det ser ut i praksis" id="eksempel">
    <div class="grid-2">
      <div class="stack">
        <p class="body-lg muted">
          En klinikk med fire behandlere brukte to timer i uken på å ringe tilbake om ledige
          timer, og en halv dag i måneden på å avstemme Vipps mot regnskapet.
        </p>
        <p class="muted">
          Etter: kunden booker og betaler selv, timen havner i behandlerens kalender,
          betalingen havner som ordre i Fiken, og påminnelsen går ut på SMS 24 timer før.
          Ingen taster noe. Det er dette vi mener med «system» – ikke en nettside med
          et skjema på.
        </p>
        <Button variant="ghost" href="/bransjer/klinikker">Se bransjesiden for klinikker</Button>
      </div>
      {/*
        Terminalen tegnet tidligere hele flyten med ASCII-piler – nøyaktig det
        Flyt-figuren under gjør, bare uleselig. To fremstillinger av samme flyt i
        samme seksjon er støy, så terminalen beholder bare poenget.
      */}
      <Terminal
        skriv
        title="~/flyt"
        lines={[
          { type: "cmd", text: "echo $MANUELLE_STEG" },
          { type: "ok", text: "0" },
        ]}
        label="Terminalutsnitt: antall manuelle steg i flyten er null."
      />
    </div>

    {/*
      Figuren, ikke et bilde av aluminiumsplater. Boksene bærer navnene på
      systemene vi faktisk kobler, så en klinikkeier ser på to sekunder hva hun
      får kjøpt. Koster 0 kB JavaScript.
    */}
    <Flyt flyt={flyter.systemer} />
  </Scene>

  {/* HER STO ET GENERERT KLIPP BAK DENNE SEKSJONEN, OG DET ER FJERNET MED VILJE.
      systemer-klippet lå på 85 % opasitet bak «Det vi kobler oftest», med masken
      satt til 62 % – altså sluppet fram i en smal stripe helt til høyre. Opptak i
      headless Chrome viser at det i praksis var en mørk flekk i ytterkanten.

      Og det sto nesten stille. Målt med .skudd/klipp-endring.mjs-metrikken endret
      det seg 5,83 av 255 fra første til siste ramme, og 78 % av den endringen lå i
      FØRSTE kvartal – klippet var ferdig etter to av åtte sekunder, mens prosjektets
      egen regel sier at poenget skal ligge rundt 50 % av tidslinjen.

      Det som faktisk forklarer denne seksjonen står rett over den: Flyt-figuren
      «Fra booking til regnskap», med Kunde, Booking, Vipps, Fiken og SMS i bokser.
      Ekte navn, en pakke som reiser gjennom kjeden i løkke, 0 kB JavaScript. Det er
      andreplassen i brandbokens rangering, og den slår et nedtonet motiv i kanten. */}
  <Scene n={3} eyebrow="Integrasjoner" tittel="Det vi kobler oftest" id="integrasjoner">
    {/* Rutenettet brytes her. Seks like kort i to rette kolonner leses som en
        tabell; litt helning leses som ting som ligger oppa hverandre.
        Vinkelen kommer fra indeksen, saa den er stabil mellom bygg.

        trinn var k % 3 – stilt for et tre-kolonners rutenett, mens .grid-2 har to.
        Med trappen levende kom rad to inn hoeyre-foer-venstre.

        `dybde` sto her og vekslet 14 / -10 per kort. Den var DOED: `--dybde` leses
        bare av keyframes for fra="dybde", og gesten her er "skjev". Maalt 0 px
        forskjell med og uten. Den er fjernet, ikke fordi den gjorde skade, men
        fordi en verdi som ser ut til aa virke er verre enn ingen: bytter noen
        gesten til "dybde" senere, spretter raden 24 px ut av linje uten at noen
        har roert tallet. Vil man ha dybde her, maa begge kortene i en rad ha
        SAMME verdi – ellers slutter raden aa dele oeverste kant.

        Vinkelen kommer fra Avslors eget vokabular, ikke fra egen CSS her.
        En egen regel ville dessuten vaert doed: kortene baerer Avslors scope-id. */}
    <div class="grid-2 kobling-rutenett">
      {integrasjoner.map((i, k) => (
        <Avslor
          trinn={k % 2}
          fra="skjev"
          skjev={[-1.4, 1.1, -0.8, 1.5, -1.2, 0.7][k] ?? 0}
          as="div"
          class="card"
        >
          <h3 class="subheading">{i.navn}</h3>
          <p class="muted">{i.verdi}</p>
          <p class="mono faint">{i.teknisk}</p>
        </Avslor>
      ))}
    </div>
  </Scene>

  <Scene n={4} class="flate--varm" eyebrow="Pris" tittel="System fra 60 000 kr" ingress="Prisen følger antall integrasjoner og hvor mye som må holdes i orden etterpå. Du får fast pris før vi begynner, og 40 % faktureres ved oppstart. Eks. mva.">
    <div class="row">
      <Button variant="primary" href="/kontakt">Beskriv behovet</Button>
      <Button variant="ghost" href="/priser">Se hele prislisten</Button>
    </div>
  </Scene>

  <ContactBlock n={5} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  /* Treffer på HVA elementet er, ikke hvor det tilfeldigvis står.
     `> .avslor` traff ingenting fordi .avslor ligger i .scene__inner, og
     `:first-of-type` gjelder tagg og ikke klasse. Begge varianter var stille døde:
     skjemaet på /verktoy/cookie-sjekk sto på 0,56 opasitet ved innlasting –
     sidens primære handling, halvgjennomsiktig til du scrollet. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

</style>

{/*
  Maskeoverstyringen laa her som en scoped <style>-regel og var DOED CSS:
  .scenefilm--venstre baerer SceneFilms scope-id mens .scenefilm-ramme baerer denne
  sidens, saa en regel som krever begge matcher ingenting. Bevis: maske 46 % og 92 %
  ga identisk maaling.

  Hele SceneFilm-blokken er naa borte fra denne siden – klippet sto nesten stille og
  forklarte ingenting – saa masken har ingenting aa overstyre lenger. Notatet staar
  igjen fordi feilen er lett aa gjenta: en scoped regel kan ikke naa et barn med en
  annen scope-id, og den feiler STILLE.

  Da regelen ble fjernet foerste gang, ble en forvillet kroellparentes staaende igjen
  i en ellers tom <style>-blokk. Den brakk hele bygget: lightningcss stoppet paa
  «Unexpected token Ident». En tom style-blokk med bare en parentes i er ikke synlig
  som feil foer noen bygger.
*/}
