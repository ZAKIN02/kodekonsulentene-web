---
import MalWow from "../layouts/MalWow.astro";
import { SideHode, Artikkelkropp } from "../components/wow/side";
import { firma } from "../data/firma";

/**
 * Siden som forklarer terminalmodusen.
 *
 * Den finnes fordi en skjult funksjon ingen vet om, ikke finnes. Epic.net har
 * «Puzzle», «Rabbit» og «Castle» stående synlig i footeren – det er nettopp det
 * som gjør at siden føles som den har dybde. Vi gjør det samme med vår egen.
 *
 * WOW-DRAKTEN (wow-undersider.md del 1.9): lesemalen. Kommandoene står som ekte kode, og
 * utsnittet står i den ekte terminalen (`kkterm`, stil i wow-terminal.css). Med JavaScript slår
 * /terminal.js på feltet under utsnittet (`data-kkterm-innfelt="utsnitt"`), så «terminalen over»
 * i teksten er en terminal du kan skrive i. Uten JavaScript står utsnittet som tekst og feltet
 * er av. Teksten er uendret fra v1.
 *
 * OVERSKRIFTEN sto en gang «Trykk ~ hvor som helst», mens siden selv sier at terminalen er av på
 * berøringsskjerm. Overskriften sier derfor hva siden ER, og vilkåret står i ingressen, der det
 * gjelder alle. (En mediespørring på `pointer: coarse` gjetter på inndataenheten og gjetter feil
 * begge veier.)
 */
const kommandoer = [
  ["sjekk <url>", "Kjører hele nettsidesjekken og skriver resultatet her"],
  ["headere <url>", "Bare sikkerhetsheaderne"],
  ["dmarc <domene>", "SPF, DKIM og DMARC"],
  ["pris", "Prisene, hentet fra prislisten"],
  ["ls", "Sidene som finnes"],
  ["cat <side>", "Leser en side her, uten å navigere bort"],
  ["open <side>", "Går til siden"],
  ["help", "Alle kommandoer"],
];

/**
 * UTSNITTET KJØRER MOT VÅRT EGET DOMENE, MED EKTE TALL.
 *
 * Det sto en gang «dmarc nkom.no … Samlet: 83/100»: en poengsum for en navngitt tredjepart,
 * uten kilde og uten dato. Vi lover andre steder at ingen sider navngis. Tallene under er kjørt
 * med hentEpostoppsett() og byggEpostRapport() fra src/lib/dns.ts mot kodekonsulentene.no
 * 7. oktober 2026, som ga
 *
 *   SPF    ok      ~all · 2/10 oppslag
 *   DKIM   nøytral Ikke sjekket (ingen selektor oppgitt)
 *   DMARC  warn    p=none
 *   totalt 67
 *
 * Et eksempel som viser vårt eget svake punkt er et bedre bevis på at verktøyet måler enn et
 * pent tall fra en fremmed side.
 *
 * Linjene får klassene /terminal.js selv bruker: ok → kk-ok, warn → kk-warn, nøytral → ingen
 * (v1 farget «Ikke sjekket» som varsel; terminalen gjør ikke det, og «Ikke sjekket» er ikke et
 * funn). Siste linje er det skrivRapport() i /terminal.js skriver i dag for de samme radene
 * (r8-rettelser.md 4.2); resten er ordrett v1.
 */
const esc = (t: string) => t.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!);
const utsnitt = [
  `<span><span class="kkterm__ps">$</span> <b>dmarc ${esc(firma.domene)}</b></span>`,
  `<span><span class="kk-ok">spf ..... ~all · 2/10 oppslag</span></span>`,
  `<span>dkim .... Ikke sjekket</span>`,
  `<span><span class="kk-warn">dmarc ... p=none</span></span>`,
  `<span></span>`,
  `<span><span class="kk-warn">1 å fikse. Samlet: 67/100.</span></span>`,
]
  .map((l) => l + "\n")
  .join("");
---

<MalWow
  tittel="Terminal i nettleseren (trykk ~)"
  beskrivelse="Siden har en terminal. Trykk tilde for å åpne den, og kjør nettsidesjekken, DMARC-oppslag eller prislisten uten å forlate siden."
  bevegelse="rolig"
  bookHref="/kontakt"
>
  <article>
    <SideHode
      tittel="En terminal i nettleseren"
      ingress="Trykk tilde (~) på et tastatur, så åpner den seg hvor som helst på siden. Den er ikke pynt – den kjører de samme sjekkene som verktøyene, mot ekte nettsider, og skriver svaret rett i vinduet. Har du ikke tastatur, kan du skrive i terminalen lenger ned på denne siden."
      storrelse="tjeneste"
      bredde="les"
    />
    <Artikkelkropp variant="handbok">
      <dl class="kommandoer">
        {kommandoer.map(([k, hva]) => (
          <div><dt><code>{k}</code></dt><dd>{hva}</dd></div>
        ))}
      </dl>
      <p class="wow-notat">
        Piltastene blar i historikken, Tab fullfører kommandonavn, Esc lukker.
        Den laster ingenting før du åpner den.
      </p>
      <p class="wow-notat">
        Det finnes også noe som ikke står i <code>help</code>.
        Folk som har spilt mye på åttitallet finner det raskest.
      </p>

      <div class="kkterm utsnitt" data-kkterm-innfelt="utsnitt">
        <div class="kkterm__bar"><span>~/{firma.domene}</span></div>
        <div class="kkterm__out" role="log" aria-live="polite" set:html={utsnitt} />
        <div class="kkterm__line">
          <span class="kkterm__ps" aria-hidden="true">$</span>
          <label class="visually-hidden" for="kkterm-side">Kommando</label>
          <input
            class="kkterm__in"
            id="kkterm-side"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            disabled
            placeholder="krever JavaScript"
          />
        </div>
      </div>
      <p class="wow-notat">
        Utsnittet er vårt eget domene, kjørt 7. oktober 2026. Kjør{" "}
        <code>dmarc {firma.domene}</code> i terminalen over, så får du
        svaret fra DNS slik det er i dag.
      </p>
    </Artikkelkropp>
  </article>
</MalWow>

<style>
  /* Ingen kontaktblokk under: luft ned til bunnfeltet. */
  article {
    padding-bottom: var(--wow-seksjon);
  }
  /* Kommandoene: koden til venstre, forklaringen til høyre, strek mellom. Under 600 px står
     forklaringen under koden. */
  .kommandoer {
    margin: 0;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .kommandoer > div {
    display: grid;
    gap: var(--wow-rom-1) var(--wow-rom-5);
    padding-block: var(--wow-rom-3);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .kommandoer dt {
    white-space: nowrap;
  }
  .kommandoer dd {
    margin: 0;
    color: var(--wow-tekst-dempet);
  }
  @media (min-width: 600px) {
    .kommandoer > div {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  /* Modalen har egen maksbredde og høyde; den innfelte følger lesekolonnen. */
  .utsnitt {
    max-width: none;
  }
  /* Linja har bare stien (modalen har «Esc lukker» til høyre); den står til venstre. */
  .utsnitt :global(.kkterm__bar span) {
    margin-left: 0;
  }
  .utsnitt :global(.kkterm__out) {
    max-height: 50svh;
  }
</style>
