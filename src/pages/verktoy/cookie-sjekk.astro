---
/**
 * Cookie-sjekken i wow-drakten (wow-undersider.md del 1.8, mønsterside for wow-r8-grunnmur).
 * Rekkefølge: Verktoyramme (brødsmuler, H1, feltet, resultatet) → loven → ekte opptak →
 * «Etterpå» → kontaktblokk. «rolig»: ingenting beveger seg uten at brukeren har gjort noe.
 *
 * Uendret fra v1: API-kallet (POST /api/cookie-sjekk med { url }), id-ene `#url-cookie` og
 * `#resultat`, feltnavnet `url`, alle feiltekster, forbeholdene og WebApplication-markupen.
 * Nytt: resultatet står i rapportspråket (lampe + status som ord), og fokus flyttes til
 * rapportens tittel når den er klar.
 */
import MalWow from "../../layouts/MalWow.astro";
import { Verktoyramme, UrlFelt, Seksjon, Prosa, Opptak, Kontaktblokk } from "../../components/wow/side";
import { verktoy } from "../../data/schema";
import { firma } from "../../data/firma";

// Siden er statisk: i bygget er searchParams tom, og skriptet under leser ?url= fra
// location.search. Linja fyller feltet bare i `astro dev`.
const forhandsutfylt = Astro.url.searchParams.get("url") ?? "";
/**
 * `WebApplication` fra `verktoy()` i src/data/schema.ts. `price: "0"` og
 * `isAccessibleForFree` er sanne: verktøyet krever ingen innlogging og koster ingenting.
 */
const schema = verktoy({
  navn: "Cookie-sjekk",
  beskrivelse:
    "Laster forsiden i en ekte nettleser med tom profil, uten aa klikke paa noe, og viser hvilke cookies, lagringsnoekler og tredjepartskall som settes foer samtykke.",
  sti: "/verktoy/cookie-sjekk",
});
---

<MalWow
  tittel="Cookie-sjekk: hva settes før samtykke?"
  beskrivelse="Se hva nettsiden din setter før noen har samtykket. Vi laster forsiden i en ekte nettleser med tom profil og klikker ikke på noe. Gratis."
  schema={[schema]}
  bevegelse="rolig"
>
  <Verktoyramme
    tittel="Hva setter siden din før noen sier ja?"
    ingress="Vi laster forsiden i en ekte nettleser med tom profil, og klikker ikke på noe. Alt som er satt i det øyeblikket, er satt uten samtykke."
  >
    <UrlFelt
      slot="skjema"
      id="url-cookie"
      action="/verktoy/cookie-sjekk"
      knapp="Kjør sjekken"
      verdi={forhandsutfylt}
      hint="Tar 15–30 sekunder. Vi lagrer ingenting."
    />
    <p slot="noscript">
      Sjekken krever JavaScript. Send adressen til{" "}
      <a class="wow-lenke" href={`mailto:${firma.epost}?subject=Cookie-sjekk`}>{firma.epost}</a>,
      så kjører vi den manuelt og sender rapporten samme dag.
    </p>
  </Verktoyramme>

  <Seksjon id="loven" tittel="Hva ekomloven § 3-15 krever" storrelse="tjeneste" tett>
    <Prosa>
      <p>
        Fra 1. januar 2025 må samtykke til informasjonskapsler oppfylle GDPR-kravene.
        I praksis betyr det tre ting: ingen forhåndsavkryssede valg, «avvis» skal være
        like lett tilgjengelig som «godta», og ingenting som krever samtykke skal lastes
        før samtykket er gitt.
      </p>
      <p>
        Unntaket er informasjonskapsler som er <em>strengt nødvendige</em> for at
        tjenesten skal virke – en handlekurv, en innlogging, en språkinnstilling.
        Det unntaket kan ingen maskin vurdere. Derfor sier dette verktøyet hva som
        ble satt, ikke om du er lovlig.
      </p>
      <p class="wow-notat">
        Dette er en teknisk observasjon, ikke en juridisk vurdering, og ikke juridisk
        rådgivning.
      </p>
      {/* V1 hadde et terminalutsnitt («cookie-sjekk --hvordan») her. Kommandoen finnes ikke, så
          det var pynt. De fire leddene er en ekte rekkefølge og står som en nummerert liste, med
          de samme ordene. */}
      <ol>
        <li>Ny nettleserprofil, ingen historikk</li>
        <li>Laster forsiden, venter til det er stille</li>
        <li>Klikker <strong>aldri</strong> på banneret</li>
        <li>Leser cookies, lagring og tredjepartskall</li>
      </ol>
      <p class="wow-notat">
        Å ikke klikke er hele poenget. Et samtykkebanner som ligger urørt er
        nettopp situasjonen loven regulerer.
      </p>
    </Prosa>
  </Seksjon>

  {/* Ekte opptak av verktøyet mens det kjører, ikke en render: det BEVISER at sjekken gjør et
      reelt oppslag. Det står alene, uten generert bilde ved siden av (et bevis ved siden av pynt
      leses som pynt). */}
  <div class="wow-rute cookie-opptak">
    <div class="wow-vt-opptak">
      <Opptak navn="cookie-sjekk" adresse="kodekonsulentene.no/verktoy/cookie-sjekk" />
    </div>
  </div>

  <Seksjon
    id="etterpa"
    tittel="Vil du at vi rydder opp?"
    ingress="Lovsjekk-pakken dekker cookies, universell utforming, lovpålagt informasjon og personvernerklæring på den siden du har i dag. Du trenger ikke ny nettside for det."
    storrelse="tjeneste"
  >
    {/* Tre handlinger, som i v1: én primær, én sekundær, én lenke (Handlinger tar bare to). */}
    <div class="wow-vt-etter">
      <a class="wow-knapp" href="/priser"><span class="wow-knapp__tekst">Se hva det koster</span></a>
      <a class="wow-knapp wow-knapp--strek" href="/sjekk"><span class="wow-knapp__tekst">Kjør den fulle sjekken</span></a>
      <a class="wow-lenke" href="/verktoy/uu-sjekk">Sjekk universell utforming</a>
    </div>
  </Seksjon>

  <Kontaktblokk tittel="Spørsmål om funnene?" ingress="Har du rapporten foran deg og vil vite hva som haster, tar det fem minutter på telefon." />
</MalWow>

<style>
  .cookie-opptak {
    padding-top: var(--wow-seksjon-tett);
  }
</style>

<script>
  import { maalingHtml, rapportarkHtml, fraSjekk, type MaalingData } from "../../components/wow/side/maaling";

  interface Cookie {
    navn: string; domene: string; forstepart: boolean;
    levetidDager: number | null; sikker: boolean; httpOnly: boolean; sporer: string | null;
  }
  interface Sporer { id: string; navn: string; kategori: string; vert: string; antallKall: number; typiskeCookies: string[] }
  interface Rapport {
    url: string; dato: string; status: "ok" | "warn" | "fail" | "neutral";
    antallCookies: number; antallTredjepart: number;
    cookies: Cookie[]; lagring: { local: string[]; session: string[] };
    sporere: Sporer[]; ukjenteTredjeparter: { vert: string; antallKall: number }[];
    sekunder: number; oppsummering: string; forbehold: string[]; feil?: string;
  }

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const boks = document.querySelector<HTMLElement>("#resultat")!;
  const felt = document.querySelector<HTMLInputElement>("#url-cookie")!;
  const skjema = felt.closest("form");

  // De fire radene sjekken alltid rapporterer. Samme navn mens den venter og når svaret er her.
  const RADER = ["Før samtykke", "Sporingstjenester", "Tredjeparts-cookies", "Lagring i nettleser"] as const;

  /** Én rad utenfor et rapportark: sjekken kjørte ikke. «Ikke sjekket», aldri «Bestått» eller «Brudd». */
  const stoppet = (hvorfor: string) => {
    boks.innerHTML = maalingHtml(
      {
        navn: "Sjekken stoppet",
        status: "ikke-sjekket",
        merknad: `${hvorfor} At sjekken ikke kjørte er ikke det samme som at siden er i orden.`,
      },
      "div",
    );
  };

  const levetid = (d: number | null) =>
    d === null ? "økt" : d === 0 ? "i dag" : d === 1 ? "1 dag" : `${d} dager`;

  function tegn(r: Rapport) {
    const lagringsliste = [...r.lagring.local, ...r.lagring.session];

    const rader: MaalingData[] = [
      { navn: RADER[0], verdi: String(r.antallCookies), status: fraSjekk[r.status], merknad: r.oppsummering },
      {
        // «Bør fikses», ikke «Brudd». Et lastet sporingsskript er en HTTP-forespørsel – ekomloven
        // § 3-15 gjelder LAGRING I og TILGANG TIL utstyret. Målt på 38 sider: tre nettsteder
        // lastet Google Tag Manager, satte NULL cookies, hadde samtykke på «denied» som standard.
        navn: RADER[1],
        verdi: String(r.sporere.length),
        status: r.sporere.length ? "bor" : "bestatt",
        merknad: r.sporere.length
          ? r.sporere.map((s) => s.navn).join(", ")
          : "Ingen kjente sporere lastet før samtykke.",
      },
      {
        navn: RADER[2],
        verdi: String(r.antallTredjepart),
        status: r.antallTredjepart ? "brudd" : "bestatt",
        merknad: r.antallTredjepart
          ? "Cookies fra andre domener er sjelden strengt nødvendige."
          : "Ingen cookies fra andre domener.",
      },
      {
        navn: RADER[3],
        verdi: String(lagringsliste.length),
        status: lagringsliste.length ? "bor" : "bestatt",
        merknad: lagringsliste.length
          ? `localStorage og sessionStorage teller også som lagring etter § 3-15: ${lagringsliste.slice(0, 5).join(", ")}`
          : "Ingenting lagret i nettleseren.",
      },
    ];

    const sporerRader = r.sporere
      .map(
        (s) => `<tr>
          <th scope="row">${esc(s.navn)}</th>
          <td>${esc(s.kategori)}</td>
          <td>${esc(s.vert)}</td>
          <td>Setter typisk ${esc(s.typiskeCookies.slice(0, 3).join(", "))}</td>
        </tr>`,
      )
      .join("");

    const cookieRader = r.cookies
      .map(
        (c) => `<tr>
          <th scope="row">${esc(c.navn)}</th>
          <td>${c.forstepart ? "Siden selv" : "Tredjepart"}</td>
          <td>${esc(c.domene)}</td>
          <td>${esc(levetid(c.levetidDager))}${c.sporer ? `, ${esc(c.sporer)}` : ""}</td>
        </tr>`,
      )
      .join("");

    boks.innerHTML =
      rapportarkHtml({
        tittelId: "rapport-tittel",
        rader,
        adresse: r.url,
        dato: `${r.dato}. Skannet på ${r.sekunder} s uten å klikke`,
      }) +
      `<div class="wow-prosa">` +
      (r.sporere.length
        ? `<table>
             <caption>Sporere som lastet</caption>
             <thead><tr><th scope="col">Tjeneste</th><th scope="col">Kategori</th><th scope="col">Vert</th><th scope="col">Typiske cookies</th></tr></thead>
             <tbody>${sporerRader}</tbody>
           </table>`
        : "") +
      (r.cookies.length
        ? `<details>
             <summary>Alle ${r.cookies.length} informasjonskapsler</summary>
             <table>
               <thead><tr><th scope="col">Navn</th><th scope="col">Satt av</th><th scope="col">Domene</th><th scope="col">Varer</th></tr></thead>
               <tbody>${cookieRader}</tbody>
             </table>
           </details>`
        : "") +
      `<details>
         <summary>Forbehold – hva sjekken ikke avgjør</summary>
         <ul class="wow-notat">${r.forbehold.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>
       </details>` +
      `</div>`;

    // Resultatet er klart: flytt fokus til rapportens tittel, så skjermleseren starter der.
    document.getElementById("rapport-tittel")?.focus({ preventScroll: false });
  }

  async function kjor(url: string) {
    if (!url.trim()) return;
    boks.setAttribute("aria-busy", "true");
    // Venter: de samme fire radene, uten verdi. Ingen spinner.
    boks.innerHTML =
      rapportarkHtml({ rader: RADER.map((navn) => ({ navn, status: "venter" as const })), adresse: url }) +
      `<p class="wow-vt-venter">Vi starter en nettleser og laster siden. Det tar vanligvis 15–30 sekunder.</p>`;
    try {
      const svar = await fetch("/api/cookie-sjekk", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ url }),
      });
      const data = (await svar.json()) as Rapport;
      if (!svar.ok || data.feil) {
        stoppet(data.feil ?? "Ukjent feil.");
        return;
      }
      tegn(data);
    } catch {
      stoppet("Fikk ikke svar fra serveren. Prøv igjen om et øyeblikk.");
    } finally {
      boks.setAttribute("aria-busy", "false");
    }
  }

  skjema?.addEventListener("submit", (e) => {
    e.preventDefault();
    history.replaceState(null, "", `/verktoy/cookie-sjekk?url=${encodeURIComponent(felt.value)}`);
    void kjor(felt.value);
  });

  // Siden er forhåndsbygget, så ?url= kommer ikke med i feltets value fra serveren. Adressen
  // leses her (samme grep som /sjekk), så feltet i artikkelen «Cookies før samtykke» og lenker
  // med ?url= kjører sjekken med en gang.
  const fraAdresse = new URLSearchParams(location.search).get("url")?.trim() ?? "";
  if (fraAdresse && !felt.value.trim()) felt.value = fraAdresse;
  if (felt.value.trim()) void kjor(felt.value);
</script>
