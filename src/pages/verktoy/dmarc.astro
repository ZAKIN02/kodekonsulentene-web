---
/**
 * E-postsjekken i wow-drakten (wow-undersider.md del 1.8, runde wow-r8-B2, etter mønstersiden
 * cookie-sjekk). Rekkefølge: Verktoyramme (brødsmuler, H1, feltet, resultatet) → de tre postene
 * (snitt og forklaring) → ekte opptak → «Etterpå» → kontaktblokk. «rolig».
 *
 * Uendret fra v1: API-kallet (POST /api/dmarc med { domene, dkim }), id-ene `#dmarc-skjema`,
 * `#domene`, `#dkim` og `#resultat`, feltnavnene `domene` og `dkim`, alle feiltekster,
 * forbeholdene og WebApplication-markupen.
 * Nytt: SPF, DKIM og DMARC står som målinger (lampe + status som ord), fokus flyttes til
 * rapportens tittel når den er klar, og `?domene=` leses fra adressen også i bygget.
 *
 * Flyttet: snittet sto mellom ingressen og feltet, og skjøv feltet ut av første skjerm på mobil.
 * Det står nå i forklaringen, der det erstatter lista som sa det samme (SPF, DKIM, DMARC).
 */
import MalWow from "../../layouts/MalWow.astro";
import { Verktoyramme, UrlFelt, Seksjon, Prosa, Opptak, Kontaktblokk } from "../../components/wow/side";
import Handlinger from "../../components/wow/side/Handlinger.astro";
import Snitt from "../../components/wow/verktoy/Snitt.astro";
import { snitt } from "../../data/flyter";
import { verktoy } from "../../data/schema";
import { firma } from "../../data/firma";
import { prisenhet } from "../../data/priser";

// Siden er statisk: i bygget er searchParams tom, og skriptet under leser ?domene= fra
// location.search. Linja fyller feltet bare i `astro dev`.
const forhandsutfylt = Astro.url.searchParams.get("domene") ?? "";
/**
 * `WebApplication` fra `verktoy()` i src/data/schema.ts. `price: "0"` og
 * `isAccessibleForFree` er sanne: verktøyet krever ingen innlogging og koster ingenting.
 */
const schema = verktoy({
  navn: "SPF-, DKIM- og DMARC-sjekk",
  beskrivelse:
    "Leser SPF, DKIM og DMARC rett fra DNS og forklarer om noen kan sende e-post i foretakets navn, og hvorfor egen e-post havner i soeppelposten. Ingen e-post sendes.",
  sti: "/verktoy/dmarc",
});
---

<MalWow
  tittel="Sjekk e-posten din: SPF, DKIM og DMARC"
  beskrivelse="Gratis sjekk av SPF, DKIM og DMARC på domenet ditt. Se om noen kan sende e-post i bedriftens navn, og om din egen e-post havner i søppelposten."
  schema={[schema]}
  bevegelse="rolig"
>
  {/* «e‑post» i H1 har hard bindestrek (U+2011), så overskriften ikke deles «E-» / «POST». Lampa
      «Din side» er av: her sjekkes et domene, ikke en side. */}
  <Verktoyramme
    tittel="Kan noen sende e‑post i ditt navn?"
    ingress="Tre poster i DNS avgjør det: SPF, DKIM og DMARC. Mangler de, kan hvem som helst sende faktura som ser ut til å komme fra bedriften din – og din egen e-post havner oftere i søppelposten."
  >
    <UrlFelt
      slot="skjema"
      id="domene"
      navn="domene"
      type="domene"
      action="/verktoy/dmarc"
      knapp="Sjekk"
      skjemaId="dmarc-skjema"
      lampe={false}
      verdi={forhandsutfylt}
      hint="Vi leser bare DNS. Ingen e-post sendes, ingenting lagres."
    >
      <details class="dmarc-dkim">
        <summary>Har du DKIM-selektoren? (valgfritt)</summary>
        <div class="wow-skjema__felt">
          <label for="dkim">DKIM-selektor</label>
          <input id="dkim" name="dkim" type="text" placeholder="google" spellcheck="false" autocapitalize="off" aria-describedby="dkim-hint" />
          <p class="wow-skjema__hint" id="dkim-hint">
            DKIM ligger på en selektor vi ikke kan gjette. Google Workspace bruker ofte
            «google», Microsoft 365 bruker «selector1». Står den ikke her, hopper vi over DKIM.
          </p>
        </div>
      </details>
    </UrlFelt>
    <p slot="noscript">
      Sjekken krever JavaScript. Send domenet til{" "}
      <a class="wow-lenke" href={`mailto:${firma.epost}?subject=E-postsjekk`}>{firma.epost}</a>,
      så kjører vi den manuelt.
    </p>
  </Verktoyramme>

  <Seksjon id="postene" tittel="De tre postene, forklart" storrelse="tjeneste" tett>
    <div class="wow-vt-stabel">
      {/* Tegning med ekte navn, hentet fra src/data/flyter.ts. Bildeteksten er av: avsnittet
          under sier det samme, og et løfte skal ikke stå to ganger på siden (del 12). */}
      <div class="wow-vt-opptak">
        <Snitt snitt={snitt.epost} bildetekst={false} />
      </div>
      <Prosa class="dmarc-prosa">
        <p>
          SPF sier hvilke servere som har lov til å sende e-post for domenet ditt.
          DKIM signerer hver e-post, slik at mottakeren ser at innholdet ikke er endret.
          DMARC binder de to sammen og sier hva som skal skje når noe ikke stemmer.
        </p>
        <p>
          Den vanligste feilen er ikke at postene mangler, men at DMARC står på{" "}
          <code>p=none</code>. Da blir falsk e-post i ditt navn levert
          som normalt – du får bare en rapport om at det skjedde.
        </p>
        {/* Kommandoen finnes og kan kjøres, så den står som kode (v1: terminalutsnitt). Linjene
            under er utsnittets egne ord. */}
        <pre><code>dig +short TXT _dmarc.dinbedrift.no
(tomt)</code></pre>
        <p>
          Ingen DMARC-post. Noen kan sende faktura i ditt navn, og du får ikke beskjed om at det skjer.
        </p>
        <p class="wow-notat">
          Sjekken sier at postene finnes og er riktig formet. Den sier ikke at hele
          e-postoppsettet ditt virker i praksis – det krever en testsending.
        </p>
      </Prosa>

      {/* Ekte opptak av vårt eget verktøy mot nkom.no, ikke en render. */}
      <div class="wow-vt-opptak">
        <Opptak navn="dmarc" adresse="kodekonsulentene.no/verktoy/dmarc" />
      </div>
    </div>
  </Seksjon>

  <Seksjon
    id="etterpa"
    tittel="Vil du at vi ordner det?"
    ingress={`Å sette opp SPF, DKIM og DMARC riktig tar vanligvis en til to timer, og det gjøres én gang. Timeprisen er ${firma.timepris}, og det er ${prisenhet}.`}
    storrelse="tjeneste"
  >
    <Handlinger
      handlinger={[
        { tekst: "Book 20 minutter", href: "/kontakt", type: "primar" },
        { tekst: "Se de andre verktøyene", href: "/verktoy", type: "strek" },
      ]}
    />
  </Seksjon>

  <Kontaktblokk />
</MalWow>

<style>
  /* Kodeblokken følger lesebredden, som avsnittene rundt den. */
  :global(.dmarc-prosa) :global(pre) {
    max-width: var(--wow-maal-brod);
  }
  /* DKIM-feltet under adressefeltet: lukket som standard, samme feltstil som kontaktskjemaet. */
  .dmarc-dkim {
    margin-top: var(--wow-rom-3);
  }
  .dmarc-dkim summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--wow-trykkflate);
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-liten);
    cursor: pointer;
  }
  .dmarc-dkim .wow-skjema__felt {
    margin-top: var(--wow-rom-3);
  }
  .dmarc-dkim input {
    width: 100%;
    min-height: var(--wow-felt);
    padding: var(--wow-rom-3) var(--wow-rom-4);
    background: var(--wow-flate);
    color: var(--wow-tekst);
    border: var(--wow-kant-1) solid var(--wow-linje-sterk);
    border-radius: var(--wow-radius-s);
    font: inherit;
    font-size: var(--wow-tekst-brod);
  }
  .dmarc-dkim input:focus {
    background: var(--wow-flate-hev);
    border-color: var(--wow-refleks);
  }
</style>

<style is:global>
  /* DNS-verdier er bokstavrette («p=none», «-all», selektornavnet). De står derfor ikke i
     versaler, og hele verdien har én størrelse: rapportspråket deler ellers verdien i tall og
     enhet, og det passer ikke på «-all · 3/10 oppslag». Gjelder bare resultatet på denne siden. */
  #resultat .wow-maaling__verdi {
    font-size: var(--wow-tekst-h3);
    line-height: 1.1;
    text-transform: none;
    white-space: normal;
    text-align: right;
  }
  #resultat .wow-maaling__verdi .wow-maalt__enhet {
    font: inherit;
    letter-spacing: inherit;
  }
</style>

<script>
  import { maalingHtml, rapportarkHtml, statusOrd, fraSjekk } from "../../components/wow/side/maaling";

  type Status = "ok" | "warn" | "fail" | "neutral";
  interface Rad { name: string; status: Status; value: string; note: string }
  interface Rapport { domene: string; dato: string; rader: Rad[]; totalt: number; forbehold: string[] }

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const boks = document.querySelector<HTMLElement>("#resultat")!;
  const skjema = document.querySelector<HTMLFormElement>("#dmarc-skjema")!;
  const felt = document.querySelector<HTMLInputElement>("#domene")!;
  const dkimFelt = document.querySelector<HTMLInputElement>("#dkim")!;

  // De tre postene sjekken slår opp. Samme navn mens den venter og når svaret er her.
  const RADER = ["SPF", "DKIM", "DMARC"] as const;

  /** Én rad utenfor et rapportark: sjekken kjørte ikke. «Ikke sjekket», aldri «Bestått» eller «Brudd». */
  const stoppet = (hvorfor: string) => {
    boks.innerHTML = maalingHtml({ navn: "Sjekken stoppet", status: "ikke-sjekket", merknad: hvorfor }, "div");
  };

  function tegn(r: Rapport) {
    boks.innerHTML =
      rapportarkHtml({
        tittelId: "rapport-tittel",
        rader: r.rader.map((x) => {
          const status = fraSjekk[x.status];
          // DKIM uten selektor kommer som verdien «Ikke sjekket» med status «neutral». Ordet
          // står da allerede ved lampa, og skrives ikke én gang til som verdi.
          const verdi = x.value === statusOrd[status] ? undefined : x.value;
          return { navn: x.name, verdi, status, merknad: x.note };
        }),
        adresse: r.domene,
        dato: `${r.dato}. Samlet: ${r.totalt} av 100`,
      }) +
      `<div class="wow-prosa">
         <details>
           <summary>Forbehold – hva sjekken ikke ser</summary>
           <ul class="wow-notat">${r.forbehold.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>
         </details>
       </div>`;

    // Resultatet er klart: flytt fokus til rapportens tittel, så skjermleseren starter der.
    document.getElementById("rapport-tittel")?.focus({ preventScroll: false });
  }

  async function kjor(domene: string, dkim: string) {
    if (!domene.trim()) return;
    boks.setAttribute("aria-busy", "true");
    // Venter: de tre postene, uten verdi. Ingen spinner.
    boks.innerHTML =
      rapportarkHtml({ rader: RADER.map((navn) => ({ navn, status: "venter" as const })), adresse: domene }) +
      `<p class="wow-vt-venter">Tre DNS-oppslag. Dette tar et par sekunder.</p>`;
    try {
      const svar = await fetch("/api/dmarc", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ domene, dkim: dkim || undefined }),
      });
      const data = (await svar.json()) as Rapport & { feil?: string };
      if (!svar.ok || data.feil) {
        stoppet(data.feil ?? "Ukjent feil.");
        return;
      }
      tegn(data);
    } catch {
      stoppet("Fikk ikke svar fra serveren. Prøv igjen om et øyeblikk.");
    } finally {
      boks.setAttribute("aria-busy", "false");
    }
  }

  skjema.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = felt.value;
    history.replaceState(null, "", `/verktoy/dmarc?domene=${encodeURIComponent(d)}`);
    void kjor(d, dkimFelt.value);
  });

  // Siden er forhåndsbygget, så ?domene= kommer ikke med i feltets value fra serveren.
  // Adressen leses her (samme grep som /sjekk).
  const fraAdresse = new URLSearchParams(location.search).get("domene")?.trim() ?? "";
  if (fraAdresse && !felt.value.trim()) felt.value = fraAdresse;
  if (felt.value.trim()) void kjor(felt.value, dkimFelt.value);
</script>
