---
import Base from "../../layouts/Base.astro";
import Snitt from "../../components/Snitt.astro";
import { snitt } from "../../data/flyter";
import Scene from "../../components/Scene.astro";
import Mega from "../../components/Mega.astro";
import Avslor from "../../components/Avslor.astro";
import Button from "../../components/Button.astro";
import Terminal from "../../components/Terminal.astro";
import Stillbilde from "../../components/Stillbilde.astro";
import Demo from "../../components/Demo.astro";
import opptak from "../../data/opptak.json";
import ContactBlock from "../../components/ContactBlock.astro";
import { firma } from "../../data/firma";

import "../../styles/scener.css";

const forhandsutfylt = Astro.url.searchParams.get("domene") ?? "";
---
<Base
  tittel="Sjekk e-posten din: SPF, DKIM og DMARC"
  beskrivelse="Gratis sjekk av SPF, DKIM og DMARC på domenet ditt. Se om noen kan sende e-post i bedriftens navn, og om din egen e-post havner i søppelposten."
>
  <Scene lav>
    <Mega som="h1" merke="Verktøy" n={1} tekst="Kan noen sende e-post i ditt navn?" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Tre poster i DNS avgjør det: SPF, DKIM og DMARC. Mangler de, kan hvem som helst sende faktura som ser ut til å komme fra bedriften din – og din egen e-post havner oftere i søppelposten.</p>
    </Avslor>

    <Avslor trinn={2}>
      {/* Tegning med ekte navn, hentet ordrett fra siden. Brandboken rangerer
          diagram over generert materiale – det forklarer, og koster 0 kB. */}
      <Snitt snitt={snitt.epost} nivaa={2} />
    </Avslor>

    <Avslor>
    <div class="stack">
      <form class="stack stack--tight" id="dmarc-skjema" style="max-width: 560px">
        <div class="kk-urlcheck">
          <label class="visually-hidden" for="domene">Domene</label>
          <span class="kk-prompt" aria-hidden="true">@</span>
          <input
            class="kk-input" id="domene" name="domene" type="text" inputmode="url"
            value={forhandsutfylt} placeholder="dinbedrift.no" autocomplete="url"
            spellcheck="false" required
          />
          <Button variant="primary" type="submit">Sjekk</Button>
        </div>
        <details>
          <summary class="small muted" style="cursor: pointer">Har du DKIM-selektoren? (valgfritt)</summary>
          <div class="field" style="margin-top: var(--space-3)">
            <label for="dkim">DKIM-selektor</label>
            <input class="control" id="dkim" name="dkim" type="text" placeholder="google" spellcheck="false" />
            <span class="hint">
              DKIM ligger på en selektor vi ikke kan gjette. Google Workspace bruker ofte
              «google», Microsoft 365 bruker «selector1». Står den ikke her, hopper vi over DKIM.
            </span>
          </div>
        </details>
        <p class="kk-urlcheck-hint">Vi leser bare DNS. Ingen e-post sendes, ingenting lagres.</p>
      </form>

      <div id="resultat" aria-live="polite" aria-busy="false"></div>

      <noscript>
        <p class="card">
          Sjekken krever JavaScript. Send domenet til
          <a class="kk-link" href={`mailto:${firma.epost}?subject=E-postsjekk`}>{firma.epost}</a>,
          så kjører vi den manuelt.
        </p>
      </noscript>
    </div>
    </Avslor>
  </Scene>

  <Scene n={2} eyebrow="Hva det betyr" tittel="De tre postene, forklart">
    <Avslor>
    <div class="grid-2">
      <div class="stack">
        <dl class="kv">
          <div><dt>SPF</dt><dd>hvem får sende</dd></div>
          <div><dt>DKIM</dt><dd>signatur på e-posten</dd></div>
          <div><dt>DMARC</dt><dd>hva mottaker skal gjøre</dd></div>
        </dl>
        <p class="muted">
          SPF sier hvilke servere som har lov til å sende e-post for domenet ditt.
          DKIM signerer hver e-post, slik at mottakeren ser at innholdet ikke er endret.
          DMARC binder de to sammen og sier hva som skal skje når noe ikke stemmer.
        </p>
        <p class="muted">
          Den vanligste feilen er ikke at postene mangler, men at DMARC står på
          <span class="mono">p=none</span>. Da blir falsk e-post i ditt navn levert
          som normalt – du får bare en rapport om at det skjedde.
        </p>
      </div>
      <div class="stack">
        <Terminal
          skriv
          title="~/kodekonsulentene/dmarc"
          lines={[
            { type: "cmd", text: "dig +short TXT _dmarc.dinbedrift.no" },
            { type: "fail", text: "(tomt)" },
            { type: "out", text: "" },
            { type: "warn", text: "ingen DMARC-post" },
            { type: "out", text: "noen kan sende faktura i ditt navn," },
            { type: "out", text: "og du får ikke beskjed om at det skjer" },
          ]}
          label="Terminalutsnitt: oppslag etter DMARC-post gir tomt svar. Uten DMARC kan noen sende faktura i bedriftens navn uten at eieren får beskjed."
        />
        <p class="small faint">
          Sjekken sier at postene finnes og er riktig formet. Den sier ikke at hele
          e-postoppsettet ditt virker i praksis – det krever en testsending.
        </p>
      </div>
    </div>
    </Avslor>

    <Avslor trinn={2}>
      {/* Ekte opptak av vårt eget verktøy mot nkom.no, ikke en render. Det BEVISER
          at verktøyet virker i stedet for å antyde det, og kan ikke kopieres av noen
          som ikke har bygget det. Demo rammer med hårlinje og bildetekst med dato;
          SceneFilm ville tonet det ned som bakgrunn, og da leser det som tapet. */}
      <Demo
        smal={opptak.dmarc.smal}
        bred={opptak.dmarc.bred}
        stor={opptak.dmarc.stor}
        plakat={opptak.dmarc.plakat}
        tekst={opptak.dmarc.tekst}
        kilde={opptak.dmarc.kilde}
      />
    </Avslor>

    <Avslor trinn={3}>
      <Stillbilde id="verktoy-dmarc" sizes="(min-width: 1120px) 1120px, 100vw">
        Tre poster. Nesten alle som feiler sjekken har to på plass og én som ikke står der den skal.
      </Stillbilde>
    </Avslor>
  </Scene>

  <Scene n={3} eyebrow="Etterpå" tittel="Vil du at vi ordner det?" ingress="Å sette opp SPF, DKIM og DMARC riktig tar vanligvis en til to timer, og det gjøres én gang. Timeprisen er 950 kr eks. mva.">
    <Avslor>
    <div class="row">
      <Button variant="primary" href="/kontakt">Book 20 minutter</Button>
      <Button variant="ghost" href="/verktoy">Se de andre verktøyene</Button>
    </div>
    </Avslor>
  </Scene>

  <ContactBlock n={4} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  .scene:first-of-type .avslor:first-of-type {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  /* Resultatet glir inn når skriptet setter det inn i DOM-en.
     @starting-style gir startverdien for et element som ikke fantes ved forrige
     maling. Før den måtte man sette en klasse fra JavaScript én ramme etterpå –
     her er det ren CSS, 0 B.

     Langformer og ikke `transition:`-stenografi. CSS-minifieren slår stenografi
     sammen på måter både Chromium og Firefox har forkastet STILLE her før.

     Rekkefølgen er ikke valgfri: @starting-style må stå ETTER hovedregelen, ellers
     vinner hovedregelen og startverdien blir lik sluttverdien – altså ingen overgang.
     Uten støtte vises resultatet uten overgang. Degraderingen går mot «synlig». */
  #resultat > * {
    opacity: 1;
    transform: none;
    transition-property: opacity, transform;
    transition-duration: 260ms;
    transition-timing-function: ease;
  }
  @starting-style {
    #resultat > * {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #resultat > * { transition-duration: 0.01ms; }
  }

  /* Skjemaet er sidens handling, og det skal aldri vente på en scroll.
     Unntaket over gjelder bare FØRSTE avdekking. Den andre inneholder selve
     skjemaet, og på 900 px høyde ligger det akkurat i foldekanten: målt 0,56
     opasitet ved innlasting på /verktoy/cookie-sjekk, 0,87 på kalkulatoren.
     Det er view()-tidslinjen som gjør jobben sin – elementet er delvis inne i
     bildet – men en halvgjennomsiktig inngang er feil på den siden som skal få
     folk til å kjøre sjekken.

     :has(form) treffer nøyaktig den blokken og ingenting annet. Uten støtte for
     :has() faller siden tilbake til dagens oppførsel: innholdet er fortsatt der
     og blir helt synlig ved første scroll. Degraderingen går mot «synlig». */
  /* Ikke barnekombinator: .avslor ligger inne i .scene__inner, ikke rett under
     .scene. Med «>» traff regelen ingenting – målt på /verktoy/cookie-sjekk, der
     skjemaet sto på 0,56 opasitet ved innlasting selv med unntaket på plass. */
  /* Ingressen treffes på hva den ER, ikke på posisjon. `:first-of-type` gjelder
     TAGG, ikke klasse: står det et annet <div> foran avdekkingen, peker den et
     annet sted. Målt på /verktoy/cookie-sjekk – ingressen lå på 0,78 ved
     innlasting selv med unntaket på plass. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>

<script>
  const ORD = { ok: "Bestått", warn: "Bør fikses", fail: "Brudd", neutral: "Ikke sjekket" } as const;
  type Status = keyof typeof ORD;

  const IKON: Record<Status, string> = {
    ok: '<path d="M20 6 9 17l-5-5"/>',
    warn: '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
    fail: '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>',
    neutral: '<circle cx="12" cy="12" r="10"/><path d="M8 12h8"/>',
  };

  interface Rad { name: string; status: Status; value: string; note: string }
  interface Rapport { domene: string; dato: string; rader: Rad[]; totalt: number; forbehold: string[] }

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const badge = (s: Status) =>
    `<span class="kk-badge kk-badge-${s}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${IKON[s]}</svg>${ORD[s]}</span>`;

  const boks = document.querySelector<HTMLElement>("#resultat")!;
  const skjema = document.querySelector<HTMLFormElement>("#dmarc-skjema")!;
  const felt = document.querySelector<HTMLInputElement>("#domene")!;
  const dkimFelt = document.querySelector<HTMLInputElement>("#dkim")!;

  const melding = (html: string) => { boks.innerHTML = `<div class="card">${html}</div>`; };

  function tegn(r: Rapport) {
    const rader = r.rader
      .map(
        (x) => `<tr>
          <td class="kk-name">${esc(x.name)}</td>
          <td>${badge(x.status)}</td>
          <td class="kk-value">${esc(x.value)}</td>
          <td class="kk-note">${esc(x.note)}</td>
        </tr>`,
      )
      .join("");

    boks.innerHTML = `
      <div class="stack">
        <div class="kk-report">
          <div class="kk-report-head"><span class="kk-url">${esc(r.domene)}</span><span>${esc(r.dato)}</span></div>
          <table>
            <thead><tr><th scope="col">Post</th><th scope="col">Status</th><th scope="col">Verdi</th><th scope="col">Hva det betyr</th></tr></thead>
            <tbody>${rader}</tbody>
          </table>
          <div class="kk-report-foot"><span>Samlet: ${r.totalt} av 100</span><span class="mono">${esc(r.domene)}</span></div>
        </div>
        <details class="card card--sunken">
          <summary class="body-strong" style="cursor: pointer">Forbehold – hva sjekken ikke ser</summary>
          <ul class="small muted" style="margin: var(--space-3) 0 0; padding-left: var(--space-5); display: grid; gap: var(--space-2)">
            ${r.forbehold.map((f) => `<li>${esc(f)}</li>`).join("")}
          </ul>
        </details>
      </div>`;
  }

  async function kjor(domene: string, dkim: string) {
    if (!domene.trim()) return;
    boks.setAttribute("aria-busy", "true");
    melding(`<p class="mono">$ dig TXT ${esc(domene)} …</p><p class="small faint">Tre DNS-oppslag. Dette tar et par sekunder.</p>`);
    try {
      const svar = await fetch("/api/dmarc", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ domene, dkim: dkim || undefined }),
      });
      const data = (await svar.json()) as Rapport & { feil?: string };
      if (!svar.ok || data.feil) {
        melding(`<p class="body-strong">Sjekken stoppet.</p><p class="muted">${esc(data.feil ?? "Ukjent feil.")}</p>`);
        return;
      }
      tegn(data);
    } catch {
      melding('<p class="body-strong">Sjekken stoppet.</p><p class="muted">Fikk ikke svar fra serveren. Prøv igjen om et øyeblikk.</p>');
    } finally {
      boks.setAttribute("aria-busy", "false");
    }
  }

  skjema.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = felt.value;
    history.replaceState(null, "", `/verktoy/dmarc?domene=${encodeURIComponent(d)}`);
    void kjor(d, dkimFelt.value);
  });

  if (felt.value.trim()) void kjor(felt.value, dkimFelt.value);
</script>
