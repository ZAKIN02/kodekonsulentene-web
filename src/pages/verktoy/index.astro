---
/**
 * Samleside for gratisverktøyene i wow-drakten (wow-undersider.md del 1.8, runde wow-r8-B2).
 * Verktøyene er sidens viktigste salgsargument: de viser at vi kan jobben i stedet for å påstå
 * det. Rekkefølge: SideHode → verktøyene som rader → «Sjekken som kjører» (ekte opptak) →
 * kontaktblokk. «rolig».
 *
 * Ute, med vilje:
 *  - ServiceCard-kortene og de tre punktene per kort (planen: rader med navn, hva det måler og
 *    lenke; fem like kort er del 12 «samme kortoppsett tre eller flere ganger»).
 *  - «Kortene uten lenke er under arbeid»: alle fem verktøyene har lenke.
 *  - «Motoren er åpen kildekode» (kommandolinje og GitHub Action). Påstanden er ikke bekreftet
 *    av eier (wow-undersider.md åpent punkt 3), og det som ikke er dokumentert, rendres ikke.
 */
import MalWow from "../../layouts/MalWow.astro";
import { SideHode, Seksjon, Tekstrader, Opptak, Kontaktblokk } from "../../components/wow/side";

const verktoy = [
  {
    tittel: "Sjekk nettsiden din",
    href: "/sjekk",
    tekst: "Ytelse, sikkerhetsheadere, cookies før samtykke, WCAG-feil og org.nr. i én sjekk.",
  },
  {
    tittel: "Hva koster det?",
    href: "/verktoy/priskalkulator",
    tekst: "Fire spørsmål gir et prisspenn, med alle timeanslag og forutsetninger synlige.",
  },
  {
    // Hard bindestrek (U+2011), så tittelen ikke deles «E-» / «POST» i versaler.
    tittel: "Kan noen sende e‑post i ditt navn?",
    href: "/verktoy/dmarc",
    tekst: "SPF, DKIM og DMARC lest rett fra DNS, forklart uten driftssjargong.",
  },
  {
    tittel: "Cookie-sjekk",
    href: "/verktoy/cookie-sjekk",
    tekst: "Laster siden uten å klikke på noe, og lister alt som settes før samtykke.",
  },
  {
    tittel: "Universell utforming",
    href: "/verktoy/uu-sjekk",
    tekst: "De maskinelt testbare av de 35 kravene private virksomheter må oppfylle.",
  },
];
---

<MalWow
  tittel="Gratisverktøy for nettsiden din"
  beskrivelse="Gratis verktøy for norske bedrifter: nettsidesjekk, priskalkulator, e-postsikkerhet, cookie-sjekk og universell utforming. Ingen innlogging."
  bevegelse="rolig"
>
  <SideHode
    tittel="Verktøy du kan kjøre selv"
    ingress="Vi selger sikkerhet og etterlevelse. Da er det rimelig at du får se at vi kan det, før du betaler for noe. Ingen innlogging, ingen e-post før du selv ber om rapporten."
    storrelse="tjeneste"
  />

  {/* Radene er h2: de er sidens innhold rett under H1, og da hopper ikke overskriftsnivået. */}
  <div class="wow-rute verktoy-liste">
    <Tekstrader rader={verktoy} niva={2} stil="display" />
  </div>

  <Seksjon id="opptak" tittel="Sjekken som kjører" storrelse="tjeneste">
    {/* Ekte opptak av e-postsjekken mot nkom.no. Navnet står i bildeteksten fordi domenet skrives
        inn på skjermen i selve opptaket. Oppslagene er offentlige DNS-poster hos et
        forvaltningsorgan; regelen om ikke å navngi gjelder sidene i masseskanningen. */}
    <div class="wow-vt-opptak">
      <Opptak navn="dmarc" adresse="kodekonsulentene.no/verktoy/dmarc" />
    </div>
  </Seksjon>

  <Kontaktblokk />
</MalWow>

<style>
  .verktoy-liste {
    padding-top: var(--wow-seksjon-tett);
  }
</style>
