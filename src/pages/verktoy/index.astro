---
import Base from "../../layouts/Base.astro";
import Scene from "../../components/Scene.astro";
import Mega from "../../components/Mega.astro";
import Avslor from "../../components/Avslor.astro";
import Demo from "../../components/Demo.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import ContactBlock from "../../components/ContactBlock.astro";

import "../../styles/scener.css";

/**
 * Samleside for gratisverktøyene. Verktøyene er sidens viktigste salgsargument:
 * de viser at vi kan jobben i stedet for å påstå det.
 *
 * cookie-sjekk og uu-sjekk bygges parallelt og er lenket herfra før de står ferdig.
 * Står de ikke oppe ennå, er `klar: false` – da lenker kortet ingen steder.
 */
const verktoy = [
  {
    n: 1,
    tittel: "Sjekk nettsiden din",
    href: "/sjekk",
    beskrivelse: "Ytelse, sikkerhetsheadere, cookies før samtykke, WCAG-feil og org.nr. i én sjekk.",
    punkter: ["Org.nr. verifiseres mot Enhetsregisteret", "Rapport på 30 sekunder", "Kan sendes på e-post"],
    klar: true,
  },
  {
    n: 2,
    tittel: "Hva koster det?",
    href: "/verktoy/priskalkulator",
    beskrivelse: "Fire spørsmål gir et prisspenn, med alle timeanslag og forutsetninger synlige.",
    punkter: ["Våre faste priser", "Markedstall med kilde og dato", "Ingen skjulte påslag"],
    klar: true,
  },
  {
    n: 3,
    tittel: "Kan noen sende e-post i ditt navn?",
    href: "/verktoy/dmarc",
    beskrivelse: "SPF, DKIM og DMARC lest rett fra DNS, forklart uten driftssjargong.",
    punkter: ["Ser om domenet kan misbrukes", "Forklarer hvorfor e-post havner i søppelposten", "Ingen e-post sendes"],
    klar: true,
  },
  {
    n: 4,
    tittel: "Cookie-sjekk",
    href: "/verktoy/cookie-sjekk",
    beskrivelse: "Laster siden uten å klikke på noe, og lister alt som settes før samtykke.",
    punkter: ["Ekomloven § 3-15", "Kjører ekte nettleser", "Ser det HTML-sjekken ikke ser"],
    klar: true,
  },
  {
    n: 5,
    tittel: "Universell utforming",
    href: "/verktoy/uu-sjekk",
    beskrivelse: "De maskinelt testbare av de 35 kravene private virksomheter må oppfylle.",
    punkter: ["WCAG 2.0 nivå A og AA", "Sier hva som ikke kan testes maskinelt", "Rapport du kan sende videre"],
    klar: true,
  },
];
---
<Base
  tittel="Gratisverktøy"
  beskrivelse="Gratis verktøy for norske bedrifter: nettsidesjekk, priskalkulator, e-postsikkerhet, cookie-sjekk og universell utforming. Ingen innlogging."
>
  <Scene lav>
    <Mega som="h1" merke="Verktøy" n={1} tekst="Verktøy du kan bruke gratis" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Vi selger sikkerhet og etterlevelse. Da er det rimelig at du får se at vi kan det, før du betaler for noe. Ingen innlogging, ingen e-post før du selv ber om rapporten.</p>
    </Avslor>

    {/*
      Kortene fra ServiceCard er h3. Uten noe imellom hopper rekkefølgen rett fra
      sidens h1 til h3, og axe melder «heading-order» – /verktoy lå på 98 i
      tilgjengelighet bare på grunn av dette. Overskriften er skjult visuelt fordi
      Mega-tittelen over allerede sier det samme med store bokstaver, men den gir
      kortlisten et navn for den som navigerer på overskrifter.

      Den strukturelt riktige løsningen er en `nivaa`-prop på ServiceCard, slik
      Section og PriceCard har. Komponenten eies av en annen agent akkurat nå.
    */}
    <h2 class="visually-hidden">Verktøyene du kan kjøre nå</h2>

    <div class="grid-3">
      {verktoy.map((v, k) => (
        <Avslor trinn={k % 3}>
        <ServiceCard
          n={v.n}
          title={v.tittel}
          href={v.klar ? v.href : undefined}
          description={v.beskrivelse}
          items={v.punkter}
          linkLabel="Kjør den"
        />
        </Avslor>
      ))}
    </div>
    <p class="small faint" style="margin-top: var(--space-5)">
      Kortene uten lenke er under arbeid. De dukker opp her når de faktisk virker –
      ikke før.
    </p>
  </Scene>

  <Scene n={2} eyebrow="Slik ser det ut" tittel="Sjekken som kjører">
    <Avslor>
      <Demo
        smal="/historie/verktoy-1280.mp4"
        bred="/historie/verktoy-1920.mp4"
        plakat="/historie/verktoy-poster.avif"
        tekst="Opptak av sjekken som kjører mot nkom.no. Funnene er ekte."
        kilde="6. oktober 2026"
      />
    </Avslor>
  </Scene>

  <Scene n={3} eyebrow="Åpent" tittel="Motoren er åpen kildekode" ingress="Sjekkene kjører også som kommandolinjeverktøy og som GitHub Action, slik at du kan ha dem i ditt eget bygg i stedet for å besøke denne siden.">
    <div class="grid-2">
      <div class="card">
        <h3 class="subheading">Kommandolinje</h3>
        <p class="muted">Kjør den samme sjekken fra terminalen, uten å installere noe.</p>
        <pre tabindex="0" class="kk-term" style="padding: var(--space-4); overflow-x: auto"><code class="mono">npx kodekonsulentene sjekk dinbedrift.no</code></pre>
      </div>
      <div class="card">
        <h3 class="subheading">GitHub Action</h3>
        <p class="muted">La bygget feile hvis en side bryter lovkravene, før den går i produksjon.</p>
        <pre tabindex="0" class="kk-term" style="padding: var(--space-4); overflow-x: auto"><code class="mono">- uses: kodekonsulentene/norsk-lovsjekk@v1
  with:
    url: https://dinbedrift.no</code></pre>
      </div>
    </div>
  </Scene>

  <ContactBlock n={3} />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  .scene:first-of-type .avslor {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
