---
import Base from "../../layouts/Base.astro";
import Scene from "../../components/Scene.astro";
import Mega from "../../components/Mega.astro";
import Avslor from "../../components/Avslor.astro";
import Stillbilde from "../../components/Stillbilde.astro";
import Demo from "../../components/Demo.astro";
import opptak from "../../data/opptak.json";
import ContactBlock from "../../components/ContactBlock.astro";
import { tillegg, timepris, TIMER_PER_EKSTRA_SIDE, TIMER_APP_FRA } from "../../lib/priskalkyle";
import { markedspriser, markedTimepris } from "../../data/markedspriser";
import { prisvilkaar } from "../../data/priser";

import "../../styles/scener.css";

const t = timepris();
const kr = (n: number) => `${n.toLocaleString("nb-NO").replace(/ /g, " ")} kr`;
---
<Base
  tittel="Hva koster en nettside? Kalkulator med åpne priser"
  beskrivelse="Svar på fire spørsmål og få et prisspenn med alle forutsetninger synlige. Våre priser er faste og står åpent. Markedstallene har kilde og dato."
>
  <Scene lav>
    <Mega som="h1" merke="Verktøy" n={1} tekst="Hva koster det?" />
    <Avslor trinn={1}>
      <p class="scene__ingress body-lg">Fire spørsmål gir et prisspenn. Du ser hver linje estimatet består av, hvilke timeanslag som ligger bak, og hva andre tar for det samme.</p>
    </Avslor>

    <Avslor>
    <div class="grid-2">
      <form class="card" id="kalk">
        <h2 class="heading">Fire spørsmål</h2>

        <div class="field">
          <label for="sider">Hvor mange sider trenger du?</label>
          <input class="control" id="sider" name="sider" type="number" min="1" max="60" value="5" />
          <span class="hint">Forside, tjenester, om, kontakt – tell dem du faktisk vil ha.</span>
        </div>

        <fieldset style="border: 0; padding: 0; margin: 0" class="stack stack--tight">
          <legend class="body-strong" style="padding: 0">Vil du endre innholdet selv?</legend>
          <label class="row" style="gap: var(--space-2)">
            <input type="checkbox" id="cms" name="cms" checked />
            <span>Ja, jeg vil ha CMS</span>
          </label>
          <span class="hint">Uten CMS endrer vi teksten for deg – det er inkludert i drift.</span>
        </fieldset>

        <fieldset style="border: 0; padding: 0; margin: 0" class="stack stack--tight">
          <legend class="body-strong" style="padding: 0">Skal noe kobles sammen?</legend>
          {tillegg.map((i) => (
            <label class="row" style="gap: var(--space-2); align-items: flex-start">
              <input type="checkbox" name="integrasjon" value={i.id} style="margin-top: 4px" />
              <span>
                {i.navn}
                <br /><span class="small faint">{i.forklaring}</span>
              </span>
            </label>
          ))}
        </fieldset>

        <fieldset style="border: 0; padding: 0; margin: 0" class="stack stack--tight">
          <legend class="body-strong" style="padding: 0">Trenger du en app?</legend>
          <label class="row" style="gap: var(--space-2)">
            <input type="checkbox" id="app" name="app" />
            <span>Ja, iOS- eller intern app</span>
          </label>
          <span class="hint">En app estimeres ordentlig etter en samtale. Her får du bare et gulv.</span>
        </fieldset>
      </form>

      <div class="stack">
        <div id="svar" aria-live="polite"></div>
        <noscript>
          <p class="card">
            Kalkulatoren krever JavaScript. Hele prislisten står uansett åpent på
            <a class="kk-link" href="/priser">prissiden</a>.
          </p>
        </noscript>
      </div>
    </div>
    </Avslor>
  </Scene>

  <Scene n={2} eyebrow="Forutsetninger" tittel="Dette ligger bak tallene" ingress="En kalkulator som ikke viser forutsetningene sine er bare en påstand med skyvebryter. Her er alle sammen.">
    <Avslor>
    <div class="grid-2">
      <div class="stack">
        <h3 class="subheading">Timeanslag</h3>
        <p class="small muted">
          Pakkeprisene er faste. Alt utover dem regnes ut fra timeprisen på
          <span class="mono">{kr(t)}</span> eks. mva og anslagene under.
          <strong>Dette er våre anslag, ikke målte tall.</strong> Spennet er bredt med vilje:
          en Vipps-integrasjon mot én betaling er noe annet enn mot et abonnement.
        </p>
        <dl class="kv">
          <div><dt>Side utover pakken</dt><dd>{TIMER_PER_EKSTRA_SIDE.lav}–{TIMER_PER_EKSTRA_SIDE.hoy} t</dd></div>
          {tillegg.map((i) => (
            <div><dt>{i.navn}</dt><dd>{i.timerLav}–{i.timerHoy} t</dd></div>
          ))}
          <div><dt>App</dt><dd>fra {TIMER_APP_FRA} t</dd></div>
        </dl>
      </div>
      <div class="stack">
        <h3 class="subheading">Vilkår</h3>
        <ul class="small muted" style="margin: 0; padding-left: var(--space-5); display: grid; gap: var(--space-2)">
          {prisvilkaar.map((v) => <li>{v}</li>)}
          <li>Estimatet erstatter ikke et tilbud. Etter en samtale får du fast pris.</li>
        </ul>
      </div>
    </div>
    </Avslor>

    <Avslor trinn={2}>
      {/* Ekte opptak av verktøyet mens det kjører, ikke en render. Det BEVISER at
          sjekken gjør et reelt oppslag i stedet for å antyde det. Demo og ikke
          SceneFilm: Demo rammer med hårlinje og bildetekst med kildedato, mens
          SceneFilm toner ned video som bakgrunn – og da leser et bevis som tapet. */}
      <Demo
        smal={opptak["priskalkulator"].smal}
        bred={opptak["priskalkulator"].bred}
        stor={opptak["priskalkulator"].stor}
        plakat={opptak["priskalkulator"].plakat}
        tekst={opptak["priskalkulator"].tekst}
        kilde={opptak["priskalkulator"].kilde}
      />
    </Avslor>

    <Avslor trinn={3}>
      <Stillbilde id="verktoy-pris" sizes="(min-width: 1120px) 1120px, 100vw">
        Like trinn, så de kan telles. Den grønne linjen markerer høyden du har valgt – en målestokk, ikke et tilbud.
      </Stillbilde>
    </Avslor>
  </Scene>

  <Scene n={3} eyebrow="Markedet" tittel="Hva andre tar" ingress="Tallene under er ikke våre. De er hentet fra leverandørenes egne nettsider, med kilde og dato, slik at du kan etterprøve dem.">
    <Avslor>
    <div class="prose" style="max-width: none">
      <table>
        <thead>
          <tr>
            <th scope="col">Leverandør</th><th scope="col">Gjelder</th>
            <th scope="col">Pris</th><th scope="col">Kilde</th>
          </tr>
        </thead>
        <tbody>
          {markedspriser.map((m) => (
            <tr>
              <td>{m.leverandor}</td>
              <td>{m.gjelder}{m.merknad && <><br /><span class="small faint">{m.merknad}</span></>}</td>
              <td class="nowrap mono">
                {m.hoy === null ? `fra ${kr(m.lav ?? 0)}` : m.lav === m.hoy ? kr(m.lav ?? 0) : `${kr(m.lav ?? 0)}–${kr(m.hoy)}`}
                {m.enhet === "mnd" ? "/mnd" : ""}
              </td>
              <td class="small faint">Sist sjekket {m.sistSjekket}</td>
            </tr>
          ))}
          <tr>
            <td>Timepris i markedet</td>
            <td>Byråer / frilansere</td>
            <td class="nowrap mono">{kr(markedTimepris.byraaLav)}–{kr(markedTimepris.byraaHoy)}/t · {kr(markedTimepris.frilansLav)}–{kr(markedTimepris.frilansHoy)}/t</td>
            <td class="small faint">Sist sjekket {markedTimepris.sistSjekket}</td>
          </tr>
        </tbody>
      </table>
      <p class="small faint">
        Leverandørene har kommersielle interesser og ulike definisjoner av «enkel nettside».
        Bruk tallene som markedssignal, ikke som fasit. Vår egen timepris er {kr(t)} eks. mva.
      </p>
    </div>
    </Avslor>
  </Scene>

  <ContactBlock n={4} tittel="Vil du ha fast pris?" ingress="Et estimat er et spenn. Et tilbud er et tall. Tjue minutter på telefon er nok til å gi deg det andre." />
</Base>
<style is:global>
  /* Sidens h1 står over folden. Scroll-avdekking på noe som allerede er synlig
     ved innlasting betyr at teksten blir stående halvt gjennomsiktig til
     brukeren scroller – målt 0,52 opasitet på de siste ordene i overskriften.
     Toppscenen står derfor ferdig; avdekkingen gjelder fra scene to og nedover. */
  .scene:first-of-type .mega .ord,
  .scene:first-of-type .mega-blokk,
  /* Bare FØRSTE avdekking i første scene, ikke hele scenen.
     Regelen fantes for at innhold over folden ikke skal ligge usynlig og vente på
     en scroll som aldri kommer. Men `.scene:first-of-type .avslor` traff ALLE
     avdekkinger i scenen – og /caser og /handbok er én eneste scene, så den slo av
     all bevegelse på hele siden. Målt: 0 bevegelsesøyeblikk, 5,5 skjermhøyder uten
     at ett element endrer seg. */
  .scene:first-of-type .avslor:first-of-type {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  /* Avkrysningen svarer med én gang, uten en linje JavaScript.
     :has() leser :checked rett fra DOM-en, så dette virker like godt med JS slått
     av – og kalkulatorens egen utregning er det eneste på siden som krever JS.
     Bruksandel 94,82 %, bredest støttet av alt i docs/research-teknikker.md.
     Uten støtte står raden som før: ingen markør, fullt lesbar tekst. */
  /* Kontrollene tegnes av operativsystemet og kom i systemets blå. På en side der
     aksenten er limegrønn leses de som fremmedelementer. `accent-color` er den
     eneste måten å fargelegge en avkrysningsboks uten å bygge den på nytt – og en
     hjemmelaget avkrysningsboks taper tastaturoppførsel og skjermleserrolle.

     Hører egentlig hjemme globalt. Reglene for dette ligger i
     src/styles/interaksjon.css, men den fila importeres BARE av /lab/interaksjon –
     se rapporten. Her settes den på sidene jeg eier. */
  #kalk input[type="checkbox"],
  #kalk input[type="number"] {
    accent-color: var(--accent);
  }

  #kalk label.row {
    /* Markøren legges i kortets egen luft, ikke i teksten. Padding alene smalnet
       tekstkolonnen med 12 px, og «Booking» brøt til en ekstra linje – raden
       vokste fra 80 til 106 px. Negativ marg av samme størrelse gir tilbake
       nøyaktig den bredden teksten hadde før. Målt, ikke antatt. */
    margin-inline-start: calc(-1 * var(--space-3));
    padding-inline-start: calc(var(--space-3) - 2px);
    border-inline-start: 2px solid transparent;
    border-radius: var(--radius-sm);
    transition-property: border-color, color;
    transition-duration: 140ms;
    transition-timing-function: ease;
  }
  #kalk label.row:has(input:checked) {
    border-inline-start-color: var(--accent);
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    #kalk label.row { transition-duration: 0.01ms; }
  }

  /* Skjemaet er sidens handling, og det skal aldri vente på en scroll.
     Unntaket over gjelder bare FØRSTE avdekking. Den andre inneholder selve
     skjemaet, og på 900 px høyde ligger det akkurat i foldekanten: målt 0,56
     opasitet ved innlasting på /verktoy/cookie-sjekk, 0,87 på kalkulatoren.
     Det er view()-tidslinjen som gjør jobben sin – elementet er delvis inne i
     bildet – men en halvgjennomsiktig inngang er feil på den siden som skal få
     folk til å kjøre sjekken.

     :has(form) treffer nøyaktig den blokken og ingenting annet. Uten støtte for
     :has() faller siden tilbake til dagens oppførsel: innholdet er fortsatt der
     og blir helt synlig ved første scroll. Degraderingen går mot «synlig». */
  /* Ikke barnekombinator: .avslor ligger inne i .scene__inner, ikke rett under
     .scene. Med «>» traff regelen ingenting – målt på /verktoy/cookie-sjekk, der
     skjemaet sto på 0,56 opasitet ved innlasting selv med unntaket på plass. */
  /* Ingressen treffes på hva den ER, ikke på posisjon. `:first-of-type` gjelder
     TAGG, ikke klasse: står det et annet <div> foran avdekkingen, peker den et
     annet sted. Målt på /verktoy/cookie-sjekk – ingressen lå på 0,78 ved
     innlasting selv med unntaket på plass. */
  .scene:first-of-type .avslor:has(.scene__ingress),
  .scene:first-of-type .avslor:has(form) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>

<script>
  import { beregn, formaterKr, type Integrasjon } from "../../lib/priskalkyle.ts";

  const skjema = document.querySelector<HTMLFormElement>("#kalk")!;
  const svar = document.querySelector<HTMLElement>("#svar")!;

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  function tegn() {
    const data = new FormData(skjema);
    const e = beregn({
      sider: Number(data.get("sider")) || 1,
      cms: data.get("cms") === "on",
      integrasjoner: data.getAll("integrasjon") as Integrasjon[],
      app: data.get("app") === "on",
    });

    const linjer = e.linjer
      .map((l) => {
        const belop = l.lav === l.hoy ? formaterKr(l.lav) : `${formaterKr(l.lav)}–${formaterKr(l.hoy)}`;
        const anslag = l.anslag
          ? `<br><span class="small faint">${l.anslag.timerLav === l.anslag.timerHoy ? `fra ${l.anslag.timerLav}` : `${l.anslag.timerLav}–${l.anslag.timerHoy}`} timer · anslag</span>`
          : "";
        return `<div><dt>${esc(l.tekst)}${anslag}</dt><dd class="nowrap">${belop}</dd></div>`;
      })
      .join("");

    const sum =
      e.lav === e.hoy
        ? `${e.aapentOppe ? "fra " : ""}${formaterKr(e.lav)}`
        : `${formaterKr(e.lav)}–${formaterKr(e.hoy)}`;

    svar.innerHTML = `
      <div class="card">
        <p class="kk-eyebrow"><span class="kk-eyebrow-n" aria-hidden="true">//</span><span>${esc(e.pakke)}-pakken</span></p>
        <p class="mono-stat" data-sum>${sum}</p>
        <p class="small faint">eks. mva${e.aapentOppe ? " · gulv, ikke tak" : ""}</p>
        <p class="muted">${esc(e.pakkeBegrunnelse)}</p>
        <dl class="kv">${linjer}</dl>
        <dl class="kv">
          <div><dt>Etter lansering</dt><dd class="nowrap">${esc(e.loepende.pris)}</dd></div>
        </dl>
        <a class="kk-btn kk-btn-primary" href="/kontakt">Få fast pris</a>
      </div>
      <details class="card card--sunken" style="margin-top: var(--space-4)">
        <summary class="body-strong" style="cursor: pointer">Hva estimatet forutsetter</summary>
        <ul class="small muted" style="margin: var(--space-3) 0 0; padding-left: var(--space-5); display: grid; gap: var(--space-2)">
          ${e.forutsetninger.map((f) => `<li>${esc(f)}</li>`).join("")}
        </ul>
      </details>`;

    animerSum(e);
  }

  /**
   * Summen teller til den nye verdien når du huker av noe.
   *
   * Hvorfor i det hele tatt: kalkulatoren er sidens eneste ekte interaksjon, og
   * et tall som bare bytter verdi mellom to malinger leses ikke som et svar på
   * det du nettopp gjorde. Opptellingen knytter handlingen til resultatet.
   *
   * Hvorfor skrevet her og ikke gjenbrukt fra Nokkeltall: den teller ÉN gang når
   * raden kommer i syne, styrt av en IntersectionObserver. Her endrer tallet seg
   * hver gang du rører skjemaet, og det er en annen mekanikk.
   *
   * Første visning står ferdig. En opptelling fra null ved innlasting ville sagt
   * at noe skjedde, mens brukeren ennå ikke har gjort noe.
   */
  const REDUSERT = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let forrige: { lav: number; hoy: number } | null = null;
  let raf = 0;

  function animerSum(e: { lav: number; hoy: number; aapentOppe: boolean }) {
    const el = svar.querySelector<HTMLElement>("[data-sum]");
    if (!el) return;

    const maal = { lav: e.lav, hoy: e.hoy };
    const fra = forrige;
    forrige = maal;
    if (REDUSERT || !fra || (fra.lav === maal.lav && fra.hoy === maal.hoy)) return;

    cancelAnimationFrame(raf);
    // Spennet avgjøres av MÅLET, ikke av de interpolerte tallene. Ellers blinker
    // «fra 14 900 kr» fram i det ene bildet der lav tilfeldigvis passerer hoy.
    const spenn = maal.lav !== maal.hoy;
    const tekst = (lav: number, hoy: number) =>
      spenn
        ? `${formaterKr(lav)}\u2013${formaterKr(hoy)}`
        : `${e.aapentOppe ? "fra " : ""}${formaterKr(lav)}`;

    // Bredden låses til sluttverdien først. Uten den vokser elementet mens
    // sifrene skifter, og hele kortet rykker sidelengs under avkryssingen.
    // Låsen regnes ÉN gang og brukes som fast pikselverdi – leses den på nytt
    // hver ramme, mater den seg selv.
    const laas = `${el.getBoundingClientRect().width}px`;

    const VARIGHET = 420;
    const start = performance.now();
    const steg = (naa: number) => {
      // Elementet slås opp på nytt hver ramme, ikke én gang utenfor løkken.
      // Avkryssing utløser BÅDE «input» og «change», så tegn() kjører to ganger
      // i samme tikk og bytter ut hele kortet. Holdt vi på referansen fra første
      // ramme, skrev vi resten av animasjonen til et element som ikke lenger satt
      // i dokumentet – tallet hoppet rett til sluttverdien, og opptellingen var
      // usynlig. Målt: 1 unik verdi gjennom hele endringen.
      const n = svar.querySelector<HTMLElement>("[data-sum]");
      if (!n) return;
      n.style.minInlineSize = laas;

      const t = Math.min(1, (naa - start) / VARIGHET);
      const k = 1 - Math.pow(1 - t, 3);
      n.textContent = tekst(
        Math.round(fra.lav + (maal.lav - fra.lav) * k),
        Math.round(fra.hoy + (maal.hoy - fra.hoy) * k),
      );
      if (t < 1) raf = requestAnimationFrame(steg);
      else {
        n.textContent = tekst(maal.lav, maal.hoy);
        n.style.minInlineSize = "";
      }
    };
    raf = requestAnimationFrame(steg);
  }

  skjema.addEventListener("input", tegn);
  skjema.addEventListener("change", tegn);
  skjema.addEventListener("submit", (ev) => ev.preventDefault());
  tegn();
</script>
