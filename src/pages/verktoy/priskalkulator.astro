---
/**
 * Priskalkulatoren i wow-drakten (wow-undersider.md del 1.8, runde wow-r8-B2).
 * Rekkefølge: Verktoyramme (brødsmuler, H1, de fire spørsmålene til venstre og estimatet til
 * høyre, festet på desktop; på mobil står estimatet rett under skjemaet) → forutsetningene og
 * ekte opptak → «Hva andre tar» (`#markedet`, forsiden og /priser lenker hit) → kontaktblokk.
 *
 * Uendret fra v1: `beregn()` fra src/lib/priskalkyle.ts, id-ene `#kalk`, `#svar`, `#sider`, `#cms`,
 * `#app` og `#markedet`, feltnavnene `sider`, `cms`, `integrasjon` og `app`, alle tekster og
 * WebApplication-markupen. Alle beløp kommer fra `priskalkyle.ts`, `priser.ts` og
 * `markedspriser.ts`. Ingen er skrevet av.
 *
 * Ute: opptellingen av summen. Et tall som ruller inn, går mot «fast pris» (Prisrader.astro), og
 * planen sier at estimatet oppdateres uten animasjon.
 */
import MalWow from "../../layouts/MalWow.astro";
import { Verktoyramme, Seksjon, Prosa, Prisrader, Opptak, Kontaktblokk } from "../../components/wow/side";
import { verktoy } from "../../data/schema";
import { tillegg, timepris, TIMER_PER_EKSTRA_SIDE, TIMER_APP_FRA } from "../../lib/priskalkyle";
import { markedspriser, markedTimepris } from "../../data/markedspriser";
import { prisvilkaar, prisenhet } from "../../data/priser";

const t = timepris();
/**
 * Et beløp er ett ord: både tusenskillet og mellomrommet foran «kr» er harde mellomrom, så
 * enheten aldri blir stående igjen på en egen linje. Spennet MELLOM to beløp kan brytes ved
 * tankestreken.
 */
const kr = (n: number) => `${n.toLocaleString("nb-NO").replace(/\s/g, " ")} kr`;
/**
 * Vertsnavnet som lenketekst i kildekolonnen, uten «www.». Hele URL-en ville brutt kolonnen, og
 * «Kilde» som lenketekst sier ingenting til den som navigerer på lenker. Vertsnavnet sier hvem
 * som oppgir prisen.
 */
const vert = (u: string) => new URL(u).hostname.replace(/^www\./, "");
/**
 * `WebApplication` fra `verktoy()` i src/data/schema.ts. `price: "0"` og
 * `isAccessibleForFree` er sanne: verktøyet krever ingen innlogging og koster ingenting.
 */
const schema = verktoy({
  navn: "Priskalkulator for nettside",
  beskrivelse:
    "Fire spoersmaal gir et prisspenn med alle timeanslag og forutsetninger synlige, satt opp mot vaare faste priser og mot markedstall med kilde og dato.",
  sti: "/verktoy/priskalkulator",
});

const timeanslag = [
  { navn: "Side utover pakken", verdi: `${TIMER_PER_EKSTRA_SIDE.lav}–${TIMER_PER_EKSTRA_SIDE.hoy} t` },
  ...tillegg.map((i) => ({ navn: i.navn, verdi: `${i.timerLav}–${i.timerHoy} t` })),
  { navn: "App", verdi: `fra ${TIMER_APP_FRA} t` },
];
---

<MalWow
  tittel="Priskalkulator: hva koster en nettside?"
  beskrivelse="Svar på fire spørsmål og få et prisspenn med alle forutsetninger synlige. Våre priser er faste og står åpent. Markedstallene har kilde og dato."
  schema={[schema]}
  bevegelse="rolig"
>
  <Verktoyramme
    tittel="Hva koster det?"
    ingress="Fire spørsmål gir et prisspenn. Du ser hver linje estimatet består av, hvilke timeanslag som ligger bak, og hva andre tar for det samme."
  >
    <form slot="skjema" class="kalk" id="kalk" aria-labelledby="kalk-tittel">
      <h2 class="wow-usynlig" id="kalk-tittel">Fire spørsmål</h2>

      <div class="kalk__sporsmal">
        <label class="kalk__tittel" for="sider">Hvor mange sider trenger du?</label>
        <input class="kalk__tall" id="sider" name="sider" type="number" inputmode="numeric" min="1" max="60" value="5" aria-describedby="sider-hint" />
        <p class="kalk__hint" id="sider-hint">Forside, tjenester, om, kontakt – tell dem du faktisk vil ha.</p>
      </div>

      <fieldset class="kalk__sporsmal">
        <legend class="kalk__tittel">Vil du endre innholdet selv?</legend>
        <label class="kalk__valg">
          <input type="checkbox" id="cms" name="cms" checked />
          <span>Ja, jeg vil ha CMS</span>
        </label>
        <p class="kalk__hint">Uten CMS endrer vi teksten for deg – det er inkludert i drift.</p>
      </fieldset>

      <fieldset class="kalk__sporsmal">
        <legend class="kalk__tittel">Skal noe kobles sammen?</legend>
        {
          tillegg.map((i) => (
            <label class="kalk__valg">
              <input type="checkbox" name="integrasjon" value={i.id} />
              <span>
                {i.navn}
                <span class="kalk__forklaring">{i.forklaring}</span>
              </span>
            </label>
          ))
        }
      </fieldset>

      <fieldset class="kalk__sporsmal">
        <legend class="kalk__tittel">Trenger du en app?</legend>
        <label class="kalk__valg">
          <input type="checkbox" id="app" name="app" />
          <span>Ja, iOS- eller intern app</span>
        </label>
        <p class="kalk__hint">En app estimeres ordentlig etter en samtale. Her får du bare et gulv.</p>
      </fieldset>
    </form>
    <p slot="noscript">
      Kalkulatoren krever JavaScript. Hele prislisten står uansett åpent på{" "}
      <a class="wow-lenke" href="/priser">prissiden</a>.
    </p>

    <div slot="side" id="svar" aria-live="polite"></div>
  </Verktoyramme>

  <Seksjon
    id="forutsetninger"
    tittel="Dette ligger bak tallene"
    ingress="En kalkulator som ikke viser forutsetningene sine er bare en påstand med skyvebryter. Her er alle sammen."
    storrelse="tjeneste"
  >
    <div class="wow-vt-stabel">
      <div class="kalk-bak">
        <div class="kalk-bak__del">
          <Prosa>
            <h3>Timeanslag</h3>
            {/* {" "} foran beløpet: Astro fjerner linjeskiftet foran et inline-element. */}
            <p>
              Pakkeprisene er faste. Alt utover dem regnes ut fra timeprisen på{" "}
              <span class="wow-ubrutt">{kr(t)}</span> – {prisenhet} – og anslagene under.{" "}
              <strong>Dette er våre anslag, ikke målte tall.</strong> Spennet er bredt med vilje:
              en Vipps-integrasjon mot én betaling er noe annet enn mot et abonnement.
            </p>
          </Prosa>
          <Prisrader rader={timeanslag} />
        </div>
        <div class="kalk-bak__del">
          <Prosa>
            <h3>Vilkår</h3>
            <ul>
              {prisvilkaar.map((v) => <li>{v}</li>)}
              <li>Estimatet erstatter ikke et tilbud. Etter en samtale får du fast pris.</li>
            </ul>
          </Prosa>
        </div>
      </div>

      {/* Ekte opptak av verktøyet mens det kjører, ikke en render. Det står alene, uten generert
          bilde ved siden av. */}
      <div class="wow-vt-opptak">
        <Opptak navn="priskalkulator" adresse="kodekonsulentene.no/verktoy/priskalkulator" />
      </div>
    </div>
  </Seksjon>

  <Seksjon
    id="markedet"
    tittel="Hva andre tar"
    ingress="Tallene under er ikke våre. De er hentet fra leverandørenes egne nettsider, med kilde og dato, slik at du kan etterprøve dem."
    storrelse="tjeneste"
  >
    <Prosa>
      <table>
        <thead>
          <tr>
            <th scope="col">Leverandør</th><th scope="col">Gjelder</th>
            <th scope="col">Pris</th><th scope="col">Kilde</th>
          </tr>
        </thead>
        <tbody>
          {
            markedspriser.map((m) => (
              <tr>
                <th scope="row">{m.leverandor}</th>
                <td>
                  {m.gjelder}
                  {m.merknad && <span class="kalk-merknad">{m.merknad}</span>}
                </td>
                <td class="wow-ubrutt">
                  {m.hoy === null ? `fra ${kr(m.lav ?? 0)}` : m.lav === m.hoy ? kr(m.lav ?? 0) : `${kr(m.lav ?? 0)}–${kr(m.hoy)}`}
                  {m.enhet === "mnd" ? "/mnd" : ""}
                </td>
                {/* Én lenke per kilde, så en rad med to endepunkter viser to kilder. Ingressen
                    lover at tallene kan etterprøves. */}
                <td>
                  {m.kilde.map((u) => (
                    <a class="kalk-kilde" href={u} rel="nofollow">{vert(u)}</a>
                  ))}
                  <span class="kalk-merknad">Lest {m.sistSjekket}</span>
                </td>
              </tr>
            ))
          }
          <tr>
            <th scope="row">Timepris i markedet</th>
            <td>Byråer / frilansere</td>
            <td class="wow-ubrutt">
              {kr(markedTimepris.byraaLav)}–{kr(markedTimepris.byraaHoy)}/t
              <br />
              {kr(markedTimepris.frilansLav)}–{kr(markedTimepris.frilansHoy)}/t
            </td>
            <td>
              {markedTimepris.kilde.map((u) => (
                <a class="kalk-kilde" href={u} rel="nofollow">{vert(u)}</a>
              ))}
              <span class="kalk-merknad">Lest {markedTimepris.sistSjekket}</span>
            </td>
          </tr>
        </tbody>
      </table>
      <p class="wow-notat">
        Leverandørene har kommersielle interesser og ulike definisjoner av «enkel nettside».
        Bruk tallene som markedssignal, ikke som fasit. Flere av dem er oppgitt eks. mva hos
        leverandøren; vår egen timepris er {kr(t)}, og det er {prisenhet}.
      </p>
    </Prosa>
  </Seksjon>

  <Kontaktblokk
    tittel="Vil du ha fast pris?"
    ingress="Et estimat er et spenn. Et tilbud er et tall. Tjue minutter på telefon er nok til å gi deg det andre."
  />
</MalWow>

<style>
  /* De fire spørsmålene: rader med strek, ingen kort. */
  .kalk {
    display: grid;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .kalk__sporsmal {
    display: grid;
    gap: var(--wow-rom-3);
    min-width: 0;
    margin: 0;
    padding: var(--wow-rom-5) 0;
    border: 0;
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .kalk__tittel {
    padding: 0;
    font-size: var(--wow-tekst-ingress);
    font-weight: 700;
    line-height: 1.2;
  }
  /* En <legend> tegnes ellers oppå fieldsettets kantlinje. Flytende blir den et vanlig barn i
     rutenettet, og streken står over spørsmålet som på de andre radene. */
  legend.kalk__tittel {
    float: left;
    width: 100%;
  }
  .kalk__hint,
  .kalk__forklaring {
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-liten);
    line-height: 1.45;
  }
  .kalk__hint {
    max-width: var(--wow-maal-brod);
  }
  .kalk__forklaring {
    display: block;
  }
  .kalk__tall {
    width: 8rem;
    min-height: var(--wow-felt);
    padding: var(--wow-rom-3) var(--wow-rom-4);
    background: var(--wow-flate);
    color: var(--wow-tekst);
    border: var(--wow-kant-1) solid var(--wow-linje-sterk);
    border-radius: var(--wow-radius-s);
    font: inherit;
    font-size: var(--wow-tekst-brod);
    font-variant-numeric: tabular-nums;
    accent-color: var(--wow-refleks);
    transition:
      border-color var(--wow-tid-kort) var(--wow-kurve),
      background-color var(--wow-tid-kort) var(--wow-kurve);
  }
  .kalk__tall:focus {
    background: var(--wow-flate-hev);
    border-color: var(--wow-refleks);
  }
  /* Hele raden er trykkflaten. Avkrysningsboksen er nettleserens egen (tastatur og skjermleser
     følger med), farget med accent-color. */
  .kalk__valg {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--wow-rom-3);
    min-height: var(--wow-trykkflate);
    padding-block: var(--wow-rom-2);
    cursor: pointer;
  }
  .kalk__valg input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.2rem 0 0;
    accent-color: var(--wow-refleks);
    cursor: pointer;
  }
  .kalk__valg:has(input:checked) > span {
    color: var(--wow-tekst);
  }

  /* Forutsetningene: timeanslag til venstre, vilkår til høyre. */
  .kalk-bak {
    display: grid;
    gap: var(--wow-rom-7) var(--wow-luke);
  }
  .kalk-bak__del {
    display: grid;
    gap: var(--wow-rom-5);
    align-content: start;
    min-width: 0;
  }
  .kalk-bak__del :global(h3) {
    margin-top: 0;
  }
  @media (min-width: 1024px) {
    .kalk-bak {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .kalk-bak__del:first-child {
      grid-column: 1 / 7;
    }
    .kalk-bak__del:last-child {
      grid-column: 8 / 13;
    }
  }

  /* Tabellen: merknad og dato under verdien, én kilde per linje. */
  .kalk-merknad {
    display: block;
    margin-top: var(--wow-rom-1);
    font-size: var(--wow-tekst-liten);
  }
  /* Smal skjerm: tabellen ruller sidelengs (Prosa). «Gjelder» har merknaden under seg og trenger
     lesebredde, ellers blir raden ti linjer høy. */
  @media (max-width: 767px) {
    #markedet td:nth-child(2) {
      min-width: 18rem;
    }
  }
  /* Hver kilde på egen linje, og høy nok til å treffes (WCAG 2.5.8: minst 24 px). */
  .kalk-kilde {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 1.75rem;
  }
</style>

<style is:global>
  /* Estimatet settes inn av skriptet, så stilen må være global. */
  .kalk-svar {
    display: grid;
    gap: var(--wow-rom-4);
  }
  .kalk-svar__pakke {
    font-weight: 700;
  }
  /* Sidens store tall. Et spenn får bryte etter tankestreken, aldri midt i et beløp. */
  .kalk-svar__sum {
    font-family: var(--wow-font-display);
    font-weight: var(--wow-display-vekt);
    font-stretch: var(--wow-display-bredde);
    font-size: var(--wow-tekst-pris);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--wow-display-sperring);
    line-height: 1;
  }
  .kalk-svar__enhet,
  .kalk-svar__hvorfor {
    color: var(--wow-tekst-dempet);
  }
  .kalk-svar__enhet {
    margin-top: calc(-1 * var(--wow-rom-2));
    font-size: var(--wow-tekst-liten);
  }
  .kalk-svar__hvorfor {
    max-width: var(--wow-maal-brod);
    text-wrap: pretty;
  }
  .kalk-linjer {
    margin: 0;
    border-bottom: var(--wow-kant-1) solid var(--wow-linje);
  }
  .kalk-linjer > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wow-rom-4);
    padding-block: var(--wow-rom-3);
    border-top: var(--wow-kant-1) solid var(--wow-linje);
  }
  .kalk-linjer dt {
    min-width: 0;
  }
  .kalk-linjer dt span {
    display: block;
    color: var(--wow-tekst-dempet);
    font-size: var(--wow-tekst-liten);
  }
  .kalk-linjer dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .kalk-svar .wow-knapp {
    justify-self: start;
  }
  @media (max-width: 599px) {
    .kalk-svar .wow-knapp {
      justify-self: stretch;
    }
  }
</style>

<script>
  import { beregn, formaterKr, type Integrasjon } from "../../lib/priskalkyle.ts";
  // Enheten under summen hentes, den skrives ikke (src/data/priser.ts).
  import { prisenhet } from "../../data/priser.ts";

  const skjema = document.querySelector<HTMLFormElement>("#kalk")!;
  const svar = document.querySelector<HTMLElement>("#svar")!;

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  /** Et spenn kan brytes etter tankestreken (usynlig bruddpunkt), aldri midt i et beløp. */
  const spenn = (lav: number, hoy: number) => `${formaterKr(lav)}–​${formaterKr(hoy)}`;

  function tegn() {
    const data = new FormData(skjema);
    const e = beregn({
      sider: Number(data.get("sider")) || 1,
      cms: data.get("cms") === "on",
      integrasjoner: data.getAll("integrasjon") as Integrasjon[],
      app: data.get("app") === "on",
    });

    const linjer = e.linjer
      .map((l) => {
        const belop = l.lav === l.hoy ? formaterKr(l.lav) : `${formaterKr(l.lav)}–${formaterKr(l.hoy)}`;
        const anslag = l.anslag
          ? `<span>${l.anslag.timerLav === l.anslag.timerHoy ? `fra ${l.anslag.timerLav}` : `${l.anslag.timerLav}–${l.anslag.timerHoy}`} timer, anslag</span>`
          : "";
        return `<div><dt>${esc(l.tekst)}${anslag}</dt><dd>${belop}</dd></div>`;
      })
      .join("");

    const sum = e.lav === e.hoy ? `${e.aapentOppe ? "fra " : ""}${formaterKr(e.lav)}` : spenn(e.lav, e.hoy);

    // Ingen opptelling: estimatet bytter verdi med en gang (wow-undersider.md del 1.8).
    svar.innerHTML = `
      <div class="kalk-svar">
        <p class="kalk-svar__pakke">${esc(e.pakke)}-pakken</p>
        <p class="kalk-svar__sum" data-sum>${sum}</p>
        <p class="kalk-svar__enhet">${prisenhet}${e.aapentOppe ? " – gulv, ikke tak" : ""}</p>
        <p class="kalk-svar__hvorfor">${esc(e.pakkeBegrunnelse)}</p>
        <dl class="kalk-linjer">
          ${linjer}
          <div><dt>Etter lansering</dt><dd>${esc(e.loepende.pris)}</dd></div>
        </dl>
        <a class="wow-knapp" href="/kontakt"><span class="wow-knapp__tekst">Få fast pris</span></a>
        <div class="wow-prosa">
          <details>
            <summary>Hva estimatet forutsetter</summary>
            <ul class="wow-notat">${e.forutsetninger.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>
          </details>
        </div>
      </div>`;
  }

  // Detaljene åpnes av brukeren. Når skjemaet tegner estimatet på nytt, skal de ikke klappe sammen.
  function tegnOgBehold() {
    const aapen = svar.querySelector("details")?.open ?? false;
    tegn();
    if (aapen) svar.querySelector("details")!.open = true;
  }

  skjema.addEventListener("input", tegnOgBehold);
  skjema.addEventListener("change", tegnOgBehold);
  skjema.addEventListener("submit", (ev) => ev.preventDefault());
  tegn();
</script>
