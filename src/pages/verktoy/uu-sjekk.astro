---
/**
 * UU-sjekken i wow-drakten (wow-undersider.md del 1.8, runde wow-r8-B2, etter mønstersiden
 * cookie-sjekk). Rekkefølge: Verktoyramme (brødsmuler, H1, feltet, resultatet) → hva en automatisk
 * test ikke kan se → ekte opptak → «Etterpå» → kontaktblokk. «rolig».
 *
 * Uendret fra v1: API-kallet (POST /api/uu-sjekk med { url }), id-ene `#url-uu` og `#resultat`,
 * feltnavnet `url`, alle feiltekster, forbeholdene (åpne som standard) og WebApplication-markupen.
 * Nytt: resultatet står i rapportspråket (lampe + status som ord), fokus flyttes til rapportens
 * tittel når den er klar, og `?url=` leses fra adressen også i bygget (samme grep som /sjekk).
 */
import MalWow from "../../layouts/MalWow.astro";
import { Verktoyramme, UrlFelt, Seksjon, Prosa, Opptak, Kontaktblokk } from "../../components/wow/side";
import { verktoy } from "../../data/schema";
import { firma } from "../../data/firma";

// Siden er statisk: i bygget er searchParams tom, og skriptet under leser ?url= fra
// location.search. Linja fyller feltet bare i `astro dev`.
const forhandsutfylt = Astro.url.searchParams.get("url") ?? "";
/**
 * `WebApplication` fra `verktoy()` i src/data/schema.ts. `price: "0"` og
 * `isAccessibleForFree` er sanne: verktøyet krever ingen innlogging og koster ingenting.
 */
const schema = verktoy({
  navn: "Sjekk av universell utforming",
  beskrivelse:
    "Automatisk WCAG-sjekk med axe-core mot de 35 suksesskriteriene som gjelder private virksomheter, og en liste over hva en automatisk test ikke kan avgjoere.",
  sti: "/verktoy/uu-sjekk",
});
---

<MalWow
  tittel="Sjekk universell utforming"
  beskrivelse="Automatisk WCAG-sjekk av nettsiden din mot kravene som gjelder private virksomheter. Vi sier også hva sjekken ikke kan avgjøre. Gratis."
  schema={[schema]}
  bevegelse="rolig"
>
  <Verktoyramme
    tittel="Sjekk universell utforming"
    ingress="Private virksomheter skal oppfylle 35 krav i WCAG 2.0 nivå A og AA. Vi kjører siden gjennom axe-core og viser de bruddene en maskin kan finne."
  >
    <UrlFelt
      slot="skjema"
      id="url-uu"
      action="/verktoy/uu-sjekk"
      knapp="Kjør sjekken"
      verdi={forhandsutfylt}
      hint="Tar 15–30 sekunder. Vi lagrer ingenting."
    />
    <p slot="noscript">
      Sjekken krever JavaScript. Send adressen til{" "}
      <a class="wow-lenke" href={`mailto:${firma.epost}?subject=UU-sjekk`}>{firma.epost}</a>,
      så kjører vi den manuelt og sender rapporten samme dag.
    </p>
  </Verktoyramme>

  <Seksjon
    id="ikke-se"
    tittel="Hva en automatisk test ikke kan se"
    ingress="Dette er den viktigste seksjonen på siden. En grønn rapport her betyr ikke at kravene er oppfylt."
    storrelse="tjeneste"
    tett
  >
    <div class="wow-vt-stabel">
      <Prosa>
        <p>
          Automatiske tester finner det som kan leses ut av koden: manglende alt-tekst,
          manglende ledetekster, feil språkkode, svak kontrast på ensfarget bakgrunn.
          Det er ekte feil, og det er verdt å rette dem.
        </p>
        <p>
          Men en maskin kan ikke avgjøre om alt-teksten faktisk beskriver bildet, om
          tastaturrekkefølgen gir mening, om skjermleseren leser innholdet i riktig
          rekkefølge, om videoen er tekstet, eller om språket er til å forstå.
          Det er mennesker som må teste det.
        </p>
        {/* V1 hadde et terminalutsnitt («uu-sjekk --dekning») her. Kommandoen finnes ikke, så det
            var pynt. Linjene står som liste, med de samme ordene; siste linje er setningen fra
            utsnittets skjermlesertekst. */}
        <ul>
          <li>Maskinelt: alt-tekst, ledetekster, språk, kontrast</li>
          <li>Manuelt: tastaturflyt, skjermleserrekkefølge</li>
          <li>Manuelt: om alt-teksten faktisk stemmer</li>
        </ul>
        <p><strong>En grønn rapport er ikke det samme som å være lovlig.</strong></p>
        <p class="wow-notat">
          Derfor sier rapporten alltid hvor mye som gjenstår manuelt. Dette er ikke
          juridisk rådgivning.
        </p>
      </Prosa>

      {/* Ekte opptak av verktøyet mens det kjører, ikke en render: det BEVISER at sjekken gjør et
          reelt oppslag. Det står alene, uten generert bilde ved siden av. */}
      <div class="wow-vt-opptak">
        <Opptak navn="uu-sjekk" adresse="kodekonsulentene.no/verktoy/uu-sjekk" />
      </div>
    </div>
  </Seksjon>

  <Seksjon
    id="etterpa"
    tittel="Vil du ha en full gjennomgang?"
    ingress="En manuell revisjon dekker det automatiske tester ikke når: tastaturnavigasjon, skjermleser, kontrast over bilder og forståelig språk."
    storrelse="tjeneste"
  >
    {/* Tre handlinger, som i v1: én primær, én sekundær, én lenke (Handlinger tar bare to). */}
    <div class="wow-vt-etter">
      <a class="wow-knapp" href="/priser"><span class="wow-knapp__tekst">Se hva det koster</span></a>
      <a class="wow-knapp wow-knapp--strek" href="/sjekk"><span class="wow-knapp__tekst">Kjør den fulle sjekken</span></a>
      <a class="wow-lenke" href="/verktoy/cookie-sjekk">Sjekk cookies</a>
    </div>
  </Seksjon>

  <Kontaktblokk tittel="Spørsmål om funnene?" ingress="Har du rapporten foran deg og vil vite hva som haster, tar det fem minutter på telefon." />
</MalWow>

<script>
  import { maalingHtml, rapportarkHtml, lampeHtml, statusOrd, fraSjekk, type LampeStatus } from "../../components/wow/side/maaling";

  interface Brudd {
    regel: string; alvorlighet: string; forklaring: string; krav: string | null;
    oversatt: boolean; antall: number; eksempler: string[]; hjelpeLenke: string;
  }
  interface Rapport {
    url: string; dato: string; status: "ok" | "warn" | "fail" | "neutral";
    antallBrudd: number; antallRegler: number; antallAlvorlige: number;
    brudd: Brudd[]; måSjekkesManuelt: { regel: string; forklaring: string; antall: number }[];
    sekunder: number; oppsummering: string; forbehold: string[]; feil?: string;
  }

  const ALVOR: Record<string, string> = {
    critical: "Kritisk", serious: "Alvorlig", moderate: "Middels", minor: "Mindre", ukjent: "Ukjent",
  };

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  /** Lampe og status som ord, i en tabellcelle. */
  const status = (s: LampeStatus) => `<span class="wow-vt-status">${lampeHtml(s)}${statusOrd[s]}</span>`;

  const boks = document.querySelector<HTMLElement>("#resultat")!;
  const felt = document.querySelector<HTMLInputElement>("#url-uu")!;
  const skjema = felt.closest("form");

  // De to radene sjekken alltid rapporterer. Samme navn mens den venter og når svaret er her.
  const RADER = ["Maskinelle brudd", "Må testes manuelt"] as const;

  /** Én rad utenfor et rapportark: sjekken kjørte ikke. «Ikke sjekket», aldri «Bestått» eller «Brudd». */
  const stoppet = (hvorfor: string) => {
    boks.innerHTML = maalingHtml(
      {
        navn: "Sjekken stoppet",
        status: "ikke-sjekket",
        merknad: `${hvorfor} At sjekken ikke kjørte er ikke det samme som at siden er i orden.`,
      },
      "div",
    );
  };

  function tegn(r: Rapport) {
    const rader = r.brudd
      .map((b) => {
        const alvor: LampeStatus = b.alvorlighet === "critical" || b.alvorlighet === "serious" ? "brudd" : "bor";
        return `<tr>
          <th scope="row">${esc(ALVOR[b.alvorlighet] ?? b.alvorlighet)}</th>
          <td>${status(alvor)}</td>
          <td>${b.antall}</td>
          <td>
            ${esc(b.forklaring)}
            ${b.krav ? ` (${esc(b.krav)})` : ""}
            ${b.oversatt ? "" : " (axe-core sin engelske tekst – regelen er ikke oversatt)"}
          </td>
        </tr>`;
      })
      .join("");

    boks.innerHTML =
      rapportarkHtml({
        tittelId: "rapport-tittel",
        rader: [
          { navn: RADER[0], verdi: String(r.antallBrudd), status: fraSjekk[r.status], merknad: r.oppsummering },
          {
            // Det axe-core ikke kunne avgjøre, er usjekket. Aldri «Bestått».
            navn: RADER[1],
            verdi: String(r.måSjekkesManuelt.length),
            status: "ikke-sjekket",
            merknad: "Regler axe-core ikke kunne avgjøre på egen hånd. De er ikke feil – de er usjekket.",
          },
        ],
        adresse: r.url,
        dato: `${r.dato}. Skannet på ${r.sekunder} s. WCAG 2.0 A + AA`,
      }) +
      `<div class="wow-prosa">` +
      (r.brudd.length
        ? `<table>
             <caption>Brudd, mest alvorlige først</caption>
             <thead><tr><th scope="col">Alvorlighet</th><th scope="col">Status</th><th scope="col">Antall</th><th scope="col">Hva det betyr for brukeren</th></tr></thead>
             <tbody>${rader}</tbody>
           </table>`
        : `<p>Ingen maskinelle brudd funnet. Les forbeholdene under før du konkluderer.</p>`) +
      (r.måSjekkesManuelt.length
        ? `<details>
             <summary>${r.måSjekkesManuelt.length} regler axe-core ikke kunne avgjøre</summary>
             <ul class="wow-notat">${r.måSjekkesManuelt.map((m) => `<li>${esc(m.forklaring)} <code>${esc(m.regel)}</code>, ${m.antall}</li>`).join("")}</ul>
           </details>`
        : "") +
      `<details open>
         <summary>Forbehold – hva sjekken ikke kan avgjøre</summary>
         <ul class="wow-notat">${r.forbehold.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>
       </details>` +
      `</div>`;

    // Resultatet er klart: flytt fokus til rapportens tittel, så skjermleseren starter der.
    document.getElementById("rapport-tittel")?.focus({ preventScroll: false });
  }

  async function kjor(url: string) {
    if (!url.trim()) return;
    boks.setAttribute("aria-busy", "true");
    // Venter: de samme to radene, uten verdi. Ingen spinner.
    boks.innerHTML =
      rapportarkHtml({ rader: RADER.map((navn) => ({ navn, status: "venter" as const })), adresse: url }) +
      `<p class="wow-vt-venter">Vi starter en nettleser og kjører axe-core. Det tar vanligvis 15–30 sekunder.</p>`;
    try {
      const svar = await fetch("/api/uu-sjekk", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ url }),
      });
      const data = (await svar.json()) as Rapport;
      if (!svar.ok || data.feil) {
        stoppet(data.feil ?? "Ukjent feil.");
        return;
      }
      tegn(data);
    } catch {
      stoppet("Fikk ikke svar fra serveren. Prøv igjen om et øyeblikk.");
    } finally {
      boks.setAttribute("aria-busy", "false");
    }
  }

  skjema?.addEventListener("submit", (e) => {
    e.preventDefault();
    history.replaceState(null, "", `/verktoy/uu-sjekk?url=${encodeURIComponent(felt.value)}`);
    void kjor(felt.value);
  });

  // Siden er forhåndsbygget, så ?url= kommer ikke med i feltets value fra serveren. Adressen
  // leses her (samme grep som /sjekk), så lenker med ?url= kjører sjekken med en gang.
  const fraAdresse = new URLSearchParams(location.search).get("url")?.trim() ?? "";
  if (fraAdresse && !felt.value.trim()) felt.value = fraAdresse;
  if (felt.value.trim()) void kjor(felt.value);
</script>
